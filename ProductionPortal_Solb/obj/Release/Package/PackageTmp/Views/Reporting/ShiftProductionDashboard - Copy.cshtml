<script>
    $(document).ready(function () {
        $("#btnToggleDowntime").on("click", function () {
            $("#downtimeDetailsBody").slideToggle(200);
            $("#downtimeToggleIcon")
                .toggleClass("fa-chevron-down fa-chevron-up");
        });

        $("#btnToggleProduction").on("click", function () {
            $("#productionDetailsBody").slideToggle(200);
            $("#productionToggleIcon")
                .toggleClass("fa-chevron-down fa-chevron-up");
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof Chart === "undefined") {
            console.error("Chart.js library is not loaded.");
            return;
        }

        Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
        Chart.defaults.color = "#444";

        var heatLabels = @Html.Raw(JsonConvert.SerializeObject(heatLabels));
        var billetRolledData = @Html.Raw(JsonConvert.SerializeObject(billetRolledData));
        var billetWeightData = @Html.Raw(JsonConvert.SerializeObject(billetWeightData));
        var finishedWeightData = @Html.Raw(JsonConvert.SerializeObject(finishedWeightData));
        var downtimeAgencyLabels = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyLabels));
        var downtimeAgencyData = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyData));
        var productivityDateLabels = @Html.Raw(JsonConvert.SerializeObject(productivityDateLabels));
        var productivityDayData = @Html.Raw(JsonConvert.SerializeObject(productivityDayData));

        var productionPlan = @Html.Raw(JsonConvert.SerializeObject(productionPlan));
        var productionActual = @Html.Raw(JsonConvert.SerializeObject(productionActual));
        var productionDifference = @Html.Raw(JsonConvert.SerializeObject(productionDifference));

        function numberLabel(value) {
            return Number(value || 0).toLocaleString();
        }

        function createDowntimeChart() {
            var canvas = document.getElementById("downtimeAgencyChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: downtimeAgencyLabels,
                    datasets: [{
                        label: "Downtime Minutes",
                        data: downtimeAgencyData,
                        backgroundColor: "#c1121f",
                        borderColor: "#991b1b",
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "Downtime: " + numberLabel(context.raw) + " min";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 0
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Minutes" },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        function createPlanVsActualChart() {
            var canvas = document.getElementById("planVsActualChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: ["Plan", "Actual", "Difference"],
                    datasets: [{
                        label: "Production Weight (MT)",
                        data: [productionPlan, productionActual, productionDifference],
                        backgroundColor: ["#6c6c6c", "#c00000", "#a6a6a6"],
                        borderColor: ["#595959", "#990000", "#808080"],
                        borderWidth: 1,
                        borderRadius: 0,
                        barPercentage: 0.72,
                        categoryPercentage: 0.72
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: "Plan Vs Actual",
                            color: "#222",
                            font: { size: 13, weight: "bold" }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return numberLabel(context.raw) + " MT";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: "rgba(0,0,0,0.10)" },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: "rgba(0,0,0,0.10)" },
                            title: { display: true, text: "Metric Tons" },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        function createAccumulatedProductionChart() {
            var canvas = document.getElementById("daywiseProductivityChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "line",
                data: {
                    labels: productivityDateLabels,
                    datasets: [{
                        label: "Accumulated Production (MT)",
                        data: productivityDayData,
                        borderColor: "#a6173f",
                        backgroundColor: "rgba(166,23,63,0.12)",
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: "#a6173f",
                        pointBorderColor: "#ffffff",
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: "top"
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "Accumulated Production: " +
                                        numberLabel(context.raw) +
                                        " MT";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            title: {
                                display: true,
                                text: "Production Date"
                            },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: "rgba(0,0,0,0.08)" },
                            title: {
                                display: true,
                                text: "Accumulated Production (MT)"
                            },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        function createWeightCompareChart() {
            var canvas = document.getElementById("weightCompareChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: heatLabels,
                    datasets: [
                        {
                            label: "Billet Wt. (MT)",
                            data: billetWeightData,
                            backgroundColor: "#0d6efd",
                            borderColor: "#0a58ca",
                            borderWidth: 1,
                            borderRadius: 6
                        },
                        {
                            label: "Finished Product Wt. (MT)",
                            data: finishedWeightData,
                            backgroundColor: "#198754",
                            borderColor: "#146c43",
                            borderWidth: 1,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: "top" },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ": " +
                                        numberLabel(context.raw) + " MT";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Metric Tons" },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        createDowntimeChart();
        createPlanVsActualChart();
        createAccumulatedProductionChart();
        createWeightCompareChart();
    });
</script>
