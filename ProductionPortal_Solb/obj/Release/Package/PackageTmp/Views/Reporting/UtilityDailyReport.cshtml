@model DAL.Models.UtilityDailyReportVM
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Utility Daily Report";

    var reportDate = Model != null ? Model.ReportDate : DateTime.Today;

    var smp = Model != null ? Model.SMP : null;
    var rm1 = Model != null ? Model.RM1 : null;
    var rm2 = Model != null ? Model.RM2 : null;

    Func<string, decimal> ToDec = value =>
    {
        decimal result;
        if (string.IsNullOrWhiteSpace(value))
            return 0;

        value = value.Trim();

        if (decimal.TryParse(value, out result))
            return result;

        return 0;
    };

    Func<decimal?, decimal> ToDecNullable = value =>
    {
        return value.HasValue ? value.Value : 0;
    };

    Func<decimal, string> F = value =>
    {
        return value.ToString("0.00");
    };

    Func<decimal, decimal, string> VarianceText = (actual, target) =>
    {
        if (target <= 0)
            return "-";

        decimal v = ((actual - target) / target) * 100;

        if (v > 0)
            return "▲ +" + v.ToString("0.00") + "%";

        if (v < 0)
            return "▼ " + v.ToString("0.00") + "%";

        return "0.00%";
    };

    Func<decimal, decimal, string> VarianceClass = (actual, target) =>
    {
        if (target <= 0)
            return "neutral";

        return actual > target ? "bad" : "good";
    };

    Func<decimal, decimal, string> StatusText = (actual, target) =>
    {
        if (target <= 0)
            return "N/A";

        decimal v = ((actual - target) / target) * 100;

        if (actual <= target)
            return "Good";

        if (v <= 5)
            return "Acceptable";

        return "High";
    };

    Func<decimal, decimal, string> StatusClass = (actual, target) =>
    {
        if (target <= 0)
            return "na";

        decimal v = ((actual - target) / target) * 100;

        if (actual <= target)
            return "good";

        if (v <= 5)
            return "warn";

        return "bad";
    };

    Func<decimal, decimal, string> BarWidth = (actual, target) =>
    {
        if (target <= 0)
            return "0";

        decimal pct = (actual / target) * 100;

        if (pct > 100)
            pct = 100;

        if (pct < 0)
            pct = 0;

        return pct.ToString("0");
    };

    decimal smpProduction =
    ToDecNullable(
        smp != null
            ? smp.TotalProductBillet
            : null
    );

    decimal rm1Production =
    ToDecNullable(
        rm1 != null
            ? rm1.TotalProductBillet
            : null
    );

    decimal rm2Production =
    ToDecNullable(
        rm2 != null
            ? rm2.TotalProductBillet
            : null
    );
    decimal rmProduction = rm1Production + rm2Production;
    decimal totalProduction = smpProduction + rmProduction;

    /*
     * ACTUAL CONSUMPTION PER TON
     * Actual = Raw Component Consumption / Plant Total Production
     */

    decimal smpPowerActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.PowerConsumption) / smpProduction
        : 0m;
    decimal smpPowerTarget = smp != null
        ? ToDecNullable(smp.PowerConsumptionKWHtarget)
        : 0m;

    decimal smpWaterActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.WaterConsumption) / smpProduction
        : 0m;
    decimal smpWaterTarget = smp != null
        ? ToDecNullable(smp.WaterConsumptionTarget)
        : 0m;

    decimal smpOxygenActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.Oxygen) / smpProduction
        : 0m;
    decimal smpOxygenTarget = smp != null
        ? ToDecNullable(smp.OxygenNm3tonTarget)
        : 0m;

    decimal smpNitrogenActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.Nitrogen) / smpProduction
        : 0m;
    decimal smpNitrogenTarget = smp != null
        ? ToDecNullable(smp.NitrogenNm3tonTarget)
        : 0m;

    decimal smpArgonActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.Argon) / smpProduction
        : 0m;
    decimal smpArgonTarget = smp != null
        ? ToDecNullable(smp.ArgonNm3tonTarget)
        : 0m;

    decimal smpLpgActual = smpProduction > 0 && smp != null
        ? ToDecNullable(smp.LPG) / smpProduction
        : 0m;
    decimal smpLpgTarget = smp != null
        ? ToDecNullable(smp.LPGNm3tonTarget)
        : 0m;

    decimal rm1PowerActual = rm1Production > 0 && rm1 != null
        ? ToDecNullable(rm1.PowerConsumption) / rm1Production
        : 0m;
    decimal rm1PowerTarget = rm1 != null
        ? ToDecNullable(rm1.PowerConsumptionKWHtarget)
        : 0m;

    decimal rm1WaterActual = rm1Production > 0 && rm1 != null
        ? ToDecNullable(rm1.WaterConsumption) / rm1Production
        : 0m;
    decimal rm1WaterTarget = rm1 != null
        ? ToDecNullable(rm1.WaterConsumptionTarget)
        : 0m;

    decimal rm2PowerActual = rm2Production > 0 && rm2 != null
        ? ToDecNullable(rm2.PowerConsumption) / rm2Production
        : 0m;
    decimal rm2PowerTarget = rm2 != null
        ? ToDecNullable(rm2.PowerConsumptionKWHtarget)
        : 0m;

    decimal rm2WaterActual = rm2Production > 0 && rm2 != null
        ? ToDecNullable(rm2.WaterConsumption) / rm2Production
        : 0m;
    decimal rm2WaterTarget = rm2 != null
        ? ToDecNullable(rm2.WaterConsumptionTarget)
        : 0m;

    bool smpPowerIssue = smpPowerTarget > 0 && smpPowerActual > smpPowerTarget;
    bool smpNitrogenIssue = smpNitrogenTarget > 0 && smpNitrogenActual > smpNitrogenTarget;

    decimal totalPowerRaw =
        ToDecNullable(smp != null ? smp.PowerConsumption : null)
        + ToDecNullable(rm1 != null ? rm1.PowerConsumption : null)
        + ToDecNullable(rm2 != null ? rm2.PowerConsumption : null);

    decimal totalWaterRaw =
        ToDecNullable(smp != null ? smp.WaterConsumption : null)
        + ToDecNullable(rm1 != null ? rm1.WaterConsumption : null)
        + ToDecNullable(rm2 != null ? rm2.WaterConsumption : null);

    decimal totalFuelRaw =
        ToDecNullable(rm1 != null ? rm1.FuelConsumption : null)
        + ToDecNullable(rm2 != null ? rm2.FuelConsumption : null);

    int issueCount = 0;
    if (smpPowerIssue)
    {
        issueCount++;
    }
    if (smpNitrogenIssue)
    {
        issueCount++;
    }
    if (rm1PowerTarget > 0 && rm1PowerActual > rm1PowerTarget)
    {
        issueCount++;
    }
    if (rm1WaterTarget > 0 && rm1WaterActual > rm1WaterTarget)
    {
        issueCount++;
    }
    if (rm2PowerTarget > 0 && rm2PowerActual > rm2PowerTarget)
    {
        issueCount++;
    }
    if (rm2WaterTarget > 0 && rm2WaterActual > rm2WaterTarget)
    {
        issueCount++;
    }

    decimal rm1FuelActual =
    rm1Production > 0
        ? ToDecNullable(
            rm1 != null
                ? rm1.FuelConsumption
                : null
          ) / rm1Production
        : 0;

    decimal rm1FuelTarget =
        ToDecNullable(
            rm1 != null
                ? rm1.FuelConsumptionTarget
                : null
        );


    decimal rm2FuelActual =
        rm2Production > 0
            ? ToDecNullable(
                rm2 != null
                    ? rm2.FuelConsumption
                    : null
              ) / rm2Production
            : 0;

    decimal rm2FuelTarget =
        ToDecNullable(
            rm2 != null
                ? rm2.FuelConsumptionTarget
                : null
        );


    bool rm1Good =
        (rm1PowerTarget <= 0 || rm1PowerActual <= rm1PowerTarget)
        &&
        (rm1WaterTarget <= 0 || rm1WaterActual <= rm1WaterTarget)
        &&
        (rm1FuelTarget <= 0 || rm1FuelActual <= rm1FuelTarget);

    bool rm2Good =
        (rm2PowerTarget <= 0 || rm2PowerActual <= rm2PowerTarget)
        &&
        (rm2WaterTarget <= 0 || rm2WaterActual <= rm2WaterTarget)
        &&
        (rm2FuelTarget <= 0 || rm2FuelActual <= rm2FuelTarget);

    bool rmGood = rm1Good && rm2Good;

    if (rm1FuelTarget > 0 && rm1FuelActual > rm1FuelTarget)
    {
        issueCount++;
    }

    if (rm2FuelTarget > 0 && rm2FuelActual > rm2FuelTarget)
    {
        issueCount++;
    }

    string overallStatus =
        issueCount == 0 ? "Healthy"
        : issueCount <= 2 ? "Monitor"
        : "Attention";
}

<style>
    :root {
        --solb-maroon: #7f1010;
        --solb-maroon-dark: #5f0b0b;
        --solb-red: #a6173f;
        --solb-grey: #f4f6f8;
        --text-main: #222;
        --text-muted: #6b7280;
        --line: #e5e7eb;
        --green: #198754;
        --orange: #fd7e14;
        --red: #c1121f;
        --blue: #0d6efd;
        --shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    body {
        background: #eef2f6;
    }

    .utility-dashboard {
        font-family: Arial, Helvetica, sans-serif;
    }

    .dashboard-header {
        background: linear-gradient(135deg, var(--solb-maroon-dark), var(--solb-maroon));
        color: #fff;
        border-radius: 14px;
        padding: 22px 24px;
        margin-bottom: 18px;
        box-shadow: var(--shadow);
    }

        .dashboard-header h3 {
            margin: 0;
            color: #fff;
            font-weight: 800;
            letter-spacing: .3px;
        }

        .dashboard-header small {
            color: rgba(255,255,255,.92);
            font-size: 13px;
        }

    .filter-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        padding: 16px;
        margin-bottom: 18px;
        border-left: 5px solid var(--solb-maroon);
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .kpi-card {
        background: #fff;
        border-radius: 14px;
        padding: 16px;
        min-height: 112px;
        box-shadow: var(--shadow);
        border-left: 6px solid var(--solb-maroon);
    }

        .kpi-card.good {
            border-left-color: var(--green);
        }

        .kpi-card.warn {
            border-left-color: var(--orange);
        }

        .kpi-card.bad {
            border-left-color: var(--red);
        }

    .kpi-label {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .kpi-value {
        margin-top: 12px;
        font-size: 28px;
        font-weight: 900;
        color: var(--text-main);
        line-height: 1;
    }

        .kpi-value small {
            font-size: 13px;
            font-weight: 700;
        }

        .kpi-value.green {
            color: var(--green);
        }

        .kpi-value.orange {
            color: var(--orange);
        }

        .kpi-value.red {
            color: var(--red);
        }

    .kpi-sub {
        margin-top: 9px;
        color: #888;
        font-size: 12px;
    }

    .section-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .section-card-header {
        background: var(--solb-maroon);
        color: #fff;
        padding: 13px 16px;
        font-size: 15px;
        font-weight: 900;
        text-transform: uppercase;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .section-card-header.dark {
            background: #343a40;
        }

        .section-card-header span {
            font-size: 12px;
            font-weight: 600;
            text-transform: none;
            opacity: .95;
        }

    .section-card-body {
        padding: 0;
    }

    .utility-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .utility-table th {
            background: #f6f7f9;
            color: #333;
            padding: 12px 10px;
            border-bottom: 1px solid var(--line);
            font-size: 13px;
            font-weight: 800;
            text-align: center;
        }

            .utility-table th:first-child {
                text-align: left;
            }

        .utility-table td {
            padding: 10px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 12px;
            vertical-align: middle;
            background: #fff;
        }

        .utility-table tr:nth-child(even) td {
            background: #fcfcfc;
        }

        .utility-table tr:last-child td {
            border-bottom: none;
        }

    .metric {
        font-weight: 800;
        color: #333;
    }

    .num {
        text-align: center;
        font-weight: 700;
        color: #333;
    }

    .good {
        color: var(--green);
    }

    .bad {
        color: var(--red);
    }

    .neutral {
        color: var(--text-muted);
    }

    .barbox {
        width: 220px;
        max-width: 100%;
        height: 10px;
        background: #edf1f5;
        border-radius: 20px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }

    .bar {
        display: block;
        height: 100%;
        border-radius: 20px;
        background: var(--green);
    }

        .bar.warn {
            background: var(--orange);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        height: 24px;
        padding: 0 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
    }

        .badge-status.good {
            background: #d1e7dd;
            color: #0f5132;
        }

        .badge-status.warn {
            background: #fff3cd;
            color: #856404;
        }

        .badge-status.bad {
            background: #f8d7da;
            color: #842029;
        }

        .badge-status.na {
            background: #e9ecef;
            color: #6c757d;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 10px;
    }

    .summary-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        border-left: 6px solid var(--solb-maroon);
        padding: 16px;
        min-height: 160px;
    }

        .summary-box h5 {
            color: var(--solb-maroon);
            font-weight: 900;
            text-transform: uppercase;
            font-size: 13px;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
            margin-bottom: 12px;
        }

    .summary-point {
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 8px;
        margin: 9px 0;
        font-size: 12px;
        line-height: 1.45;
    }

        .summary-point b {
            font-weight: 900;
        }

    .icon-good {
        color: var(--green);
        font-weight: 900;
    }

    .icon-warn {
        color: var(--orange);
        font-weight: 900;
    }

    .icon-bad {
        color: var(--red);
        font-weight: 900;
    }


    .executive-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .executive-tile {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, #fff 0%, #fbfbfc 100%);
        border: 1px solid #eceff3;
        border-radius: 16px;
        padding: 16px 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
    }

        .executive-tile:after {
            content: "";
            position: absolute;
            right: -28px;
            top: -28px;
            width: 92px;
            height: 92px;
            border-radius: 50%;
            background: rgba(127,16,16,.06);
        }

        .executive-tile .caption {
            color: #7b8190;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .55px;
            font-weight: 800;
        }

        .executive-tile .big {
            margin-top: 6px;
            font-size: 25px;
            line-height: 1.1;
            font-weight: 900;
            color: #20242a;
        }

        .executive-tile .unit {
            font-size: 11px;
            color: #8a9099;
            font-weight: 700;
            margin-left: 4px;
        }

        .executive-tile .mini {
            margin-top: 7px;
            font-size: 11px;
            color: #6b7280;
        }

    .dashboard-header {
        position: relative;
        overflow: hidden;
    }

        .dashboard-header:before {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            right: -75px;
            top: -120px;
            background: rgba(255,255,255,.08);
        }

    .header-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.14);
        font-size: 11px;
        font-weight: 800;
    }

        .header-status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #8cffb1;
            box-shadow: 0 0 0 4px rgba(140,255,177,.12);
        }

    @@media (max-width: 1200px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-header .text-right {
            text-align: left !important;
            margin-top: 12px;
        }

        .section-card-header {
            display: block;
        }

            .section-card-header span {
                display: block;
                margin-top: 4px;
            }
    }

    @@media print {
        .no-print,
        .xp-breadcrumbbar,
        .navbar,
        .sidebar,
        .footer,
        header {
            display: none !important;
        }

        html,
        body {
            background: #fff !important;
            margin: 0 !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .xp-contentbar {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
        }

        .dashboard-header,
        .kpi-card,
        .section-card,
        .summary-box,
        .filter-card {
            box-shadow: none !important;
        }

        .dashboard-header {
            background: #7f1010 !important;
            color: #fff !important;
            border-radius: 10px !important;
            margin-bottom: 10px !important;
            padding: 16px 20px !important;
        }

            .dashboard-header h3,
            .dashboard-header small,
            .dashboard-header b,
            .dashboard-header div {
                color: #fff !important;
            }

        .kpi-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 8px !important;
            margin-bottom: 10px !important;
        }

        .kpi-card {
            border: 1px solid #ddd !important;
            border-left: 5px solid #7f1010 !important;
            border-radius: 10px !important;
            min-height: 90px !important;
            padding: 10px !important;
        }

        .section-card {
            border: 1px solid #ddd !important;
            border-radius: 10px !important;
            page-break-inside: avoid !important;
            margin-bottom: 10px !important;
        }

        .section-card-header {
            background: #7f1010 !important;
            color: #fff !important;
        }

            .section-card-header.dark {
                background: #343a40 !important;
            }

        .utility-table th {
            background: #f3f3f3 !important;
            color: #333 !important;
            border: 1px solid #ddd !important;
        }

        .utility-table td {
            border: 1px solid #eee !important;
            background: #fff !important;
        }

        .summary-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 10px !important;
        }

        .summary-box {
            border: 1px solid #ddd !important;
            border-left: 5px solid #7f1010 !important;
            border-radius: 10px !important;
            page-break-inside: avoid !important;
        }

        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
    }
</style>

<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-8">
            <h4 class="xp-page-title">Utility Daily Report</h4>
        </div>
        <div class="col-md-4 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">
                        <i class="icon-home"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">Utility</li>
                <li class="breadcrumb-item active">Daily Report</li>
            </ol>
        </div>
    </div>
</div>

<div class="xp-contentbar utility-dashboard">

    <div class="filter-card no-print">
        <form method="get" action="@Url.Action("UtilityDailyReport", "Consumption")">
            <div class="row align-items-end">
                <div class="col-md-3">
                    <label><b>Date</b></label>
                    <input type="date"
                           name="date"
                           class="form-control"
                           value="@reportDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        Load Report
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            onclick="printUtilityReport()">
                        Print
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3>Utility Daily Report</h3>
                <small>
                    <b>Steel Melting Plant & Rolling Mill Analysis</b>
                </small>
                <div class="header-status">
                    <span class="dot"></span>
                    Overall Status: @overallStatus
                </div>
            </div>
            <div class="col-md-4 text-right">
                <div><b>Date:</b> @reportDate.ToString("dd MMM yyyy")</div>
                <div><b>Report No:</b> UDR-@reportDate.ToString("yyyyMMdd")</div>
            </div>
        </div>
    </div>

    <section class="executive-strip">
        <div class="executive-tile">
            <div class="caption">Total Power Draw</div>
            <div class="big">@F(totalPowerRaw)<span class="unit">KWH</span></div>
            <div class="mini">SMP + RM1 + RM2 daily total</div>
        </div>

        <div class="executive-tile">
            <div class="caption">Total Water Usage</div>
            <div class="big">@F(totalWaterRaw)<span class="unit">M³</span></div>
            <div class="mini">Combined plant water consumption</div>
        </div>

        <div class="executive-tile">
            <div class="caption">Rolling Mill Fuel</div>
            <div class="big">@F(totalFuelRaw)<span class="unit">Liter</span></div>
            <div class="mini">RM1 + RM2 fuel usage</div>
        </div>

        <div class="executive-tile">
            <div class="caption">Exceptions</div>
            <div class="big">@issueCount</div>
            <div class="mini">Metrics above configured target</div>
        </div>
    </section>

    <section class="kpi-grid">
