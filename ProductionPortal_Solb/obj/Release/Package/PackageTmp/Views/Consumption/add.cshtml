@model DAL.Models.PlantConsumptionBLL

@{
    ViewBag.Title =
        "Plant Consumption";


    DAL.Models.PlantConsumptionBLL smp =
        ViewBag.SMP
            as DAL.Models.PlantConsumptionBLL
        ??
        new DAL.Models.PlantConsumptionBLL();


    DAL.Models.PlantConsumptionBLL rm1 =
        ViewBag.RM1
            as DAL.Models.PlantConsumptionBLL
        ??
        new DAL.Models.PlantConsumptionBLL();


    DAL.Models.PlantConsumptionBLL rm2 =
        ViewBag.RM2
            as DAL.Models.PlantConsumptionBLL
        ??
        new DAL.Models.PlantConsumptionBLL();


    bool isEditMode =
        smp.ID > 0 ||
        rm1.ID > 0 ||
        rm2.ID > 0;


    string consumptionDate =
        Convert.ToString(
            ViewBag.ConsumptionDate
        );


    if (
        string.IsNullOrWhiteSpace(
            consumptionDate
        )
    )
    {
        consumptionDate =
            DateTime.Today.ToString(
                "yyyy-MM-dd"
            );
    }
}


<style>

    .plant-card {
        background: #fff;
        border: 1px solid #ddd;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    .plant-card-header {
        background: #8b0018;
        color: #fff;
        padding: 12px 15px;
        font-weight: 600;
    }

    .plant-card-body {
        padding: 20px;
    }
</style>


<div class="xp-breadcrumbbar">

    <div class="row">

        <div class="col-md-6">

            <h4 class="xp-page-title">

                @(isEditMode
                    ? "Edit Plant Consumption"
                    : "Add Plant Consumption")

            </h4>

        </div>

    </div>

</div>


<div class="xp-contentbar">


    <form action="@Url.Action("add", "Consumption")"
          id="addprofileform"
          method="post">


        @Html.AntiForgeryToken()


        <!-- IDs -->

        <input type="hidden"
               name="SMP_ID"
               value="@smp.ID" />

        <input type="hidden"
               name="RM1_ID"
               value="@rm1.ID" />

        <input type="hidden"
               name="RM2_ID"
               value="@rm2.ID" />


        <!-- DATE -->

        <div class="plant-card">

            <div class="plant-card-header">
                Consumption Date
            </div>

            <div class="plant-card-body">

                <div class="form-row">

                    <div class="form-group col-md-3">

                        <label>
                            Date
                        </label>

                        <input type="date"
                               id="ConsumptionDate"
                               name="ConsumptionDate"
                               class="form-control"
                               value="@consumptionDate"
                               required />

                    </div>

                </div>

            </div>

        </div>


        <!-- SMP -->

        <div class="plant-card">

            <div class="plant-card-header">
                STEEL MAKING PLANT (SMP) DAILY CONSUMPTION
            </div>

            <div class="plant-card-body">


                <div class="form-row">


                    <div class="form-group col-md-3">

                        <label>
                            Total Product Billet (Ton)
                        </label>

                        <input type="number"
                               step="0.001"
                               id="SMP_TotalProductBillet"
                               name="SMP_TotalProductBillet"
                               class="form-control"
                               value="@smp.TotalProductBillet"
                               readonly />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            LPG (Nm3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_LPG"
                               class="form-control"
                               value="@smp.LPG" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Oxygen (Nm3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_Oxygen"
                               class="form-control"
                               value="@smp.Oxygen" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Nitrogen (Nm3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_Nitrogen"
                               class="form-control"
                               value="@smp.Nitrogen" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Argon (Nm3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_Argon"
                               class="form-control"
                               value="@smp.Argon" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Water Consumption (M3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_WaterConsumption"
                               class="form-control"
                               value="@smp.WaterConsumption" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Power Consumption (KWH)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="SMP_PowerConsumption"
                               class="form-control"
                               value="@smp.PowerConsumption" />

                    </div>


                </div>

            </div>

        </div>


        <!-- RM1 -->

        <div class="plant-card">

            <div class="plant-card-header">
                ROLLING MILL 1 (RM1) DAILY CONSUMPTION
            </div>

            <div class="plant-card-body">

                <div class="form-row">


                    <div class="form-group col-md-3">

                        <label>
                            Total Product Billet (Ton)
                        </label>

                        <input type="number"
                               step="0.001"
                               id="RM1_TotalProductBillet"
                               name="RM1_TotalProductBillet"
                               class="form-control"
                               value="@rm1.TotalProductBillet"
                               readonly />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Water Consumption (M3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM1_WaterConsumption"
                               class="form-control"
                               value="@rm1.WaterConsumption" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Fuel Consumption (Liter)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM1_FuelConsumption"
                               class="form-control"
                               value="@rm1.FuelConsumption" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Power Consumption (KWH)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM1_PowerConsumption"
                               class="form-control"
                               value="@rm1.PowerConsumption" />

                    </div>


                </div>

            </div>

        </div>


        <!-- RM2 -->

        <div class="plant-card">

            <div class="plant-card-header">
                ROLLING MILL 2 (RM2) DAILY CONSUMPTION
            </div>

            <div class="plant-card-body">

                <div class="form-row">


                    <div class="form-group col-md-3">

                        <label>
                            Total Product Billet (Ton)
                        </label>

                        <input type="number"
                               step="0.001"
                               id="RM2_TotalProductBillet"
                               name="RM2_TotalProductBillet"
                               class="form-control"
                               value="@rm2.TotalProductBillet"
                               readonly />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Water Consumption (M3)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM2_WaterConsumption"
                               class="form-control"
                               value="@rm2.WaterConsumption" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Fuel Consumption (Liter)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM2_FuelConsumption"
                               class="form-control"
                               value="@rm2.FuelConsumption" />

                    </div>


                    <div class="form-group col-md-3">

                        <label>
                            Power Consumption (KWH)
                        </label>

                        <input type="number"
                               step="0.001"
                               name="RM2_PowerConsumption"
                               class="form-control"
                               value="@rm2.PowerConsumption" />

                    </div>


                </div>

            </div>

        </div>


        <div class="text-right">

            <a href="@Url.Action("list", "Consumption")"
               class="btn btn-secondary">

                Back

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fa fa-save"></i>

                @(isEditMode
                ? "Update"
                : "Save")

            </button>

        </div>


    </form>

</div>

<script>
    $(document).ready(function () {

        function loadProductionByDate() {

            var selectedDate =
                $("#ConsumptionDate").val();

            if (!selectedDate) {
                $("#SMP_TotalProductBillet").val("0.000");
                $("#RM1_TotalProductBillet").val("0.000");
                $("#RM2_TotalProductBillet").val("0.000");
                return;
            }

            $.ajax({
                url: '@Url.Action("GetProductionByDate", "Consumption")',
                type: 'GET',
                data: {
                    date: selectedDate
                },
                success: function (res) {

                    if (res && res.success) {

                        /*
                         * Production always comes from source production tables.
                         */
                        $("#SMP_TotalProductBillet").val(
                            Number(res.smpProduction || 0).toFixed(3)
                        );

                        $("#RM1_TotalProductBillet").val(
                            Number(res.rm1Production || 0).toFixed(3)
                        );

                        $("#RM2_TotalProductBillet").val(
                            Number(res.rm2Production || 0).toFixed(3)
                        );


                        /*
                         * If PlantConsumption already exists for selected date,
                         * load the saved utility values as well.
                         */
                        var smp = res.smp || {};
                        var rm1 = res.rm1 || {};
                        var rm2 = res.rm2 || {};

                        $("input[name='SMP_ID']").val(smp.id || 0);
                        $("input[name='RM1_ID']").val(rm1.id || 0);
                        $("input[name='RM2_ID']").val(rm2.id || 0);

                        $("input[name='SMP_LPG']").val(
                            smp.lpg != null ? smp.lpg : ""
                        );

                        $("input[name='SMP_Oxygen']").val(
                            smp.oxygen != null ? smp.oxygen : ""
                        );

                        $("input[name='SMP_Nitrogen']").val(
                            smp.nitrogen != null ? smp.nitrogen : ""
                        );

                        $("input[name='SMP_Argon']").val(
                            smp.argon != null ? smp.argon : ""
                        );

                        $("input[name='SMP_WaterConsumption']").val(
                            smp.waterConsumption != null
                                ? smp.waterConsumption
                                : ""
                        );

                        $("input[name='SMP_PowerConsumption']").val(
                            smp.powerConsumption != null
                                ? smp.powerConsumption
                                : ""
                        );


                        $("input[name='RM1_WaterConsumption']").val(
                            rm1.waterConsumption != null
                                ? rm1.waterConsumption
                                : ""
                        );

                        $("input[name='RM1_FuelConsumption']").val(
                            rm1.fuelConsumption != null
                                ? rm1.fuelConsumption
                                : ""
                        );

                        $("input[name='RM1_PowerConsumption']").val(
                            rm1.powerConsumption != null
                                ? rm1.powerConsumption
                                : ""
                        );


                        $("input[name='RM2_WaterConsumption']").val(
                            rm2.waterConsumption != null
                                ? rm2.waterConsumption
                                : ""
                        );

                        $("input[name='RM2_FuelConsumption']").val(
                            rm2.fuelConsumption != null
                                ? rm2.fuelConsumption
                                : ""
                        );

                        $("input[name='RM2_PowerConsumption']").val(
                            rm2.powerConsumption != null
                                ? rm2.powerConsumption
                                : ""
                        );
                    }
                    else {

                        $("#SMP_TotalProductBillet").val("0.000");
                        $("#RM1_TotalProductBillet").val("0.000");
                        $("#RM2_TotalProductBillet").val("0.000");

                        $("input[name='SMP_ID']").val(0);
                        $("input[name='RM1_ID']").val(0);
                        $("input[name='RM2_ID']").val(0);

                        $("input[name='SMP_LPG']").val("");
                        $("input[name='SMP_Oxygen']").val("");
                        $("input[name='SMP_Nitrogen']").val("");
                        $("input[name='SMP_Argon']").val("");
                        $("input[name='SMP_WaterConsumption']").val("");
                        $("input[name='SMP_PowerConsumption']").val("");

                        $("input[name='RM1_WaterConsumption']").val("");
                        $("input[name='RM1_FuelConsumption']").val("");
                        $("input[name='RM1_PowerConsumption']").val("");

                        $("input[name='RM2_WaterConsumption']").val("");
                        $("input[name='RM2_FuelConsumption']").val("");
                        $("input[name='RM2_PowerConsumption']").val("");
                    }
                },
                error: function () {

                    $("#SMP_TotalProductBillet").val("0.000");
                    $("#RM1_TotalProductBillet").val("0.000");
                    $("#RM2_TotalProductBillet").val("0.000");

                    alert("Production data could not be loaded.");
                }
            });
        }


        /*
         * Date change:
         * SMP = SMPDayWiseProduction.TotalCastedTon
         * RM1/RM2 = BundlesSection.TotalWeight by Date + Plant
         */
        $("#ConsumptionDate").on(
            "change",
            loadProductionByDate
        );


        /*
         * Load production automatically when page opens.
         */
        loadProductionByDate();
    });
</script>