@using System.Globalization
@{
    ViewBag.Title = "list";

}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Rolling Mill Target</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Rolling Mill</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Targets</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="fromDate" class="mr-2">From</label>
                                <input type="date" id="fromDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="toDate" class="mr-2">To</label>
                                <input type="date" id="toDate" class="form-control" />
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("add", "Target")">
                                    <i class="fa fa-plus-circle"></i> Add Record
                                </a>
                            </div>
                            <div class="form-group d-flex align-items-end">
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <!-- Start XP Row -->
    <div class="row">
        <!-- End XP Col -->
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="xp-default-datatable" class="display table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Heat #</th>
                                    <th>Total Alloys</th>
                                    <th>Total Dry Charge</th>
                                    <th>Lime (kg)</th>
                                    <th>KWH</th>
                                    <th>Total Delay</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @*@foreach (var item in Model)
                                {
                                    var gregorian = new CultureInfo("en-US");
                                    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
                                    <tr>
                                        <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                        <td>
                                            <a href="javascript:void(0);"
                                               onclick="confirmDelete('@item.HeatNo')"
                                               class="btn btn-sm btn-danger">
                                                <i class="mdi mdi-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }*@
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- End XP Col -->
    </div>
    <!-- End XP Row -->
</div>
<!-- End XP Contentbar -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        var table = $('#xp-default-datatable').DataTable();

        // ✅ Custom date filter
        $.fn.dataTable.ext.search.push(function (settings, data) {

            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            // data[0] = first column (Date)
            // extract yyyy-MM-dd from hidden span
            var dateMatch = data[0].match(/\d{4}-\d{2}-\d{2}/);
            if (!dateMatch) return true;

            var rowDate = new Date(dateMatch[0] + "T00:00:00");

            var fromDate = from ? new Date(from + "T00:00:00") : null;
            var toDate = to ? new Date(to + "T23:59:59") : null;

            if (fromDate && rowDate < fromDate) return false;
            if (toDate && rowDate > toDate) return false;

            return true;
        });

        // ✅ Default dates
        var today = new Date();
        var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

        function formatDate(d) {
            return d.toISOString().split('T')[0];
        }

        $('#fromDate').val(formatDate(firstDay));
        $('#toDate').val(formatDate(today));

        table.draw();

        // Filter
        $('#filterBtn').click(function () {
            table.draw();
        });

        // Clear
        $('#clearBtn').click(function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            table.draw();
        });

    });
</script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        var msg = '@TempData["SuccessMessage"]';
        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }
    });
</script>

<script>
    function confirmDelete(heatNo) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/Meltshop/EAFdelete?heatNo=' + heatNo;
            }
        });
    }
</script>