@model DAL.Models.CCMDailyProductionReportBLL

@using System
@using System.Linq

@{
    Layout = null;

    var details =
        Model != null &&
        Model.Details != null
            ? Model.Details
                .OrderBy(x => x.SequenceNo)
                .ToList()
            : new List<DAL.Models.CCMDailyProductionReportDetailBLL>();

    int total14M =
        details.Sum(x => x.Billet14M);

    int total13M =
        details.Sum(x => x.Billet13M);

    int total12M =
        details.Sum(x => x.Billet12M);

    int total11M =
        details.Sum(x => x.Billet11M);

    int totalPrimeBillets =
        details.Sum(x => x.GoodBillets);

    int totalShortBillets =
        details.Sum(x => x.ShortBillets);

    int totalBend =
        details.Sum(x => x.Bend);

    int totalBillets =
        details.Sum(x => x.TotalBillets);

    decimal totalPrimeLength =
        details.Sum(
            x => x.TotalLength ?? 0M
        );

    decimal totalShortLength =
        details.Sum(
            x => x.ShortBilletTotalLength ?? 0M
        );

    decimal totalPrimeWeight =
        details.Sum(
            x => x.PrimeBilletWeight ?? 0M
        );

    decimal totalShortWeight =
        details.Sum(
            x => x.ShortBilletWeight ?? 0M
        );

    decimal totalWeight =
        details.Sum(
            x => x.TotalWeight ?? 0M
        );

    decimal overallShortAverageLength =
        totalShortBillets > 0
            ? totalShortLength /
              totalShortBillets
            : 0M;

    string remarks =
        details
            .Where(
                x =>
                    !string.IsNullOrWhiteSpace(
                        x.Remarks
                    )
            )
            .Select(x => x.Remarks)
            .FirstOrDefault() ??
        string.Empty;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />

    <title>
        Billet Yard Daily Production Report
    </title>

    <style>
        @@page {
            size: A4 landscape;
            margin: 6mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #ffffff;
            color: #111111;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 7.5px;
        }

        .report-container {
            width: 100%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .header-table td {
            border: 1px solid #111;
            vertical-align: middle;
        }

        .logo-cell {
            width: 15%;
            padding: 7px;
            text-align: center;
            font-size: 15px;
            font-weight: 800;
            line-height: 1.15;
        }

        .title-cell {
            width: 60%;
            padding: 7px;
            text-align: center;
        }

            .title-cell .company {
                font-size: 15px;
                font-weight: 800;
            }

            .title-cell .section {
                margin-top: 3px;
                font-size: 11px;
                font-weight: 700;
            }

            .title-cell .report-title {
                margin-top: 4px;
                font-size: 13px;
                font-weight: 800;
            }

        .document-cell {
            width: 25%;
            padding: 0;
        }

        .document-table td {
            padding: 4px 5px;
            border: 0;
            border-bottom: 1px solid #111;
            font-size: 7px;
        }

        .document-table tr:last-child td {
            border-bottom: 0;
        }

        .meta-table {
            margin-top: 4px;
        }

            .meta-table td {
                padding: 4px 6px;
                border: 1px solid #111;
                font-size: 8px;
            }

        .production-table {
            margin-top: 5px;
            table-layout: fixed;
        }

            .production-table th,
            .production-table td {
                padding: 3px 2px;
                border: 1px solid #111;
                text-align: center;
                vertical-align: middle;
                overflow-wrap: anywhere;
            }

            .production-table thead th {
                background: #e7e7e7;
                font-weight: 800;
                line-height: 1.2;
            }

            .production-table .sr {
                width: 2.5%;
            }

            .production-table .heat {
                width: 6%;
            }

            .production-table .grade {
                width: 5%;
            }

            .production-table .qty {
                width: 3%;
            }

            .production-table .metric {
                width: 5.2%;
            }

            .production-table .weight {
                width: 5.7%;
            }

            .production-table .total-col {
                width: 4%;
            }

        .number {
            text-align: right !important;
            padding-right: 4px !important;
        }

        .total-row td {
            background: #ececec;
            font-weight: 800;
        }

        .summary-table {
            margin-top: 5px;
        }

            .summary-table td {
                padding: 5px 6px;
                border: 1px solid #111;
                text-align: center;
            }

        .summary-label {
            background: #ededed;
            font-weight: 800;
        }

        .remarks-container {
            min-height: 35px;
            margin-top: 5px;
            padding: 5px 7px;
            border: 1px solid #111;
        }

        .remarks-title {
            margin-bottom: 4px;
            font-weight: 800;
        }

        .signature-table {
            margin-top: 16px;
        }

            .signature-table td {
                width: 50%;
                padding: 4px 45px;
                text-align: center;
                vertical-align: bottom;
            }

        .signature-name {
            min-height: 14px;
            font-weight: 700;
        }

        .signature-line {
            margin-top: 20px;
            padding-top: 4px;
            border-top: 1px solid #111;
            font-weight: 800;
        }

        .footer-note {
            margin-top: 5px;
            color: #555;
            font-size: 6.5px;
            text-align: right;
        }
    </style>
</head>

<body>
    <div class="report-container">

        <table class="header-table">
            <tr>
                <td class="logo-cell">
                    <img src="@Url.Content("~/assets/images/logo.png")" class="img-fluid" alt="SOLB Steel" width="140" height="60" decoding="async" style="width:50%;">
                </td>

                <td class="title-cell">
                    <div class="company">
                        SOLB STEEL COMPANY
                    </div>

                    <div class="section">
                        MELTSHOP – CCM / BILLET YARD
                    </div>

                    <div class="report-title">
                        BILLET YARD DAILY PRODUCTION REPORT
                    </div>
                </td>

                <td class="document-cell">
                    <table class="document-table">
                        <tr>
                            <td>
                                <strong>Document No.</strong>
                            </td>
                            <td>
                                QMF-SM-969
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>Revision</strong>
                            </td>
                            <td>
                                Rev. 0
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <strong>Page</strong>
                            </td>
                            <td>
                                Page 1 of 1
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <table class="meta-table">
            <tr>
                <td>
                    <strong>Report No.:</strong>
                    @(Model != null ? Model.ReportNo : "-")
                </td>

                <td>
                    <strong>Date:</strong>
                    @(Model != null
                        ? Model.ReportDate.ToString("dd-MMM-yyyy")
                        : "-")
                </td>

                <td>
                    <strong>Shift:</strong>
                    @(Model != null ? Model.Shift : "-")
                </td>

                <td>
                    <strong>Team:</strong>
                    @(Model != null ? Model.Team : "-")
                </td>

                <td>
                    <strong>CCM Foreman:</strong>
                    @(Model != null ? Model.CCMForeman : "-")
                </td>

                <td>
                    <strong>Billet Yard Operator:</strong>
                    @(Model != null ? Model.BilletYardOperator : "-")
                </td>
            </tr>
        </table>

        <table class="production-table">
            <thead>
                <tr>
                    <th rowspan="2" class="sr">
                        Sr.
                    </th>

                    <th rowspan="2" class="heat">
                        Heat No.
                    </th>

                    <th rowspan="2" class="grade">
                        Grade
                    </th>

                    <th colspan="4">
                        PRIME BILLET QUANTITY
                    </th>

                    <th rowspan="2" class="total-col">
                        Prime / Good Qty
                    </th>

                    <th rowspan="2" class="metric">
                        Prime Total Length (m)
                    </th>

                    <th colspan="3">
                        SHORT BILLET
                    </th>

                    <th rowspan="2" class="metric">
                        Per Unit Weight
                    </th>

                    <th colspan="3">
                        WEIGHT
                    </th>

                    <th rowspan="2" class="total-col">
                        Bend
                    </th>

                    <th rowspan="2" class="total-col">
                        Total Billets
                    </th>
                </tr>

                <tr>
                    <th class="qty">14M</th>
                    <th class="qty">13M</th>
                    <th class="qty">12M</th>
                    <th class="qty">11M</th>

                    <th class="total-col">
                        Qty
                    </th>

                    <th class="metric">
                        Total Length (m)
                    </th>

                    <th class="metric">
                        Avg. Length (m)
                    </th>

                    <th class="weight">
                        Prime
                    </th>

                    <th class="weight">
                        Short
                    </th>

                    <th class="weight">
                        Total
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (details.Count > 0)
                {
                    foreach (var item in details)
                    {
                        <tr>
                            <td>
                                @item.SequenceNo
                            </td>

                            <td>
                                @item.HeatNo
                            </td>

                            <td>
                                @item.Grade
                            </td>

                            <td>@item.Billet14M</td>
                            <td>@item.Billet13M</td>
                            <td>@item.Billet12M</td>
                            <td>@item.Billet11M</td>

                            <td>
                                @item.GoodBillets
                            </td>

                            <td class="number">
                                @((item.TotalLength ?? 0M).ToString("0.000"))
                            </td>

                            <td>
                                @item.ShortBillets
                            </td>

                            <td class="number">
                                @((item.ShortBilletTotalLength ?? 0M).ToString("0.000"))
                            </td>

                            <td class="number">
                                @((item.ShortBilletAvgLength ?? 0M).ToString("0.00000"))
                            </td>

                            <td class="number">
                                @((item.PerCoilBundleWeight ?? 0M).ToString("0.00000"))
                            </td>

                            <td class="number">
                                @((item.PrimeBilletWeight ?? 0M).ToString("0.000"))
                            </td>

                            <td class="number">
                                @((item.ShortBilletWeight ?? 0M).ToString("0.000"))
                            </td>

                            <td class="number">
                                @((item.TotalWeight ?? 0M).ToString("0.000"))
                            </td>

                            <td>
                                @item.Bend
                            </td>

                            <td>
                                @item.TotalBillets
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="18">
                            No billet yard production details found.
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr class="total-row">
                    <td colspan="3">
                        TOTAL
                    </td>

                    <td>@total14M</td>
                    <td>@total13M</td>
                    <td>@total12M</td>
                    <td>@total11M</td>

                    <td>@totalPrimeBillets</td>

                    <td class="number">
                        @totalPrimeLength.ToString("0.000")
                    </td>

                    <td>@totalShortBillets</td>

                    <td class="number">
                        @totalShortLength.ToString("0.000")
                    </td>

                    <td class="number">
                        @overallShortAverageLength.ToString("0.00000")
                    </td>

                    <td>
                        -
                    </td>

                    <td class="number">
                        @totalPrimeWeight.ToString("0.000")
                    </td>

                    <td class="number">
                        @totalShortWeight.ToString("0.000")
                    </td>

                    <td class="number">
                        @totalWeight.ToString("0.000")
                    </td>

                    <td>@totalBend</td>
                    <td>@totalBillets</td>
                </tr>
            </tfoot>
        </table>

        <table class="summary-table">
            <tr>
                <td class="summary-label">
                    Prime / Good Billets
                </td>
                <td>
                    @totalPrimeBillets
                </td>

                <td class="summary-label">
                    Short Billets
                </td>
                <td>
                    @totalShortBillets
                </td>

                <td class="summary-label">
                    Total Billets
                </td>
                <td>
                    @totalBillets
                </td>

                <td class="summary-label">
                    Total Weight
                </td>
                <td>
                    @totalWeight.ToString("0.000")
                </td>
            </tr>
        </table>

        <div class="remarks-container">
            <div class="remarks-title">
                REMARKS
            </div>

            <div>
                @(string.IsNullOrWhiteSpace(remarks)
                    ? "-"
                    : remarks)
            </div>
        </div>

        <table class="signature-table">
            <tr>
                <td>
                    <div class="signature-name">
                        @(Model != null
                            ? Model.BilletYardOperator
                            : "")
                    </div>

                    <div class="signature-line">
                        SIGNATURE OF BILLET YARD OPERATOR
                    </div>
                </td>

                <td>
                    <div class="signature-name">
                        @(Model != null
                            ? Model.CCMForeman
                            : "")
                    </div>

                    <div class="signature-line">
                        SIGNATURE OF CCM FOREMAN
                    </div>
                </td>
            </tr>
        </table>

        <div class="footer-note">
            Generated from CCM Production Portal
        </div>
    </div>
</body>
</html>
