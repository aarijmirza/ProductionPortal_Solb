@model DAL.Models.CCMDailyProductionReportBLL
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model != null && Model.ID > 0
        ? "Edit Billet Yard Report"
        : "Billet Yard Report";

    int initialRowCount =
        Model != null && Model.ID > 0
            ? Model.Details.Count
            : Math.Min(Model.Details.Count, 1);
}

<style>
    :root {
        --solb-maroon: #9f163d;
        --solb-maroon-dark: #75102d;
        --solb-maroon-soft: #faeef2;
        --solb-bg: #f3f5f7;
        --solb-border: #dfe3e8;
        --solb-text: #202936;
        --solb-muted: #6b7280;
    }

    body {
        background: var(--solb-bg);
    }

    .ccm-shell {
        max-width: 1720px;
        margin: 0 auto;
    }

    .ccm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 20px 24px;
        margin-bottom: 16px;
        border-radius: 16px;
        color: #fff;
        background: linear-gradient(135deg, var(--solb-maroon-dark), var(--solb-maroon));
        box-shadow: 0 10px 26px rgba(117, 16, 45, .20);
        overflow: hidden;
        position: relative;
    }

        .ccm-header:after {
            content: "";
            position: absolute;
            right: -60px;
            top: -110px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

        .ccm-header h3 {
            margin: 0;
            color: #fff;
            font-size: 21px;
            font-weight: 800;
        }

        .ccm-header p {
            margin: 5px 0 0;
            color: rgba(255,255,255,.90);
            font-size: 12px;
            font-weight: 600;
        }

    .ccm-doc-chip {
        position: relative;
        z-index: 2;
        min-width: 130px;
        padding: 9px 13px;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 10px;
        background: rgba(255,255,255,.10);
        text-align: center;
        font-size: 11px;
        font-weight: 800;
    }

    .ccm-card {
        margin-bottom: 17px;
        overflow: hidden;
        border: 1px solid var(--solb-border);
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 6px 18px rgba(15,23,42,.06);
    }

    .ccm-card-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid var(--solb-border);
        background: linear-gradient(180deg,#fff,#fafbfc);
    }

        .ccm-card-title h5 {
            margin: 0;
            color: var(--solb-text);
            font-size: 14px;
            font-weight: 800;
        }

        .ccm-card-title small {
            color: var(--solb-muted);
            font-size: 11px;
            font-weight: 600;
        }

    .ccm-card-body {
        padding: 18px;
    }

    .header-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr 1fr 1fr 1.35fr 1.35fr;
        gap: 12px;
    }

    .form-group {
        margin-bottom: 0;
    }

        .form-group label {
            margin-bottom: 6px;
            color: #4b5563;
            font-size: 10.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

    .required:after {
        content: " *";
        color: #dc3545;
    }

    .form-control {
        height: 40px;
        border: 1px solid #cfd5dc;
        border-radius: 8px;
        box-shadow: none;
        color: var(--solb-text);
        font-size: 13px;
    }

        .form-control:focus {
            border-color: var(--solb-maroon);
            box-shadow: 0 0 0 3px rgba(159,22,61,.10);
        }

    .production-scroll {
        overflow: auto;
        max-height: none;
        border: 1px solid var(--solb-border);
        border-radius: 11px;
        background: #fff;
    }

    .production-table {
        min-width: 1450px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .production-table thead th {
            position: sticky;
            top: 0;
            z-index: 5;
            padding: 9px 6px;
            border-color: rgba(255,255,255,.15);
            background: var(--solb-maroon-dark);
            color: #fff;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 10.5px;
            font-weight: 800;
        }

        .production-table thead tr:nth-child(2) th {
            top: 37px;
            background: var(--solb-maroon);
        }

        .production-table td {
            padding: 5px;
            border-color: #e5e7eb;
            vertical-align: middle;
            text-align: center;
            background: #fff;
        }

        .production-table tbody tr:nth-child(even) td {
            background: #fbfbfc;
        }

        .production-table tbody tr:hover td {
            background: #fff7fa;
        }

    .sticky-one,
    .sticky-two {
        position: sticky;
        z-index: 4;
    }

    .sticky-one {
        left: 0;
        width: 52px;
        min-width: 52px;
    }

    .sticky-two {
        left: 52px;
        width: 125px;
        min-width: 125px;
    }

    .production-table thead .sticky-one,
    .production-table thead .sticky-two {
        z-index: 7;
        background: var(--solb-maroon-dark);
    }

    .serial-cell {
        color: var(--solb-maroon-dark);
        background: var(--solb-maroon-soft) !important;
        font-weight: 800;
    }

    .production-table .form-control {
        height: 32px;
        min-width: 60px;
        padding: 4px 5px;
        border-radius: 6px;
        text-align: center;
        font-size: 12px;
    }

    .production-table .grade-input {
        min-width: 115px;
        text-align: left;
        font-weight: 700;
    }

    .production-table .remarks-input {
        min-width: 220px;
        text-align: left;
    }

    .production-table .row-total {
        background: #f1f3f5 !important;
        color: var(--solb-maroon-dark);
        font-weight: 800;
    }


    .grid-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .grid-toolbar-text {
        color: var(--solb-muted);
        font-size: 11px;
        font-weight: 600;
    }

    .btn-add-row {
        border: 1px solid var(--solb-maroon);
        border-radius: 8px;
        padding: 7px 14px;
        background: var(--solb-maroon);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

        .btn-add-row:hover,
        .btn-add-row:focus {
            background: var(--solb-maroon-dark);
            border-color: var(--solb-maroon-dark);
            color: #fff;
        }

    .btn-remove-row {
        width: 32px;
        height: 32px;
        padding: 0;
        border: 1px solid #efc3cc;
        border-radius: 7px;
        background: #fff4f6;
        color: var(--solb-maroon-dark);
        font-size: 13px;
    }

        .btn-remove-row:hover {
            background: #f8d7da;
            color: #842029;
        }

    .overall-remarks {
        margin-top: 16px;
        padding: 15px;
        border: 1px solid var(--solb-border);
        border-radius: 12px;
        background: #fafbfc;
    }

        .overall-remarks label {
            display: block;
            margin-bottom: 7px;
            color: var(--solb-text);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .overall-remarks textarea {
            min-height: 90px;
            resize: vertical;
            background: #fff;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(170px, 1fr));
        gap: 12px;
        margin-top: 15px;
    }

    .summary-box {
        padding: 13px 15px;
        border: 1px solid var(--solb-border);
        border-radius: 11px;
        background: #fff;
        border-left: 4px solid var(--solb-maroon);
    }

        .summary-box.good {
            border-left-color: #198754;
        }

        .summary-box.nonprime {
            border-left-color: #d28a00;
        }

        .summary-box.rows {
            border-left-color: #64748b;
        }

        .summary-box span {
            display: block;
            color: var(--solb-muted);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

        .summary-box strong {
            display: block;
            margin-top: 3px;
            color: var(--solb-text);
            font-size: 22px;
            font-weight: 800;
        }

    .action-bar {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 16px;
        border-top: 1px solid var(--solb-border);
        background: rgba(255,255,255,.96);
        backdrop-filter: blur(8px);
    }

    .action-note {
        color: var(--solb-muted);
        font-size: 11px;
        font-weight: 600;
    }

    .btn-solb {
        min-width: 135px;
        padding: 9px 20px;
        border-radius: 8px;
        border-color: var(--solb-maroon);
        background: var(--solb-maroon);
        color: #fff;
        font-weight: 700;
    }

        .btn-solb:hover,
        .btn-solb:focus {
            border-color: var(--solb-maroon-dark);
            background: var(--solb-maroon-dark);
            color: #fff;
        }

    .validation-summary-errors {
        padding: 12px 14px;
        margin-bottom: 14px;
        border: 1px solid #f5c2c7;
        border-radius: 9px;
        background: #f8d7da;
        color: #842029;
        font-size: 12px;
    }

    .field-validation-error {
        display: block;
        margin-top: 3px;
        color: #dc3545;
        font-size: 10px;
        font-weight: 700;
    }


    .production-card-list {
        display: grid;
        gap: 14px;
    }

    .production-detail-card {
        overflow: hidden;
        border: 1px solid var(--solb-border);
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
    }

    .production-detail-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 14px;
        border-bottom: 1px solid var(--solb-border);
        background: linear-gradient(180deg,#fff,#fafbfc);
    }

    .production-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--solb-text);
        font-size: 13px;
        font-weight: 800;
    }

    .production-card-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 29px;
        height: 29px;
        border-radius: 50%;
        background: var(--solb-maroon-soft);
        color: var(--solb-maroon-dark);
        font-size: 12px;
        font-weight: 900;
    }

    .production-detail-card-body {
        padding: 15px;
    }

    .production-card-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(130px, 1fr));
        gap: 12px;
    }

        .production-card-grid .span-2 {
            grid-column: span 2;
        }

        .production-card-grid .span-full {
            grid-column: 1 / -1;
        }

    .length-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(90px, 1fr));
        gap: 9px;
        padding: 12px;
        border: 1px solid var(--solb-border);
        border-radius: 10px;
        background: #fafbfc;
    }

    .length-grid-title {
        grid-column: 1 / -1;
        color: var(--solb-maroon-dark);
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .weight-field .form-control {
        font-weight: 800;
        color: var(--solb-maroon-dark);
        background: #fffafb;
    }

    .calculated-field .form-control {
        font-weight: 800;
        color: #374151;
        background: #f1f3f5;
    }

    .card-remove-button {
        width: 32px;
        height: 32px;
        padding: 0;
        border: 1px solid #efc3cc;
        border-radius: 7px;
        background: #fff4f6;
        color: var(--solb-maroon-dark);
    }

    @@media(max-width:1199px) {
        .production-card-grid {
            grid-template-columns: repeat(3, minmax(140px, 1fr));
        }

        .length-grid {
            grid-template-columns: repeat(4, minmax(90px, 1fr));
        }
    }

    @@media(max-width:767px) {
        .production-card-grid,
        .length-grid {
            grid-template-columns: 1fr;
        }

            .production-card-grid .span-2 {
                grid-column: span 1;
            }
    }

    @@media(max-width:1199px) {
        .header-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media(max-width:767px) {
        .grid-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .btn-add-row {
            width: 100%;
        }

        .ccm-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-grid,
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .ccm-card-body {
            padding: 14px;
        }

        .action-bar {
            align-items: stretch;
            flex-direction: column;
        }

            .action-bar .btn {
                width: 100%;
            }
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: #fff !important;
        }

        .ccm-card, .ccm-header {
            box-shadow: none !important;
        }

        .production-scroll {
            overflow: visible !important;
            max-height: none !important;
        }

        .production-table {
            min-width: 0 !important;
            width: 100% !important;
        }

            .production-table th,
            .production-table td {
                position: static !important;
                padding: 3px !important;
                font-size: 8px !important;
            }

            .production-table .form-control {
                min-width: 0 !important;
                height: auto !important;
                padding: 0 !important;
                border: 0 !important;
                font-size: 8px !important;
            }

        @@page {
            size: A4 landscape;
            margin: 7mm;
        }
    }
</style>

<div class="xp-breadcrumbbar no-print">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="xp-page-title">@ViewBag.Title</h4>
        </div>
        <div class="col-md-4 text-right">
            <a href="@Url.Action("List","CCMProduction")"
               class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>

<div class="xp-contentbar">
    <div class="ccm-shell">

        <div class="ccm-header">
            <div>
                <h3>Billet Yard Report</h3>
                <p>SOLB Steel Company · Meltshop / CCM Section</p>
            </div>

            <div class="ccm-doc-chip">
                QMF-SM-969<br />
                Rev. 0
            </div>
        </div>

        @using (Html.BeginForm("Add", "CCMProduction", FormMethod.Post,
            new { id = "ccmProductionForm", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.ID)
            @Html.HiddenFor(x => x.StatusID)

            <div class="ccm-card">
                <div class="ccm-card-title">
                    <div>
                        <h5>Report Information</h5>
                        <small>Basic report details and responsible personnel</small>
                    </div>
                </div>

                <div class="ccm-card-body">


                    <div class="header-grid">
                        <div class="form-group" hidden>
                            <label class="required">Report No.</label>
                            @Html.TextBoxFor(x => x.ReportNo,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "CCM-20260310",
                                     required = "required",
                                     hidden = "hidden",
                                     value = "00000"
                                 })
                            @Html.ValidationMessageFor(x => x.ReportNo)
                        </div>

                        <div class="form-group">
                            <label class="required">Report Date</label>
                            @Html.TextBoxFor(x => x.ReportDate, "{0:yyyy-MM-dd}",
                                                                                                 new
                                                                                                 {
                                                                                                     @class = "form-control",
                                                                                                     type = "date",
                                                                                                     required = "required"
                                                                                                 })
                            @Html.ValidationMessageFor(x => x.ReportDate)
                        </div>

                        <div class="form-group">
                            <label class="required">Shift</label>
                            @Html.DropDownListFor(x => x.Shift,
                                                                                                 (SelectList)ViewBag.Shifts,
                                                                                                 "-- Select Shift --",
                                                                                                 new
                                                                                                 {
                                                                                                     @class = "form-control",
                                                                                                     required = "required"
                                                                                                 })
                            @Html.ValidationMessageFor(x => x.Shift)
                        </div>

                        <div class="form-group">
                            <label>Team</label>
                            @Html.TextBoxFor(x => x.Team,
                                                                                                 new
                                                                                                 {
                                                                                                     @class = "form-control",
                                                                                                     placeholder = "Team"
                                                                                                 })
                        </div>

                        <div class="form-group">
                            <label>CCM Foreman</label>
                            @Html.TextBoxFor(x => x.CCMForeman,
                                                                                                 new
                                                                                                 {
                                                                                                     @class = "form-control",
                                                                                                     placeholder = "Foreman name"
                                                                                                 })
                        </div>

                        <div class="form-group">
                            <label>Billet Yard Operator</label>
                            @Html.TextBoxFor(x => x.BilletYardOperator,
                                                                                                 new
                                                                                                 {
                                                                                                     @class = "form-control",
                                                                                                     placeholder = "Operator name"
                                                                                                 })
                        </div>
                    </div>
                </div>
            </div>

            <div class="ccm-card">
                <div class="ccm-card-title">
                    <div>
                        <h5>Billet Production Details</h5>
                        <small>Add or remove grade-wise production rows as required</small>
                    </div>
                </div>

                <div class="ccm-card-body">

                    <div class="grid-toolbar no-print">
                        <div class="grid-toolbar-text">
                            Use “Add Row” to enter another billet grade.
                        </div>

                        <button type="button"
                                class="btn-add-row"
                                id="btnAddProductionRow">
                            <i class="fa fa-plus"></i>
                            Add Row
                        </button>
                    </div>

                    <div id="productionRows"
                         class="production-card-list">

                        @for (int i = 0; i < initialRowCount; i++)
                        {
                            <div class="production-detail-card production-row"
                                 data-row-index="@i">

                                <div class="production-detail-card-header">
                                    <div class="production-card-title">
                                        <span class="production-card-number row-sequence">
                                            @(i + 1)
                                        </span>
                                        <span>Billet Production Entry</span>
                                    </div>

                                    <button type="button"
                                            class="card-remove-button btn-remove-row no-print"
                                            title="Remove entry">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>

                                <div class="production-detail-card-body">

                                    @Html.HiddenFor(x => x.Details[i].ID, new { @class = "detail-id" })
                                    @Html.HiddenFor(x => x.Details[i].ReportID, new { @class = "detail-report-id" })
                                    @Html.HiddenFor(x => x.Details[i].SequenceNo, new { @class = "detail-sequence" })
                                    @Html.HiddenFor(x => x.Details[i].Remarks, new { @class = "detail-remarks" })

                                    <div class="production-card-grid">

                                        <div class="form-group">
                                            <label>Heat No.</label>

                                            @Html.TextBoxFor(
                                                                                                                                     x => x.Details[i].HeatNo,
                                                                                                                                     new
                                                                                                                                     {
                                                                                                                                         @class = "form-control heat-no-input",
                                                                                                                                         placeholder = "Enter heat no.",
                                                                                                                                         autocomplete = "off"
                                                                                                                                     }
                                                                                                                                 )
                                        </div>

                                        <div class="form-group">
                                            <label>Grade</label>
                                            @Html.TextBoxFor(
                                                                                                                                          x => x.Details[i].Grade,
                                                                                                                                          new
                                                                                                                                          {
                                                                                                                                              @class = "form-control grade-input",
                                                                                                                                              placeholder = "Enter billet grade"
                                                                                                                                          }
                                                                                                                                      )
                                        </div>

                                        <div class="form-group calculated-field">
                                            <label>Total Billets</label>
                                            <input type="number"
                                                   name="Details[@i].TotalBillets"
                                                   id="Details_@(i)__TotalBillets"
                                                   class="form-control row-total"
                                                   value="@Model.Details[i].TotalBillets"
                                                   readonly />
                                        </div>

                                        <div class="form-group">
                                            <label>Good / Prime Billets</label>
                                            @Html.TextBoxFor(
                                                                                                                                          x => x.Details[i].GoodBillets,
                                                                                                                                          new
                                                                                                                                          {
                                                                                                                                              @class = "form-control good-billet-input",
                                                                                                                                              type = "number",
                                                                                                                                              min = "0",
                                                                                                                                              @readonly = "readonly"
                                                                                                                                          }
                                                                                                                                      )
                                        </div>

                                        <div class="form-group">
                                            <label>Bend</label>
                                            @Html.TextBoxFor(
                                                                                                                                          x => x.Details[i].Bend,
                                                                                                                                          new
                                                                                                                                          {
                                                                                                                                              @class = "form-control billet-input",
                                                                                                                                              type = "number",
                                                                                                                                              min = "0"
                                                                                                                                          }
                                                                                                                                      )
                                        </div>

                                        <div class="form-group weight-field">
                                            <label>Per Unit Weight</label>
                                            @Html.TextBoxFor(
                                                                                                                                         x => x.Details[i].PerCoilBundleWeight,
                                                                                                                                         new
                                                                                                                                         {
                                                                                                                                             @class = "form-control coil-bundle-weight-input",
                                                                                                                                             type = "number",
                                                                                                                                             min = "0",
                                                                                                                                             step = "0.000001",
                                                                                                                                             placeholder = "0.00000"
                                                                                                                                         }
                                                                                                                                     )
                                        </div>

                                        <div class="form-group weight-field">
                                            <label>Prime Billet Weight</label>
                                            @Html.TextBoxFor(
                                                                                                                                         x => x.Details[i].PrimeBilletWeight,
                                                                                                                                         new
                                                                                                                                         {
                                                                                                                                             @class = "form-control prime-weight-input",
                                                                                                                                             type = "number",
                                                                                                                                             min = "0",
                                                                                                                                             step = "0.00001",
                                                                                                                                             placeholder = "0.00000",
                                                                                                                                             @readonly = "readonly"
                                                                                                                                         }
                                                                                                                                     )
                                        </div>

                                        <div class="form-group weight-field">
                                            <label>Short Billet Weight</label>
                                            @Html.TextBoxFor(
                                                                                                                                         x => x.Details[i].ShortBilletWeight,
                                                                                                                                         new
                                                                                                                                         {
                                                                                                                                             @class = "form-control short-weight-input",
                                                                                                                                             type = "number",
                                                                                                                                             min = "0",
                                                                                                                                             step = "0.00001",
                                                                                                                                             placeholder = "0.00000",
                                                                                                                                             @readonly = "readonly"
                                                                                                                                         }
                                                                                                                                     )
                                        </div>

                                        <div class="form-group calculated-field">
                                            <label>Total Weight</label>
                                            @Html.TextBoxFor(
                                                                                                                                         x => x.Details[i].TotalWeight,
                                                                                                                                         new
                                                                                                                                         {
                                                                                                                                             @class = "form-control total-weight-input",
                                                                                                                                             type = "number",
                                                                                                                                             step = "0.00001",
                                                                                                                                             @readonly = "readonly"
                                                                                                                                         }
                                                                                                                                     )
                                        </div>

                                        <div class="length-grid span-full">
                                            <div class="length-grid-title">
                                                No. of Billets for 150 × 150
                                            </div>

                                            <div class="form-group"><label>14m</label>@Html.TextBoxFor(x => x.Details[i].Billet14M, new { @class = "form-control billet-input", type = "number", min = "0" })</div>
                                            <div class="form-group"><label>13m</label>@Html.TextBoxFor(x => x.Details[i].Billet13M, new { @class = "form-control billet-input", type = "number", min = "0" })</div>
                                            <div class="form-group"><label>12m</label>@Html.TextBoxFor(x => x.Details[i].Billet12M, new { @class = "form-control billet-input", type = "number", min = "0" })</div>
                                            <div class="form-group"><label>11m</label>@Html.TextBoxFor(x => x.Details[i].Billet11M, new { @class = "form-control billet-input", type = "number", min = "0" })</div>
                                            <div class="form-group calculated-field">
                                                <label>Total Length (m)</label>
                                                <input type="number"
                                                       name="Details[@i].TotalLength"
                                                       id="Details_@(i)__TotalLength"
                                                       class="form-control prime-total-length-input"
                                                       value="@((Model.Details[i].TotalLength ?? 0M).ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture))"
                                                       min="0"
                                                       step="0.00001"
                                                       readonly />
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label>Short Billet Quantity</label>
                                            @Html.TextBoxFor(
                                                               x => x.Details[i].ShortBillets,
                                                               new
                                                               {
                                                                   @class = "form-control short-billet-quantity-input",
                                                                   type = "number",
                                                                   min = "0",
                                                                   step = "1"
                                                               }
                                                           )
                                        </div>

                                        <div class="form-group">
                                            <label>Short Billet Total Length (m)</label>
                                            <input type="number"
                                                   name="Details[@i].ShortBilletTotalLength"
                                                   id="Details_@(i)__ShortBilletTotalLength"
                                                   class="form-control short-total-length-input"
                                                   value="@((Model.Details[i].ShortBilletTotalLength ?? 0M).ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture))"
                                                   min="0"
                                                   step="0.00001" />
                                        </div>

                                        <div class="form-group calculated-field">
                                            <label>Short Billet Avg. Length (m)</label>
                                            <input type="number"
                                                   name="Details[@i].ShortBilletAvgLength"
                                                   id="Details_@(i)__ShortBilletAvgLength"
                                                   class="form-control short-average-length-input"
                                                   value="@((Model.Details[i].ShortBilletAvgLength ?? 0M).ToString("0.00000", System.Globalization.CultureInfo.InvariantCulture))"
                                                   min="0"
                                                   step="0.00001"
                                                   readonly />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }

                    </div>

                    <div class="overall-remarks">
                        <label for="overallRemarks">
                            Overall Remarks
                        </label>

                        <textarea id="overallRemarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter overall production remarks...">@(initialRowCount > 0 ? Model.Details[0].Remarks : "")</textarea>
                    </div>

                    <div class="summary-grid">
                        <div class="summary-box">
                            <span>Total Billets</span>
                            <strong id="grandTotalBillets">0</strong>
                        </div>

                        <div class="summary-box good">
                            <span>Good / Prime Billets</span>
                            <strong id="grandGoodBillets">0</strong>
                        </div>

                        <div class="summary-box nonprime">
                            <span>Short Billets</span>
                            <strong id="grandNonPrimeBillets">0</strong>
                        </div>

                        <div class="summary-box rows">
                            <span>Active Rows</span>
                            <strong id="activeRows">0</strong>
                        </div>
                    </div>
                </div>

                <div class="action-bar no-print">
                    <div class="action-note">
                        Row and report totals are calculated automatically.
                    </div>

                    <div>
                        <a href="@Url.Action("List","CCMProduction")"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-solb">
                            <i class="fa fa-save"></i>
                            @(Model != null && Model.ID > 0 ? "Update Report" : "Save Report")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<script>
    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var productionRows =
                document.getElementById(
                    "productionRows"
                );

            var addRowButton =
                document.getElementById(
                    "btnAddProductionRow"
                );

            var overallRemarks =
                document.getElementById(
                    "overallRemarks"
                );

            if (!productionRows) {
                return;
            }

            function toNumber(value) {
                var parsed =
                    parseFloat(value);

                return isNaN(parsed)
                    ? 0
                    : parsed;
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getInputByProperty(
                row,
                propertyName) {

                return row.querySelector(
                    '[name$=".' +
                    propertyName +
                    '"]'
                );
            }

            function getValue(
                row,
                propertyName) {

                var input =
                    getInputByProperty(
                        row,
                        propertyName
                    );

                if (!input) {
                    return 0;
                }

                var value =
                    Math.max(
                        0,
                        toNumber(input.value)
                    );

                if (toNumber(input.value) < 0) {
                    input.value = 0;
                }

                return value;
            }

            function setValue(
                row,
                selector,
                value,
                decimalPlaces) {

                var input =
                    row.querySelector(selector);

                if (!input) {
                    return;
                }

                input.value =
                    Number(value)
                        .toFixed(decimalPlaces);
            }

            function numberInput(
                index,
                propertyName,
                className,
                options) {

                options = options || {};

                var step =
                    options.step || "1";

                var value =
                    options.value !== undefined
                        ? options.value
                        : "0";

                var readOnly =
                    options.readOnly
                        ? " readonly"
                        : "";

                return (
                    '<input type="number"' +
                    ' name="Details[' + index + '].' +
                    propertyName + '"' +
                    ' id="Details_' + index + '__' +
                    propertyName + '"' +
                    ' class="form-control ' +
                    className + '"' +
                    ' value="' + value + '"' +
                    ' min="0"' +
                    ' step="' + step + '"' +
                    readOnly +
                    ' />'
                );
            }

            function textInput(
                index,
                propertyName,
                className,
                placeholder) {

                return (
                    '<input type="text"' +
                    ' name="Details[' + index + '].' +
                    propertyName + '"' +
                    ' id="Details_' + index + '__' +
                    propertyName + '"' +
                    ' class="form-control ' +
                    className + '"' +
                    ' value=""' +
                    ' placeholder="' +
                    escapeHtml(placeholder) + '"' +
                    ' autocomplete="off" />'
                );
            }

            function hiddenInput(
                index,
                propertyName,
                className,
                value) {

                return (
                    '<input type="hidden"' +
                    ' name="Details[' + index + '].' +
                    propertyName + '"' +
                    ' id="Details_' + index + '__' +
                    propertyName + '"' +
                    ' class="' + className + '"' +
                    ' value="' + escapeHtml(value) + '" />'
                );
            }

            function createProductionRow(index) {

                var card =
                    document.createElement("div");

                card.className =
                    "production-detail-card production-row";

                card.setAttribute(
                    "data-row-index",
                    index
                );

                card.innerHTML =
                    '<div class="production-detail-card-header">' +
                    '<div class="production-card-title">' +
                    '<span class="production-card-number row-sequence">' +
                    (index + 1) +
                    '</span>' +
                    '<span>Billet Production Entry</span>' +
                    '</div>' +
                    '<button type="button"' +
                    ' class="card-remove-button btn-remove-row no-print"' +
                    ' title="Remove entry">' +
                    '<i class="fa fa-trash"></i>' +
                    '</button>' +
                    '</div>' +

                    '<div class="production-detail-card-body">' +

                    hiddenInput(
                        index,
                        "ID",
                        "detail-id",
                        "0"
                    ) +

                    hiddenInput(
                        index,
                        "ReportID",
                        "detail-report-id",
                        "0"
                    ) +

                    hiddenInput(
                        index,
                        "SequenceNo",
                        "detail-sequence",
                        index + 1
                    ) +

                    hiddenInput(
                        index,
                        "Remarks",
                        "detail-remarks",
                        overallRemarks
                            ? overallRemarks.value
                            : ""
                    ) +

                    '<div class="production-card-grid">' +

                    '<div class="form-group">' +
                    '<label>Heat No.</label>' +
                    textInput(
                        index,
                        "HeatNo",
                        "heat-no-input",
                        "Enter heat no."
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>Grade</label>' +
                    textInput(
                        index,
                        "Grade",
                        "grade-input",
                        "Enter billet grade"
                    ) +
                    '</div>' +

                    '<div class="form-group calculated-field">' +
                    '<label>Total Billets</label>' +
                    numberInput(
                        index,
                        "TotalBillets",
                        "row-total",
                        {
                            step: "1",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group calculated-field">' +
                    '<label>Good / Prime Billets</label>' +
                    numberInput(
                        index,
                        "GoodBillets",
                        "good-billet-input",
                        {
                            step: "1",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>Bend</label>' +
                    numberInput(
                        index,
                        "Bend",
                        "billet-input",
                        {
                            step: "1"
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group weight-field">' +
                    '<label>Per Unit Weight</label>' +
                    numberInput(
                        index,
                        "PerCoilBundleWeight",
                        "coil-bundle-weight-input",
                        {
                            step: "0.000001"
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group weight-field">' +
                    '<label>Prime Billet Weight</label>' +
                    numberInput(
                        index,
                        "PrimeBilletWeight",
                        "prime-weight-input",
                        {
                            step: "0.00001",
                            value: "0.00000",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group weight-field">' +
                    '<label>Short Billet Weight</label>' +
                    numberInput(
                        index,
                        "ShortBilletWeight",
                        "short-weight-input",
                        {
                            step: "0.00001",
                            value: "0.00000",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group calculated-field">' +
                    '<label>Total Weight</label>' +
                    numberInput(
                        index,
                        "TotalWeight",
                        "total-weight-input",
                        {
                            step: "0.00001",
                            value: "0.00000",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '<div class="length-grid span-full">' +
                    '<div class="length-grid-title">' +
                    'No. of Billets for 150 × 150' +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>14m</label>' +
                    numberInput(
                        index,
                        "Billet14M",
                        "billet-input",
                        { step: "1" }
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>13m</label>' +
                    numberInput(
                        index,
                        "Billet13M",
                        "billet-input",
                        { step: "1" }
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>12m</label>' +
                    numberInput(
                        index,
                        "Billet12M",
                        "billet-input",
                        { step: "1" }
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>11m</label>' +
                    numberInput(
                        index,
                        "Billet11M",
                        "billet-input",
                        { step: "1" }
                    ) +
                    '</div>' +

                    '<div class="form-group calculated-field">' +
                    '<label>Total Length (m)</label>' +
                    numberInput(
                        index,
                        "TotalLength",
                        "prime-total-length-input",
                        {
                            step: "0.00001",
                            value: "0.00000",
                            readOnly: true
                        }
                    ) +
                    '</div>' +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>Short Billet Quantity</label>' +
                    numberInput(
                        index,
                        "ShortBillets",
                        "short-billet-quantity-input",
                        { step: "1" }
                    ) +
                    '</div>' +

                    '<div class="form-group">' +
                    '<label>Short Billet Total Length (m)</label>' +
                    numberInput(
                        index,
                        "ShortBilletTotalLength",
                        "short-total-length-input",
                        {
                            step: "0.00001",
                            value: "0.00000"
                        }
                    ) +
                    '</div>' +

                    '<div class="form-group calculated-field">' +
                    '<label>Short Billet Avg. Length (m)</label>' +
                    numberInput(
                        index,
                        "ShortBilletAvgLength",
                        "short-average-length-input",
                        {
                            step: "0.00001",
                            value: "0.00000",
                            readOnly: true
                        }
                    ) +
                    '</div>' +

                    '</div>' +
                    '</div>';

                return card;
            }

            function calculateRow(row) {

                var billet14 =
                    getValue(row, "Billet14M");

                var billet13 =
                    getValue(row, "Billet13M");

                var billet12 =
                    getValue(row, "Billet12M");

                var billet11 =
                    getValue(row, "Billet11M");

                var shortQuantity =
                    getValue(row, "ShortBillets");

                var shortTotalLength =
                    getValue(
                        row,
                        "ShortBilletTotalLength"
                    );

                var perUnitWeight =
                    getValue(
                        row,
                        "PerCoilBundleWeight"
                    );

                var primeQuantity =
                    billet14 +
                    billet13 +
                    billet12 +
                    billet11;

                var totalLength =
                    (14 * billet14) +
                    (13 * billet13) +
                    (12 * billet12) +
                    (11 * billet11);

                var shortAverageLength =
                    shortQuantity > 0
                        ? shortTotalLength /
                        shortQuantity
                        : 0;

                var primeBilletWeight =
                    totalLength *
                    perUnitWeight;

                var shortBilletWeight =
                    shortTotalLength *
                    perUnitWeight;

                var totalWeight =
                    primeBilletWeight +
                    shortBilletWeight;

                var totalBillets =
                    primeQuantity +
                    shortQuantity;

                var goodInput =
                    row.querySelector(
                        ".good-billet-input"
                    );

                var totalBilletsInput =
                    row.querySelector(
                        ".row-total"
                    );

                if (goodInput) {
                    goodInput.value =
                        Math.round(
                            primeQuantity
                        );
                }

                if (totalBilletsInput) {
                    totalBilletsInput.value =
                        Math.round(
                            totalBillets
                        );
                }

                setValue(
                    row,
                    ".prime-total-length-input",
                    totalLength,
                    5
                );

                setValue(
                    row,
                    ".short-average-length-input",
                    shortAverageLength,
                    5
                );

                setValue(
                    row,
                    ".prime-weight-input",
                    primeBilletWeight,
                    5
                );

                setValue(
                    row,
                    ".short-weight-input",
                    shortBilletWeight,
                    5
                );

                setValue(
                    row,
                    ".total-weight-input",
                    totalWeight,
                    5
                );

                return {
                    totalBillets:
                        totalBillets,

                    primeBillets:
                        primeQuantity,

                    shortBillets:
                        shortQuantity
                };
            }

            function syncRemarks() {
                var value =
                    overallRemarks
                        ? overallRemarks.value
                        : "";

                productionRows
                    .querySelectorAll(
                        ".detail-remarks"
                    )
                    .forEach(
                        function (input) {
                            input.value = value;
                        }
                    );
            }

            function updateRemoveButtons() {
                var rows =
                    productionRows
                        .querySelectorAll(
                            ".production-row"
                        );

                rows.forEach(
                    function (row) {
                        var button =
                            row.querySelector(
                                ".btn-remove-row"
                            );

                        if (button) {
                            button.style.display =
                                rows.length === 1
                                    ? "none"
                                    : "";
                        }
                    }
                );
            }

            function reIndexRows() {
                var rows =
                    productionRows
                        .querySelectorAll(
                            ".production-row"
                        );

                rows.forEach(
                    function (row, index) {

                        row.setAttribute(
                            "data-row-index",
                            index
                        );

                        var number =
                            row.querySelector(
                                ".row-sequence"
                            );

                        if (number) {
                            number.textContent =
                                index + 1;
                        }

                        row.querySelectorAll(
                            "input, select, textarea"
                        ).forEach(
                            function (input) {

                                var name =
                                    input.getAttribute(
                                        "name"
                                    );

                                if (name) {
                                    input.setAttribute(
                                        "name",
                                        name.replace(
                                            /Details\[\d+\]/,
                                            "Details[" +
                                            index +
                                            "]"
                                        )
                                    );
                                }

                                var id =
                                    input.getAttribute(
                                        "id"
                                    );

                                if (id) {
                                    input.setAttribute(
                                        "id",
                                        id.replace(
                                            /Details_\d+__/,
                                            "Details_" +
                                            index +
                                            "__"
                                        )
                                    );
                                }
                            }
                        );

                        var sequenceInput =
                            row.querySelector(
                                ".detail-sequence"
                            );

                        if (sequenceInput) {
                            sequenceInput.value =
                                index + 1;
                        }
                    }
                );

                updateRemoveButtons();
            }

            function calculateSummary() {

                var totalBillets = 0;
                var primeBillets = 0;
                var shortBillets = 0;
                var activeRows = 0;

                productionRows
                    .querySelectorAll(
                        ".production-row"
                    )
                    .forEach(
                        function (row) {

                            var result =
                                calculateRow(row);

                            totalBillets +=
                                result.totalBillets;

                            primeBillets +=
                                result.primeBillets;

                            shortBillets +=
                                result.shortBillets;

                            var heatInput =
                                row.querySelector(
                                    ".heat-no-input"
                                );

                            var gradeInput =
                                row.querySelector(
                                    ".grade-input"
                                );

                            var hasHeader =
                                (
                                    heatInput &&
                                    heatInput.value.trim() !== ""
                                ) ||
                                (
                                    gradeInput &&
                                    gradeInput.value.trim() !== ""
                                );

                            if (
                                result.totalBillets > 0 ||
                                hasHeader
                            ) {
                                activeRows++;
                            }
                        }
                    );

                var grandTotal =
                    document.getElementById(
                        "grandTotalBillets"
                    );

                var grandPrime =
                    document.getElementById(
                        "grandGoodBillets"
                    );

                var grandShort =
                    document.getElementById(
                        "grandNonPrimeBillets"
                    );

                var activeRowsElement =
                    document.getElementById(
                        "activeRows"
                    );

                if (grandTotal) {
                    grandTotal.innerText =
                        Math.round(totalBillets);
                }

                if (grandPrime) {
                    grandPrime.innerText =
                        Math.round(primeBillets);
                }

                if (grandShort) {
                    grandShort.innerText =
                        Math.round(shortBillets);
                }

                if (activeRowsElement) {
                    activeRowsElement.innerText =
                        activeRows;
                }
            }

            if (addRowButton) {
                addRowButton.addEventListener(
                    "click",
                    function () {

                        var index =
                            productionRows
                                .querySelectorAll(
                                    ".production-row"
                                )
                                .length;

                        var newRow =
                            createProductionRow(
                                index
                            );

                        productionRows.appendChild(
                            newRow
                        );

                        reIndexRows();
                        syncRemarks();
                        calculateSummary();

                        var heatInput =
                            newRow.querySelector(
                                ".heat-no-input"
                            );

                        if (heatInput) {
                            heatInput.focus();
                        }
                    }
                );
            }

            productionRows.addEventListener(
                "click",
                function (event) {

                    var removeButton =
                        event.target.closest(
                            ".btn-remove-row"
                        );

                    if (!removeButton) {
                        return;
                    }

                    var rows =
                        productionRows
                            .querySelectorAll(
                                ".production-row"
                            );

                    if (rows.length <= 1) {
                        return;
                    }

                    var row =
                        removeButton.closest(
                            ".production-row"
                        );

                    if (row) {
                        row.remove();
                        reIndexRows();
                        calculateSummary();
                    }
                }
            );

            productionRows.addEventListener(
                "input",
                calculateSummary
            );

            productionRows.addEventListener(
                "change",
                calculateSummary
            );

            if (overallRemarks) {
                overallRemarks.addEventListener(
                    "input",
                    syncRemarks
                );
            }

            var form =
                document.getElementById(
                    "ccmProductionForm"
                );

            if (form) {
                form.addEventListener(
                    "submit",
                    function () {
                        reIndexRows();
                        syncRemarks();
                        calculateSummary();
                    }
                );
            }

            reIndexRows();
            syncRemarks();
            calculateSummary();
        }
    );
</script>

