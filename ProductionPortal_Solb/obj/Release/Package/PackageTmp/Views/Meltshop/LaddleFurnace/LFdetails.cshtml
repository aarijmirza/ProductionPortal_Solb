@* Declare the model as a single object *@
@model DAL.Models.LaddleFurnaceBLL
@using System.Globalization
@{
    ViewBag.Title = "Heat Details - " + Model.HeatNo;
    Layout = "~/Views/Shared/_Layout.cshtml"; // Assuming standard layout

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
}

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Laddle Furnace Heat Detail</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("LFlist", "Meltshop")">Laddle Furnace</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Heat Information</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h4>🔥 Primary Data</h4>
                            <hr />
                            <p><strong>Date:</strong> @(Model.Date?.ToString("dd-MM-yyyy", gregorian))</p>
                            <p><strong>Heat No:</strong> @Model.HeatNo</p>
                            <p><strong>LM For Casting (Ton):</strong> @Model.LMForCasting</p>
                        </div>
                        <div class="col-md-6">
                            <h4>⚡ Energy & Gas Consumption</h4>
                            <hr />
                            <p><strong>KWH (per Ton):</strong> @Model.KWH</p>
                            <p><strong>Electrode (kg/T):</strong> @Model.Electrode</p>
                            <p><strong>Nitrogen (Nm³):</strong> @Model.Nitrogen</p>
                            <p><strong>Argon (Nm³):</strong> @Model.Argon</p>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <h4>🧪 Alloying & Fluxes</h4>
                            <hr />
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>FeSi</th>
                                        <th>FeMn</th>
                                        <th>SiMn</th>
                                        <th>Total Alloys</th>
                                        <th>Lime 3-12mm</th>
                                        <th>Dololime</th>
                                        <th>MgO</th>
                                        <th>Flour Spar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Model.FeSi</td>
                                        <td>@Model.FeMn</td>
                                        <td>@Model.SiMn</td>
                                        <td>@Model.TotalAlloys</td>
                                        <td>@Model.Lime312mm</td>
                                        <td>@Model.Dololime</td>
                                        <td>@Model.MgO</td>
                                        <td>@Model.FlourSpar</td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-4">Injection / Carburizing</h4>
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Recarburizer Silo</th>
                                        <th>Recarburizer Bags</th>
                                        <th>Rice Husk</th>
                                        <th>CaSi</th>
                                        <th>CaFe Wire</th>
                                        <th>CaC2</th>
                                        <th>Syn Slag</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@Model.RecarburizerSilo</td>
                                        <td>@Model.RecarburizerBags</td>
                                        <td>@Model.RiceHusk</td>
                                        <td>@Model.CaSi</td>
                                        <td>@Model.CafeWire</td>
                                        <td>@Model.Cac2</td>
                                        <td>@Model.SynSlag</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="@Url.Action("LFlist", "Meltshop")" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                        @* Optional: Add Edit Link *@
                        @* <a href="@Url.Action("LFedit", "Meltshop", new { id = Model.LFRecordID })" class="btn btn-warning ml-2">Edit Record</a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>