@using System.Globalization
@{
    ViewBag.Title = "list";
    var delay = Model as List<DAL.Models.PlantDelayBLL>;
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delays</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form method="get"
                          action="@Url.Action("SMPlist", "Delay")"
                          id="filterForm"
                          class="d-flex justify-content-between">

                        <div class="d-flex">

                            <div class="form-group mr-3">

                                <label for="fromDate"
                                       class="mr-2">
                                    From
                                </label>

                                <input type="date"
                                       id="fromDate"
                                       name="fromDate"
                                       class="form-control"
                                       value="@ViewBag.FromDate" />

                            </div>

                            <div class="form-group mr-3">

                                <label for="toDate"
                                       class="mr-2">
                                    To
                                </label>

                                <input type="date"
                                       id="toDate"
                                       name="toDate"
                                       class="form-control"
                                       value="@ViewBag.ToDate" />

                            </div>

                            <div class="form-group d-flex align-items-end mr-3">

                                <button type="submit"
                                        class="btn btn-primary mr-2">
                                    Filter
                                </button>

                                <a href="@Url.Action("SMPlist", "Delay")"
                                   class="btn btn-secondary">
                                    Clear
                                </a>

                            </div>

                        </div>

                        <div class="d-flex justify-content-end">

                            <div class="form-group d-flex align-items-end mr-3">

                                <a class="btn btn-info text-white"
                                   href="@Url.Action("SMPadd", "Delay")">

                                    <i class="fa fa-plus-circle"></i>
                                    Add Delay

                                </a>

                            </div>

                            <div class="form-group d-flex align-items-end">

                                <button type="button"
                                        id="exportPdf"
                                        class="btn btn-danger mr-2">

                                    <i class="fa fa-file-pdf-o"></i>
                                    Export PDF

                                </button>

                            </div>

                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="delayListTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Reason</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in delay)
                                {
                                    var gregorian = new CultureInfo("en-US");
                                    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
                                    <tr>
                                        <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                        <td>@item.Area</td>
                                        <td>@item.StartTime</td>
                                        <td>@item.EndTime</td>
                                        <td>@item.AgencyName</td>
                                        <td>@item.Equipments</td>
                                        <td>@item.Reason</td>
                                        <td>
                                            @*<a href="javascript:void(0);"
                                                   onclick="openDelayPopup('@item.ID', '@(item.Date?.ToString(" yyyy-MM-dd"))', '@item.Area' )"
                                                   class="btn btn-sm btn-success">
                                                    <i class="mdi mdi-plus"></i>
                                                </a>*@

                                            <a href="@Url.Action("SMPdetails", "Delay", new { ID = item.ID })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                <i class="mdi mdi-book-open-page-variant"></i>
                                            </a>
                                            <a href="javascript:void(0);"
                                               onclick="confirmDelete('@item.ID')"
                                               class="btn btn-sm btn-danger">
                                                <i class="mdi mdi-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        /*
         * Controller/ViewBag se jo date already aayi hai
         * usko preserve karenge.
         */

        var from =
            $('#fromDate').val();

        var to =
            $('#toDate').val();


        /*
         * First load par agar controller ne
         * dates nahi di hain, tab today set karo.
         */
        if (!from && !to) {

            var today =
                new Date();

            var year =
                today.getFullYear();

            var month =
                String(
                    today.getMonth() + 1
                ).padStart(
                    2,
                    '0'
                );

            var day =
                String(
                    today.getDate()
                ).padStart(
                    2,
                    '0'
                );

            var todayText =
                year +
                '-' +
                month +
                '-' +
                day;

            $('#fromDate').val(
                todayText
            );

            $('#toDate').val(
                todayText
            );
        }


        /*
         * Filter button form submit karega.
         * Controller DB se filtered data reload karega.
         */
        $('#filterForm').on(
            'submit',
            function () {

                var fromDate =
                    $('#fromDate').val();

                var toDate =
                    $('#toDate').val();

                if (
                    fromDate &&
                    toDate &&
                    fromDate > toDate
                ) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Date Range',
                        text:
                            'From Date cannot be greater than To Date.',
                        confirmButtonColor:
                            '#3085d6'
                    });

                    return false;
                }

                return true;
            }
        );


        /*
         * Export PDF
         */
        $('#exportPdf').on(
            'click',
            function () {

                var from =
                    $('#fromDate').val() ||
                    '';

                var to =
                    $('#toDate').val() ||
                    '';

                var url =
                    '@Url.Action("SMPDelayReport", "Meltshop")'
                    +
                    '?startdate='
                    +
                    encodeURIComponent(
                        from
                    )
                    +
                    '&enddate='
                    +
                    encodeURIComponent(
                        to
                    );

                window.open(
                    url,
                    '_blank'
                );
            }
        );

    });
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        var msg = '@TempData["SuccessMessage"]';
        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }
    });

    function confirmDelete(ID) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/delay/smpdelaydelete?ID=' + ID;
            }
        });
    }
</script>

<script>
    function openDelayPopup(id, date, area) {
        $("#popupDelayID").val(id);
        $("#popupDate").val(date);
        $("#popupArea").val(area);
        $("#popupDuration").val('');

        $("#delayPopupModal").modal("show");
    }

    $(document).on("change keyup", "input[name='StartTime'], input[name='EndTime']", function () {
        var start = $("input[name='StartTime']").val();
        var end = $("input[name='EndTime']").val();

        if (start && end) {
            var startDate = new Date("2000-01-01T" + start);
            var endDate = new Date("2000-01-01T" + end);

            if (endDate < startDate) {
                endDate.setDate(endDate.getDate() + 1);
            }

            var diffMs = endDate - startDate;
            var diffMins = Math.floor(diffMs / 60000);

            var hours = Math.floor(diffMins / 60);
            var minutes = diffMins % 60;

            $("#popupDuration").val(hours + "h " + minutes + "m");
        }
    });
</script>

<!-- Add Extra Delay Detail Modal -->
<div class="modal fade" id="delayPopupModal" tabindex="-1" role="dialog" aria-labelledby="delayPopupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <form action="/Delay/AddDelayPopupDetail" method="post" id="delayPopupForm">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="delayPopupModalLabel">Failure Analysis Detail</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="popupDelayID" name="DelayID" />

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Last P.M Date</label>
                            <input type="date" id="popupDate" name="LastPMDate" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Report Status</label>
                            <select class="form-control" name="FailureReportStatus">
                                <option selected disabled>-- please select --</option>
                                <option value="Done">Done</option>
                                <option value="Not Done">Not Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>
                                Long term Action To increase MTBF
                            </label>
                            <textarea class="form-control" rows="3" name="IncreaseMTBF"></textarea>
                        </div>

                        <div class="form-group col-md-6">
                            <label>
                                Long term Action To decrease MTTR
                            </label>
                            <textarea class="form-control" rows="3" name="DecreaseMTTR"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>SAP Breakdown Order</label>
                            <input type="text" id="popupDate" name="SAPBreakdownOrder" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Category1 (Component)</label>
                            <input type="text" id="popupDate" name="FailureCategory1Component" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Category2 (Root Cause)</label>
                            <input type="text" id="popupDate" name="FailureCategory2RootCause" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        Close
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>