@using System.Globalization
@{
    ViewBag.Title = "list";
    var delay = Model as List<DAL.Models.PlantDelayBLL>;
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delays</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="fromDate" class="mr-2">From</label>
                                <input type="date" id="fromDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="toDate" class="mr-2">To</label>
                                <input type="date" id="toDate" class="form-control" />
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("SMPadd", "Delay")">
                                    <i class="fa fa-plus-circle"></i> Add Delay
                                </a>
                            </div>
                            <div class="form-group d-flex align-items-end">
                                @*<button type="button" id="exportExcel" class="btn btn-success mr-2">
                                        <i class="fa fa-file-excel-o"></i> Export Excel
                                    </button>*@
                                <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                    <i class="fa fa-file-pdf-o"></i> Export PDF
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="delayListTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Reason</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in delay)
                                {
                                    var gregorian = new CultureInfo("en-US");
                                    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
                                    <tr>
                                        <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                        <td>@item.Area</td>
                                        <td>@item.StartTime</td>
                                        <td>@item.EndTime</td>
                                        <td>@item.AgencyName</td>
                                        <td>@item.Equipments</td>
                                        <td>@item.Reason</td>
                                        <td>
                                            <a href="@Url.Action("details", "CCM", new { ID = item.ID })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                <i class="mdi mdi-book-open-page-variant"></i>
                                            </a>
                                            <a href="javascript:void(0);"
                                               onclick="confirmDelete('@item.ID')"
                                               class="btn btn-sm btn-danger">
                                                <i class="mdi mdi-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        function parseDateFlexible(dateStr) {
            // supports: dd-MM-yyyy OR dd/MM/yyyy
            if (!dateStr) return null;

            dateStr = dateStr.trim();
            var sep = dateStr.includes('-') ? '-' : (dateStr.includes('/') ? '/' : null);
            if (!sep) return null;

            var parts = dateStr.split(sep);
            if (parts.length !== 3) return null;

            var dd = parseInt(parts[0], 10);
            var mm = parseInt(parts[1], 10);
            var yy = parseInt(parts[2], 10);

            if (!yy || !mm || !dd) return null;

            return new Date(yy, mm - 1, dd); // midnight
        }

        function filterTable() {

            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            if (!from || !to) {
                $('#delayListTable tbody tr').show();
                return;
            }

            // 🔧 normalize input dates (LOCAL midnight)
            var fromParts = from.split('-'); // yyyy-MM-dd
            var toParts = to.split('-');

            var fromDate = new Date(fromParts[0], fromParts[1] - 1, fromParts[2], 0, 0, 0);
            var toDate = new Date(toParts[0], toParts[1] - 1, toParts[2], 23, 59, 59);

            $('#delayListTable tbody tr').each(function () {

                var rowDateText = $(this).find('td:first').text().trim(); // dd-MM-yyyy
                var rowDate = parseDateFlexible(rowDateText);

                if (!rowDate) {
                    $(this).hide();
                    return;
                }

                // 🔧 normalize row date
                rowDate.setHours(0, 0, 0, 0);

                var show = rowDate >= fromDate && rowDate <= toDate;
                $(this).toggle(show);
            });
        }


        // ✅ Default today & AUTO FILTER
        var today = new Date().toISOString().split('T')[0];
        $('#fromDate').val(today);
        $('#toDate').val(today);

        filterTable(); // ✅ THIS LINE is the main fix

        // Buttons
        $('#filterBtn').on('click', filterTable);

        $('#clearBtn').on('click', function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            $('#delayListTable tbody tr').show();
        });

        $('#exportPdf').click(function () {

        var from = $('#fromDate').val();
        var to = $('#toDate').val();

        var url = '@Url.Action("SMPDelayReport", "Meltshop")'
        + '?startdate=' + encodeURIComponent(from)
        + '&enddate=' + encodeURIComponent(to);

            window.open(url, '_blank');
        });

    });
</script>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        var msg = '@TempData["SuccessMessage"]';
        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }
    });

    function confirmDelete(ID) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/delay/delete?ID=' + ID;
            }
        });
    }
</script>