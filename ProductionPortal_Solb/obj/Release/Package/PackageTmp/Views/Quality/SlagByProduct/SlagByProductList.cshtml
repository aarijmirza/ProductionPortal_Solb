@using System.Globalization
@{
    ViewBag.Title = "list";
    var slag = Model as List<DAL.Models.SlagByProductAnalysisBLL>;
    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Slag & By-Products</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index" ,"Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Slag & By-Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Records</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="fromDate" class="mr-2">From</label>
                                <input type="date" id="fromDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="toDate" class="mr-2">To</label>
                                <input type="date" id="toDate" class="form-control" />
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("AddSlagByProduct", "Quality")">
                                    <i class="fa fa-plus-circle"></i> Add Slag By Product
                                </a>
                            </div>
                            <div class="form-group d-flex align-items-end">
                                @*<button type="button" id="exportExcel" class="btn btn-success mr-2">
                                        <i class="fa fa-file-excel-o"></i> Export Excel
                                    </button>*@
                                <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                    <i class="fa fa-file-pdf-o"></i> Export PDF
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <!-- Start XP Row -->
    <div class="row">
        <!-- End XP Col -->
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="xp-default-datatable" class="display table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Production Date</th>
                                    <th>Heat #</th>
                                    <th>Certificate #</th>
                                    <th>Analysis Date</th>
                                    <th>Action</th>
                            </thead>
                            <tbody>
                                @foreach (var item in slag)
                                {
                                    <tr>
                                        <td>@(item.DateOfProduction?.ToString("dd-MM-yyyy", gregorian))</td>
                                        <td>@item.HeatNo</td>
                                        <td>@item.CertificateNo</td>
                                        <td>@(item.DateOfAnalysis?.ToString("dd-MM-yyyy", gregorian))</td>
                                        <td>
                                            <a href="@Url.Action("AddSlagByProduct", "Quality", new { ID = item.ID })" class="btn btn-sm btn-primary">
                                                <i class="mdi mdi-pencil"></i>
                                            </a>
                                            <a href="@Url.Action("SlagByProductDetail", "Quality", new { ID = item.ID })" class="btn btn-sm btn-info">
                                                <i class="mdi mdi-account-card-details"></i>
                                            </a>
                                            <a href="@Url.Action("SlagByProductDelete", "Quality", new { ID = item.ID })" class="btn btn-sm btn-danger">
                                                <i class="mdi mdi-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- End XP Col -->
    </div>
    <!-- End XP Row -->
</div>
<!-- End XP Contentbar -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        var table = $('#xp-default-datatable').DataTable();

        // ✅ DataTables custom date range filter
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            // only for this table
            if (settings.nTable.id !== "xp-default-datatable") return true;

            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            var fromDate = from ? new Date(from + "T00:00:00") : null;
            var toDate = to ? new Date(to + "T23:59:59") : null;

            // read ISO date from hidden span
            var rowNode = table.row(dataIndex).node();
            var iso = $(rowNode).find("span.isoDate").text(); // yyyy-MM-dd

            if (!iso) return true;

            var rowDate = new Date(iso + "T12:00:00"); // safe mid-day

            if (fromDate && rowDate < fromDate) return false;
            if (toDate && rowDate > toDate) return false;

            return true;
        });

        // ✅ default dates: first of month → today
        var today = new Date();
        var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

        function formatDate(d) {
            var mm = String(d.getMonth() + 1).padStart(2, '0');
            var dd = String(d.getDate()).padStart(2, '0');
            return d.getFullYear() + '-' + mm + '-' + dd;
        }

        $('#fromDate').val(formatDate(firstDay));
        $('#toDate').val(formatDate(today));

        // initial draw
        table.draw();

        // Filter button
        $('#filterBtn').on('click', function () {
            table.draw();
        });

        // Clear button
        $('#clearBtn').on('click', function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            table.draw();
        });

        // ✅ Export PDF with same date range
        $('#exportPdf').click(function () {
            var from = $('#fromDate').val() || '';
            var to = $('#toDate').val() || '';

            // 👇 apna correct action/controller yahan lagao
            var exportPDFUrl = '@Url.Action("SlagByProductPDF", "Quality")';

            var url = exportPDFUrl
                + '?from=' + encodeURIComponent(from)
                + '&to=' + encodeURIComponent(to);

            window.open(url, '_blank');
        });

    });
</script>


<script>
    $(document).ready(function () {
        var msg = '@TempData["SuccessMessage"]';
        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }
    });
</script>

<script>
    function confirmDelete(id) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/Quality/SlagByProductDelete?id=' + id;
            }
        });
    }
</script>