@model DAL.Models.QCHBIDRIAnalysisBLL

@{
    ViewBag.Title = "Add / Edit HBI DRI Analysis";
}

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">HBI DRI Analysis</h4>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    <form action="/Quality/AddHBIDRIAnalysis" method="post" id="addprofileform">

        @Html.HiddenFor(m => m.ID)

        <!-- ================= MASTER SECTION ================= -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>

                    <div class="card-body">

                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Receiving Date</label>
                                @Html.TextBoxFor(m => m.ReceivingDate, "{0:yyyy-MM-dd}",
                                    new { @class = "form-control", type = "date" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Material</label>
                                @Html.TextBoxFor(m => m.Material,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Shipment Code No</label>
                                @Html.TextBoxFor(m => m.ShipmentCodeNo,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Supplier</label>
                                @Html.TextBoxFor(m => m.Supplier,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Quantity</label>
                                @Html.TextBoxFor(m => m.Quantity,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Analysis Date</label>
                                @Html.TextBoxFor(m => m.AnalysisDate, "{0:yyyy-MM-dd}",
                                    new { @class = "form-control", type = "date" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Received Quantity</label>
                                @Html.TextBoxFor(m => m.ReceivedQuantity,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-2">
                                <label>Reference No</label>
                                @Html.TextBoxFor(m => m.ReferenceNo,
                                    new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-6">
                                <label>Physical Analysis</label>
                                @Html.TextAreaFor(m => m.PhysicalAnalysis,
                                    new { @class = "form-control", rows = 3 })
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

