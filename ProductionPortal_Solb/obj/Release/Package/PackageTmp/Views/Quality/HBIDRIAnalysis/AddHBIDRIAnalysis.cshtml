<!-- ================= SCRIPT ================= -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    $(document).ready(function () {
        $("input[type='number']").attr({
            step: "any",
            min: "0"
        });
    });

    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>
<script>

    $("input[type='number']").attr("step", "any");
    // Set current date
    const today = new Date().toISOString().split('T')[0];
    document.getElementById("date").value = today;
</script>
<script>
    let sampleIndex = $('#samplesContainer .sample-block').length;

    $('#addSample').click(function () {

        let html = `
        <div class="sample-block border p-2 mb-2">
        <!-- 🔥 REQUIRED FOR MVC -->
        <input type="hidden" name="Samples.Index" value="0" />
        <div class="form-row">
        <!-- Sample Code -->
        <div class="form-group col-md-2">
           <label>Sample Code</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].SampleCode" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Fe Total</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].FeTotal" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Fe Metallic</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].FeMetallic" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Metallization</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].Metallization" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>C %</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].C" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>S %</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].S" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>P %</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].P" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>SiO2</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].SiO2" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Al2O3</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].Al2O3" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>MgO</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].MgO" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>CaO</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].CaO" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Total Gangue</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].TotalGangue" />
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label>Grain Size</label>
                                        <input type="text"
                                               class="form-control"
                                               name="Samples[${sampleIndex}].GrainSize" />
                                    </div>
          <div class="form-group col-md-7">
           <label>Comments</label>
           <textarea class="form-control"
              rows="2"
              name="Samples[${sampleIndex}].Comment"></textarea>
           </div>

           <div class="form-group col-md-2 d-flex align-items-end">
    <button type="button"
            class="btn btn-danger btn-sm removeSample">
        Remove
    </button>
</div>

          </div>
        </div>
        `;

        $('#samplesContainer').append(html);
        sampleIndex++;
    });

    $(document).on('click', '.removeSample', function () {
        $(this).closest('.sample-block').remove();
        reIndex();
    });

    function reIndex() {
        $('#samplesContainer .sample-block').each(function (i) {

            $(this).find('input[name="Samples.Index"]').val(i);

            $(this).find('input, textarea').each(function () {
                let name = $(this).attr('name');
                if (name)
                    $(this).attr('name', name.replace(/Samples\[\d+\]/, 'Samples[' + i + ']'));
            });
        });

        sampleIndex = $('#samplesContainer .sample-block').length;
    }
</script>