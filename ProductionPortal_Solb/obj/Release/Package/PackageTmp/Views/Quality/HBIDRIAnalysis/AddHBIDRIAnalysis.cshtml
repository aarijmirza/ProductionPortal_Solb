@model DAL.Models.QCHBIDRIAnalysisBLL
@using System.Globalization

@{
    ViewBag.Title = Model != null && Model.ID > 0
        ? "Edit HBI / DRI Analysis"
        : "Add HBI / DRI Analysis";

    var samples = Model != null && Model.Samples != null
        ? Model.Samples
        : new List<DAL.Models.SampleHBIDRIBLL>();
}

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">
                @(Model != null && Model.ID > 0
                    ? "Edit HBI / DRI Analysis"
                    : "Add HBI / DRI Analysis")
            </h4>
        </div>

        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="icon-home"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("HBIDRIlist", "Quality")">
                            HBI / DRI Analysis
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        @(Model != null && Model.ID > 0 ? "Edit" : "Add")
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    @using (Html.BeginForm(
        "AddHBIDRIAnalysis",
        "Quality",
        FormMethod.Post,
        new
        {
            id = "addprofileform",
            autocomplete = "off"
        }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ID)

        <!-- ========================================================= -->
        <!-- MASTER SECTION                                            -->
        <!-- ========================================================= -->

        <div class="row">
            <div class="col-lg-12">

                <div class="card m-b-30">

                    <div class="card-header bg-white">

                        <h5 class="card-title d-inline">
                            Receiving Information
                        </h5>

                        <div class="float-right">

                            <a href="@Url.Action("HBIDRIlist", "Quality")"
                               class="btn btn-secondary">
                                <i class="mdi mdi-arrow-left"></i>
                                Back
                            </a>

                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary">

                                <i class="mdi mdi-content-save"></i>

                                @(Model != null && Model.ID > 0
                                    ? "Update"
                                    : "Save")
                            </button>

                        </div>
                    </div>

                    <div class="card-body">

                        @Html.ValidationSummary(
                            false,
                            "",
                            new { @class = "text-danger mb-3" })

                        <div class="form-row">

                            <!-- Receiving Date -->
                            <div class="form-group col-md-2">

                                <label>
                                    Receiving Date
                                    <span class="text-danger">*</span>
                                </label>

                                @Html.TextBoxFor(
                                    m => m.ReceivingDate,
                                    "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "date",
                                        required = "required"
                                    })

                            </div>

                            <!-- Material -->
                            <div class="form-group col-md-2">

                                <label>
                                    Material
                                    <span class="text-danger">*</span>
                                </label>

                                @Html.TextBoxFor(
                                    m => m.Material,
                                    new
                                    {
                                        @class = "form-control",
                                        maxlength = "100",
                                        required = "required"
                                    })

                            </div>

                            <!-- Shipment Code -->
                            <div class="form-group col-md-2">

                                <label>
                                    Shipment Code No
                                </label>

                                @Html.TextBoxFor(
                                    m => m.ShipmentCodeNo,
                                    new
                                    {
                                        @class = "form-control",
                                        maxlength = "100"
                                    })

                            </div>

                            <!-- Supplier -->
                            <div class="form-group col-md-2">

                                <label>
                                    Supplier
                                    <span class="text-danger">*</span>
                                </label>

                                @Html.TextBoxFor(
                                    m => m.Supplier,
                                    new
                                    {
                                        @class = "form-control",
                                        maxlength = "200",
                                        required = "required"
                                    })

                            </div>

                            <!-- Quantity -->
                            <div class="form-group col-md-2">

                                <label>
                                    Quantity
                                </label>

                                @Html.TextBoxFor(
                                    m => m.Quantity,
                                    new
                                    {
                                        @class = "form-control",
                                        type = "number",
                                        min = "0",
                                        step = "1"
                                    })

                            </div>

                            <!-- Analysis Date -->
                            <div class="form-group col-md-2">

                                <label>
                                    Analysis Date
                                    <span class="text-danger">*</span>
                                </label>

                                @Html.TextBoxFor(
                                    m => m.AnalysisDate,
                                    "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "date",
                                        required = "required"
                                    })

                            </div>

                        </div>

                        <div class="form-row">

                            <!-- Received Quantity -->
                            <div class="form-group col-md-2">

                                <label>
                                    Received Quantity
                                </label>

                                @Html.TextBoxFor(
                                    m => m.ReceivedQuantity,
                                    new
                                    {
                                        @class = "form-control",
                                        maxlength = "100"
                                    })

                            </div>

                            <!-- Reference No -->
                            <div class="form-group col-md-2">

                                <label>
                                    Reference No
                                </label>

                                @Html.TextBoxFor(
                                    m => m.ReferenceNo,
                                    new
                                    {
                                        @class = "form-control",
                                        maxlength = "100"
                                    })

                            </div>

                            <!-- Physical Analysis -->
                            <div class="form-group col-md-8">

                                <label>
                                    Physical Analysis
                                </label>

                                @Html.TextAreaFor(
                                    m => m.PhysicalAnalysis,
                                    new
                                    {
                                        @class = "form-control",
                                        rows = "3",
                                        maxlength = "1000"
                                    })

                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- ========================================================= -->
        <!-- SAMPLE SECTION                                            -->
        <!-- ========================================================= -->

        <div class="row">
            <div class="col-lg-12">

                <div class="card m-b-30">

                    <div class="card-header bg-white">

                        <h5 class="card-title d-inline">
                            Analysis Results
                        </h5>

                        <button type="button"
                                class="btn btn-success btn-sm float-right"
                                id="addSample">

                            <i class="fa fa-plus-circle"></i>
                            Add Sample

                        </button>

                    </div>

                    <div class="card-body">

                        <div id="samplesContainer">

                            @if (samples.Count > 0)
                            {
                                for (int i = 0; i < samples.Count; i++)
                                {
                                    var sample = samples[i];

                                    <div class="sample-block border rounded p-3 mb-3">

                                        <input type="hidden"
                                               name="Samples.Index"
                                               value="@i" />

                                        <div class="d-flex justify-content-between mb-2">

                                            <strong class="sample-title">
                                                Sample @(i + 1)
                                            </strong>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm removeSample">

                                                <i class="mdi mdi-delete"></i>
                                                Remove

                                            </button>

                                        </div>

                                        <div class="form-row">

                                            <div class="form-group col-md-2">
                                                <label>Sample Code</label>

                                                <input type="text"
                                                       class="form-control sample-code"
                                                       name="Samples[@i].SampleCode"
                                                       value="@sample.SampleCode"
                                                       maxlength="100" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>Fe Total</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].FeTotal"
                                                       value="@(sample.FeTotal?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>Fe Metallic</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].FeMetallic"
                                                       value="@(sample.FeMetallic?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>Metallization</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].Metallization"
                                                       value="@(sample.Metallization?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-1">
                                                <label>C %</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].C"
                                                       value="@(sample.C?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-1">
                                                <label>S %</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].S"
                                                       value="@(sample.S?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-1">
                                                <label>P %</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].P"
                                                       value="@(sample.P?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-1">
                                                <label>SiO2</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].SiO2"
                                                       value="@(sample.SiO2?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                        </div>

                                        <div class="form-row">

                                            <div class="form-group col-md-2">
                                                <label>Al2O3</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].Al2O3"
                                                       value="@(sample.Al2O3?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>MgO</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].MgO"
                                                       value="@(sample.MgO?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>CaO</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].CaO"
                                                       value="@(sample.CaO?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>Total Gangue</label>

                                                <input type="number"
                                                       step="any"
                                                       min="0"
                                                       class="form-control"
                                                       name="Samples[@i].TotalGangue"
                                                       value="@(sample.TotalGangue?.ToString(CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="form-group col-md-2">
                                                <label>Grain Size</label>

                                                <input type="text"
                                                       class="form-control"
                                                       name="Samples[@i].GrainSize"
                                                       value="@sample.GrainSize"
                                                       maxlength="100" />
                                            </div>

                                        </div>

                                        <div class="form-row">

                                            <div class="form-group col-md-12">

                                                <label>
                                                    Comments
                                                </label>

                                                <textarea class="form-control"
                                                          rows="2"
                                                          maxlength="1000"
                                                          name="Samples[@i].Comment">@sample.Comment</textarea>

                                            </div>

                                        </div>

                                    </div>
                                }
                            }

                        </div>

                    </div>
                </div>

            </div>
        </div>
    }

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    $(document).ready(function () {

        /*
         * If somehow no sample exists on page,
         * create the first blank sample.
         */
        if ($('#samplesContainer .sample-block').length === 0) {
            addNewSample();
        }

        updateSampleTitles();


        /*
         * Add new sample.
         */
        $('#addSample').on('click', function () {
            addNewSample();
        });


        /*
         * Remove sample.
         */
        $(document).on('click', '.removeSample', function () {

            var total =
                $('#samplesContainer .sample-block').length;

            if (total <= 1) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Sample Required',
                    text: 'At least one sample row must remain.'
                });

                return;
            }

            $(this)
                .closest('.sample-block')
                .remove();

            reIndexSamples();
        });


        /*
         * Form submit confirmation.
         */
        var isSubmitting = false;

        $('#addprofileform').on('submit', function (e) {

            if (isSubmitting) {
                return;
            }

            e.preventDefault();

            reIndexSamples();

            /*
             * Duplicate Sample Code validation.
             */
            var duplicateCodes =
                getDuplicateSampleCodes();

            if (duplicateCodes.length > 0) {

                Swal.fire({
                    icon: 'error',
                    title: 'Duplicate Sample Code',
                    text:
                        'Duplicate Sample Code(s): ' +
                        duplicateCodes.join(', ')
                });

                return;
            }

            var isEdit =
                parseInt($('#ID').val() || '0') > 0;

            Swal.fire({
                title:
                    isEdit
                        ? 'Confirm Update'
                        : 'Confirm Submission',

                text:
                    isEdit
                        ? 'Are you sure you want to update this HBI / DRI Analysis?'
                        : 'Are you sure you want to save this HBI / DRI Analysis?',

                icon: 'question',

                showCancelButton: true,

                confirmButtonText:
                    isEdit
                        ? 'Yes, Update'
                        : 'Yes, Save',

                cancelButtonText: 'Cancel',

                allowOutsideClick: false,
                allowEscapeKey: false

            }).then(function (result) {

                if (!result.isConfirmed) {
                    return;
                }

                isSubmitting = true;

                $('#submitBtn')
                    .prop('disabled', true)
                    .html(
                        '<i class="fa fa-spinner fa-spin"></i> Saving...'
                    );

                $('#addprofileform')[0].submit();

            });

        });

    });


    function addNewSample() {

        var index =
            $('#samplesContainer .sample-block').length;

        var html = `

        <div class="sample-block border rounded p-3 mb-3">

            <input type="hidden"
                   name="Samples.Index"
                   value="${index}" />

            <div class="d-flex justify-content-between mb-2">

                <strong class="sample-title">
                    Sample ${index + 1}
                </strong>

                <button type="button"
                        class="btn btn-danger btn-sm removeSample">

                    <i class="mdi mdi-delete"></i>
                    Remove

                </button>

            </div>

            <div class="form-row">

                <div class="form-group col-md-2">

                    <label>Sample Code</label>

                    <input type="text"
                           class="form-control sample-code"
                           maxlength="100"
                           name="Samples[${index}].SampleCode" />

                </div>

                <div class="form-group col-md-2">

                    <label>Fe Total</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].FeTotal" />

                </div>

                <div class="form-group col-md-2">

                    <label>Fe Metallic</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].FeMetallic" />

                </div>

                <div class="form-group col-md-2">

                    <label>Metallization</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].Metallization" />

                </div>

                <div class="form-group col-md-1">

                    <label>C %</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].C" />

                </div>

                <div class="form-group col-md-1">

                    <label>S %</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].S" />

                </div>

                <div class="form-group col-md-1">

                    <label>P %</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].P" />

                </div>

                <div class="form-group col-md-1">

                    <label>SiO2</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].SiO2" />

                </div>

            </div>

            <div class="form-row">

                <div class="form-group col-md-2">

                    <label>Al2O3</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].Al2O3" />

                </div>

                <div class="form-group col-md-2">

                    <label>MgO</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].MgO" />

                </div>

                <div class="form-group col-md-2">

                    <label>CaO</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].CaO" />

                </div>

                <div class="form-group col-md-2">

                    <label>Total Gangue</label>

                    <input type="number"
                           step="any"
                           min="0"
                           class="form-control"
                           name="Samples[${index}].TotalGangue" />

                </div>

                <div class="form-group col-md-2">

                    <label>Grain Size</label>

                    <input type="text"
                           class="form-control"
                           maxlength="100"
                           name="Samples[${index}].GrainSize" />

                </div>

            </div>

            <div class="form-row">

                <div class="form-group col-md-12">

                    <label>Comments</label>

                    <textarea class="form-control"
                              rows="2"
                              maxlength="1000"
                              name="Samples[${index}].Comment"></textarea>

                </div>

            </div>

        </div>`;

        $('#samplesContainer').append(html);

        updateSampleTitles();
    }


    function reIndexSamples() {

        $('#samplesContainer .sample-block')
            .each(function (index) {

                var block =
                    $(this);

                block
                    .find('input[name="Samples.Index"]')
                    .val(index);

                block
                    .find('input, textarea, select')
                    .each(function () {

                        var name =
                            $(this).attr('name');

                        if (!name) {
                            return;
                        }

                        name =
                            name.replace(
                                /Samples\[\d+\]/g,
                                'Samples[' + index + ']'
                            );

                        $(this).attr(
                            'name',
                            name
                        );

                    });

            });

        updateSampleTitles();
    }


    function updateSampleTitles() {

        $('#samplesContainer .sample-block')
            .each(function (index) {

                $(this)
                    .find('.sample-title')
                    .text(
                        'Sample ' +
                        (index + 1)
                    );

            });
    }


    function getDuplicateSampleCodes() {

        var seen = {};
        var duplicates = [];

        $('.sample-code').each(function () {

            var value =
                $.trim(
                    $(this).val()
                ).toUpperCase();

            if (!value) {
                return;
            }

            if (seen[value]) {

                if (
                    duplicates.indexOf(value) === -1
                ) {
                    duplicates.push(value);
                }

            }
            else {
                seen[value] = true;
            }

        });

        return duplicates;
    }

</script>