<div class="xp-contentbar">

    <div class="main-card">
        <div class="main-card-header">
            Maintenance / Delay Detail
        </div>

        <div class="main-card-body">
            <div class="row">

                <!-- LEFT LIST -->
                <div class="col-md-6">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Date</span>
                            <span class="info-value">
                                @(Model.Date.HasValue ? Model.Date.Value.ToString("dd-MMM-yyyy", gregorian) : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">Delay Code</span>
                            <span class="info-value">@(Model.Delaycode ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Area</span>
                            <span class="info-value">@(Model.Area ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Plant</span>
                            <span class="info-value">@(Model.Plant ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Shift</span>
                            <span class="info-value">@(Model.Shift ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Team</span>
                            <span class="info-value">@(Model.Team ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Shift Incharge</span>
                            <span class="info-value">@(Model.ShiftIncharge ?? "-")</span>
                        </li>
                        <li>
                            <span class="info-label">Created By</span>
                            <span class="info-value">@(Model.CreatedBy ?? "-")</span>
                        </li>
                    </ul>
                </div>

                <!-- RIGHT LIST -->
                <div class="col-md-6">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Start Time</span>
                            <span class="info-value">
                                @(Model.StartTime.HasValue ? Model.StartTime.Value.ToString(@"hh\:mm") : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">End Time</span>
                            <span class="info-value">
                                @(Model.EndTime.HasValue ? Model.EndTime.Value.ToString(@"hh\:mm") : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">Total Duration</span>
                            <span class="info-value">
                                @(Model.TotalDuration.HasValue ? Model.TotalDuration.Value + " Min" : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">Cobble</span>
                            <span class="info-value">@(Model.Cobble.HasValue ? Model.Cobble.Value.ToString() : "0")</span>
                        </li>

                        <li>
                            <span class="info-label">Hot Out</span>
                            <span class="info-value">@(Model.HotOut.HasValue ? Model.HotOut.Value.ToString() : "0")</span>
                        </li>

                        <li>
                            <span class="info-label">Delay Type</span>
                            <span class="info-value">@(Model.DelayType ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Agency Name</span>
                            <span class="info-value">@(Model.AgencyName ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Agency Code</span>
                            <span class="info-value">@(Model.AgencyCode ?? "-")</span>
                        </li>
                        <li>
                            <span class="info-label">Created Date</span>
                            <span class="info-value">
                                @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt", gregorian) : "-")
                            </span>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- EQUIPMENT CARD -->
    <div class="main-card">
        <div class="main-card-header">
            Equipment Information
        </div>

        <div class="main-card-body">

            @if (canEditEquipment)
            {
                using (
                    Html.BeginForm(
                        "UpdateDelayEquipment",
                        "Maintenance",
                        FormMethod.Post,
                        new
                        {
                            id = "equipmentUpdateForm"
                        }
                    )
                )
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="DelayID"
                           value="@Model.ID" />

                    <div class="row align-items-end">

                        <div class="col-md-8">
                            <div class="form-group mb-md-0">
                                <label class="font-weight-bold">
                                    Equipment
                                </label>

                                <select id="EquipmentDropdown"
                                        name="Equipments"
                                        class="form-control"
                                        required>

                                    <option value="">
                                        -- Select Equipment --
                                    </option>

                                    @foreach (
                                        string equipmentItem
                                        in equipmentItems
                                    )
                                    {
                                        bool isSelected =
                                            string.Equals(
                                                Model.Equipments ?? "",
                                                equipmentItem ?? "",
                                                StringComparison.OrdinalIgnoreCase
                                            );

                                        <option value="@equipmentItem"
                                                @(isSelected ? "selected" : "")>
                                            @equipmentItem
                                        </option>
                                    }

                                </select>

                                <small class="form-text text-muted">
                                    Equipment list is filtered for Plant:
                                    <strong>@(Model.Plant ?? "-")</strong>
                                </small>

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        Model.Equipments
                                    )
                                )
                                {
                                    <small class="form-text text-muted">
                                        Current Equipment:
                                        <strong>
                                            @Model.Equipments
                                        </strong>
                                    </small>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group mb-0">
                                <button type="submit"
                                        class="btn btn-success btn-block">
                                    <i class="fa fa-save"></i>
                                    Save Equipment
                                </button>
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <!-- Non-User roles can view current equipment only. -->
                <div class="row">
                    <div class="col-md-6">
                        <ul class="info-list">
                            <li>
                                <span class="info-label">Equipment</span>
                                <span class="info-value">
                                    @(Model.Equipments ?? "-")
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            <hr />

            <div class="row">

                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">
                                Delay Description
                            </span>

                            <span class="info-value">
                                @(Model.DelayDescription ?? "-")
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">
                                Reason for Occurence
                            </span>

                            <span class="info-value">
                                @(Model.ReasonForOccurence ?? "-")
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">
                                Action Taken
                            </span>

                            <span class="info-value">
                                @(Model.ActionTaken ?? "-")
                            </span>
                        </li>
                    </ul>
                </div>

            </div>

        </div>
    </div>


    <!-- DELAY CORRECTION / UPDATE FORM -->
    <div class="main-card">
        <div class="main-card-header">
            Delay Correction / Additional Remarks
        </div>

        <div class="main-card-body">

            @using (Html.BeginForm("UpdateDelayCorrection", "Maintenance", FormMethod.Post, new { id = "delayCorrectionForm" }))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="DelayID" value="@Model.ID" />

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Delay Description</label>
                            <textarea class="form-control"
                                      rows="4"
                                      name="DelayDescription1"
                                      placeholder="Enter delay description"
                                      value="@Model.DelayDescription1">@Model.DelayDescription1</textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Reason for Occurrence</label>
                            <textarea class="form-control"
                                      rows="4"
                                      name="ReasonforOccurence1"
                                      placeholder="Enter reason for occurrence"
                                      value="@Model.ReasonForOccurence1">@Model.ReasonForOccurence1</textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Action Taken</label>
                            <textarea class="form-control"
                                      rows="4"
                                      name="ActionTaken1"
                                      placeholder="Enter action taken"
                                      value="@Model.ActionTaken1">@Model.ActionTaken1</textarea>
                        </div>
                    </div>
                </div>

                <div class="text-right mt-2">
                    <button type="submit" class="btn btn-success">
                        Update Delay Remarks
                    </button>
                </div>
            }

        </div>
    </div>




    <!-- MAINTENANCE ANALYSIS INPUT FORM -->
    <div class="main-card">
        <div class="main-card-header">
            Maintenance Analysis Form
        </div>

        <div class="main-card-body">

            @using (Html.BeginForm(
                "InsertMaintenanceAnalysis",
                "Maintenance",
                FormMethod.Post,
                new
                {
                    id = "analysisForm",
                    enctype = "multipart/form-data"
                }
            ))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="ID" value="@(analysis != null ? analysis.ID : 0)" />
                <input type="hidden" name="DelayID" value="@Model.ID" />
                <input type="hidden" name="StatusID" value="1" />

                if (hasAnalysis)
                {
                    <div class="alert alert-info">
                        Existing analysis found. Filled fields are locked. Empty fields are available for input.
                        <br />
                        <b>Analysis Code:</b> @(analysis.AnalysisCode ?? "-")
                    </div>
                }

                <div class="row">

                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Last PM Date</label>
                            <input type="date"
                                   name="LastPMDate"
                                   class="form-control"
                                   value="@(hasLastPMDate ? analysis.LastPMDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                    </div>

                    @if (showFailureReportStatus)
                    {
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Failure Report Status</label>

                                @if (hasFailureReportStatus)
                                {
                                    <input type="text"
                                           class="form-control"
                                           value="@analysis.FailureReportStatus"
                                           readonly />

                                    <input type="hidden"
                                           name="FailureReportStatus"
                                           value="@analysis.FailureReportStatus" />
                                }
                                else
                                {
                                    <select name="FailureReportStatus" class="form-control">
                                        <option value="">-- Select Status --</option>
                                        <option value="Open">Open</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SAP Breakdown Order</label>
                            <input type="text"
                                   name="SAPBreakdownOrder"
                                   class="form-control"
                                   maxlength="50"
                                   value="@(hasSAPBreakdownOrder ? analysis.SAPBreakdownOrder : "")"
                                   placeholder="Enter SAP Breakdown Order" />
                        </div>
                    </div>

                </div>

                <div class="mtbf-mttr-wrapper">

                    <div class="row">

                        <!-- ==================================================
                             MTBF - UNLIMITED DYNAMIC ACTIONS
                             ================================================== -->
                        <div class="col-md-6">
                            <div class="mtbf-mttr-box">

                                <div class="mtbf-mttr-box-title">
                                    MTBF Improvement Actions
                                </div>

                                <div class="form-group">
                                    <label>Long Term Action Taken to Increase MTBF</label>

                                    <textarea name="IncreaseMTBF"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter MTBF improvement remarks">@(analysis != null ? analysis.IncreaseMTBF : "")</textarea>
                                </div>

                                @if (hasIncreaseMTBF1)
                                {
                                    <div class="mtbf-dynamic-row">
                                        <div class="form-group">
                                            <label>Existing Additional MTBF Action</label>

                                            <textarea name="IncreaseMTBF1"
                                                      class="form-control"
                                                      rows="3"
                                                      placeholder="Enter additional MTBF action">@(analysis != null ? analysis.IncreaseMTBF1 : "")</textarea>
                                        </div>
                                    </div>
                                }

                                @if (savedMtbfActions.Any())
                                {
                                    <div class="mt-3">
                                        <label class="font-weight-bold">
                                            Saved Dynamic MTBF Actions
                                        </label>

                                        @foreach (var savedAction in savedMtbfActions)
                                        {
                                            <div class="saved-action-item">
                                                <small>
                                                    @(string.IsNullOrWhiteSpace(savedAction.ActionCode)
                                                        ? "Saved Action"
                                                        : savedAction.ActionCode)
                                                </small>

                                                <div>
                                                    @savedAction.ActionRemarks
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div id="mtbfAdditionalContainer"></div>

                                <div class="mtbf-add-wrap">
                                    <button type="button"
                                            id="btnAddMtbf"
                                            class="btn btn-sm btn-success">
                                        + Add MTBF Action
                                    </button>
                                </div>

                            </div>
                        </div>


                        <!-- ==================================================
                             MTTR - UNLIMITED DYNAMIC ACTIONS
                             ================================================== -->
                        <div class="col-md-6">
                            <div class="mtbf-mttr-box">

                                <div class="mtbf-mttr-box-title">
                                    MTTR Reduction Actions
                                </div>

                                <div class="form-group">
                                    <label>Long Term Action Taken to Decrease MTTR</label>

                                    <textarea name="DecreaseMTTR"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter MTTR reduction details">@(analysis != null ? analysis.DecreaseMTTR : "")</textarea>
                                </div>

                                @if (hasDecreaseMTTR1)
                                {
                                    <div class="mttr-dynamic-row">
                                        <div class="form-group">
                                            <label>Existing Additional MTTR Action</label>

                                            <textarea name="DecreaseMTTR1"
                                                      class="form-control"
                                                      rows="3"
                                                      placeholder="Enter additional MTTR action">@(analysis != null ? analysis.DecreaseMTTR1 : "")</textarea>
                                        </div>
                                    </div>
                                }

                                @if (savedMttrActions.Any())
                                {
                                    <div class="mt-3">
                                        <label class="font-weight-bold">
                                            Saved Dynamic MTTR Actions
                                        </label>

                                        @foreach (var savedAction in savedMttrActions)
                                        {
                                            <div class="saved-action-item">
                                                <small>
                                                    @(string.IsNullOrWhiteSpace(savedAction.ActionCode)
                                                        ? "Saved Action"
                                                        : savedAction.ActionCode)
                                                </small>

                                                <div>
                                                    @savedAction.ActionRemarks
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div id="mttrAdditionalContainer"></div>

                                <div class="mtbf-add-wrap">
                                    <button type="button"
                                            id="btnAddMttr"
                                            class="btn btn-sm btn-success">
                                        + Add MTTR Action
                                    </button>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                <!--<div class="row mtbf-mttr-row" id="mtbfMttrRows">

                <div class="col-md-5">
                    <div class="form-group">
                        <label>Action Taken to Increase MTBF</label>
                        <textarea name="IncreaseMTBFAction[]"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter MTBF improvement remarks"></textarea>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="form-group">
                        <label>Action Taken Decrease MTTR</label>
                        <textarea name="DecreaseMTTRAction[]"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Enter MTTR reduction details"></textarea>
                    </div>
                </div>


                <div class="col-md-2" style=" align-content: center;">
                    <div class="col-md-12 text-right">
                        <button type="button" id="btnAddMtbfMttr" class="btn btn-sm btn-success">
                            + Add More
                        </button>
                    </div>
                </div>-->

                @*<div class="col-md-6">
                        <div class="form-group">
                            <label>Action Taken to Increase MTBF</label>
                            <textarea name="IncreaseMTBF1"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Enter MTBF improvement remarks"
                                      @(hasIncreaseMTBF1 ? "readonly" : "")>@(hasIncreaseMTBF1 ? analysis.IncreaseMTBF1 : "")</textarea>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Action Taken Decrease MTTR</label>
                            <textarea name="DecreaseMTTR"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Enter MTTR reduction details"
                                      @(hasDecreaseMTTR ? "readonly" : "")>@(hasDecreaseMTTR ? analysis.DecreaseMTTR : "")</textarea>
                        </div>
                    </div>*@

                <!--</div>-->

                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Failure Category 1 - Component</label>
                            <textarea name="FailureCategory1Component"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Enter component failure category">@(hasFailureCategory1Component ? analysis.FailureCategory1Component : "")</textarea>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Failure Category 2 - Root Cause</label>
                            <select class="form-control"
                                    name="FailureCategory2RootCause"
                                    id="FailureCategory2RootCause">
                                <option value="">-- please select --</option>

                                <option value="Shortage of Spares"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Shortage of Spares", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Shortage of Spares
                                </option>

                                <option value="Can Be avoided"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Can Be avoided", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Can Be avoided
                                </option>

                                <option value="Machine Poor Condition"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Machine Poor Condition", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Machine Poor Condition
                                </option>

                                <option value="Undetectable failure"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Undetectable failure", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Undetectable failure
                                </option>

                                <option value="Poor Operation Condition"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Poor Operation Condition", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Poor Operation Condition
                                </option>

                                <option value="Human Mistake"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Human Mistake", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Human Mistake
                                </option>

                                <option value="Design issues"
                                        @((analysis != null && string.Equals(analysis.FailureCategory2RootCause, "Design issues", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                    Design issues
                                </option>
                            </select>
                        </div>
                    </div>

                </div>

                <!-- FAILURE ANALYSIS ATTACHMENT -->
                <div class="row mt-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Failure Analysis Attachment
                            </label>

                            <div class="custom-file">
                                <input type="file"
                                       class="custom-file-input"
                                       id="FailureAnalysisFile"
                                       name="FailureAnalysisFile"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />

                                <label class="custom-file-label"
                                       for="FailureAnalysisFile">
                                    Choose file
                                </label>
                            </div>

                            <small class="form-text text-muted">
                                Allowed: PDF, Word, Excel, JPG, JPEG, PNG.
                                Maximum recommended size: 10 MB.
                            </small>
                        </div>
                    </div>

                    @*<div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Attachment Remarks
                                </label>

                                <input type="text"
                                       class="form-control"
                                       id="FailureAnalysisFileRemarks"
                                       name="FailureAnalysisFileRemarks"
                                       maxlength="250"
                                       placeholder="Enter attachment remarks (optional)" />
                            </div>
                        </div>*@
                </div>

                <div class="text-right mt-3">
                    <button type="submit"
                            id="btnSaveAnalysis"
                            class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        <span class="save-analysis-text">
                            @(hasAnalysis ? "Update Missing Information" : "Save Analysis")
                        </span>
                    </button>
                </div>
            }

        </div>
    </div>

    <div class="text-right no-print">
        <a href="@Url.Action("list", "Maintenance")" class="btn btn-secondary">
            Back
        </a>

        <button type="button" class="btn btn-danger" onclick="window.print()">
            Print
        </button>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        $("#FailureAnalysisFile").on("change", function () {
            var fileName = "";

            if (
                this.files &&
                this.files.length > 0
            ) {
                fileName =
                    this.files[0].name;
            }

            $(this)
                .next(".custom-file-label")
                .text(
                    fileName || "Choose file"
                );
        });

        $("#equipmentUpdateForm").on("submit", function (e) {

            e.preventDefault();

            var selectedEquipment =
                ($("#EquipmentDropdown").val() || "").trim();

            if (!selectedEquipment) {

                Swal.fire({
                    icon: "warning",
                    title: "Equipment Required",
                    text: "Please select equipment before saving.",
                    confirmButtonColor: "#7f1010"
                });

                return;
            }


            var form =
                this;


            Swal.fire({
                title: "Update Equipment?",
                text: "Selected equipment will be saved against this delay record.",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Yes, Save",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#198754",
                cancelButtonColor: "#6c757d"
            })
                .then(function (result) {

                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
        });


        $("#analysisForm").on("submit", function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Confirm Submission",
                text: "Are you sure you want to save this maintenance analysis?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Save",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33"
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#analysisForm")[0].submit();
                }
            });
        });

    });
</script>
<script>
    $(document).ready(function () {

        var mtbfActionIndex = 0;
        var mttrActionIndex = 0;


        // =========================================================
        // MTBF - ADD UNLIMITED DYNAMIC ACTIONS
        // =========================================================
        $("#btnAddMtbf").on("click", function () {

            mtbfActionIndex++;

            var html = `
                <div class="mtbf-dynamic-row dynamic-mtbf-item">

                    <div class="form-group">
                        <label>
                            Additional MTBF Action ${mtbfActionIndex}
                        </label>

                        <textarea name="increaseMTBFActions"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter additional MTBF action"></textarea>
                    </div>

                    <div class="text-right mtbf-mttr-remove">
                        <button type="button"
                                class="btn btn-sm btn-danger btnRemoveMtbf">
                            Remove
                        </button>
                    </div>

                </div>
            `;

            $("#mtbfAdditionalContainer").append(html);
        });


        // =========================================================
        // MTTR - ADD UNLIMITED DYNAMIC ACTIONS
        // =========================================================
        $("#btnAddMttr").on("click", function () {

            mttrActionIndex++;

            var html = `
                <div class="mttr-dynamic-row dynamic-mttr-item">

                    <div class="form-group">
                        <label>
                            Additional MTTR Action ${mttrActionIndex}
                        </label>

                        <textarea name="decreaseMTTRActions"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter additional MTTR action"></textarea>
                    </div>

                    <div class="text-right mtbf-mttr-remove">
                        <button type="button"
                                class="btn btn-sm btn-danger btnRemoveMttr">
                            Remove
                        </button>
                    </div>

                </div>
            `;

            $("#mttrAdditionalContainer").append(html);
        });


        // =========================================================
        // REMOVE ONLY CLICKED MTBF FIELD
        // =========================================================
        $(document).on("click", ".btnRemoveMtbf", function () {
            $(this)
                .closest(".dynamic-mtbf-item")
                .remove();
        });


        // =========================================================
        // REMOVE ONLY CLICKED MTTR FIELD
        // =========================================================
        $(document).on("click", ".btnRemoveMttr", function () {
            $(this)
                .closest(".dynamic-mttr-item")
                .remove();
        });

    });
</script>

<script>
    $(document).ready(function () {

        $("#analysisForm").on("submit", function () {

            var $form =
                $(this);

            var $button =
                $("#btnSaveAnalysis");

            if (
                $form.data("submitting") === true
            ) {
                return false;
            }

            $form.data(
                "submitting",
                true
            );

            $button
                .prop(
                    "disabled",
                    true
                );

            $button
                .find(
                    ".save-analysis-text"
                )
                .text(
                    "Saving..."
                );

            return true;
        });

    });
</script>
