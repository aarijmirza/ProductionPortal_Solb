@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "list";

    var steelMakingRecordsObject = (object)ViewBag.SteelMakingRecords;
    var steelMakingDelays =
        steelMakingRecordsObject as IEnumerable<DAL.Models.PlantDelayBLL>
        ?? Enumerable.Empty<DAL.Models.PlantDelayBLL>();

    var rollingMillRecordsObject = (object)ViewBag.RollingMillRecords;
    var rollingMillDelays =
        rollingMillRecordsObject as IEnumerable<DAL.Models.PlantDelayBLL>
        ?? Enumerable.Empty<DAL.Models.PlantDelayBLL>();

    var failureAnalysisStatusObject = (object)ViewBag.FailureAnalysisStatus;
    var failureAnalysisStatus =
        failureAnalysisStatusObject as Dictionary<int, bool>
        ?? new Dictionary<int, bool>();

    var steelAgenciesObject = (object)ViewBag.SteelAgencies;
    var steelAgencies =
        steelAgenciesObject as IEnumerable<DAL.Models.PlantDelayBLL>
        ?? Enumerable.Empty<DAL.Models.PlantDelayBLL>();

    var rollingAgenciesObject = (object)ViewBag.RollingAgencies;
    var rollingAgencies =
        rollingAgenciesObject as IEnumerable<DAL.Models.PlantDelayBLL>
        ?? Enumerable.Empty<DAL.Models.PlantDelayBLL>();

    Func<object, List<string>> toSelectedList =
        value =>
        {
            string csv =
                Convert.ToString(
                    value
                ) ?? string.Empty;

            return
                string.IsNullOrWhiteSpace(csv)
                    ? new List<string>()
                    : csv
                        .Split(
                            new[] { ',' },
                            StringSplitOptions.RemoveEmptyEntries
                        )
                        .Select(
                            x => (x ?? string.Empty).Trim()
                        )
                        .Where(
                            x => !string.IsNullOrWhiteSpace(x)
                        )
                        .ToList();
        };


    var selectedSteelPlants =
        toSelectedList(
            (object)ViewBag.SteelPlant
        );

    var selectedSteelAgencies =
        toSelectedList(
            (object)ViewBag.SteelAgency
        );

    var selectedSteelDelayTypes =
        toSelectedList(
            (object)ViewBag.SteelDelayType
        );


    var selectedRollingPlants =
        toSelectedList(
            (object)ViewBag.RollingPlant
        );

    var selectedRollingAgencies =
        toSelectedList(
            (object)ViewBag.RollingAgency
        );

    var selectedRollingDelayTypes =
        toSelectedList(
            (object)ViewBag.RollingDelayType
        );


    string steelFromDateValue =
        Convert.ToString(
            (object)ViewBag.SteelFromDate
        ) ?? string.Empty;

    string steelToDateValue =
        Convert.ToString(
            (object)ViewBag.SteelToDate
        ) ?? string.Empty;

    string rollingFromDateValue =
        Convert.ToString(
            (object)ViewBag.RollingFromDate
        ) ?? string.Empty;

    string rollingToDateValue =
        Convert.ToString(
            (object)ViewBag.RollingToDate
        ) ?? string.Empty;


    string activeTab =
        Convert.ToString(
            (object)ViewBag.ActiveTab
        ) ?? string.Empty;

    if (
        !string.Equals(
            activeTab,
            "steel",
            StringComparison.OrdinalIgnoreCase
        )
        &&
        !string.Equals(
            activeTab,
            "rolling",
            StringComparison.OrdinalIgnoreCase
        )
    )
    {
        activeTab = "steel";
    }
    else
    {
        activeTab =
            activeTab.ToLowerInvariant();
    }
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Failure Analysis</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CMD Maintenance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Maintenance Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<link href="@Url.Content("~/assets/plugins/select2/select2.min.css")" rel="stylesheet" />
<style>
    .maintenance-filter-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .06);
    }

        .maintenance-filter-card label {
            color: #4b5563;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

    .delay-type-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        min-height: 40px;
        padding: 5px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #f9fafb;
    }

    .delay-radio {
        position: relative;
        margin: 0;
    }

        .delay-radio input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .delay-radio label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 92px;
            min-height: 30px;
            margin: 0;
            padding: 6px 12px;
            border: 1px solid #d1d5db;
            border-radius: 20px;
            background: #ffffff;
            color: #4b5563;
            cursor: pointer;
            font-size: 10px;
            font-weight: 800;
            text-transform: none;
            letter-spacing: 0;
            transition: all .18s ease;
        }

        .delay-radio input:checked + label {
            border-color: #a6173f;
            background: #a6173f;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(166, 23, 63, .18);
        }

    .select2-container {
        width: 100% !important;
        display: block;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 44px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 5px 8px;
        background: #ffffff;
        box-shadow: none;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        overflow: visible;
    }

    .select2-container--default.select2-container--focus
    .select2-selection--multiple {
        border-color: #a6173f;
        box-shadow: 0 0 0 3px rgba(166, 23, 63, .10);
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__rendered {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        width: 100%;
        min-height: 32px;
        padding: 0;
        margin: 0;
        line-height: normal;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-search--inline {
        flex: 1 1 120px;
        margin: 0;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-search__field {
        width: 100% !important;
        height: 30px;
        min-width: 120px;
        margin: 0;
        padding: 4px 2px;
        border: 0 !important;
        outline: 0;
        color: #374151;
        font-size: 13px;
        line-height: 22px;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__choice {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        margin: 0;
        padding: 4px 9px 4px 25px;
        border: 1px solid #d7a7b6;
        border-radius: 16px;
        background: #faeef2;
        color: #75102d;
        font-size: 11px;
        font-weight: 700;
        line-height: 18px;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__choice__remove {
        top: 50%;
        left: 7px;
        transform: translateY(-50%);
        border-right: 0;
        color: #a6173f;
        font-size: 16px;
        line-height: 1;
    }

        .select2-container--default
        .select2-selection--multiple
        .select2-selection__choice__remove:hover {
            background: transparent;
            color: #7f1230;
        }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__clear {
        margin-top: 0;
        margin-right: 3px;
        color: #6b7280;
        font-size: 18px;
        line-height: 1;
    }

    .select2-dropdown {
        border: 1px solid #d1d5db;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .12);
    }

    .select2-container--default
    .select2-results__option--highlighted[aria-selected] {
        background: #a6173f;
        color: #ffffff;
    }

    .select2-container--default
    .select2-results__option[aria-selected=true] {
        background: #faeef2;
        color: #75102d;
    }

    .filter-select-group {
        margin-bottom: 12px;
    }

        .filter-select-group label {
            display: block;
            margin-bottom: 7px;
        }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
    }

    .btn-filter {
        border-color: #a6173f;
        background: #a6173f;
        color: #ffffff;
        font-weight: 700;
    }

        .btn-filter:hover,
        .btn-filter:focus {
            border-color: #7f1230;
            background: #7f1230;
            color: #ffffff;
        }

    @@media(max-width: 767px) {
        .filter-actions {
            margin-top: 8px;
        }

        .delay-radio label {
            min-width: 82px;
        }
    }

    .failure-analysis-indicator {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 82px;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .failure-analysis-light {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        flex: 0 0 11px;
    }

    .failure-analysis-filled {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

        .failure-analysis-filled .failure-analysis-light {
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .18);
        }

    .failure-analysis-pending {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }

        .failure-analysis-pending .failure-analysis-light {
            background: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, .18);
        }

    .maintenance-tabs-wrap {
        margin: 0 0 16px 0;
    }

    .maintenance-tabs {
        border-bottom: 2px solid #e5e7eb;
        gap: 6px;
    }

        .maintenance-tabs .nav-item {
            margin-bottom: -2px;
        }

        .maintenance-tabs .nav-link {
            border: 0;
            border-bottom: 3px solid transparent;
            border-radius: 8px 8px 0 0;
            color: #6b7280;
            font-size: 13px;
            font-weight: 800;
            padding: 10px 18px;
            transition: all .18s ease;
        }

            .maintenance-tabs .nav-link:hover,
            .maintenance-tabs .nav-link:focus {
                background: #faf5f7;
                color: #7f1230;
            }

            .maintenance-tabs .nav-link.active {
                background: #fff;
                border-bottom-color: #a6173f;
                color: #a6173f;
            }

    .maintenance-tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 22px;
        margin-left: 6px;
        padding: 0 7px;
        border-radius: 999px;
        background: #f3f4f6;
        color: #4b5563;
        font-size: 10px;
        font-weight: 800;
    }

    .maintenance-tabs .nav-link.active .maintenance-tab-count {
        background: #faeef2;
        color: #7f1230;
    }

    .maintenance-tab-pane {
        padding-top: 4px;
    }
</style>

<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">

    <div class="maintenance-tabs-wrap">
        <ul class="nav maintenance-tabs"
            id="maintenanceTabs"
            role="tablist">

            <li class="nav-item">
                <a class="nav-link @(activeTab == "steel" ? "active" : "")"
                   id="steel-making-tab"
                   data-toggle="tab"
                   href="#steel-making-pane"
                   role="tab"
                   aria-controls="steel-making-pane"
                   aria-selected="@(activeTab == "steel" ? "true" : "false")"
                   data-tab-value="steel">

                    <i class="fa fa-industry"></i>
                    Steel Making

                    <span class="maintenance-tab-count">
                        @steelMakingDelays.Count()
                    </span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(activeTab == "rolling" ? "active" : "")"
                   id="rolling-mill-tab"
                   data-toggle="tab"
                   href="#rolling-mill-pane"
                   role="tab"
                   aria-controls="rolling-mill-pane"
                   aria-selected="@(activeTab == "rolling" ? "true" : "false")"
                   data-tab-value="rolling">

                    <i class="fa fa-cogs"></i>
                    Rolling Mill

                    <span class="maintenance-tab-count">
                        @rollingMillDelays.Count()
                    </span>
                </a>
            </li>

        </ul>
    </div>


    <div class="tab-content"
         id="maintenanceTabsContent">

        <!-- =====================================================
             STEEL MAKING TAB
             ===================================================== -->
        <div class="tab-pane fade @(activeTab == "steel" ? "show active" : "") maintenance-tab-pane"
             id="steel-making-pane"
             role="tabpanel"
             aria-labelledby="steel-making-tab">

            <!-- STEEL MAKING FILTERS -->
            <div class="card maintenance-filter-card mb-3">
                <div class="card-body">

                    <form id="steelFilterForm"
                          method="get"
                          action="@Url.Action("list", "Maintenance")">

                        <input type="hidden"
                               name="tab"
                               value="steel" />

                        <div class="row align-items-end">

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="steelFromDate">
                                        From Date
                                    </label>

                                    <input type="date"
                                           id="steelFromDate"
                                           name="steelFromDate"
                                           class="form-control"
                                           value="@steelFromDateValue" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="steelToDate">
                                        To Date
                                    </label>

                                    <input type="date"
                                           id="steelToDate"
                                           name="steelToDate"
                                           class="form-control"
                                           value="@steelToDateValue" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group filter-select-group">

                                    <label for="steelPlant">
                                        Area
                                    </label>

                                    <select id="steelPlant"
                                            name="steelPlant"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select EAF / LF / CCM">

                                        <option value="EAF"
                                                @(selectedSteelPlants.Any(x => string.Equals(x, "EAF", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            EAF
                                        </option>

                                        <option value="LF"
                                                @(selectedSteelPlants.Any(x => string.Equals(x, "LF", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            LF
                                        </option>

                                        <option value="CCM"
                                                @(selectedSteelPlants.Any(x => string.Equals(x, "CCM", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            CCM
                                        </option>

                                    </select>

                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">

                                    <label for="steelAgency">
                                        Agency
                                    </label>

                                    <select id="steelAgency"
                                            name="steelAgency"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select agencies">

                                        @foreach (var a in steelAgencies)
                                        {
                                            string agencyValue =
                                                string.IsNullOrWhiteSpace(a.AgencyName)
                                                    ? string.Empty
                                                    : a.AgencyName.Trim();

                                            bool isSelected =
                                                selectedSteelAgencies.Any(
                                                    x => string.Equals(
                                                        x,
                                                        agencyValue,
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                );

                                            <option value="@agencyValue"
                                                    data-code="@a.AgencyCode"
                                                    data-department="@a.Area"
                                                    data-delaytype="@a.DelayType"
                                                    @(isSelected ? "selected" : "")>
                                                @a.AgencyName
                                            </option>
                                        }

                                    </select>

                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">

                                    <label for="steelDelayType">
                                        Delay Type
                                    </label>

                                    <select id="steelDelayType"
                                            name="steelDelayType"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select delay types">

                                        <option value="Scheduled"
                                                @(selectedSteelDelayTypes.Any(x => string.Equals(x, "Scheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Scheduled
                                        </option>

                                        <option value="Unscheduled"
                                                @(selectedSteelDelayTypes.Any(x => string.Equals(x, "Unscheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Unscheduled
                                        </option>

                                    </select>

                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="filter-actions">

                                    <button type="submit"
                                            class="btn btn-filter"
                                            title="Apply Steel Making Filters">
                                        <i class="fa fa-filter"></i>
                                        Apply
                                    </button>

                                    <a href="@Url.Action(
                                            "list",
                                            "Maintenance",
                                            new { tab = "steel" }
                                        )"
                                       class="btn btn-secondary"
                                       title="Clear Steel Making Filters">
                                        <i class="fa fa-times"></i>
                                        Clear
                                    </a>

                                    <button type="submit"
                                            class="btn btn-success"
                                            title="Download Failure Analysis"
                                            formaction="@Url.Action(
                                                    "ExportFailureAnalysisExcel",
                                                    "Maintenance"
                                                )"
                                            formmethod="get">
                                        <i class="fa fa-file-excel-o"></i>
                                        Failure Analysis Report
                                    </button>

                                </div>
                            </div>
                        </div>

                    </form>

                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">
                    <div class="card m-b-30">
                        <div class="card-body">

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover maintenance-data-table"
                                       id="steelMakingTable">

                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Area</th>
                                            <th>Plant</th>
                                            <th>Shift</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th>Total Duration</th>
                                            <th>Delay Type</th>
                                            <th>Agency</th>
                                            <th>Delay Code</th>
                                            <th>Equipment</th>
                                            <th>Description</th>
                                            <th>Failure Analysis</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (steelMakingDelays.Any())
                                        {
                                            foreach (var item in steelMakingDelays)
                                            {
                                                var gregorian =
                                                    new CultureInfo("en-US");

                                                gregorian.DateTimeFormat.Calendar =
                                                    new GregorianCalendar();

                                                bool failureAnalysisFilled =
                                                    failureAnalysisStatus.ContainsKey(item.ID) &&
                                                    failureAnalysisStatus[item.ID];

                                                <tr>
                                                    <td>
                                                        @(item.Date?.ToString(
                                                            "dd-MM-yyyy",
                                                            gregorian
                                                        ))
                                                    </td>

                                                    <td>@item.Area</td>
                                                    <td>@item.Plant</td>
                                                    <td>@item.Shift</td>
                                                    <td>@item.StartTime</td>
                                                    <td>@item.EndTime</td>
                                                    <td>@item.TotalDuration</td>
                                                    <td>@item.DelayType</td>
                                                    <td>@item.AgencyName</td>
                                                    <td>@item.Delaycode</td>
                                                    <td>@item.Equipments</td>
                                                    <td>@item.DelayDescription</td>

                                                    <td class="text-center"
                                                        data-order="@(failureAnalysisFilled ? 1 : 0)"
                                                        data-search="@(failureAnalysisFilled ? "Filled" : "Pending")">

                                                        <span class="failure-analysis-indicator @(failureAnalysisFilled ? "failure-analysis-filled" : "failure-analysis-pending")"
                                                              title="@(failureAnalysisFilled ? "Failure analysis is filled" : "Failure analysis is not filled")">

                                                            <span class="failure-analysis-light"></span>

                                                            <span>
                                                                @(failureAnalysisFilled ? "Filled" : "Pending")
                                                            </span>

                                                        </span>
                                                    </td>

                                                    <td>
                                                        <a href="@Url.Action(
                                                                "add",
                                                                "DelayCounterMeasure",
                                                                new
                                                                {
                                                                    plantDelayID = item.ID
                                                                }
                                                            )"
                                                           class="btn btn-sm btn-warning"
                                                           title="Countermeasures">

                                                            <i class="fa fa-tasks"></i>
                                                        </a>

                                                        <a href="@Url.Action(
                                                                "detail",
                                                                "Maintenance",
                                                                new
                                                                {
                                                                    ID = item.ID,
                                                                    source = "SteelMaking"
                                                                }
                                                            )"
                                                           class="btn btn-sm btn-info"
                                                           onclick="event.stopPropagation();"
                                                           title="Detail">

                                                            <i class="mdi mdi-book-open-page-variant"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>

                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!-- =====================================================
             ROLLING MILL TAB
             ===================================================== -->
        <div class="tab-pane fade @(activeTab == "rolling" ? "show active" : "") maintenance-tab-pane"
             id="rolling-mill-pane"
             role="tabpanel"
             aria-labelledby="rolling-mill-tab">

            <!-- ROLLING MILL FILTERS -->
            <div class="card maintenance-filter-card mb-3">
                <div class="card-body">

                    <form id="rollingFilterForm"
                          method="get"
                          action="@Url.Action("list", "Maintenance")">

                        <input type="hidden"
                               name="tab"
                               value="rolling" />

                        <div class="row align-items-end">

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="rollingFromDate">
                                        From Date
                                    </label>

                                    <input type="date"
                                           id="rollingFromDate"
                                           name="rollingFromDate"
                                           class="form-control"
                                           value="@rollingFromDateValue" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="rollingToDate">
                                        To Date
                                    </label>

                                    <input type="date"
                                           id="rollingToDate"
                                           name="rollingToDate"
                                           class="form-control"
                                           value="@rollingToDateValue" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group filter-select-group">

                                    <label for="rollingPlant">
                                        Plant
                                    </label>

                                    <select id="rollingPlant"
                                            name="rollingPlant"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select Rolling Mill">

                                        <option value="Rolling Mill 1"
                                                @(selectedRollingPlants.Any(x => string.Equals(x, "Rolling Mill 1", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Rolling Mill 1
                                        </option>

                                        <option value="Rolling Mill 2"
                                                @(selectedRollingPlants.Any(x => string.Equals(x, "Rolling Mill 2", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Rolling Mill 2
                                        </option>

                                    </select>

                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">

                                    <label for="rollingAgency">
                                        Agency
                                    </label>

                                    <select id="rollingAgency"
                                            name="rollingAgency"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select agencies">

                                        @foreach (var a in rollingAgencies)
                                        {
                                            string agencyValue =
                                                string.IsNullOrWhiteSpace(a.AgencyName)
                                                    ? string.Empty
                                                    : a.AgencyName.Trim();

                                            bool isSelected =
                                                selectedRollingAgencies.Any(
                                                    x => string.Equals(
                                                        x,
                                                        agencyValue,
                                                        StringComparison.OrdinalIgnoreCase
                                                    )
                                                );

                                            <option value="@agencyValue"
                                                    data-code="@a.AgencyCode"
                                                    data-department="@a.Area"
                                                    data-delaytype="@a.DelayType"
                                                    @(isSelected ? "selected" : "")>
                                                @a.AgencyName
                                            </option>
                                        }

                                    </select>

                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">

                                    <label for="rollingDelayType">
                                        Delay Type
                                    </label>

                                    <select id="rollingDelayType"
                                            name="rollingDelayType"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select delay types">

                                        <option value="Scheduled"
                                                @(selectedRollingDelayTypes.Any(x => string.Equals(x, "Scheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Scheduled
                                        </option>

                                        <option value="Unscheduled"
                                                @(selectedRollingDelayTypes.Any(x => string.Equals(x, "Unscheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Unscheduled
                                        </option>

                                    </select>

                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="filter-actions">

                                    <button type="submit"
                                            class="btn btn-filter"
                                            title="Apply Rolling Mill Filters">
                                        <i class="fa fa-filter"></i>
                                        Apply
                                    </button>

                                    <a href="@Url.Action(
                                            "list",
                                            "Maintenance",
                                            new { tab = "rolling" }
                                        )"
                                       class="btn btn-secondary"
                                       title="Clear Rolling Mill Filters">
                                        <i class="fa fa-times"></i>
                                        Clear
                                    </a>

                                    <button type="submit"
                                            class="btn btn-success"
                                            title="Download Failure Analysis"
                                            formaction="@Url.Action(
                                                    "ExportFailureAnalysisExcel",
                                                    "Maintenance"
                                                )"
                                            formmethod="get">
                                        <i class="fa fa-file-excel-o"></i>
                                        Failure Analysis Report
                                    </button>

                                </div>
                            </div>
                        </div>

                    </form>

                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">
                    <div class="card m-b-30">
                        <div class="card-body">

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover maintenance-data-table"
                                       id="rollingMillTable">

                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Area</th>
                                            <th>Plant</th>
                                            <th>Shift</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th>Total Duration</th>
                                            <th>Delay Type</th>
                                            <th>Agency</th>
                                            <th>Delay Code</th>
                                            <th>Equipment</th>
                                            <th>Description</th>
                                            <th>Failure Analysis</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (rollingMillDelays.Any())
                                        {
                                            foreach (var item in rollingMillDelays)
                                            {
                                                var gregorian =
                                                    new CultureInfo("en-US");

                                                gregorian.DateTimeFormat.Calendar =
                                                    new GregorianCalendar();

                                                bool failureAnalysisFilled =
                                                    failureAnalysisStatus.ContainsKey(item.ID) &&
                                                    failureAnalysisStatus[item.ID];

                                                <tr>
                                                    <td>
                                                        @(item.Date?.ToString(
                                                            "dd-MM-yyyy",
                                                            gregorian
                                                        ))
                                                    </td>

                                                    <td>@item.Area</td>
                                                    <td>@item.Plant</td>
                                                    <td>@item.Shift</td>
                                                    <td>@item.StartTime</td>
                                                    <td>@item.EndTime</td>
                                                    <td>@item.TotalDuration</td>
                                                    <td>@item.DelayType</td>
                                                    <td>@item.AgencyName</td>
                                                    <td>@item.Delaycode</td>
                                                    <td>@item.Equipments</td>
                                                    <td>@item.DelayDescription</td>

                                                    <td class="text-center"
                                                        data-order="@(failureAnalysisFilled ? 1 : 0)"
                                                        data-search="@(failureAnalysisFilled ? "Filled" : "Pending")">

                                                        <span class="failure-analysis-indicator @(failureAnalysisFilled ? "failure-analysis-filled" : "failure-analysis-pending")"
                                                              title="@(failureAnalysisFilled ? "Failure analysis is filled" : "Failure analysis is not filled")">

                                                            <span class="failure-analysis-light"></span>

                                                            <span>
                                                                @(failureAnalysisFilled ? "Filled" : "Pending")
                                                            </span>

                                                        </span>
                                                    </td>

                                                    <td>
                                                        <a href="@Url.Action(
                                                                "add",
                                                                "DelayCounterMeasure",
                                                                new
                                                                {
                                                                    plantDelayID = item.ID
                                                                }
                                                            )"
                                                           class="btn btn-sm btn-warning"
                                                           title="Countermeasures">

                                                            <i class="fa fa-tasks"></i>
                                                        </a>

                                                        <a href="@Url.Action(
                                                                "detail",
                                                                "Maintenance",
                                                                new
                                                                {
                                                                    ID = item.ID,
                                                                    source = "RollingMill"
                                                                }
                                                            )"
                                                           class="btn btn-sm btn-info"
                                                           onclick="event.stopPropagation();"
                                                           title="Detail">

                                                            <i class="mdi mdi-book-open-page-variant"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>

                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
<!-- End XP Contentbar -->
<script src="@Url.Content("~/assets/plugins/select2/select2.min.js")"></script>
<script>
    $(document).ready(function () {

        $(".multi-select").each(function () {
            var $select = $(this);

            $select.select2({
                width: "100%",
                closeOnSelect: false,
                allowClear: true,
                placeholder:
                    $select.data("placeholder") ||
                    "Select options"
            });
        });

        // ==============================
        // DATATABLE INIT - BOTH TABS
        // ==============================
        function initMaintenanceTable(
            selector,
            exportTitle
        ) {
            if ($.fn.DataTable.isDataTable(selector)) {
                $(selector).DataTable().destroy();
            }

            $(selector).DataTable({
                pageLength: 10,
                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "All"]
                ],
                ordering: true,
                searching: true,
                responsive: true,
                autoWidth: false,
                order: [[0, "desc"]],
                dom: "Bfrtip",
                buttons: [
                    {
                        extend: "excelHtml5",
                        text: "Export Excel",
                        className: "btn btn-success btn-sm",
                        title: exportTitle
                    },
                    {
                        extend: "pdfHtml5",
                        text: "Export PDF",
                        className: "btn btn-danger btn-sm",
                        title: exportTitle,
                        orientation: "landscape",
                        pageSize: "A4",
                        exportOptions: {
                            columns: ":not(:last-child)"
                        }
                    },
                    {
                        extend: "print",
                        text: "Print",
                        className: "btn btn-secondary btn-sm",
                        title: exportTitle,
                        exportOptions: {
                            columns: ":not(:last-child)"
                        }
                    }
                ],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ records",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    emptyTable: "No data available"
                }
            });
        }

        initMaintenanceTable(
            "#steelMakingTable",
            "Steel Making Maintenance Record"
        );

        initMaintenanceTable(
            "#rollingMillTable",
            "Rolling Mill Maintenance Record"
        );


        // Adjust DataTables when a tab becomes visible.
        $('#maintenanceTabs a[data-toggle="tab"]').on(
            'shown.bs.tab',
            function () {

                $.fn.dataTable
                    .tables({
                        visible: true,
                        api: true
                    })
                    .columns
                    .adjust();
            }
        );



    });
</script>