@using System.Globalization
@{
    ViewBag.Title = "list";
    var delay = Model as List<DAL.Models.PlantDelayBLL>;
}
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Failure Analysis</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CMD Maintenance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Maintenance Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm"
                          method="get"
                          action="@Url.Action("list", "Maintenance")">

                        <div class="row align-items-end">

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="fromDate">From Date</label>

                                    <input type="date"
                                           id="fromDate"
                                           name="fromDate"
                                           class="form-control"
                                           value="@ViewBag.FromDate" />
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="toDate">To Date</label>

                                    <input type="date"
                                           id="toDate"
                                           name="toDate"
                                           class="form-control"
                                           value="@ViewBag.ToDate" />
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="plant">Plant</label>

                                    <select id="plant"
                                            name="plant"
                                            class="form-control">

                                        <option value=""
                                                @(string.IsNullOrWhiteSpace(ViewBag.Plant as string) ? "selected" : "")>
                                            All Plants
                                        </option>

                                        <option value="Rolling Mill 1"
                                                @((ViewBag.Plant as string) == "Rolling Mill 1" ? "selected" : "")>
                                            Rolling Mill 1
                                        </option>

                                        <option value="Rolling Mill 2"
                                                @((ViewBag.Plant as string) == "Rolling Mill 2" ? "selected" : "")>
                                            Rolling Mill 2
                                        </option>

                                        <option value="EAF"
                                                @((ViewBag.Plant as string) == "EAF" ? "selected" : "")>
                                            EAF
                                        </option>

                                        <option value="LF"
                                                @((ViewBag.Plant as string) == "LF" ? "selected" : "")>
                                            LF
                                        </option>

                                        <option value="CCM"
                                                @((ViewBag.Plant as string) == "CCM" ? "selected" : "")>
                                            CCM
                                        </option>

                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <button type="submit"
                                            class="btn btn-primary mr-2">
                                        <i class="fa fa-filter"></i>
                                        Filter
                                    </button>

                                    <a href="@Url.Action("list", "Maintenance")"
                                       class="btn btn-secondary">
                                        <i class="fa fa-times"></i>
                                        Clear
                                    </a>
                                </div>
                            </div>

                        </div>

                    </form>
