@using System.Globalization
@{
    ViewBag.Title = "list";

    var delay =
        Model as List<DAL.Models.PlantDelayBLL>;

    string selectedDelayType =
        string.IsNullOrWhiteSpace(
            Convert.ToString(ViewBag.DelayType)
        )
            ? "Unscheduled"
            : Convert.ToString(ViewBag.DelayType);

    string selectedAgency =
        Convert.ToString(ViewBag.Agency);
}
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Failure Analysis</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CMD Maintenance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Maintenance Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<style>
    .maintenance-filter-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .06);
    }

        .maintenance-filter-card label {
            color: #4b5563;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

    .delay-type-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        min-height: 40px;
        padding: 5px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #f9fafb;
    }

    .delay-radio {
        position: relative;
        margin: 0;
    }

        .delay-radio input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .delay-radio label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 92px;
            min-height: 30px;
            margin: 0;
            padding: 6px 12px;
            border: 1px solid #d1d5db;
            border-radius: 20px;
            background: #ffffff;
            color: #4b5563;
            cursor: pointer;
            font-size: 10px;
            font-weight: 800;
            text-transform: none;
            letter-spacing: 0;
            transition: all .18s ease;
        }

        .delay-radio input:checked + label {
            border-color: #a6173f;
            background: #a6173f;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(166, 23, 63, .18);
        }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
    }

    .btn-filter {
        border-color: #a6173f;
        background: #a6173f;
        color: #ffffff;
        font-weight: 700;
    }

        .btn-filter:hover,
        .btn-filter:focus {
            border-color: #7f1230;
            background: #7f1230;
            color: #ffffff;
        }

    @@media(max-width: 767px) {
        .filter-actions {
            margin-top: 8px;
        }

        .delay-radio label {
            min-width: 82px;
        }
    }
</style>

<div class="xp-breadcrumbbar"
     style="padding: 35px 30px 0 30px;">

    <div class="row">
        <div class="col-lg-12">

            <div class="card maintenance-filter-card mb-3">
                <div class="card-body">

                    <form id="filterForm"
                          method="get"
                          action="@Url.Action("list", "Maintenance")">

                        <div class="row align-items-end">

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="fromDate">
                                        From Date
                                    </label>

                                    <input type="date"
                                           id="fromDate"
                                           name="fromDate"
                                           class="form-control"
                                           value="@ViewBag.FromDate" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="toDate">
                                        To Date
                                    </label>

                                    <input type="date"
                                           id="toDate"
                                           name="toDate"
                                           class="form-control"
                                           value="@ViewBag.ToDate" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="plant">
                                        Plant
                                    </label>

                                    <select id="plant"
                                            name="plant"
                                            class="form-control">

                                        <option value=""
                                                @(string.IsNullOrWhiteSpace(ViewBag.Plant as string) ? "selected" : "")>
                                            All Plants
                                        </option>

                                        <option value="Rolling Mill 1"
                                                @((ViewBag.Plant as string) == "Rolling Mill 1" ? "selected" : "")>
                                            Rolling Mill 1
                                        </option>

                                        <option value="Rolling Mill 2"
                                                @((ViewBag.Plant as string) == "Rolling Mill 2" ? "selected" : "")>
                                            Rolling Mill 2
                                        </option>

                                        <option value="EAF"
                                                @((ViewBag.Plant as string) == "EAF" ? "selected" : "")>
                                            EAF
                                        </option>

                                        <option value="LF"
                                                @((ViewBag.Plant as string) == "LF" ? "selected" : "")>
                                            LF
                                        </option>

                                        <option value="CCM"
                                                @((ViewBag.Plant as string) == "CCM" ? "selected" : "")>
                                            CCM
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="agency">
                                        Agency
                                    </label>

                                    <select id="agency"
                                            name="agency"
                                            class="form-control">

                                        <option value=""
                                                @(string.IsNullOrWhiteSpace(selectedAgency) ? "selected" : "")>
                                            All Agencies
                                        </option>

                                        <option value="Electrical"
                                                @(selectedAgency == "Electrical" ? "selected" : "")>
                                            Electrical
                                        </option>

                                        <option value="Mechanical"
                                                @(selectedAgency == "Mechanical" ? "selected" : "")>
                                            Mechanical
                                        </option>

                                        <option value="Utility"
                                                @(selectedAgency == "Utility" ? "selected" : "")>
                                            Utility
                                        </option>

                                        <option value="Cranes"
                                                @(selectedAgency == "Cranes" ? "selected" : "")>
                                            Cranes
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-8">
                                <div class="form-group">
                                    <label>
                                        Delay Type
                                    </label>

                                    <div class="delay-type-filter">

                                        <div class="delay-radio">
                                            <input type="radio"
                                                   id="delayScheduled"
                                                   name="delayType"
                                                   value="Scheduled"
                                                   @(selectedDelayType.Equals("Scheduled", StringComparison.OrdinalIgnoreCase) ? "checked" : "") />

                                            <label for="delayScheduled">
                                                Scheduled
                                            </label>
                                        </div>

                                        <div class="delay-radio">
                                            <input type="radio"
                                                   id="delayUnscheduled"
                                                   name="delayType"
                                                   value="Unscheduled"
                                                   @(selectedDelayType.Equals("Unscheduled", StringComparison.OrdinalIgnoreCase) ? "checked" : "") />

                                            <label for="delayUnscheduled">
                                                Unscheduled
                                            </label>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-4 col-md-4">
                                <div class="form-group">
                                    <div class="filter-actions">

                                        <button type="submit"
                                                class="btn btn-filter"
                                                title="Apply Filters">
                                            <i class="fa fa-filter"></i>
                                        </button>

                                        <a href="@Url.Action(
                                            "list",
                                            "Maintenance"
                                        )"
                                           class="btn btn-secondary"
                                           title="Clear Filters">
                                            <i class="fa fa-times"></i>
                                        </a>

                                        <button type="submit"
                                                class="btn btn-success"
                                                title="Download Failure Analysis"
                                                formaction="@Url.Action(
                                                    "ExportFailureAnalysisExcel",
                                                    "Maintenance"
                                                )"
                                                formmethod="get">
                                            <i class="fa fa-file-excel-o"></i>
                                            Failure Analysis Report
                                        </button>

                                    </div>
                                </div>
                            </div>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="maintenanceTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Shift</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Total Duration</th>
                                    <th>Delay Type</th>
                                    <th>Agency</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Description</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (delay != null && delay.Any())
                                {
                                    foreach (var item in delay)
                                    {
                                        var gregorian = new CultureInfo("en-US");
                                        gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

                                        <tr>
                                            <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                            <td>@item.Area</td>
                                            <td>@item.Shift</td>
                                            <td>@item.StartTime</td>
                                            <td>@item.EndTime</td>
                                            <td>@item.TotalDuration</td>
                                            <td>@item.DelayType</td>
                                            <td>@item.AgencyName</td>
                                            <td>@item.Delaycode</td>
                                            <td>@item.Equipments</td>
                                            <td>@item.DelayDescription</td>
                                            <td>
                                                <a href="@Url.Action(
                                                        "add",
                                                        "DelayCounterMeasure",
                                                        new
                                                        {
                                                            plantDelayID = item.ID
                                                        }
                                                    )"
                                                   class="btn btn-sm btn-warning"
                                                   title="Countermeasures">

                                                    <i class="fa fa-tasks"></i>
                                                </a>
                                                @*<a href="javascript:void(0);"
                                                   class="btn btn-sm btn-danger btn-delete"
                                                   data-id="@item.ID">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </a>*@
                                                <a href="@Url.Action("detail", "Maintenance", new { ID = item.ID })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="12" class="text-center text-muted font-italic">
                                            No data available
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $(document).ready(function () {

        // ==============================
        // DATATABLE INIT
        // ==============================
        if ($.fn.DataTable.isDataTable("#maintenanceTable")) {
            $("#maintenanceTable").DataTable().destroy();
        }

        $("#maintenanceTable").DataTable({
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            ordering: true,
            searching: true,
            responsive: true,
            autoWidth: false,
            order: [[0, "desc"]],
            dom: "Bfrtip",
            buttons: [
                {
                    extend: "excelHtml5",
                    text: "Export Excel",
                    className: "btn btn-success btn-sm",
                    title: "Maintenance Record"
                },
                {
                    extend: "pdfHtml5",
                    text: "Export PDF",
                    className: "btn btn-danger btn-sm",
                    title: "Maintenance Record",
                    orientation: "landscape",
                    pageSize: "A4",
                    exportOptions: {
                        columns: ":not(:last-child)"
                    }
                },
                {
                    extend: "print",
                    text: "Print",
                    className: "btn btn-secondary btn-sm",
                    title: "Maintenance Record",
                    exportOptions: {
                        columns: ":not(:last-child)"
                    }
                }
            ],
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ records",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No data available"
            }
        });

        // ==============================
        // CUSTOM EXPORT PDF BUTTON
        // ==============================
        $("#exportPdf").on("click", function () {
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            if (!fromDate) {
                alert("Please select From Date");
                return;
            }

            if (!toDate) {
                alert("Please select To Date");
                return;
            }

            var url = '@Url.Action("ExportMaintenancePdf", "Maintenance")'
                + '?fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate);

            window.open(url, "_blank");
        });

    });
</script>