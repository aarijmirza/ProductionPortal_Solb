@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ================= BREADCRUMB ================= -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">Rolling Mill</h4>
        </div>
        <div class="col-md-6">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">Rolling Mill Plant</li>
                <li class="breadcrumb-item active">Reports</li>
            </ol>
        </div>
    </div>
</div>

<!-- ================= FILTER SECTION ================= -->
<div class="xp-contentbar">
    <div class="card mb-3">
        <div class="card-body">

            <div class="row align-items-end">

                <div class="col-md-3">
                    <label>From Date</label>
                    <input type="date" id="fromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>To Date</label>
                    <input type="date" id="toDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <button class="btn btn-primary mt-4" id="applyFilter">
                        Apply Filter
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- ================= REPORT CARDS ================= -->
    <div class="row">

        <!-- Shift Production -->
        <div class="col-md-3">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Shift Production Report</h5>
                    <button class="btn btn-primary openReport"
                            data-url="@Url.Action("ShiftProductionReport", "Reporting")">
                        View Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Monthly -->
        <div class="col-md-3">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Monthly Performance</h5>
                    <button class="btn btn-primary openReport"
                            data-url="@Url.Action("RMMonthlyPerformanceReport", "Reporting")">
                        View Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Daily -->
        <div class="col-md-3">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Daily Production</h5>
                    <button class="btn btn-primary openReport"
                            data-url="@Url.Action("DailyProductionRM", "Reporting")">
                        View Report
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ================= SCRIPTS ================= -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        // ✅ Default = Today
        var today = new Date().toISOString().split('T')[0];
        $("#fromDate").val(today);
        $("#toDate").val(today);

        // 🔥 Apply filter button (optional)
        $("#applyFilter").click(function () {

            if (!$("#fromDate").val() || !$("#toDate").val()) {
                alert("Please select dates");
                return;
            }

            alert("Filter applied. Now click any report.");
        });

        // 🔥 Open report with filters
        $(document).on("click", ".openReport", function () {

            var from = $("#fromDate").val();
            var to = $("#toDate").val();

            if (!from || !to) {
                alert("Please select From & To dates");
                return;
            }

            var baseUrl = $(this).data("url");

            var finalUrl = baseUrl
                + "?from=" + encodeURIComponent(from)
                + "&to=" + encodeURIComponent(to);

            window.open(finalUrl, "_blank");
        });

    });
</script>