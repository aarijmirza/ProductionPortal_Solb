@using System.Globalization
@{
    ViewBag.Title = "list";
    var delay = Model as List<DAL.Models.PlantDelayBLL>;
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delays</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="fromDate" class="mr-2">From</label>
                                <input type="date" id="fromDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="toDate" class="mr-2">To</label>
                                <input type="date" id="toDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="shiftFilter">Shift</label>
                                <select id="shiftFilter" class="form-control">
                                    <option value="">All</option>
                                    <option value="Morning">Morning</option>
                                    <option value="Evening">Evening</option>
                                    <option value="Night">Night</option>
                                </select>
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("add", "Delay")">
                                    <i class="fa fa-plus-circle"></i> Add Delay
                                </a>
                            </div>
                            <div class="form-group d-flex align-items-end">
                                @*<button type="button" id="exportExcel" class="btn btn-success mr-2">
                                        <i class="fa fa-file-excel-o"></i> Export Excel
                                    </button>*@
                                <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                    <i class="fa fa-file-pdf-o"></i> Export PDF
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="delayListTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Shift</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Total Duration</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Reason</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (delay != null)
                                {
                                    foreach (var item in delay)
                                    {
                                        var gregorian = new CultureInfo("en-US");
                                        gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

                                        <tr>
                                            <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                            <td>@item.Area</td>
                                            <td>@item.Shift</td>
                                            <td>@item.StartTime</td>
                                            <td>@item.EndTime</td>
                                            <td>@item.TotalDuration</td>
                                            <td>@item.AgencyName</td>
                                            <td>@item.Equipments</td>
                                            <td>@item.Reason</td>
                                            <td>
                                                <a href="@Url.Action("details", "CCM", new { ID = item.ID })"
                                                   class="btn btn-sm btn-info"
                                                   onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i>
                                                </a>

                                                <a href="javascript:void(0);"
                                                   onclick="confirmDelete('@item.ID')"
                                                   class="btn btn-sm btn-danger">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted font-italic">
                                            No data available
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="xp-contentbar">
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body p-3">
                    <h6 class="mb-1">Total Records</h6>
                    <h4 class="mb-0" id="totalRecordCount">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body p-3">
                    <h6 class="mb-1">Total Delay Time</h6>
                    <h4 class="mb-0" id="totalDelayTime">0 min</h4>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    var table;

    $(document).ready(function () {

        table = $('#delayListTable').DataTable();

        var today = new Date();

        function formatDate(d) {
            return d.toISOString().split('T')[0];
        }

        $('#fromDate').val(formatDate(today));
        $('#toDate').val(formatDate(today));

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            var from = $('#fromDate').val();
            var to = $('#toDate').val();
            var shift = $('#shiftFilter').val();

            var rowDate = parseDMY(data[0]);
            var rowArea = data[1];
            var rowShift = data[2];

            if (rowArea !== "Rolling Mill")
                return false;

            if (shift && rowShift !== shift)
                return false;

            if (from) {
                var fromDate = new Date(from);
                fromDate.setHours(0, 0, 0, 0);
                if (rowDate < fromDate) return false;
            }

            if (to) {
                var toDate = new Date(to);
                toDate.setHours(23, 59, 59, 999);
                if (rowDate > toDate) return false;
            }

            return true;
        });

        table.draw();
        updateSummary();

        $('#filterBtn').click(function () {
            table.draw();
        });

        $('#clearBtn').click(function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            $('#shiftFilter').val('');
            table.draw();
        });

        table.on('draw', function () {
            updateSummary();
        });
    });

    function updateSummary() {
        if (!table) return;

        var filteredData = table.rows({ search: 'applied' }).data();
        var totalRecords = filteredData.length;
        var totalDuration = 0;

        for (var i = 0; i < filteredData.length; i++) {
            var row = filteredData[i];
            var durationText = $('<div>').html(row[5]).text().trim();
            totalDuration += parseDurationToMinutes(durationText);
        }

        $('#totalRecordCount').text(totalRecords);
        $('#totalDelayTime').text(formatMinutes(totalDuration));
    }

    function parseDurationToMinutes(value) {
        if (!value) return 0;

        value = value.toString().trim();

        if (/^\d+(\.\d+)?$/.test(value)) {
            return parseFloat(value);
        }

        if (value.indexOf(':') > -1) {
            var parts = value.split(':').map(Number);

            if (parts.length === 3) {
                return (parts[0] * 60) + parts[1] + (parts[2] / 60);
            }

            if (parts.length === 2) {
                return (parts[0] * 60) + parts[1];
            }
        }

        return 0;
    }

    function formatMinutes(totalMinutes) {
        totalMinutes = Math.round(totalMinutes);

        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;

        if (hours > 0) {
            return hours + 'h ' + minutes + 'm';
        }

        return minutes + ' min';
    }

    function parseDMY(dateStr) {
        var parts = dateStr.split('-');
        return new Date(parts[2], parts[1] - 1, parts[0], 0, 0, 0);
    }
</script>

<script>

    $(document).ready(function () {

        var table = $('#delayListTable').DataTable();

        // 🔹 Set default dates = TODAY
        var today = new Date();

        function formatDate(d) {
            return d.toISOString().split('T')[0];
        }

        $('#fromDate').val(formatDate(today));
        $('#toDate').val(formatDate(today));

        // 🔹 Custom filter
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            var from = $('#fromDate').val();
            var to = $('#toDate').val();
            var shift = $('#shiftFilter').val();

            var rowDate = parseDMY(data[0]);   // Date column
            var rowArea = data[1];             // Area column
            var rowShift = data[2];            // ⚠️ Shift column index

            // ONLY Rolling Mill
            if (rowArea !== "Rolling Mill")
                return false;

            // SHIFT FILTER
            if (shift && rowShift !== shift)
                return false;

            // FROM DATE
            if (from) {
                var fromDate = new Date(from);
                fromDate.setHours(0, 0, 0, 0);
                if (rowDate < fromDate) return false;
            }

            // TO DATE
            if (to) {
                var toDate = new Date(to);
                toDate.setHours(23, 59, 59, 999);
                if (rowDate > toDate) return false;
            }

            return true;
        });

        // 🔹 Apply filter immediately on page load
        table.draw();

        // 🔹 Filter button
        $('#filterBtn').click(function () {
            table.draw();
            updateTotalCount();
        });

        // 🔹 Clear button
        $('#clearBtn').click(function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            $('#shiftFilter').val('');
            table.draw();
            updateTotalCount();
        });

    });

    function updateTotalCount() {
        var count = table.rows({ filter: 'applied' }).count();
        $('#totalRecordCount').text(count);
    }

    // Helper: dd-MM-yyyy → Date
    function parseDMY(dateStr) {
        var parts = dateStr.split('-');
        return new Date(parts[2], parts[1] - 1, parts[0], 0, 0, 0);
    }

    var exportPDFUrl = '@Url.Action("GenerateDelayReportPDF", "RollingMill")';

    $('#exportPdf').click(function () {

        var from = $('#fromDate').val() || '';
        var to = $('#toDate').val() || '';
        var shift = $('#shiftFilter').val() || '';

        var url = exportPDFUrl
            + '?startdate=' + encodeURIComponent(from)
            + '&enddate=' + encodeURIComponent(to)
            + '&shift=' + encodeURIComponent(shift);
        window.open(url, '_blank');
        //window.location.href = url;
    });
</script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
$(document).ready(function () {

    var successMsg = '@TempData["SuccessMessage"]';
    var errorMsg   = '@TempData["ErrorMessage"]';

    if (successMsg) {
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: successMsg,
            confirmButtonColor: '#3085d6'
        });
    }
    else if (errorMsg) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: errorMsg,
            confirmButtonColor: '#d33'
        });
    }

    function confirmDelete(ID) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/delay/delete?ID=' + ID;
            }
        });
    }

});
</script>