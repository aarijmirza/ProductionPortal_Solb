@model DAL.Models.DelaysVM
@using System.Linq
@{
    ViewBag.Title = ViewBag.IsEdit == true ? "Edit Delay" : "Add Delay";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        ViewBag.IsEdit == true;

    var equipmentItems =
        ViewBag.EquipmentItems as
            IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}


@*Start XP Breadcrumbbar*@
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record Form</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delay</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                        @(isEdit ? "Edit Record" : "Add Record")
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>
@*End XP Breadcrumbbar*@

<div class="xp-contentbar">
    @using (Html.BeginForm(
        "add",
        "Delay",
        FormMethod.Post,
        new
        {
            id = "addprofileform"
        }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ID)

        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" class="btn btn-primary">
                            @(isEdit ? "Update Delay" : "Save Delay")
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="form-row mb-4" hidden>
                            <div class="form-group col-md-3">
                                <div class="custom-control custom-radio">
                                    <input class="custom-control-input plant-radio" type="radio" id="radio2" name="Area" value="Rolling Mill" hidden checked>
                                    <label class="custom-control-label" for="radio2">Rolling Mill</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label>Date</label>
                                @Html.TextBoxFor(
                                                                  m => m.Date,
                                                                  "{0:yyyy-MM-dd}",
                                                                  new
                                                                  {
                                                                      @class = "form-control",
                                                                      type = "date",
                                                                      id = "date",
                                                                      required = "required"
                                                                  }
                                                              )
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Plant</label>
                                @Html.DropDownListFor(m => m.Plant, new List<SelectListItem>
                                                                                                                                {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Rolling Mill 1", Value = "Rolling Mill 1" },
                                    new SelectListItem { Text = "Rolling Mill 2", Value = "Rolling Mill 2" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Shift</label>
                                @Html.DropDownListFor(m => m.Shift, new List<SelectListItem>
                                                                                                                                {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Morning", Value = "Morning" },
                                    new SelectListItem { Text = "Afternoon", Value = "Evening" },
                                    new SelectListItem { Text = "Night", Value = "Night" },
                                    new SelectListItem { Text = "Long Morning", Value = "Long Morning" },
                                    new SelectListItem { Text = "Long Night", Value = "Long Night" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Team</label>
                                @Html.DropDownListFor(m => m.Team, new List<SelectListItem>
                                                                                                                                {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Team A", Value = "Team A" },
                                    new SelectListItem { Text = "Team B", Value = "Team B" },
                                    new SelectListItem { Text = "Team C", Value = "Team C" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Shift Incharge</label>
                                @Html.DropDownListFor(m => m.ShiftIncharge, new List<SelectListItem>
                                                                                                                                {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Muhammad Ali", Value = "Muhammad Ali" },
                                    new SelectListItem { Text = "Altaf Khan", Value = "Altaf Khan" },
                                    new SelectListItem { Text = "Waseem Akram", Value = "Waseem Akram" }
                                }, new { @class = "form-control" })
                            </div>

                            <div class="form-group col-md-3">
                                <label>Cobbles</label>
                                @Html.TextBoxFor(
                                                                  m => m.Cobble,
                                                                  new
                                                                  {
                                                                      @class = "form-control",
                                                                      type = "number",
                                                                      min = "0"
                                                                  }
                                                              )
                            </div>
                            <div class="form-group col-md-3">
                                <label>Hot Out</label>
                                @Html.TextBoxFor(
                                                                  m => m.HotOut,
                                                                  new
                                                                  {
                                                                      @class = "form-control",
                                                                      type = "number",
                                                                      min = "0"
                                                                  }
                                                              )
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Agency</label>
                                <select id="AgencyDropdown"
                                        name="AgencyName"
                                        class="form-control">
                                    <option value=""
                                            data-code="">
                                        -- Select Agency --
                                    </option>

                                    @foreach (
                                        var a in
                                        (
                                            ViewBag.Agencies as
                                                IEnumerable<DAL.Models.PlantDelayBLL>
                                            ?? Enumerable.Empty<DAL.Models.PlantDelayBLL>()
                                        )
                                    )
                                    {
                                        bool selectedAgency =
                                            string.Equals(
                                                Model != null
                                                    ? Model.AgencyName
                                                    : "",
                                                a.AgencyName,
                                                StringComparison.OrdinalIgnoreCase
                                            )
                                            ||
                                            string.Equals(
                                                Model != null
                                                    ? Model.AgencyName
                                                    : "",
                                                a.AgencyCode,
                                                StringComparison.OrdinalIgnoreCase
                                            );

                                        <option value="@a.AgencyName"
                                                data-code="@a.AgencyCode"
                                                data-department="@a.Area"
                                                data-delaytype="@a.DelayType"
                                                @(selectedAgency ? "selected" : "")>
                                            @a.AgencyName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-1">
                                <label>Code</label>
                                <input type="text"
                                       id="AgencyCodeInput"
                                       class="form-control"
                                       name="AgencyCode"
                                       value=""
                                       readonly />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Start Time</label>
                                @Html.TextBox(
                                                            "StartTime",
                                                            Model != null && Model.StartTime.HasValue
                                                            ? Model.StartTime.Value.ToString(@"hh\:mm")
                                                            : "",
                                                            new
                                                            {
                                                                @class = "form-control",
                                                                type = "time",
                                                                id = "StartTime",
                                                                required = "required"
                                                            }
                                                            )
                            </div>
                            <div class="form-group col-md-3">
                                <label>End Time</label>
                                @Html.TextBox(
                                                             "EndTime",
                                                             Model != null && Model.EndTime.HasValue
                                                             ? Model.EndTime.Value.ToString(@"hh\:mm")
                                                             : "",
                                                             new
                                                             {
                                                                 @class = "form-control",
                                                                 type = "time",
                                                                 id = "EndTime",
                                                                 required = "required"
                                                             }
                                                             )
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Equipment</label>

                                <select id="ddlEquipments"
                                        name="EquipmentName"
                                        class="form-control select2">

                                    <option value="">
                                        -- Select Equipment --
                                    </option>

                                    @foreach (var equipmentItem in equipmentItems)
                                    {
                                        bool selectedEquipment =
                                            equipmentItem.Selected
                                            ||
                                            string.Equals(
                                                Model != null
                                                    ? Model.EquipmentName
                                                    : "",
                                                equipmentItem.Value,
                                                StringComparison.OrdinalIgnoreCase
                                            );

                                        <option value="@equipmentItem.Value"
                                                @(selectedEquipment ? "selected" : "")>
                                            @equipmentItem.Text
                                        </option>
                                    }

                                </select>

                                <input type="hidden"
                                       id="Equipments"
                                       name="Equipments"
                                       value="@(Model != null ? Model.EquipmentName : "")" />
                            </div>

                            <div class="form-group col-md-6">
                                <label>Component</label>
                                @Html.DropDownListFor(
                                                   model => model.Component,
                                                   ViewBag.Component as SelectList,
                                                   "-- Select Component --",
                                                   new
                                                   {
                                                       @class = "form-control select2",
                                                       id = "ddlComponents",
                                                       disabled = isEdit ? "disabled" : null
                                                   }
                                               )

                                @if (isEdit)
                                {
                                    @Html.HiddenFor(
                                                       model => model.Component,
                                                       new
                                                       {
                                                           id = "ComponentHidden"
                                                       }
                                                   )
                                }
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Reason</label>
                                @Html.TextAreaFor(
                                                                  m => m.Reason,
                                                                  1,
                                                                  1,
                                                                  new
                                                                  {
                                                                      @class = "form-control"
                                                                  }
                                                              )
                            </div>
                            <div class="form-group col-md-6">
                                <label>Delay Description</label>
                                @Html.TextAreaFor(
                                                                  m => m.DelayDescription,
                                                                  1,
                                                                  1,
                                                                  new
                                                                  {
                                                                      @class = "form-control"
                                                                  }
                                                              )
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Reason For Occurence</label>
                                @Html.TextAreaFor(
                                                                  m => m.ReasonForOccurence,
                                                                  3,
                                                                  1,
                                                                  new
                                                                  {
                                                                      @class = "form-control"
                                                                  }
                                                              )
                            </div>
                            <div class="form-group col-md-6">
                                <label>Action Taken</label>
                                @Html.TextAreaFor(
                                                                  m => m.ActionTaken,
                                                                  3,
                                                                  1,
                                                                  new
                                                                  {
                                                                      @class = "form-control"
                                                                  }
                                                              )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

@*SCRIPTS*@
<!-- 1️⃣ jQuery (ONLY ONE, no duplicates) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2️⃣ Popper (Bootstrap dependency) -->
<script src="~/assets/js/popper.min.js"></script>

<!-- 3️⃣ Bootstrap JS (THIS DEFINES `bootstrap`) -->
<script src="~/assets/js/bootstrap.min.js"></script>

<!-- 4️⃣ Bootstrap Select -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- 5️⃣ Init -->
<script>
    $(function () {
        $('.selectpicker').selectpicker();
    });
</script>

<script>
    $(document).ready(function () {

        // Add mode mein hi today's local date set karo.
        // Edit mode mein model se aane wali date preserve rahegi.
        if (!$("#date").val()) {
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, "0");
            var day = String(now.getDate()).padStart(2, "0");

            $("#date").val(
                year + "-" + month + "-" + day
            );
        }

        // Initial filter and edit-value binding on page load.
        filterAgenciesByArea();
        bindAgencyCode();

        // When Area changes (future-proof)
        $("input[name='Area']").on("change", function () {
            filterAgenciesByArea();
        });

        // Agency select hone par Agency Name aur Code dono bind honge.
        function bindAgencyCode() {
            var selectedOption =
                $("#AgencyDropdown option:selected");

            $("#AgencyCodeInput").val(
                selectedOption.data("code") || ""
            );
        }

        $("#AgencyDropdown").on(
            "change",
            bindAgencyCode
        );

        function filterAgenciesByArea() {
            var selectedDept = $("input[name='Area']:checked").val();

            $("#AgencyDropdown option").show();

            $("#AgencyDropdown option").not(":first").each(function () {
                var dept = $(this).data("department");

                if (dept !== selectedDept) {
                    $(this).hide();
                }
            });

            // Add mode mein selection clear hogi.
            // Edit mode mein existing Agency Name aur Code preserve rahenge.
            if (!@isEdit.ToString().ToLower()) {
                $("#AgencyDropdown").val("");
            }

            bindAgencyCode();
        }

        window.bindEquipment = function () {
            $("#Equipments").val(
                $("#ddlEquipments").val() || ""
            );
        };

        $("#ddlEquipments").on(
            "change",
            window.bindEquipment
        );

        window.bindEquipment();

    });
</script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault();

            window.bindEquipment();

            if (isSubmitting) {
                return;
            }

            Swal.fire({
                title: 'Confirm Submission',
                text: '@(isEdit
                    ? "Are you sure you want to update this Delay Record?"
                    : "Are you sure you want to save this Delay Record?")',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '@(isEdit ? "Yes, Update" : "Yes, Save")',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>