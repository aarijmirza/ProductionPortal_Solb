@model DAL.Models.QCLimeReactivityReportBLL
@using System.Linq

@{
    ViewBag.Title = "Lime Reactivity Report Details";
}

<style>
    .detail-card {
        border: 1px solid #e8edf3;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .detail-header {
        background: #f8f9fb;
        border-bottom: 1px solid #e8edf3;
        padding: 15px 20px;
        font-weight: 600;
        font-size: 18px;
    }

    .detail-label {
        font-size: 12px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .detail-value {
        background: #f3f5f8;
        border: 1px solid #e8edf3;
        border-radius: 5px;
        min-height: 38px;
        padding: 9px 12px;
        font-size: 14px;
        color: #333;
        word-break: break-word;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #444;
        border-left: 4px solid #b30d0d;
        padding-left: 10px;
        margin: 20px 0 15px;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .status-accepted {
        background: #d4edda;
        color: #155724;
    }

    .status-mrb {
        background: #fff3cd;
        color: #856404;
    }

    .status-other {
        background: #e2e3e5;
        color: #383d41;
    }

    .btn-back {
        min-width: 100px;
    }

    .sample-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border: 1px solid #e8edf3;
        border-radius: 6px;
    }

    .sample-table {
        min-width: 1900px;
        margin-bottom: 0;
        background: #fff;
    }

        .sample-table thead th {
            background: #f8f9fb;
            color: #444;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            vertical-align: middle !important;
            white-space: nowrap;
        }

        .sample-table tbody td {
            font-size: 13px;
            vertical-align: middle !important;
            white-space: nowrap;
            text-align: center;
        }

            .sample-table tbody td.text-left {
                text-align: left;
            }

    .empty-row {
        text-align: center !important;
        color: #888;
        padding: 25px !important;
    }

    .remarks-box {
        min-height: 75px;
        white-space: pre-wrap;
    }

    @@media (max-width: 767px) {
        .detail-header {
            display: block !important;
        }

            .detail-header .status-badge {
                margin-top: 10px;
            }

        .detail-value {
            margin-bottom: 5px;
        }

        .detail-actions {
            text-align: left !important;
        }

            .detail-actions .btn {
                margin-bottom: 5px;
            }
    }
</style>

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Lime Reactivity Report Details</h4>
        </div>

        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("List", "Home")">
                            <i class="icon-home"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("List", "LimeReactivity")">
                            Lime Reactivity
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        Details
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (Model == null)
{
    <div class="xp-contentbar">
        <div class="alert alert-danger">
            Record not found or model is empty.
        </div>

        <a href="@Url.Action("List", "LimeReactivity")"
           class="btn btn-secondary">
            Back
        </a>
    </div>

    return;
}

<div class="xp-contentbar">

    <div class="card detail-card">

        <div class="detail-header d-flex justify-content-between align-items-center">

            <span>
                Active CaO, MgO and Lime Reactivity Test Report
                <small class="text-muted ml-2">QCF-TR-03</small>
            </span>

            @if (
                string.Equals(
                    Model.FinalStatus,
                    "Accepted",
                    System.StringComparison.OrdinalIgnoreCase
                )
            )
            {
                <span class="status-badge status-accepted">
                    Accepted
                </span>
            }
            else if (
                string.Equals(
                    Model.FinalStatus,
                    "MRB",
                    System.StringComparison.OrdinalIgnoreCase
                )
            )
            {
                <span class="status-badge status-mrb">
                    MRB
                </span>
            }
            else
            {
                <span class="status-badge status-other">
                    @(string.IsNullOrWhiteSpace(Model.FinalStatus)
                        ? "Not Set"
                        : Model.FinalStatus)
                </span>
            }

        </div>

        <div class="card-body">

            <div class="section-title">
                Report Information
            </div>

            <div class="form-row">

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Analysis Date (QC)
                    </div>

                    <div class="detail-value">
                        @(Model.AnalysisDateQC.HasValue
                            ? Model.AnalysisDateQC.Value.ToString("dd-MMM-yyyy")
                            : "-")
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Reference No.
                    </div>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.ReferenceNo)
                            ? "-"
                            : Model.ReferenceNo)
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Final Status
                    </div>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.FinalStatus)
                            ? "-"
                            : Model.FinalStatus)
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        MRB No.
                    </div>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.MRBNo)
                            ? "-"
                            : Model.MRBNo)
                    </div>
                </div>

            </div>


            <div class="section-title">
                Sample / Chemical Analysis
            </div>

            <div class="sample-table-wrap">

                <table class="table table-bordered table-condensed sample-table">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Shipment Code</th>
                            <th>Received Date</th>
                            <th>Supplier</th>
                            <th>Qty Tons</th>
                            <th>Sample No.</th>
                            <th>Active CaO %</th>
                            <th>Total CaO %</th>
                            <th>MgO %</th>
                            <th>LOI %</th>
                            <th>0 sec</th>
                            <th>30 sec</th>
                            <th>60 sec</th>
                            <th>90 sec</th>
                            <th>120 sec</th>
                            <th>150 sec</th>
                            <th>180 sec</th>
                            <th>240 sec</th>
                            <th>360 sec</th>
                            <th>600 sec</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (
                            Model.Samples != null &&
                            Model.Samples.Any()
                        )
                        {
                            foreach (var s in Model.Samples)
                            {
                                <tr>
                                    <td>@s.SrNo</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(s.ShipmentCode)
                                            ? "-"
                                            : s.ShipmentCode)
                                    </td>

                                    <td>
                                        @(s.ReceivedDate.HasValue
                                            ? s.ReceivedDate.Value.ToString("dd-MMM-yyyy")
                                            : "-")
                                    </td>

                                    <td class="text-left">
                                        @(string.IsNullOrWhiteSpace(s.Supplier)
                                            ? "-"
                                            : s.Supplier)
                                    </td>

                                    <td>
                                        @(s.QuantityTons.HasValue
                                            ? s.QuantityTons.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(s.SampleNo)
                                            ? "-"
                                            : s.SampleNo)
                                    </td>

                                    <td>
                                        @(s.ActiveCaO.HasValue
                                            ? s.ActiveCaO.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.TotalCaO.HasValue
                                            ? s.TotalCaO.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.MgO.HasValue
                                            ? s.MgO.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.LOI.HasValue
                                            ? s.LOI.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp0Sec.HasValue
                                            ? s.Temp0Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp30Sec.HasValue
                                            ? s.Temp30Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp60Sec.HasValue
                                            ? s.Temp60Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp90Sec.HasValue
                                            ? s.Temp90Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp120Sec.HasValue
                                            ? s.Temp120Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp150Sec.HasValue
                                            ? s.Temp150Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp180Sec.HasValue
                                            ? s.Temp180Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp240Sec.HasValue
                                            ? s.Temp240Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp360Sec.HasValue
                                            ? s.Temp360Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(s.Temp600Sec.HasValue
                                            ? s.Temp600Sec.Value.ToString("0.###")
                                            : "-")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(s.TestStatus)
                                            ? "-"
                                            : s.TestStatus)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="21"
                                    class="empty-row">
                                    No sample records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="section-title">
                Remarks
            </div>

            <div class="form-row">

                <div class="form-group col-md-12">

                    <div class="detail-label">
                        Remarks
                    </div>

                    <div class="detail-value remarks-box">
                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "-"
                            : Model.Remarks)
                    </div>

                </div>

            </div>


            <div class="section-title">
                System Information
            </div>

            <div class="form-row">

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Created By
                    </div>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.CreatedBy)
                            ? "-"
                            : Model.CreatedBy)
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Created Date
                    </div>

                    <div class="detail-value">
                        @(Model.CreatedDate.HasValue
                            ? Model.CreatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt")
                            : "-")
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Updated By
                    </div>

                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.UpdatedBy)
                            ? "-"
                            : Model.UpdatedBy)
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <div class="detail-label">
                        Updated Date
                    </div>

                    <div class="detail-value">
                        @(Model.UpdatedDate.HasValue
                            ? Model.UpdatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt")
                            : "-")
                    </div>
                </div>

            </div>


            <div class="text-right mt-3 detail-actions">

                <a href="@Url.Action("List", "LimeReactivity")"
                   class="btn btn-secondary btn-back">
                    Back
                </a>

                <a href="@Url.Action(
                    "Add",
                    "LimeReactivity",
                    new
                    {
                        id = Model.ID
                    }
                )"
                   class="btn btn-warning">
                    Edit
                </a>

            </div>

        </div>

    </div>

</div>
