@model IEnumerable<DAL.Models.QCLimeReactivityReportBLL>
@using System.Linq

@{
    ViewBag.Title = "Active CaO, MgO and Lime Reactivity Test Report";
}
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Active CaO, MgO and Lime Reactivity Test Report</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Active CaO, MgO and Lime Reactivity Test Report</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-8">
            @*<h3></h3>
                <small class="text-muted">QCF-TR-03</small>*@
        </div>
        <div class="col-md-4 text-right">
            <a class="btn btn-primary" href="@Url.Action("Add", "LimeReactivity")">Add New Report</a>
        </div>
    </div>
    <!-- Filters Section -->
    <div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
        <div class="row">
            <div class="col-lg-12">
                <div class="card mb-3">
                    <div class="card-body">
                        <form method="get"
                              action="@Url.Action("SMPlist", "Delay")"
                              id="filterForm"
                              class="d-flex justify-content-between">

                            <div class="d-flex">

                                @*<div class="form-group mr-3">

                                    <label for="fromDate"
                                           class="mr-2">
                                        From
                                    </label>

                                    <input type="date"
                                           id="fromDate"
                                           name="fromDate"
                                           class="form-control"
                                           value="@ViewBag.FromDate" />

                                </div>

                                <div class="form-group mr-3">

                                    <label for="toDate"
                                           class="mr-2">
                                        To
                                    </label>

                                    <input type="date"
                                           id="toDate"
                                           name="toDate"
                                           class="form-control"
                                           value="@ViewBag.ToDate" />

                                </div>

                                <div class="form-group d-flex align-items-end mr-3">

                                    <button type="submit"
                                            class="btn btn-primary mr-2">
                                        Filter
                                    </button>

                                    <a href="@Url.Action("SMPlist", "Delay")"
                                       class="btn btn-secondary">
                                        Clear
                                    </a>

                                </div>*@

                            </div>

                            <div class="d-flex justify-content-end">

                                <div class="form-group d-flex align-items-end mr-3">

                                    <a class="btn btn-info text-white"
                                       href="@Url.Action("Add", "LimeReactivity")">

                                        <i class="fa fa-plus-circle"></i>
                                        Add Record

                                    </a>

                                </div>

                                <div class="form-group d-flex align-items-end">

                                    <button type="button"
                                            id="exportPdf"
                                            class="btn btn-danger mr-2">

                                        <i class="fa fa-file-pdf-o"></i>
                                        Export PDF

                                    </button>

                                </div>

                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Filter Section -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    <!-- Start XP Contentbar -->
    <div class="xp-contentbar">
        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Analysis Date (QC)</th>
                                        <th>Reference No.</th>
                                        <th>Final Status</th>
                                        <th>MRB No.</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.ID</td>
                                                <td>@(item.AnalysisDateQC.HasValue ? item.AnalysisDateQC.Value.ToString("dd-MMM-yyyy") : "")</td>
                                                <td>@item.ReferenceNo</td>
                                                <td>@item.FinalStatus</td>
                                                <td>@item.MRBNo</td>
                                                <td style="white-space:nowrap">
                                                    <a class="btn btn-sm btn-info" href="@Url.Action("Details", "LimeReactivity", new { id = item.ID })">View</a>
                                                    <a class="btn btn-sm btn-warning" href="@Url.Action("Add", "LimeReactivity", new { id = item.ID })">Edit</a>
                                                    @using (Html.BeginForm("Delete", "LimeReactivity", FormMethod.Post, new { style = "display:inline", onsubmit = "return confirm('Delete this report?');" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.ID" />
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="text-center">No records found.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<!-- End XP Contentbar -->