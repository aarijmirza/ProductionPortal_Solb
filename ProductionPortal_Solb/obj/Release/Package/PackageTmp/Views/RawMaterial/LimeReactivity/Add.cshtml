                            <label>150 sec</label>
                            <input type="number" step="0.001" class="form-control"
                                   name="Samples[${index}].Temp150Sec" />
                        </div>

                        <div class="temp-field">
                            <label>180 sec</label>
                            <input type="number" step="0.001" class="form-control"
                                   name="Samples[${index}].Temp180Sec" />
                        </div>

                        <div class="temp-field">
                            <label>240 sec</label>
                            <input type="number" step="0.001" class="form-control"
                                   name="Samples[${index}].Temp240Sec" />
                        </div>

                        <div class="temp-field">
                            <label>360 sec</label>
                            <input type="number" step="0.001" class="form-control"
                                   name="Samples[${index}].Temp360Sec" />
                        </div>

                        <div class="temp-field">
                            <label>600 sec</label>
                            <input type="number" step="0.001" class="form-control"
                                   name="Samples[${index}].Temp600Sec" />
                        </div>

                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="form-group">
                            <label>Sample Status</label>
                            <select class="form-control"
                                    name="Samples[${index}].TestStatus">
                                <option value="">-- Select --</option>
                                <option value="Accepted">Accepted</option>
                                <option value="Rejected">Rejected</option>
                                <option value="MRB">MRB</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>
        </div>`;
        }

        addRowButton.addEventListener('click', function () {

            var index =
                sampleBody.querySelectorAll('.sample-row').length;

            sampleBody.insertAdjacentHTML(
                'beforeend',
                emptyRow(index)
            );
        });

        sampleBody.addEventListener('click', function (e) {

            var target = e.target;

            if (
                target &&
                target.classList.contains('remove-row')
            ) {
                var rows =
                    sampleBody.querySelectorAll('.sample-row');

                if (rows.length === 1) {
                    alert('At least one row is required.');
                    return;
                }

                var row =
                    target.closest('.sample-row');

                if (row) {
                    row.parentNode.removeChild(row);
                    renumber();
                }
            }
        });

        function toggleMRB() {

            var finalStatus =
                document.getElementById('FinalStatus');

            var mrbBox =
                document.getElementById('mrbBox');

            if (!finalStatus || !mrbBox) {
                return;
            }

            var isMRB =
                finalStatus.value === 'MRB';

            mrbBox.style.display =
                isMRB ? '' : 'none';
        }

        var finalStatus =
            document.getElementById('FinalStatus');

        if (finalStatus) {
            finalStatus.addEventListener(
                'change',
                toggleMRB
            );
        }

        toggleMRB();

    })();
</script>
