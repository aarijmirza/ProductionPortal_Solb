@model IEnumerable<DAL.Models.QCFerroAlloyReportBLL>
@using System.Linq

@{
    ViewBag.Title = "Ferro Alloy Analysis Reports";
    var reports = Model != null
        ? Model.ToList()
        : new List<DAL.Models.QCFerroAlloyReportBLL>();
}

<style>
    .status-badge {
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .status-accepted {
        background: #d4edda;
        color: #155724;
    }

    .status-mrb {
        background: #fff3cd;
        color: #856404;
    }

    .status-other {
        background: #e2e3e5;
        color: #383d41;
    }

    .table td,
    .table th {
        vertical-align: middle !important;
        white-space: nowrap;
    }

    @@media (max-width: 991px) {
        .filter-toolbar,
        .filter-left,
        .filter-right {
            display: block !important;
        }

        .filter-left .form-group,
        .filter-right .form-group {
            margin-right: 0 !important;
            width: 100%;
        }

        .filter-right {
            margin-top: 10px;
        }

        .filter-right .btn {
            width: 100%;
            margin-bottom: 8px;
        }
    }
</style>

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Ferro Alloy Analysis Reports</h4>
        </div>

        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="icon-home"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="#">Raw Material</a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        Ferro Alloy
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between filter-toolbar">

                        <div class="d-flex filter-left">

                            <div class="form-group mr-3">
                                <label for="filterDate">Analysis Date</label>
                                <input type="date"
                                       id="filterDate"
                                       class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="materialFilter">Material</label>

                                <select id="materialFilter"
                                        class="form-control">
                                    <option value="">All</option>
                                    <option value="Fe-Si">Fe-Si</option>
                                    <option value="Fe-Mn">Fe-Mn</option>
                                    <option value="Ca-Si">Ca-Si</option>
                                    <option value="Si-Mn">Si-Mn</option>
                                    <option value="Fe-V">Fe-V</option>
                                </select>
                            </div>

                            <div class="form-group mr-3">
                                <label for="statusFilter">Final Status</label>

                                <select id="statusFilter"
                                        class="form-control">
                                    <option value="">All</option>
                                    <option value="Accepted">Accepted</option>
                                    <option value="MRB">MRB</option>
                                </select>
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button"
                                        id="applyFilter"
                                        class="btn btn-primary mr-2">
                                    Filter
                                </button>

                                <button type="button"
                                        id="clearFilter"
                                        class="btn btn-secondary">
                                    Clear
                                </button>
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <div>
                                    <small>Total Records</small><br />
                                    <span class="badge badge-primary p-2"
                                          id="totalRecordCount">
                                        0
                                    </span>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end filter-right">
                            <div class="form-group d-flex align-items-end mr-3">

                                <a class="btn btn-info text-white"
                                   href="@Url.Action("Add", "FerroAlloy")">

                                    <i class="fa fa-plus-circle"></i>
                                    Add Ferro Alloy
                                </a>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover"
                               id="ferroAlloyListTable">

                            <thead>
                                <tr>
                                    <th>Analysis Date</th>
                                    <th>Material</th>
                                    <th>Supplier</th>
                                    <th>Quantity</th>
                                    <th>Shipment Code</th>
                                    <th>Receiving Date</th>
                                    <th>Reference No.</th>
                                    <th>Certificate No.</th>
                                    <th>Final Status</th>
                                    <th>MRB No.</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (reports.Any())
                                {
                                    foreach (var item in reports)
                                    {
                                        <tr>

                                            <td data-date="@(item.AnalysisDate.HasValue ? item.AnalysisDate.Value.ToString("yyyy-MM-dd") : "")">
                                                @(item.AnalysisDate.HasValue
                                                    ? item.AnalysisDate.Value.ToString("dd-MM-yyyy")
                                                    : "-")
                                            </td>

                                            <td>@(string.IsNullOrWhiteSpace(item.Material) ? "-" : item.Material)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Supplier) ? "-" : item.Supplier)</td>

                                            <td>
                                                @(item.Quantity.HasValue
                                                    ? item.Quantity.Value.ToString("0.###")
                                                    : "-")
                                            </td>

                                            <td>@(string.IsNullOrWhiteSpace(item.ShipmentCodeNo) ? "-" : item.ShipmentCodeNo)</td>

                                            <td>
                                                @(item.ReceivingDate.HasValue
                                                    ? item.ReceivingDate.Value.ToString("dd-MM-yyyy")
                                                    : "-")
                                            </td>

                                            <td>@(string.IsNullOrWhiteSpace(item.ReferenceNo) ? "-" : item.ReferenceNo)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.CertificateNo) ? "-" : item.CertificateNo)</td>

                                            <td>
                                                @if (string.Equals(item.FinalStatus, "Accepted", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="status-badge status-accepted">Accepted</span>
                                                }
                                                else if (string.Equals(item.FinalStatus, "MRB", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="status-badge status-mrb">MRB</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-other">
                                                        @(string.IsNullOrWhiteSpace(item.FinalStatus) ? "-" : item.FinalStatus)
                                                    </span>
                                                }
                                            </td>

                                            <td>@(string.IsNullOrWhiteSpace(item.MRBNo) ? "-" : item.MRBNo)</td>

                                            <td>
                                                <a href="@Url.Action("Details", "FerroAlloy", new { id = item.ID })"
                                                   class="btn btn-sm btn-info"
                                                   title="View Details"
                                                   onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i>
                                                </a>

                                                <a href="@Url.Action("Add", "FerroAlloy", new { id = item.ID })"
                                                   class="btn btn-sm btn-primary"
                                                   title="Edit Ferro Alloy"
                                                   onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-pencil"></i>
                                                </a>

                                                <a href="javascript:void(0);"
                                                   class="btn btn-sm btn-danger btn-delete"
                                                   data-id="@item.ID"
                                                   title="Delete Ferro Alloy">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </a>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="11"
                                            class="text-center text-muted font-italic">
                                            No data available
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>var table;

    $(document).ready(function () {

        if ($.fn.DataTable.isDataTable('#ferroAlloyListTable')) {
            table = $('#ferroAlloyListTable').DataTable();
        }
        else {
            table = $('#ferroAlloyListTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10
            });
        }

        $.fn.dataTable.ext.search.push(
            function (settings, data, dataIndex) {

                if (settings.nTable.id !== 'ferroAlloyListTable') {
                    return true;
                }

                var selectedDate = $('#filterDate').val() || '';
                var selectedMaterial = $('#materialFilter').val() || '';
                var selectedStatus = $('#statusFilter').val() || '';

                var row = table.row(dataIndex).node();

                var rowDate =
                    $(row)
                        .find('td:eq(0)')
                        .data('date')
                    || '';

                var material =
                    $('<div>')
                        .html(data[1])
                        .text()
                        .trim();

                var status =
                    $('<div>')
                        .html(data[8])
                        .text()
                        .trim();

                if (selectedDate && rowDate !== selectedDate) {
                    return false;
                }

                if (selectedMaterial && material !== selectedMaterial) {
                    return false;
                }

                if (selectedStatus && status !== selectedStatus) {
                    return false;
                }

                return true;
            }
        );

        $('#applyFilter').on('click', function () {
            table.draw();
        });

        $('#clearFilter').on('click', function () {
            $('#filterDate').val('');
            $('#materialFilter').val('');
            $('#statusFilter').val('');

            table.search('');
            table.columns().search('');
            table.draw();
        });

        updateSummary();

        table.on('draw', function () {
            updateSummary();
        });

        $(document).on('click', '.btn-delete', function (e) {

            e.preventDefault();
            e.stopPropagation();

            var id = $(this).data('id');

            Swal.fire({
                title: 'Are you sure?',
                text: 'This Ferro Alloy report will be deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            })
            .then(function (result) {

                if (result.isConfirmed) {
                    $('#deleteId').val(id);
                    $('#deleteForm').submit();
                }

            });
        });

    });

    function updateSummary() {

        if (!table) {
            return;
        }

        var totalRecords =
            table
                .rows({
                    search: 'applied'
                })
                .count();

        $('#totalRecordCount').text(totalRecords);
    }</script>

@using (
    Html.BeginForm(
        "Delete",
        "FerroAlloy",
        FormMethod.Post,
        new
        {
            id = "deleteForm",
            style = "display:none;"
        }
    )
)
{
    @Html.AntiForgeryToken()

    <input type="hidden"
           id="deleteId"
           name="id"
           value="" />
}
