    <!-- Start JS -->
    <script>
        function applyFilter() {

            var department = $("#department").val();
            var date = $("#date").val();
            var shift = $("#shift").val();

            $.ajax({
                url: '/RollingMill/SaveFilter',
                type: 'POST',
                data: {
                    Department: department,
                    Shift: shift,
                    FilterDate: date
                },
                success: function () {

                    window.location.href = "/home/dashboard";

                }
            });
        }
    </script>

