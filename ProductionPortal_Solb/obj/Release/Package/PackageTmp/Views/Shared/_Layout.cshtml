                                            </li>
                                        </ul>
                                    }
                                </li>
                            }*@
                        @if (User.IsInRole("Administrator"))
                        {
                            <li>
                                <a href="javaScript:void();">
                                    <span>SECURITY</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("KPIAdd", "Security")">SHER DETAIL</a></li>
                                    <li><a href="@Url.Action("FSadd", "Security")">FIRE SYSTEM KPI</a></li>
                                </ul>
                            </li>
