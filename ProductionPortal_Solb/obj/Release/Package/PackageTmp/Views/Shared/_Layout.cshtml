                                            <li><a href="@Url.Action("RMMonthlyPerformanceReport", "Reporting")" target="_blank">RM MONTHLY SUMMARY REPORT</a></li>
                                        }
                                    </ul>*@
                            </li>
                        }

                        @if (User.IsInRole("Administrator"))
                        {
                            <li>
                                <a href="javaScript:void();">
