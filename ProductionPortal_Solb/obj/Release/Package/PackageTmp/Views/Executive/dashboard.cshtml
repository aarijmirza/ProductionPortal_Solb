@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Executive Operations Dashboard";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --solb-maroon: #a81435;
        --solb-maroon-dark: #76001d;
        --solb-red: #c8102e;
        --solb-green: #168b5b;
        --solb-orange: #f59e0b;
        --solb-blue: #1769aa;
        --solb-navy: #183346;
        --page-bg: #edf1f5;
        --card-bg: #ffffff;
        --border: #dce2e9;
        --line: #e9edf2;
        --text: #17202d;
        --muted: #6c7687;
        --radius: 13px;
        --shadow: 0 5px 18px rgba(21, 32, 48, .07);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--page-bg);
    
        color: var(--text);
    }

    .xp-contentbar {
/*        padding: 18px !important;
*/        background: var(--page-bg) !important;
    }

    .executive-dashboard {
        width: 100%;
        max-width: 1580px;
        margin: 0 auto;
    }

    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .executive-header {
        position: relative;
        overflow: hidden;
        min-height: 120px;
        padding: 23px 25px;
        border-radius: 15px;
        background: linear-gradient( 120deg, var(--solb-maroon-dark) 0%, var(--solb-maroon) 55%, #bd2144 100% );
        color: #ffffff;
        box-shadow: var(--shadow);
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 20px;
    }

        .executive-header::after {
            content: "";
            position: absolute;
            width: 310px;
            height: 310px;
            right: -115px;
            top: -155px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

    .header-main {
        position: relative;
        z-index: 2;
    }

    .header-tag {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 10px;
        margin-bottom: 9px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.11);
        font-size: 11px;
        font-weight: 700;
    }

    .header-main h2 {
        margin: 0;
        color: #ffffff;
        font-size: 29px;
        line-height: 1.1;
        font-weight: 900;
        letter-spacing: -.3px;
    }

    .header-main p {
        margin: 8px 0 0;
        color: rgba(255,255,255,.9);
        font-size: 12px;
        font-weight: 600;
    }

    .header-side {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-meta {
        min-width: 190px;
        padding: 10px 13px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.1);
        text-align: right;
    }

        .header-meta small {
            display: block;
            color: rgba(255,255,255,.72);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .header-meta strong {
            display: block;
            margin-top: 3px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 900;
        }

    .print-btn {
        height: 42px;
        padding: 0 15px;
        border: 1px solid rgba(255,255,255,.55);
        border-radius: 9px;
        background: #ffffff;
        color: var(--solb-maroon);
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

        .print-btn i {
            margin-right: 6px;
        }

        .print-btn:hover {
            background: #f8e8ed;
        }

    /* =========================================================
       COMMON CARD
    ========================================================= */

    .dashboard-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-header {
        min-height: 48px;
        padding: 12px 15px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .card-title {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text);
        font-size: 15px;
        font-weight: 900;
    }

        .card-title i {
            color: var(--solb-maroon);
            font-size: 14px;
        }

    .card-note {
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .card-body {
        padding: 15px;
    }

    /* =========================================================
       EXECUTIVE KPI CARDS
    ========================================================= */

    .executive-kpis {
        display: grid;
        grid-template-columns: repeat(8, minmax(0, 1fr));
        gap: 11px;
        margin-top: 14px;
    }

    .executive-kpi {
        position: relative;
        min-height: 125px;
        padding: 15px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: var(--shadow);
    }

        .executive-kpi::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--solb-orange);
        }

        .executive-kpi.good::before {
            background: var(--solb-green);
        }

        .executive-kpi.bad::before {
            background: var(--solb-maroon);
        }

        .executive-kpi.info::before {
            background: var(--solb-blue);
        }

    .kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

    .kpi-label {
        color: var(--muted);
        font-size: 10px;
        line-height: 1.3;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .kpi-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: #f6e8ec;
        color: var(--solb-maroon);
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        font-size: 12px;
    }

    .executive-kpi.good .kpi-icon {
        background: #e4f3ec;
        color: var(--solb-green);
    }

    .executive-kpi.info .kpi-icon {
        background: #e6f0f9;
        color: var(--solb-blue);
    }

    .kpi-value {
        margin-top: 12px;
        color: var(--text);
        font-size: 24px;
        line-height: 1;
        font-weight: 900;
    }

    .kpi-subtitle {
        margin-top: 8px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.35;
        font-weight: 650;
    }

    .kpi-status {
        display: inline-flex;
        margin-top: 9px;
        padding: 3px 7px;
        border-radius: 12px;
        background: #eef1f5;
        color: var(--muted);
        font-size: 9px;
        font-weight: 900;
    }

        .kpi-status.good {
            background: #e3f3ea;
            color: var(--solb-green);
        }

        .kpi-status.warn {
            background: #fff2d9;
            color: #a66500;
        }

        .kpi-status.bad {
            background: #f8e5e9;
            color: var(--solb-maroon);
        }

    /* =========================================================
       TOP ANALYTICS
    ========================================================= */

    /*    .top-analytics {
        display: grid;
        grid-template-columns: 1.35fr 1fr .82fr;
        gap: 13px;
        margin-top: 14px;
    }*/

    .top-analytics {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 14px;
        margin-top: 14px;
        align-items: start;
    }

    .trend-health-column {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

        .trend-health-column .dashboard-card {
            width: 100%;
        }

        .trend-health-column .chart-box {
            height: 260px;
        }

        .trend-health-column .health-score-layout {
            min-height: 220px;
        }

    .chart-box {
        height: 255px;
        position: relative;
    }

    .production-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
        margin-bottom: 12px;
    }

    .production-mini {
        padding: 10px;
        border: 1px solid #e4e8ee;
        border-radius: 9px;
        background: #fafbfc;
    }

        .production-mini small {
            color: var(--muted);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .production-mini strong {
            display: block;
            margin-top: 4px;
            color: var(--text);
            font-size: 17px;
            font-weight: 900;
        }

        .production-mini span {
            display: block;
            margin-top: 3px;
            color: var(--solb-green);
            font-size: 9px;
            font-weight: 800;
        }

    /* =========================================================
       HEALTH SCORE
    ========================================================= */

    .health-score-layout {
        display: grid;
        grid-template-columns: 145px 1fr;
        gap: 15px;
        align-items: center;
    }

    .health-donut-wrap {
        width: 140px;
        height: 140px;
        position: relative;
        margin: auto;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        pointer-events: none;
    }

        .donut-center strong {
            color: var(--text);
            font-size: 25px;
            font-weight: 900;
        }

        .donut-center span {
            margin-top: 2px;
            color: var(--muted);
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

    .health-list {
        display: grid;
        gap: 9px;
    }

    .health-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: center;
    }

    .health-name {
        color: var(--muted);
        font-size: 10px;
        font-weight: 750;
    }

    .health-value {
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    .health-track {
        grid-column: 1 / -1;
        height: 5px;
        border-radius: 10px;
        background: #edf0f4;
        overflow: hidden;
    }

        .health-track span {
            display: block;
            height: 100%;
            border-radius: 10px;
            background: var(--solb-green);
        }

        .health-track.warn span {
            background: var(--solb-orange);
        }

        .health-track.bad span {
            background: var(--solb-maroon);
        }

    /* =========================================================
       DEPARTMENT PERFORMANCE
    ========================================================= */

    .department-section {
        margin-top: 14px;
    }

    .department-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 11px;
    }

    .department-card {
        padding: 13px;
        border: 1px solid #e1e6ed;
        border-radius: 10px;
        background: #fbfcfd;
    }

    .department-head {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: center;
    }

    .department-name {
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    .department-score {
        font-size: 14px;
        font-weight: 900;
        color: var(--solb-green);
    }

        .department-score.warn {
            color: var(--solb-orange);
        }

        .department-score.bad {
            color: var(--solb-maroon);
        }

    .department-progress {
        height: 7px;
        margin-top: 10px;
        background: #e9edf2;
        border-radius: 10px;
        overflow: hidden;
    }

        .department-progress span {
            display: block;
            height: 100%;
            border-radius: 10px;
            background: var(--solb-green);
        }

        .department-progress.warn span {
            background: var(--solb-orange);
        }

        .department-progress.bad span {
            background: var(--solb-maroon);
        }

    .department-meta {
        margin-top: 8px;
        display: flex;
        justify-content: space-between;
        color: var(--muted);
        font-size: 8px;
        font-weight: 700;
    }

    /* =========================================================
       MIDDLE GRID
    ========================================================= */

    .middle-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 13px;
        margin-top: 14px;
    }

    /* =========================================================
       TOP RISKS
    ========================================================= */

    .risk-list {
        display: grid;
        gap: 8px;
    }

    .risk-item {
        display: grid;
        grid-template-columns: 28px 1fr auto;
        gap: 9px;
        align-items: center;
        padding: 9px;
        border: 1px solid #e9edf2;
        border-radius: 9px;
        background: #fbfcfd;
    }

    .risk-rank {
        width: 24px;
        height: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 7px;
        background: var(--solb-maroon);
        color: #ffffff;
        font-size: 10px;
        font-weight: 900;
    }

        .risk-rank.warn {
            background: var(--solb-orange);
        }

    .risk-title {
        color: var(--text);
        font-size: 10px;
        font-weight: 850;
    }

    .risk-detail {
        margin-top: 2px;
        color: var(--muted);
        font-size: 8px;
        line-height: 1.25;
        font-weight: 650;
    }

    .risk-value {
        text-align: right;
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    /* =========================================================
       SUPPLY CHAIN SNAPSHOT
    ========================================================= */

    .supply-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .supply-item {
        padding: 10px;
        border-radius: 9px;
        border: 1px solid #e6eaf0;
        background: #fafbfc;
    }

    .supply-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        background: #f5e7eb;
        color: var(--solb-maroon);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 12px;
    }

    .supply-label {
        margin-top: 8px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .supply-value {
        margin-top: 4px;
        color: var(--text);
        font-size: 18px;
        font-weight: 900;
    }

    .supply-sub {
        margin-top: 3px;
        color: var(--muted);
        font-size: 8px;
        font-weight: 650;
    }

    /* =========================================================
       UTILITY COMPLIANCE
    ========================================================= */

    .utility-table {
        width: 100%;
        border-collapse: collapse;
    }

        .utility-table th {
            padding: 9px 7px;
            background: #f0f3f6;
            color: var(--muted);
            font-size: 8px;
            text-align: center;
            font-weight: 900;
            text-transform: uppercase;
        }

            .utility-table th:first-child {
                text-align: left;
            }

        .utility-table td {
            padding: 9px 7px;
            border-bottom: 1px solid #edf0f4;
            color: var(--text);
            font-size: 9px;
            text-align: center;
            font-weight: 700;
        }

            .utility-table td:first-child {
                text-align: left;
                font-weight: 850;
            }

        .utility-table tr:last-child td {
            border-bottom: 0;
        }

    .status-pill {
        display: inline-flex;
        justify-content: center;
        min-width: 54px;
        padding: 3px 7px;
        border-radius: 12px;
        background: #e4f2eb;
        color: var(--solb-green);
        font-size: 8px;
        font-weight: 900;
    }

        .status-pill.warn {
            background: #fff1d4;
            color: #a76700;
        }

        .status-pill.bad {
            background: #f7e3e8;
            color: var(--solb-maroon);
        }

    /* =========================================================
       BOTTOM TREND
    ========================================================= */

    .bottom-grid {
        display: grid;
        grid-template-columns: 1.65fr 1fr;
        gap: 13px;
        margin-top: 14px;
    }

    .trend-chart {
        height: 275px;
        position: relative;
    }

    /* =========================================================
       MANAGEMENT ACTIONS TABLE
    ========================================================= */

    .action-table {
        width: 100%;
        border-collapse: collapse;
    }

        .action-table th {
            padding: 9px 7px;
            background: var(--solb-maroon);
            color: #ffffff;
            font-size: 8px;
            text-align: left;
            font-weight: 900;
            text-transform: uppercase;
        }

        .action-table td {
            padding: 10px 7px;
            border-bottom: 1px solid #ebeff3;
            color: var(--text);
            font-size: 8px;
            line-height: 1.3;
            vertical-align: top;
        }

        .action-table tr:last-child td {
            border-bottom: 0;
        }

    .priority {
        display: inline-flex;
        justify-content: center;
        min-width: 44px;
        padding: 3px 6px;
        border-radius: 10px;
        background: #f7e2e7;
        color: var(--solb-maroon);
        font-size: 7px;
        font-weight: 900;
    }

        .priority.medium {
            background: #fff1d5;
            color: #a76700;
        }

        .priority.low {
            background: #e2f1e9;
            color: var(--solb-green);
        }

    /* =========================================================
       FOOTER
    ========================================================= */

    .dashboard-footer {
        margin-top: 14px;
        padding: 13px 4px 3px;
        border-top: 1px solid #ccd3dc;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
        text-align: right;
    }

        .dashboard-footer strong {
            color: var(--solb-maroon);
        }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1450px) {
        .executive-kpis {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .department-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1150px) {
        .top-analytics,
        .middle-grid,
        .bottom-grid {
            grid-template-columns: 1fr;
        }

        .department-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .xp-contentbar {
            padding: 9px !important;
        }

        .executive-header {
            grid-template-columns: 1fr;
        }

        .header-side {
            align-items: stretch;
            flex-direction: column;
        }

        .header-meta {
            text-align: left;
        }

        .executive-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .health-score-layout {
            grid-template-columns: 1fr;
        }

        .department-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .executive-kpis {
            grid-template-columns: 1fr;
        }

        .production-summary-grid,
        .supply-grid {
            grid-template-columns: 1fr;
        }
    }

    /* =========================================================
       PRINT
    ========================================================= */

    @@media print {
        @@page {
            size: A4 landscape;
            margin: 5mm;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        .no-print,
        .xp-breadcrumbbar,
        .navbar,
        .sidebar,
        .footer,
        .xp-leftbar,
        .xp-rightbar,
        .xp-topbar {
            display: none !important;
        }

        html,
        body,
        .xp-contentbar {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
        }

        .executive-dashboard {
            width: 100% !important;
            max-width: none !important;
        }

        .executive-header {
            min-height: 76px !important;
            padding: 12px 15px !important;
            border-radius: 8px !important;
            box-shadow: none !important;
        }

        .header-main h2 {
            font-size: 21px !important;
        }

        .executive-kpis {
            grid-template-columns: repeat(8, 1fr) !important;
            gap: 5px !important;
            margin-top: 7px !important;
        }

        .executive-kpi {
            min-height: 75px !important;
            padding: 7px 7px 6px 10px !important;
            border-radius: 7px !important;
            box-shadow: none !important;
        }

        .kpi-label {
            font-size: 7px !important;
        }

        .kpi-icon {
            width: 21px !important;
            height: 21px !important;
        }

        .kpi-value {
            margin-top: 5px !important;
            font-size: 16px !important;
        }

        .kpi-subtitle,
        .kpi-status {
            font-size: 6px !important;
            margin-top: 4px !important;
        }

        .top-analytics {
            grid-template-columns: 1.35fr 1fr .82fr !important;
            gap: 6px !important;
            margin-top: 7px !important;
        }

        .department-section,
        .middle-grid,
        .bottom-grid {
            margin-top: 7px !important;
        }

        .middle-grid {
            grid-template-columns: 1fr 1fr 1fr !important;
            gap: 6px !important;
        }

        .bottom-grid {
            grid-template-columns: 1.65fr 1fr !important;
            gap: 6px !important;
        }

        .department-grid {
            grid-template-columns: repeat(5, 1fr) !important;
            gap: 5px !important;
        }

        .dashboard-card,
        .department-card {
            page-break-inside: avoid !important;
            box-shadow: none !important;
        }

        .card-header {
            min-height: 31px !important;
            padding: 6px 8px !important;
        }

        .card-title {
            font-size: 9px !important;
        }

        .card-note {
            font-size: 6px !important;
        }

        .card-body {
            padding: 7px !important;
        }

        .chart-box,
        .trend-chart {
            height: 145px !important;
        }

        .health-donut-wrap {
            width: 95px !important;
            height: 95px !important;
        }

        .department-card {
            padding: 7px !important;
