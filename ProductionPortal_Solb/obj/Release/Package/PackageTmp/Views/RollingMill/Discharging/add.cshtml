<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    // JAVASCRIPT FOR MULTI-COLUMN DROPDOWN
    $(document).ready(function () {

        // 🔥 Recalculate after filter
        calculateKPI();

        const gradeDataJson = '@Html.Raw(ViewBag.GradeDataJson)';
        let gradeData = [];

        try {
            gradeData = JSON.parse(gradeDataJson);
        } catch (e) {
            console.error("Error parsing Grade Data JSON:", e);
            return;
        }

        const $specGradeBody = $('#specGradeBody');
        const $inputField = $('#productSpec');
        const $dropdownTable = $('#multiColumnDropdown');
        const $toggleBtn = $('#toggleDropdownBtn');
        const $hiddenIdField = $('#hiddenProductID');
        const $billetLengthField = $('#billetLength');
        const $crossSectionField = $('#crosssection');
        const $steelGradeField = $('#steelGrade');   // ✅ add this input in HTML

        // ----------------------------
        // POPULATE DROPDOWN TABLE
        // ----------------------------
        gradeData.forEach(item => {
            const row = `
                <tr
                    data-id="${item.ProductID}"
                    data-spec="${item.SpecGrade}"
                    data-grade="${item.SteelGrade}"
                    data-l="${item.Length}"
                    data-w="${item.Width}"
                    data-billet="${item.BilletLength}">
                    <td>${item.SpecGrade}</td>
                    <td>${item.SteelGrade}</td>
                    <td>${item.Length}</td>
                    <td>${item.Width}</td>
                    <td>${item.BilletLength}</td>
                </tr>`;
            $specGradeBody.append(row);
        });

        // ----------------------------
        // TOGGLE DROPDOWN
        // ----------------------------
        $toggleBtn.on('click', function () {
            $dropdownTable.toggle();
        });

        // ----------------------------
        // ROW CLICK EVENT
        // ----------------------------
        $specGradeBody.on('click', 'tr', function () {

            const $row = $(this);

            const selectedId = $row.data('id');
            const selectedSpec = $row.data('spec');
            const selectedGrade = $row.data('grade');
            const billetLength = $row.data('billet');

            const length = $row.data('l');
            const width = $row.data('w');
            const crossSectionValue = length + 'x' + width;

            // ✅ SET VALUES
            debugger
            $inputField.val(selectedSpec);
            $hiddenIdField.val(selectedId);
            $billetLengthField.val(billetLength);
            $crossSectionField.val(crossSectionValue);
            $steelGradeField.val(selectedGrade);     // ✅ Fixed variable

            $dropdownTable.hide();
        });

        // ----------------------------
        // HIDE DROPDOWN IF CLICK OUTSIDE
        // ----------------------------
        $(document).on('click', function (e) {
            if (!$dropdownTable.is(e.target) &&
                $dropdownTable.has(e.target).length === 0 &&
                !$toggleBtn.is(e.target) &&
                !$inputField.is(e.target)) {
                $dropdownTable.hide();
            }
        });
    });

    function calculateKPI() {

        var totalBillet = 0;
        var totalProduced = 0;

        var rows = document.querySelectorAll("tbody tr");

        rows.forEach(function (row) {

            if (row.style.display === "none") return; // skip hidden rows

            var cols = row.querySelectorAll("td");

            var billet = parseFloat(cols[4].innerText) || 0;
            var weight = parseFloat(cols[5].innerText) || 0;

            totalBillet += billet;
            totalProduced += weight;

        });

        document.getElementById("totalBilletBadge").innerText = totalBillet;
        document.getElementById("totalProducedBadge").innerText = totalProduced.toFixed(2);
    }
</script>

<script>
    $(document).ready(function () {

        $("input[type='number']").attr("step", "any");

        $("#date").val(new Date().toISOString().split('T')[0]);

        $("#ddlgrade").on("change", function () {

            debugger

            var heatNo = $(this).val();

            if (heatNo === "") {
                clearFields();
                return;
            }

            $.ajax({
                url: '/RollingMill/GetChargingByHeat',
                type: 'GET',
                data: { heatNo: heatNo },
                success: function (res) {

                    if (res) {
                        debugger
                        $("#txtBoarding").val(res.BoardingNo);
                        $("#txtGrade").val(res.SteelGrade);
                        $("#txtprofile").val(res.Profile);
                        $("#txtTotalBillet").val(res.TotalBillet);
                        $("#txtTotalWeight").val(res.TotalWeight);
                        $("#txtBilletLength").val(res.BilletLength);
                        $("#txtProductSpecs").val(res.ProductSpecs);
                    }
                    else {
                        clearFields();
                    }
                }
            });
        });

        function clearFields() {
            $("#txtBoarding").val('');
            $("#txtGrade").val('');
            $("#txtSize").val('');
            $("#txtWeight").val('');
            $("#txtTotalBillet").val('');
            $("#txtTotalWeight").val('');
            $("#txtProductSpecs").val('');
        }
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

        var msg = '@TempData["SuccessMessage"]';
        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }

    });
</script>
<script>
    document.getElementById("ddlgrade").addEventListener("change", function () {
        let heatNo = this.value;

        // set PO number same as Heat #
        document.getElementById("txtPONumber").value = heatNo;
    });

    document.getElementById("shiftFilter").addEventListener("change", function () {

        var selectedShift = this.value.toLowerCase();
        var rows = document.querySelectorAll("tbody tr");

        rows.forEach(function (row) {

            var rowShift = row.getAttribute("data-shift").toLowerCase();

            if (selectedShift === "" || rowShift === selectedShift) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }

        });

        // 🔥 Recalculate after filter
        calculateKPI();
    });
</script>