@using System.Globalization
@model DAL.Models.ViewModel.RMChargingVM

@{
    ViewBag.Title = "Billet Charging";
}

<style>
    .used-heat-option {
        background-color: #f8d7da !important;
        color: #721c24 !important;
        font-weight: bold;
    }
</style>

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Rolling Mill</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Rolling Mill</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Billet Charging</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->

<div class="xp-contentbar">

    <form action="/RollingMill/AddCharge" id="addprofileform" method="post">

        <!-- 🔥 SHIFT DETAILS CARD -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header">
                <b>Rolling Mill Shift Details</b>
            </div>
            <div class="card-body">
                <div class="form-row">
                    <div class="col-md-3"><b>Date:</b> @(Model.Date?.ToString("dd-MM-yyyy") ?? "-")</div>
                    <div class="col-md-3"><b>Plant:</b> @Model.Plant</div>
                    <div class="col-md-3"><b>Shift:</b> @Model.Shift</div>
                    <div class="col-md-3"><b>Incharge:</b> @Model.ShiftIncharge</div>
                </div>
            </div>
        </div>

        <!-- 🔥 FORM -->
        <div class="card">
            <div class="card-header text-right">
                <button type="submit" class="btn btn-primary">Charge Heat</button>
            </div>

            <div class="card-body">
                <div class="form-row">

                    <!-- DATE -->
                    <div class="col-md-2">
                        <label>Date</label>
                        <input type="date" class="form-control"
                               name="Date"
                               value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- SHIFT -->
                    <!--<div class="col-md-2">
                        <label>Shift</label>
                        <input type="text" class="form-control" value="@Model.Shift" readonly />
                        <input type="hidden" name="Shift" value="@Model.Shift" />
                    </div>-->
                    <!-- HEAT -->
                    <div class="col-md-2">
                        <label>Heat #</label>
                        @Html.DropDownListFor(m => m.HeatNo,
                            (IEnumerable<SelectListItem>)ViewBag.HeatNo,
                            "-- Select Heat --",
                            new { @class = "form-control", id = "ddlHeat" })
                    </div>

                    <!-- BOARDING -->
                    <div class="col-md-2">
                        <label>Boarding</label>
                        <input type="text" id="txtBoarding" name="BoardingNo" class="form-control" readonly />
                    </div>

                    <!-- GRADE -->
                    <div class="col-md-2">
                        <label>Grade</label>
                        <input type="text" id="txtGrade" name="SteelGrade" class="form-control" readonly />
                    </div>

                    <!-- SIZE -->
                    <div class="col-md-2">
                        <label>Size</label>
                        <input type="text" id="txtSize" name="BilletSize" class="form-control" readonly />
                    </div>

                </div>

                <div class="form-row mt-2">

                    <div class="col-md-2">
                        <label>Length</label>
                        <input type="text" id="txtBilletLength" name="BilletLength" class="form-control" readonly />
                    </div>

                    <div class="col-md-2">
                        <label>Total Billet</label>
                        <input type="text" id="txtTotalBillet" name="TotalBillet" class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label>Weight</label>
                        <input type="text" id="txtWeight" name="Weight" class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label>Total Weight</label>
                        <input type="text" id="txtTotalWeight" name="TotalWeight" class="form-control" readonly />
                    </div>

                    <div class="col-md-2">
                        <label>Sequence</label>
                        <input type="number" name="HeatSequence" class="form-control" value="0" />
                    </div>

                </div>
            </div>
        </div>

    </form>

    <!-- 🔥 TABLE -->
    <div class="card mt-3">
        <div class="card-body">

            <select id="shiftFilter" class="form-control mb-2" style="width:200px;">
                <option value="">All</option>
                <option>Morning</option>
                <option>Evening</option>
                <option>Night</option>
            </select>

            <div class="mb-2">
                <span class="badge badge-primary" id="totalBilletBadge">0</span>
                <span class="badge badge-success" id="totalProducedBadge">0</span>
            </div>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Seq</th>
                        <th>Shift</th>
                        <th>Heat</th>
                        <th>Billet</th>
                        <th>Weight</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.SubmittedHeat)
                    {
                        <tr data-shift="@item.Shift">
                            <td>@item.HeatSequence</td>
                            <td>@item.Shift</td>
                            <td>@item.HeatNo</td>
                            <td>@item.TotalBillet</td>
                            <td>@item.TotalWeight</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>

<!-- 🔥 SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    function toNum(val) {
        return parseFloat(val) || 0;
    }

    var usedHeatNos = [
    @if (Model.SubmittedHeat != null && Model.SubmittedHeat.Any())
    {
        foreach (var item in Model.SubmittedHeat)
        {
            <text>'@item.HeatNo',</text>
        }
    }
];

usedHeatNos = usedHeatNos.map(function (x) {
    return (x || '').trim().toUpperCase();
});

$("#ddlHeat option").each(function () {
    var optionHeat = ($(this).val() || '').trim().toUpperCase();

    if (usedHeatNos.indexOf(optionHeat) >= 0) {
        $(this)
            .addClass("used-heat-option")
            .css({
                "background-color": "#f8d7da",
                "color": "#721c24",
                "font-weight": "bold"
            })
            .text($(this).text() + " - Used");
    }
});

    // 🔥 TOTAL WEIGHT (INPUT BASED)
    $("#txtTotalBillet, #txtWeight").on("keyup change", function () {
        var total = toNum($("#txtTotalBillet").val()) * toNum($("#txtWeight").val());
        $("#txtTotalWeight").val(total.toFixed(2));
    });

    // 🔥 HEAT AUTO FILL
    $("#ddlHeat").change(function () {

        var heatNo = $(this).val();

        if (!heatNo) {
            clearFields();
            return;
        }

        $.get('/RollingMill/GetBilletBoardingByHeat', { heatNo: heatNo }, function (res) {

            if (!res) {
                clearFields();
                return;
            }

            $("#txtBoarding").val(res.BoardingNo || '');
            $("#txtGrade").val(res.SteelGrade || '');
            $("#txtSize").val(res.BilletSize || '');
            $("#txtBilletLength").val(res.BilletLength || '');
            $("#txtTotalBillet").val(res.NoOfBillet || 0);
            $("#txtWeight").val(res.BilletWeight || 0);

            // 🔥 Recalculate after autofill
            var total = toNum(res.NoOfBillet) * toNum(res.BilletWeight);
            $("#txtTotalWeight").val(total.toFixed(2));
        });
    });

    function clearFields() {
        $("#txtBoarding, #txtGrade, #txtSize, #txtBilletLength").val('');
        $("#txtTotalBillet, #txtWeight, #txtTotalWeight").val('');
    }

    // 🔥 FILTER
    $("#shiftFilter").change(function () {

        var shift = ($(this).val() || "").toLowerCase();

        $("tbody tr").each(function () {

            var rowShift = ($(this).data("shift") || "").toLowerCase();

            if (!shift || rowShift === shift) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });

        calculateTotals(); // 🔥 recalc after filter
    });

    // 🔥 TOTAL CALCULATION (VISIBLE ROWS)
    function calculateTotals() {

        var totalBillet = 0, totalWeight = 0;

        $("tbody tr:visible").each(function () {

            totalBillet += toNum($(this).find("td:eq(3)").text());
            totalWeight += toNum($(this).find("td:eq(4)").text());

        });

        $("#totalBilletBadge").text(totalBillet);
        $("#totalProducedBadge").text(totalWeight.toFixed(2));
    }

    // 🔥 INITIAL LOAD FIX (VERY IMPORTANT)
    $(document).ready(function () {
        calculateTotals();
    });

</script>