@model DAL.Models.SupplyChainDailyBLL

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .sc-header {
        background: #7f1010;
        color: #fff;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px rgba(0,0,0,.10);
    }

    .sc-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        margin-bottom: 18px;
        overflow: hidden;
    }

        .sc-card .card-header {
            background: #991b1b;
            color: #fff;
            font-weight: 700;
            padding: 12px 16px;
        }

    .form-group label {
        font-size: 13px;
        font-weight: 700;
        color: #555;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-save {
        min-width: 150px;
        border-radius: 8px;
    }
</style>

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">Supply Chain Dashboard</h4>
            <small>All quantities in MT except Fuel Oil where applicable.</small>
        </div>
        <div class="col-md-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                    </li>
                    <li class="breadcrumb-item active">Supply Chain</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    @*<div class="sc-header">
            <h3>Supply Chain Department Dashboard</h3>
            <small>All quantities in MT except Fuel Oil where applicable.</small>
        </div>*@

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @using (Html.BeginForm("Add", "SupplyChain", FormMethod.Post, new { id = "supplyChainForm" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(x => x.ID)

        <div class="card sc-card">
            <div class="card-header">Report Information</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Report Date</label>
                            <input type="date"
                                   name="ReportDate"
                                   class="form-control"
                                   value="@(Model.ReportDate.HasValue ? Model.ReportDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                    </div>

                    @*<div class="col-md-3">
                            <div class="form-group">
                                <label>Report Time</label>
                                <input type="time"
                                       name="ReportTime"
                                       class="form-control"
                                       value="@(Model.ReportTime.HasValue ? Model.ReportTime.Value.ToString(@"hh\:mm") : "")" />
                            </div>
                        </div>*@
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">Inventory Status - Raw Materials</div>
            <div class="card-body">
                <div class="row">
                    @InputBox("Scrap", "Scrap", Model.Scrap)
                    @InputBox("DRI", "DRI", Model.DRI)
                    @InputBox("HBI", "HBI", Model.HBI)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">Inventory Status - Finished Goods Materials</div>
            <div class="card-body">
                <div class="row">
                    @InputBox("Billet", "Billet", Model.Billet)
                    @InputBox("Rebar", "Rebar", Model.Rebar)
                    @InputBox("WireRodCoil", "Wire Rod Coil", Model.WireRodCoil)
                    @InputBox("RebarInCoil", "Rebar in Coil", Model.RebarInCoil)
                    @InputBox("EpoxyRebar", "Epoxy Rebar", Model.EpoxyRebar)
                    @InputBox("ShortBar", "Short Bar", Model.ShortBar)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">Dispatch Performance</div>
            <div class="card-body">
                <div class="row">
                    @InputBox("DailyDispatch", "Daily Dispatch", Model.DailyDispatch)
                    @InputBox("DailyDispatchTarget", "Daily Dispatch Target", Model.DailyDispatchTarget)
                    @InputBox("DailyTruck", "Daily Truck", Model.DailyTruck)
                    @InputBox("DailyTruckTarget", "Daily Truck Target", Model.DailyTruckTarget)
                    @InputBox("WTDDispatch", "WTD Dispatch", Model.WTDDispatch)
                    @InputBox("WTDDispatchTarget", "WTD Dispatch Target", Model.WTDDispatchTarget)
                    @InputBox("MTDDispatch", "MTD Dispatch", Model.MTDDispatch)
                    @InputBox("MTDDispatchTarget", "MTD Dispatch Target", Model.MTDDispatchTarget)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">Received Materials</div>
            <div class="card-body">
                <div class="row">
                    @InputBox("RawMaterialsReceived", "Raw Materials", Model.RawMaterialsReceived)
                    @InputBox("SubRawMaterialsReceived", "Sub Raw Materials", Model.SubRawMaterialsReceived)
                    @InputBox("RefractoryMaterialsReceived", "Refractory Materials", Model.RefractoryMaterialsReceived)
                    @InputBox("FuelOilReceived", "Fuel Oil", Model.FuelOilReceived)
                    @InputBox("OtherReceived", "Other", Model.OtherReceived)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">By-Products</div>
            <div class="card-body">
                <div class="row">
                    @InputBox("MillScale", "Mill Scale", Model.MillScale)
                    @InputBox("Slag", "Slag", Model.Slag)
                    @InputBox("Dust", "Dust", Model.Dust)
                    @InputBox("Sludge", "Sludge", Model.Sludge)
                </div>
            </div>
        </div>

        <div class="text-right mb-4">
            <button type="submit" class="btn btn-primary btn-save">Save</button>
            <a href="@Url.Action("Index", "Reporting")" class="btn btn-secondary">Back</a>
        </div>
    }

</div>

@helper InputBox(string name, string label, decimal? value)
{
    <div class="col-md-3">
        <div class="form-group">
            <label>@label</label>
            <input type="number"
                   step="0.001"
                   name="@name"
                   class="form-control"
                   value="@(value.HasValue ? value.Value.ToString("0.###") : "")"
                   placeholder="0.000" />
        </div>
    </div>
}