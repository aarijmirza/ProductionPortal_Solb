<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-9">
            <h4 class="xp-page-title">SMP Daily Dashboard</h4>
        </div>
        <div class="col-md-3 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">Steel Melting Plant</li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </div>
    </div>
</div>

<div class="xp-contentbar">
    <div class="smp-dashboard">

        <div class="dashboard-actions no-print">
            <button type="button"
                    class="print-btn"
                    onclick="downloadSMPDashboardPDF(this)">
                <i class="fa-solid fa-file-pdf"></i>
                Download Single Page PDF
            </button>
        </div>

        <div class="dashboard-shell" id="smpPdfReport">

            <!-- HEADER -->
            <header class="dashboard-header">
                <div class="header-logo">
                    <img src="~/assets/images/logo.png" alt="SOLB Steel" />
                </div>

                <div class="header-title">
                    <h1>Steel Making Plant Dashboard</h1>
                    <p>Production / Utilities / Reliability</p>
                </div>

                <div class="header-meta">
                    <strong>
                        <i class="fa-regular fa-calendar-days"></i>
                        From: @m.FromDate.ToString("dd-MMM-yyyy")
                        &nbsp; To: @m.ToDate.ToString("dd-MMM-yyyy")
                    </strong>

                    <form method="get"
                          action="@Url.Action("SMPDailyDashboard", "SMPReports")"
                          class="header-filter no-print">

                        <input type="date"
                               name="fromDate"
                               value="@m.FromDate.ToString("yyyy-MM-dd")" />

                        <input type="date"
                               name="toDate"
                               value="@m.ToDate.ToString("yyyy-MM-dd")" />

                        <button type="submit">Load</button>
                    </form>

                    Date Range Management View
                </div>
            </header>

            <!-- KPI CARDS -->
            <section class="kpi-grid">

                <div class="kpi-card">
                    <div class="kpi-head">
                        <div class="kpi-name">Heat Count</div>
                        <div class="kpi-badge">H</div>
                    </div>
                    <div class="kpi-value">@m.HeatCount.ToString("N0")</div>
                    <div class="kpi-target">Target: @heatTarget.ToString("N0") heats</div>
                </div>

                <div class="kpi-card good">
                    <div class="kpi-head">
                        <div class="kpi-name">Billet Output (MT)</div>
                        <div class="kpi-badge">B</div>
                    </div>
                    <div class="kpi-value">@m.BilletOutput.ToString("N0")</div>
                    <div class="kpi-target">
                        Target: @m.PeriodTarget.ToString("N0") MT
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-head">
                        <div class="kpi-name">Yield (%)</div>
                        <div class="kpi-badge">Y</div>
                    </div>
                    <div class="kpi-value">@m.Yield.ToString("N0")</div>
                    <div class="kpi-target">Target: 87%</div>
                </div>

                <div class="kpi-card good">
                    <div class="kpi-head">
                        <div class="kpi-name">Productivity (t/hr)</div>
                        <div class="kpi-badge">P</div>
                    </div>
                    <div class="kpi-value">@m.Productivity.ToString("N0")</div>
                    <div class="kpi-target">Target: 140 t/hr</div>
                </div>

                <div class="kpi-card bad">
                    <div class="kpi-head">
                        <div class="kpi-name">Power Consumption (EAF-LF)</div>
                        <div class="kpi-badge">E</div>
                    </div>
                    <div class="kpi-value">@m.PowerConsumption.ToString("N0")</div>
                    <div class="kpi-target">Target: 602 kWh/t</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-head">
                        <div class="kpi-name">TTT Time (min)</div>
                        <div class="kpi-badge">T</div>
                    </div>
                    <div class="kpi-value">@m.TapToTap.ToString("N0")</div>
                    <div class="kpi-target">Target: 60 min</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-head">
                        <div class="kpi-name">Power-on Time (min)</div>
                        <div class="kpi-badge">O</div>
                    </div>
                    <div class="kpi-value">@m.PowerOnTime.ToString("N0")</div>
                    <div class="kpi-target">Target: 48 min</div>
                </div>

                <div class="kpi-card bad">
                    <div class="kpi-head">
                        <div class="kpi-name">Heat Weight (t)</div>
                        <div class="kpi-badge">W</div>
                    </div>
                    <div class="kpi-value">@m.HeatWeight.ToString("N0")</div>
                    <div class="kpi-target">Target: 140 t</div>
                </div>

            </section>

            <!-- OVERVIEW -->
            <section class="overview-grid">

                <div class="dashboard-card variance-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-chart-column"></i>
                            Production Variance
                        </h3>
                        <span class="card-note">Daily / MTD / YTD</span>
                    </div>

                    <div class="card-body">
                        <table class="variance-table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Daily</th>
                                    <th>MTD</th>
                                    <th>YTD</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Actual</td>
                                    <td>@m.DailyActual.ToString("N0")</td>
                                    <td>@m.MTDActual.ToString("N0")</td>
                                    <td>@m.YTDActual.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Target</td>
                                    <td>@m.DailyTarget.ToString("N0")</td>
                                    <td>@m.MTDTarget.ToString("N0")</td>
                                    <td>@m.YTDTarget.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Variance</td>
                                    <td>
                                        <span class="variance-value @(dailyVariance > 0 ? "up" : dailyVariance < 0 ? "down" : "flat")">
                                            <span class="variance-arrow" aria-hidden="true"></span>
                                            @dailyVariance.ToString("+#,##0;-#,##0;0")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="variance-value @(mtdVariance > 0 ? "up" : mtdVariance < 0 ? "down" : "flat")">
                                            <span class="variance-arrow" aria-hidden="true"></span>
                                            @mtdVariance.ToString("+#,##0;-#,##0;0")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="variance-value @(ytdVariance > 0 ? "up" : ytdVariance < 0 ? "down" : "flat")">
                                            <span class="variance-arrow" aria-hidden="true"></span>
                                            @ytdVariance.ToString("+#,##0;-#,##0;0")
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">Yearly Production Achievement</h3>
                    </div>

                    <div class="yearly-body">
                        <div>
                            <div class="single-donut-wrap">
                                <canvas id="yearlyChart"></canvas>
                                <div class="donut-center">@m.YearlyAchievement.ToString("0.0")%</div>
                            </div>

                            <div style="text-align:center;
                                        margin-top:6px;
                                        font-size:10px;
                                        font-weight:700;
                                        color:#697386;">
                                YTD Actual: @m.YTDActual.ToString("N1") MT
                                <br />
                                Target: @m.YearlyTarget.ToString("N1") MT
                            </div>
                        </div>
                    </div>
                </div>

            </section>

            <!-- ANALYTICS -->
            <section class="analytics-grid">

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-chart-column"></i>
                            Performance KPIs
                        </h3>
                        <span class="card-note">(%)</span>
                    </div>

                    <div class="card-body">
                        <div class="chart-box">
                            <canvas id="performanceChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-regular fa-clock"></i>
                            Top 5 Delays
                        </h3>
                        <span class="card-note">Minutes</span>
                    </div>

                    <div class="card-body">
                        <div class="delay-list">
                            @if (topDelays.Count > 0)
                            {
                                for (int i = 0; i < topDelays.Count; i++)
                                {
                                    var delay = topDelays[i];

                                    decimal width =
                                        maxDelay > 0
                                            ? (delay.Minutes / maxDelay) * 100
                                            : 0;

                                    <div class="delay-row">
                                        <div class="delay-rank @(i == 0 || i == 4 ? "orange" : "")">
                                            @(i + 1)
                                        </div>

                                        <div class="delay-name">@delay.DelayName</div>

                                        <div class="delay-track @(i == 0 || i == 4 ? "orange" : "")">
                                            <span style="width:@width.ToString("0.##")%;"></span>
                                        </div>

                                        <div class="delay-min">@delay.Minutes.ToString("N0")</div>
                                        <div class="delay-area">@delay.Area</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-delay">
                                    No delay records found for the selected date.
                                </div>
                            }
                        </div>

                        <div class="delay-note">
                            Top delays are calculated from SMP day-wise delay columns.
                        </div>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-flask"></i>
                            Raw Material Consumption
                        </h3>
                        <span class="card-note">Kg/t</span>
                    </div>

                    <div class="card-body">
                        <div class="chart-box">
                            <canvas id="rawMaterialChart"></canvas>
                        </div>
                    </div>
                </div>

            </section>

            <!-- LOWER SECTION -->
            <section class="lower-grid">

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-bolt"></i>
                            Utility Consumption
                        </h3>
                        <span class="card-note">Nm³/t</span>
                    </div>

                    <div class="card-body">
                        <div class="utility-chart-box">
                            <canvas id="utilityChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="dashboard-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-chart-pie"></i>
                            Operational Composition
                        </h3>
                    </div>

                    <div class="card-body">
                        <div class="composition-grid">

                            <div class="mini-donut-card">
                                <div class="mini-donut-title">Charge Mix</div>

                                <div class="mini-donut-wrap">
                                    <canvas id="chargeMixChart"></canvas>
                                </div>

                                <div class="legend-list">
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#d60000;"></span>
                                        DRI — @m.DRIShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#245f96;"></span>
                                        HBI — @m.HBIShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#c7c7c7;"></span>
                                        Scrap — @m.ScrapShare.ToString("0.0")%
                                    </div>
                                </div>
                            </div>

                            <div class="mini-donut-card">
                                <div class="mini-donut-title">Availability Breakdown</div>

                                <div class="mini-donut-wrap">
                                    <canvas id="availabilityChart"></canvas>
                                    <div class="mini-center">@m.Availability.ToString("0.0")%</div>
                                </div>

                                <div class="legend-list">
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#a91435;"></span>
                                        Operation — @m.OperationShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#245f96;"></span>
                                        Mechanical — @m.MechanicalShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#bfc5ce;"></span>
                                        Electrical — @m.ElectricalShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#5d9138;"></span>
                                        Refractory — @m.RefractoryShare.ToString("0.0")%
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-color" style="background:#efa500;"></span>
                                        Other — @m.OtherShare.ToString("0.0")%
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="dashboard-card production-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa-solid fa-chart-line"></i>
                            Day Wise Production
                        </h3>
                        <span class="card-note">
                            MT
                        </span>
                    </div>

                    <div class="card-body">
                        <div class="production-chart-box">
                            <canvas id="dailyProductionChart"></canvas>
                        </div>
                    </div>
                </div>

            </section>

            <footer class="dashboard-footer">
                <strong>Solb Steel</strong> &nbsp;•&nbsp; SMP Dashboard
            </footer>

        </div>
    </div>
</div>
</div>

<script>
    Chart.defaults.font.family = "Segoe UI, Arial, sans-serif";
    Chart.defaults.color = "#384152";

    const gridColor = "#e8ecf1";
    const redColor = "#d60000";
    const grayColor = "#9da3ab";
    const blueColor = "#245f96";

    const valueLabelPlugin = {
        id: "valueLabelPlugin",

        afterDatasetsDraw(chart) {

            const ctx = chart.ctx;

            ctx.save();
            ctx.fillStyle = "#202632";
            ctx.textAlign = "center";
            ctx.textBaseline = "bottom";
            ctx.font = "700 9px Segoe UI";

            chart.data.datasets.forEach(function (dataset, datasetIndex) {

                if (dataset.type === "line") {
                    return;
                }

                const meta =
                    chart.getDatasetMeta(datasetIndex);

                if (
                    !meta ||
                    meta.hidden
                ) {
                    return;
                }

                meta.data.forEach(function (element, index) {

                    const value =
                        Number(dataset.data[index] || 0);

                    if (!Number.isFinite(value)) {
                        return;
                    }

                    const label =
                        value.toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 1,
                                maximumFractionDigits: 1
                            }
                        );

                    /*
                     * When Target + Actual are both very small,
                     * stagger labels slightly so they do not overlap.
                     */
                    const yOffset =
                        datasetIndex % 2 === 0
                            ? 5
                            : 16;

                    ctx.fillText(
                        label,
                        element.x,
                        Math.max(
                            element.y - yOffset,
                            10
                        )
                    );
                });
            });

            ctx.restore();
        }
    };

    new Chart(document.getElementById("yearlyChart"), {
        type: "doughnut",
        data: {
            labels: ["Achievement", "Remaining"],
            datasets: [{
                data: [
                    @m.YearlyAchievement.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    @(Math.Max(0, 100 - m.YearlyAchievement).ToString(System.Globalization.CultureInfo.InvariantCulture))
                ],
                backgroundColor: [redColor, "#d8d8d8"],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "58%",
            animation: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    enabled: false
                }
            }
        }
    });

    new Chart(document.getElementById("performanceChart"), {
        type: "bar",
        data: {
            labels: ["Performance", "Availability", "Quality"],
            datasets: [
                {
                    label: "Target",
                    data: [85, 87, 99],
                    backgroundColor: grayColor,
                    borderRadius: 4,
                    barThickness: 25
                },
                {
                    label: "Actual",
                    data: [
                        @m.Performance.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.Availability.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.QualityYield.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    ],
                    backgroundColor: redColor,
                    borderRadius: 4,
                    barThickness: 25
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            layout: {
                padding: {
                    top: 15
                }
            },
            plugins: {
                legend: {
                    position: "bottom",
                    labels: {
                        boxWidth: 12,
                        usePointStyle: false,
                        font: {
                            size: 10,
                            weight: "bold"
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 110,
                    ticks: {
                        display: false
                    },
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: {
                            size: 10,
                            weight: "bold"
                        }
                    },
                    border: {
                        display: false
                    }
                }
            }
        },
        plugins: [valueLabelPlugin]
    });

    new Chart(document.getElementById("rawMaterialChart"), {
        type: "bar",
        data: {
            labels: [
                "FeSi",
                "SiMn",
                "Fluorspar",
                "Calcined C",
                "Charge Coal",
                "Rice Husk",
                "Lime",
                "Dolo Lime"
            ],
            datasets: [
                {
                    label: "Target",
                    data: [
                        2,      // FeSi
                        11,     // SiMn
                        0.80,   // Flourspar
                        16,     // Calcined Carbon
                        10,     // Charge Coal
                        0.25,   // Rice Husk
                        40,     // Lime
                        30      // Dolo Lime
                    ],
                    backgroundColor: grayColor,
                    borderColor: "#7d8794",
                    borderWidth: 1,
                    borderRadius: 3,
                    barThickness: 25,
                    minBarLength: 3
                },
                {
                    label: "Actual",
                    data: [
                        @m.FeSi.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.SiMn.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.Fluorspar.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.CalcinedCarbon.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.ChargeCoal.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.RiceHusk.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.Lime.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @m.DoloLime.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    ],
                    backgroundColor: redColor,
                    borderRadius: 3,
                    barThickness: 25,
                    minBarLength: 3
                }

            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            layout: {
                padding: {
                    top: 30
                }
            },
            plugins: {
                legend: {
                    position: "bottom",
                    labels: {
                        boxWidth: 16,
                        font: {
                            size: 10,
                            weight: "bold"
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    suggestedMax: 45,
                    ticks: {
                        display: false
                        //stepSize: 5,
                        //font: {
                        //    size: 9
                        //}
                    },
                    grid: {
                        display: false
                    },
                    border: {
                        display: false
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        maxRotation: 45,
                        minRotation: 45,
                        font: {
                            size: 9,
                            weight: "bold"
                        }
                    },
                    border: {
                        display: false
                    }
                }
            }
        },
        plugins: [valueLabelPlugin]
    });

    new Chart(document.getElementById("utilityChart"), {
        type: "bar",
        data: {
            labels: ["LPG", "O₂", "Argon", "N₂"],
            datasets: [
                {
