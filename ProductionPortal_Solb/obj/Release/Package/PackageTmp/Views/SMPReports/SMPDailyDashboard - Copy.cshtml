@model DAL.Models.SMPDashboardVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var m =
        Model ?? new DAL.Models.SMPDashboardVM
        {
            FromDate = DateTime.Today,
            ToDate = DateTime.Today
        };

    var topDelays =
        m.TopDelays ?? new List<DAL.Models.SMPDelayItemBLL>();

    var dailyProduction =
        m.DailyProduction ?? new List<DAL.Models.SMPDailyProductionPointBLL>();

    decimal dailyVariance =
        m.DailyActual - m.DailyTarget;

    decimal mtdVariance =
        m.MTDActual - m.MTDTarget;

    decimal ytdVariance =
        m.YTDActual - m.YTDTarget;

    decimal maxDelay = 0;

    /*
     * Use the HeatTarget returned by the SP.  The PeriodTarget fallback
     * also protects the card when an older repository mapper has not yet
     * mapped the HeatTarget column.
     */
    decimal heatTarget =
        Convert.ToDecimal(m.HeatTarget);

    decimal periodTarget =
        Convert.ToDecimal(m.PeriodTarget);

    if (heatTarget <= 0 && periodTarget > 0)
    {
        heatTarget = Math.Round(
            periodTarget / 140m,
            0,
            MidpointRounding.AwayFromZero
        );
    }

    for (int i = 0; i < topDelays.Count; i++)
    {
        if (topDelays[i].Minutes > maxDelay)
        {
            maxDelay = topDelays[i].Minutes;
        }
    }

    var dayLabels =
        new List<string>();

    var actualValues =
        new List<string>();

    DateTime chartToDate = m.ToDate.Date;
    DateTime chartFromDate = new DateTime(
        chartToDate.Year,
        chartToDate.Month,
        1
    );

    /*
     * Build a continuous month-to-date series up to the selected ToDate.
     * Missing dates remain zero and previous dates keep their production.
     */
    for (
        DateTime chartDate = chartFromDate;
        chartDate <= chartToDate;
        chartDate = chartDate.AddDays(1)
    )
    {
        decimal dayActual = 0;
        string dateLabel = chartDate.ToString("dd-MMM");

        for (int i = 0; i < dailyProduction.Count; i++)
        {
            if (dailyProduction[i].ProductionDate.Date != chartDate)
            {
                continue;
            }

            dayActual += dailyProduction[i].Actual;

            if (!string.IsNullOrWhiteSpace(dailyProduction[i].DateLabel))
            {
                dateLabel = dailyProduction[i].DateLabel;
            }
        }

        dayLabels.Add("\"" + dateLabel + "\"");

        actualValues.Add(
            dayActual.ToString(
                System.Globalization.CultureInfo.InvariantCulture
            )
        );

    }

    string dayLabelsJson =
        "[" + string.Join(",", dayLabels.ToArray()) + "]";

    string actualValuesJson =
        "[" + string.Join(",", actualValues.ToArray()) + "]";

    string pdfFileName =
        "SMP_Daily_Dashboard_" +
        m.FromDate.ToString("yyyyMMdd") +
        "_to_" +
        m.ToDate.ToString("yyyyMMdd") +
        ".pdf";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
    :root {
        --brand: #a91435;
        --brand-dark: #76001d;
        --red: #d60000;
        --green: #158f63;
        --orange: #efa500;
        --blue: #245f96;
        --page-bg: #eef1f5;
        --card-bg: #ffffff;
        --border: #d8dee8;
        --grid: #e8ecf1;
        --text: #1d2430;
        --muted: #697386;
        --radius: 13px;
        --shadow: 0 5px 18px rgba(17, 24, 39, .06);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--page-bg);
        color: var(--text);
    }

    .xp-contentbar {
        padding: 20px !important;
        background: var(--page-bg) !important;
    }

    .smp-dashboard {
        width: 100%;
        max-width: 1480px;
        margin: 0 auto;
    }

    /* ============================
       ACTIONS
    ============================ */

    .dashboard-actions {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 10px;
    }

    .print-btn {
        background: var(--brand);
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 9px 16px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

        .print-btn:hover {
            background: var(--brand-dark);
        }

        .print-btn i {
            margin-right: 6px;
        }

    /* ============================
       MAIN SHELL
    ============================ */

    .dashboard-shell {
        background: #f6f7f9;
        border: 1px solid #cfd5de;
        border-top: 8px solid var(--brand);
        padding: 22px;
        box-shadow: 0 8px 28px rgba(17, 24, 39, .08);
    }

    /* ============================
       HEADER
    ============================ */

    .dashboard-header {
        display: grid;
        grid-template-columns: 135px 1fr 235px;
        gap: 20px;
        align-items: center;
        margin-bottom: 20px;
    }

    .header-logo {
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }

        .header-logo img {
            width: 118px;
            max-height: 88px;
            object-fit: contain;
        }

    .header-title h1 {
        margin: 0;
        color: #172033;
        font-size: 34px;
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -.7px;
    }

    .header-title p {
        margin: 8px 0 0;
        font-size: 13px;
        color: #303846;
        font-weight: 650;
    }

    .header-meta {
        text-align: right;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.65;
    }

        .header-meta strong {
            display: block;
            margin-bottom: 2px;
            color: var(--text);
            font-size: 12px;
            font-weight: 900;
        }

        .header-meta i {
            margin-right: 5px;
            color: var(--brand);
        }

    /* ============================
       KPI GRID
    ============================ */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .kpi-card {
        position: relative;
        min-height: 112px;
        padding: 15px 15px 13px 18px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 11px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

        .kpi-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--orange);
        }

        .kpi-card.good::before {
            background: var(--green);
        }

        .kpi-card.bad::before {
            background: var(--brand);
        }

    .kpi-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
    }

    .kpi-name {
        font-size: 11px;
        color: #202632;
        font-weight: 900;
        line-height: 1.25;
    }

    .kpi-badge {
        width: 25px;
        height: 25px;
        border-radius: 50%;
        background: var(--orange);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 10px;
        font-weight: 900;
    }

    .kpi-card.good .kpi-badge {
        background: var(--green);
    }

    .kpi-card.bad .kpi-badge {
        background: var(--brand);
    }

    .kpi-value {
        margin-top: 10px;
        color: #111827;
        font-size: 26px;
        line-height: 1;
        font-weight: 900;
    }

    .kpi-target {
        margin-top: 8px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
    }

    /* ============================
       COMMON CARDS
    ============================ */

    .dashboard-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-header {
        min-height: 49px;
        padding: 13px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .card-title {
        margin: 0;
        color: var(--text);
        font-size: 16px;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .card-title i {
            color: var(--brand);
        }

    .card-note {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .card-body {
        padding: 16px;
    }

    /* ============================
       OVERVIEW
    ============================ */

    .overview-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(280px, .8fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    .variance-card .card-body {
        padding: 0;
    }

    .variance-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .variance-table th {
            background: #e4e8ee;
            padding: 12px 10px;
            text-align: center;
            color: #202632;
            font-weight: 900;
        }

        .variance-table td {
            padding: 14px 10px;
            text-align: center;
            border-bottom: 1px solid #edf0f4;
            font-weight: 700;
        }

            .variance-table td:first-child {
                text-align: left;
                padding-left: 20px;
                color: var(--muted);
                font-weight: 800;
            }

        .variance-table tr:last-child td {
            border-bottom: 0;
        }

        .variance-table tbody tr:last-child {
            background: #f8fafc;
        }

            .variance-table tbody tr:last-child td {
                padding-top: 11px;
                padding-bottom: 11px;
            }

    .variance-value {
        min-width: 92px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 6px 10px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 12px;
        line-height: 1;
        font-weight: 900;
        letter-spacing: .1px;
    }

        .variance-value .variance-arrow {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: inline-block;
            position: relative;
            flex: 0 0 20px;
        }

        .variance-value.up {
            color: #087a50;
            background: #e9f8f1;
            border-color: #bcebd7;
        }

            .variance-value.up .variance-arrow {
                background: #159565;
            }

                .variance-value.up .variance-arrow::before {
                    content: "";
                    position: absolute;
                    left: 9px;
                    top: 9px;
                    width: 2px;
                    height: 7px;
                    background: #fff;
                    border-radius: 2px;
                }

                .variance-value.up .variance-arrow::after {
                    content: "";
                    position: absolute;
                    left: 6px;
                    top: 4px;
                    width: 0;
                    height: 0;
                    border-left: 4px solid transparent;
                    border-right: 4px solid transparent;
                    border-bottom: 6px solid #fff;
                }

        .variance-value.down {
            color: #b42335;
            background: #fff0f2;
            border-color: #f3c5cd;
        }

            .variance-value.down .variance-arrow {
                background: #c83248;
            }

                .variance-value.down .variance-arrow::before {
                    content: "";
                    position: absolute;
                    left: 9px;
                    top: 4px;
                    width: 2px;
                    height: 7px;
                    background: #fff;
                    border-radius: 2px;
                }

                .variance-value.down .variance-arrow::after {
                    content: "";
                    position: absolute;
                    left: 6px;
                    top: 10px;
                    width: 0;
                    height: 0;
                    border-left: 4px solid transparent;
                    border-right: 4px solid transparent;
                    border-top: 6px solid #fff;
                }

        .variance-value.flat {
            color: #5f6b7a;
            background: #f1f4f7;
            border-color: #d9e0e8;
        }

            .variance-value.flat .variance-arrow {
                background: #778395;
            }

                .variance-value.flat .variance-arrow::before {
                    content: "";
                    position: absolute;
                    left: 5px;
                    top: 9px;
                    width: 10px;
                    height: 2px;
                    background: #fff;
                    border-radius: 2px;
                }

    .positive {
        color: var(--green) !important;
    }

    .negative {
        color: #e00000 !important;
    }

    .yearly-body {
        height: 202px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .single-donut-wrap {
        width: 168px;
        height: 168px;
        position: relative;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        color: #111827;
        font-size: 28px;
        font-weight: 900;
    }

    /* ============================
       MAIN ANALYTICS
    ============================ */

    .analytics-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 14px;
    }

    .chart-box {
        height: 265px;
        position: relative;
    }

    /* ============================
       DELAYS
    ============================ */

    .delay-list {
        display: grid;
        gap: 9px;
    }

    .delay-row {
        display: grid;
        grid-template-columns: 28px minmax(105px, 1fr) 76px 40px minmax(95px, 1fr);
        gap: 8px;
        align-items: center;
        padding: 9px 8px;
        border: 1px solid #edf0f4;
        border-radius: 9px;
        background: #fbfcfd;
    }

    .delay-rank {
        width: 23px;
        height: 23px;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 900;
    }

        .delay-rank.orange {
            background: var(--orange);
        }

    .delay-name {
        color: #202632;
        font-size: 11px;
        font-weight: 850;
    }

    .delay-track {
        height: 6px;
        border-radius: 20px;
        background: #e9edf2;
        overflow: hidden;
    }

        .delay-track span {
            display: block;
            height: 100%;
            background: var(--brand);
            border-radius: 20px;
        }

        .delay-track.orange span {
            background: var(--orange);
        }

    .delay-min {
        text-align: right;
        font-size: 11px;
        font-weight: 900;
    }

    .delay-area {
        color: var(--muted);
        font-size: 10px;
        line-height: 1.2;
        font-weight: 650;
    }

    .delay-note {
        margin-top: 12px;
        padding: 10px;
        border-radius: 8px;
        background: #f5f6f8;
        color: #303846;
        font-size: 10px;
        line-height: 1.4;
        font-weight: 700;
    }

    /* ============================
       LOWER GRID
    ============================ */

    .lower-grid {
        display: grid;
        grid-template-columns: minmax(300px, .8fr) minmax(360px, 1fr) minmax(0, 1.8fr);
        gap: 14px;
        margin-bottom: 14px;
    }

    .utility-chart-box {
        height: 250px;
        position: relative;
    }

    .composition-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .mini-donut-card {
        min-height: 250px;
        padding: 14px 12px;
        border: 1px solid #e2e6ec;
        border-radius: 10px;
        background: #fafbfc;
        text-align: center;
    }

    .mini-donut-title {
        margin-bottom: 10px;
        color: var(--text);
        font-size: 13px;
        font-weight: 900;
    }

    .mini-donut-wrap {
        width: 125px;
        height: 125px;
        position: relative;
        margin: 0 auto 11px;
    }

    .mini-center {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        font-weight: 900;
        pointer-events: none;
    }

    .legend-list {
        display: grid;
        gap: 5px;
        text-align: left;
        font-size: 9px;
        color: #303846;
        font-weight: 750;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .legend-color {
        width: 9px;
        height: 9px;
        display: inline-block;
        flex-shrink: 0;
    }

    .production-chart-box {
        height: 250px;
        position: relative;
    }

    /* ============================
       FOOTER
    ============================ */

    .dashboard-footer {
        margin-top: 8px;
        padding-top: 12px;
        border-top: 1px solid #cfd5de;
        color: var(--muted);
        text-align: right;
        font-size: 10px;
        font-weight: 700;
    }

        .dashboard-footer strong {
            color: var(--brand);
        }


    .header-filter {
        margin-top: 9px;
        display: flex;
        justify-content: flex-end;
        gap: 7px;
    }

        .header-filter input {
            height: 34px;
            padding: 5px 8px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: #fff;
            font-size: 12px;
        }

        .header-filter button {
            height: 34px;
            padding: 5px 12px;
            border: 0;
            border-radius: 7px;
            background: var(--brand);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
        }

    .empty-delay {
        padding: 18px;
        text-align: center;
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
    }

    /* ============================
       RESPONSIVE
    ============================ */

    @@media (max-width: 1250px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .analytics-grid {
            grid-template-columns: 1fr 1fr;
        }

            .analytics-grid > :last-child {
                grid-column: 1 / -1;
            }

        .lower-grid {
            grid-template-columns: 1fr 1fr;
        }

        .production-card {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 850px) {
        .dashboard-header {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .header-logo {
            justify-content: center;
        }

        .header-meta {
            text-align: center;
        }

        .overview-grid,
        .analytics-grid,
        .lower-grid {
            grid-template-columns: 1fr;
        }

            .analytics-grid > :last-child,
            .production-card {
                grid-column: auto;
            }
    }

    @@media (max-width: 600px) {
        .xp-contentbar {
            padding: 8px !important;
        }

        .dashboard-shell {
            padding: 12px;
        }

        .header-title h1 {
            font-size: 27px;
        }

        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .composition-grid {
            grid-template-columns: 1fr;
        }

        .delay-row {
            grid-template-columns: 28px 1fr 40px;
        }

        .delay-track,
        .delay-area {
            display: none;
        }
    }

    /* ============================
       PRINT
    ============================ */

    @@media print {
        @@page {
            size: A4 landscape;
            margin: 5mm;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        .no-print,
        .xp-breadcrumbbar,
        .navbar,
        .sidebar,
        .footer,
        .xp-leftbar,
        .xp-rightbar,
        .xp-topbar {
            display: none !important;
        }

        html,
        body,
        .xp-contentbar {
            background: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .smp-dashboard {
            max-width: none !important;
            width: 100% !important;
        }

        .dashboard-shell {
            border: 1px solid #bbb !important;
            border-top: 7px solid #a91435 !important;
            padding: 10px !important;
            box-shadow: none !important;
        }

        .dashboard-header {
            margin-bottom: 9px !important;
        }

        .kpi-grid {
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 6px !important;
            margin-bottom: 8px !important;
        }

        .kpi-card {
            min-height: 78px !important;
            padding: 8px 8px 7px 11px !important;
            box-shadow: none !important;
        }

        .kpi-value {
            font-size: 18px !important;
            margin-top: 5px !important;
        }

        .overview-grid {
            grid-template-columns: 2fr .7fr !important;
            gap: 7px !important;
            margin-bottom: 7px !important;
        }

        .analytics-grid {
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 7px !important;
            margin-bottom: 7px !important;
        }

        .lower-grid {
            grid-template-columns: .8fr 1fr 1.8fr !important;
            gap: 7px !important;
        }

        .dashboard-card,
        .kpi-card {
            box-shadow: none !important;
            page-break-inside: avoid !important;
        }

        .card-header {
            min-height: 34px !important;
            padding: 8px 9px !important;
        }

        .card-title {
            font-size: 12px !important;
        }

        .card-body {
            padding: 8px !important;
        }

        .chart-box,
        .utility-chart-box,
        .production-chart-box {
            height: 165px !important;
        }

        .yearly-body {
            height: 145px !important;
        }

        .single-donut-wrap {
            width: 130px !important;
            height: 130px !important;
        }

        .composition-grid {
            gap: 5px !important;
        }

        .mini-donut-card {
            min-height: 165px !important;
            padding: 6px !important;
        }

        .mini-donut-wrap {
            width: 88px !important;
            height: 88px !important;
        }

        .legend-list {
            font-size: 7px !important;
        }
    }

    /* Used only while generating the one-page PDF. */
    #smpPdfReport.pdf-export-mode {
        width: 1800px !important;
        max-width: none !important;
        height: auto !important;
        margin: 0 !important;
        padding: 12px !important;
        overflow: visible !important;
        background: #ffffff !important;
        box-shadow: none !important;
    }

        #smpPdfReport.pdf-export-mode .dashboard-header {
            grid-template-columns: 135px 1fr 235px !important;
