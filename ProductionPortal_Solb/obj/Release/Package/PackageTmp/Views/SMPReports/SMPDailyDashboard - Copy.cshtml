    async function downloadSMPDashboardPDF(button) {

        const report =
            document.getElementById("smpPdfReport");

        if (!report) {
            alert("Report area was not found.");
            return;
        }

        const originalButtonHtml =
            button ? button.innerHTML : "";

        if (button) {
            button.disabled = true;
            button.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin"></i> Preparing PDF...';
        }

        try {
            if (!window.html2canvas || !window.jspdf) {
                throw new Error("PDF libraries could not be loaded.");
            }

            report.classList.add("pdf-export-mode");

            if (document.fonts && document.fonts.ready) {
                await document.fonts.ready;
            }

            /* Finish chart animations before taking the snapshot. */
            if (window.Chart && typeof Chart.getChart === "function") {
                report.querySelectorAll("canvas").forEach(function (canvas) {
                    const chart = Chart.getChart(canvas);

                    if (chart) {
                        chart.stop();
                        chart.resize();
                        chart.update("none");
                    }
                });
            }

            await new Promise(function (resolve) {
                requestAnimationFrame(function () {
                    requestAnimationFrame(resolve);
                });
            });

            const reportWidth =
                Math.ceil(report.scrollWidth);

            const reportHeight =
                Math.ceil(report.scrollHeight);

            const canvas = await html2canvas(report, {
                scale: 2,
                useCORS: true,
                allowTaint: false,
                backgroundColor: "#ffffff",
                logging: false,
                width: reportWidth,
                height: reportHeight,
                windowWidth: reportWidth,
                windowHeight: reportHeight,
                scrollX: 0,
                scrollY: 0,
                ignoreElements: function (element) {
                    return element.classList &&
                        element.classList.contains("no-print");
                }
            });

            const jsPDF = window.jspdf.jsPDF;

            const pdf = new jsPDF({
                orientation: "landscape",
                unit: "mm",
                format: "a4",
                compress: true
            });

            const pageWidth =
                pdf.internal.pageSize.getWidth();

            const pageHeight =
                pdf.internal.pageSize.getHeight();

            const margin = 1.5;
            const availableWidth = pageWidth - (margin * 2);
            const availableHeight = pageHeight - (margin * 2);

            const fitRatio = Math.min(
                availableWidth / canvas.width,
                availableHeight / canvas.height
            );

            const imageWidth = canvas.width * fitRatio;
            const imageHeight = canvas.height * fitRatio;
            const imageX = (pageWidth - imageWidth) / 2;
            const imageY = (pageHeight - imageHeight) / 2;

            const imageData =
                canvas.toDataURL("image/png");

            pdf.addImage(
                imageData,
                "PNG",
                imageX,
                imageY,
                imageWidth,
                imageHeight,
                undefined,
                "FAST"
            );

            pdf.save("@pdfFileName");
        }
        catch (error) {
            console.error(error);
            alert(
                "PDF could not be generated. Please refresh the page and try again."
            );
        }
        finally {
            report.classList.remove("pdf-export-mode");

            if (window.Chart && typeof Chart.getChart === "function") {
                requestAnimationFrame(function () {
                    report.querySelectorAll("canvas").forEach(function (canvas) {
                        const chart = Chart.getChart(canvas);

                        if (chart) {
                            chart.resize();
                            chart.update("none");
                        }
                    });
                });
            }

            if (button) {
                button.disabled = false;
                button.innerHTML = originalButtonHtml;
            }
        }
    }
</script>