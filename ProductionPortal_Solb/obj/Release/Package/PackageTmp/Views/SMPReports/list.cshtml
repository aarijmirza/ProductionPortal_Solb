<!-- ================= SCRIPTS ================= -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        setTodayDefault();

        function getTodayText() {
            var today = new Date();
            var yyyy = today.getFullYear();
            var mm = String(today.getMonth() + 1).padStart(2, "0");
            var dd = String(today.getDate()).padStart(2, "0");

            return yyyy + "-" + mm + "-" + dd;
        }

        function setTodayDefault() {
            var todayText = getTodayText();

            if (!$("#fromDate").val()) {
                $("#fromDate").val(todayText);
            }

            if (!$("#toDate").val()) {
                $("#toDate").val(todayText);
            }
        }

        function showMessage(message, type) {
            var popup = $("#filterPopup");

            popup.removeClass("success error info");

            if (type === "success") {
                popup.addClass("success");
            } else if (type === "error") {
                popup.addClass("error");
            } else {
                popup.addClass("info");
            }

            popup.text(message);
            popup.stop(true, true).fadeIn(200);

            setTimeout(function () {
                popup.fadeOut(300);
            }, 2000);
        }

        function validateDates() {
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            if (!fromDate) {
                showMessage("Please select From Date.", "error");
                return false;
            }

            if (!toDate) {
                showMessage("Please select To Date.", "error");
                return false;
            }

            if (fromDate > toDate) {
                showMessage("From Date cannot be greater than To Date.", "error");
                return false;
            }

            return true;
        }

        function buildReportUrl(baseUrl, download) {
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            var params = [];

            if (fromDate) {
                params.push("from=" + encodeURIComponent(fromDate));
            }

            if (toDate) {
                params.push("to=" + encodeURIComponent(toDate));
            }

            params.push("download=" + encodeURIComponent(download));

            if (params.length > 0) {
                return baseUrl + "?" + params.join("&");
            }

            return baseUrl;
        }

        $("#todayBtn").click(function () {
            var todayText = getTodayText();

            $("#fromDate").val(todayText);
            $("#toDate").val(todayText);

            showMessage("Today date selected.", "success");
        });

        $("#filterBtn").click(function () {
            if (!validateDates()) {
                return;
            }

            showMessage("Filter applied successfully. Please click View Report.", "success");
        });

        $("#clearBtn").click(function () {
            $("#fromDate").val("");
            $("#toDate").val("");

            showMessage("Filter cleared.", "info");
        });

        $(document).on("click", ".openReport", function () {
            if (!validateDates()) {
                return;
            }

            var baseUrl = $(this).data("url");
            var finalUrl = buildReportUrl(baseUrl, false);

            window.open(finalUrl, "_blank");
        });

        $(document).on("click", ".downloadReport", function () {
            if (!validateDates()) {
                return;
            }

            var baseUrl = $(this).data("url");
            var finalUrl = buildReportUrl(baseUrl, true);

            window.open(finalUrl, "_blank");
        });

    });
</script>
