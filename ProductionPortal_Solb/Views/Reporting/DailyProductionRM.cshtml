    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 13px;
            margin: 0;
            padding: 0;
        }

        .sheet {
            margin: 10px auto;
            border: 1px solid #000;
            padding: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #000;
            padding: 2px 3px;
            vertical-align: middle;
        }

        .no-border td,
        .no-border th {
            border: none !important;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
            font-size: 28px;
        }

        .header-title {
            font-size: 16px;
            font-weight: bold;
        }

        .sub-header {
            font-size: 14px;
            font-weight: bold;
        }

        .small {
            font-size: 12px;
        }

        .section-title {
            font-weight: bold;
            background-color: #f2f2f2;
        }

        .red {
            color: #c00000;
            font-weight: bold;
        }

        .text-top {
            vertical-align: top;
        }

        .logo-cell img {
            max-height: 90px;
        }

        .total-row {
            font-weight: bold;
            background-color: #f9f9f9;
        }

        .legend-cell {
            font-size: 9px;
        }

        @@media print {
            body {
                margin: 0;
            }

            .sheet {
                margin: 0;
                border: none;
            }
        }

        .panel {
            background: #fff;
            position: relative;
        }

        .title {
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 6px;
        }

        .footnote {
            position: absolute;
            bottom: 6px;
            left: 8px;
            font-size: 14px;
            font-weight: bold;
            color: #000;
        }

        .panel {
            height: auto; /* 👈 FIXED HEIGHT HATAO */
        }
    </style>

</head>
