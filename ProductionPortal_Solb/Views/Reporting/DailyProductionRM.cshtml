    <script>
        const plan = 30000;
        const actual = 31000;

        // clamp actual so gauge never exceeds full arc
        const actualClamped = Math.min(actual, plan);
        const remaining = plan - actualClamped;
        const percent = ((actual / plan) * 100).toFixed(1);

        // Gradient bars
        const chPlanActualGauge = document.getElementById('chPlanActualGauge').getContext('2d');
        const gradientx = chPlanActualGauge.createLinearGradient(0, 0, 0, 180);
        gradientx.addColorStop(0, '#C00000');
        gradientx.addColorStop(1, '#C00000');

        // =======================
        // NEEDLE + CENTER TEXT
        // =======================

        const gaugePlugin = {
            id: 'gaugePlugin',
            afterDraw(chart) {
                const { ctx } = chart;
                const meta = chart.getDatasetMeta(0);
                if (!meta.data.length) return;

                const arc = meta.data[0];
                const cx = arc.x;
                const cy = arc.y;
                const r = arc.outerRadius;

                // ---- VALUES ----
                const plan = 30000;
                const actual = 31000;
                const actualClamped = Math.min(actual, plan);
                const percent = ((actual / plan) * 100).toFixed(1);

                // ---- NEEDLE ANGLE ----
                const ratio = actualClamped / plan;
                const startAngle = -Math.PI;     // left
                const endAngle = 0;              // right
                const angle = startAngle + (endAngle - startAngle) * ratio;

                ctx.save();
                ctx.translate(cx, cy);
                ctx.rotate(angle);

                // ---- NEEDLE ----
                ctx.beginPath();
                ctx.moveTo(0, -3);
                ctx.lineTo(r - 18, 0);
                ctx.lineTo(0, 3);
                ctx.fillStyle = '#000';
                ctx.fill();

                // ---- CENTER DOT ----
                ctx.beginPath();
                ctx.arc(0, 0, 5, 0, Math.PI * 2);
                ctx.fill();

                // ---- % TEXT AT POINTER TIP ----
                ctx.font = 'bold 12px Calibri';
                ctx.fillStyle = '#fff';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';

                ctx.fillText(`${percent}%`, r - 20, -14);

                ctx.restore();
            }
        };


        // =======================
        // GAUGE CHART
        // =======================
        new Chart(chPlanActualGauge, {
            type: 'doughnut',
            data: {
                labels: ['Actual', 'Remaining'],
                datasets: [{
                    data: [actualClamped, remaining],
                    backgroundColor: ['#C00000', '#E6E6E6'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: false,
                rotation: -90,        // 👈 start from left
                circumference: 180,    // 👈 half circle
                cutout: '70%',
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            boxWidth: 12,
                            font: { size: 10 },
                            generateLabels(chart) {
                                return [
                                    {
                                        text: 'Actual',
                                        fillStyle: '#C00000'
                                    },
                                    {
                                        text: 'Plan',
                                        fillStyle: '#E6E6E6'
                                    }
                                ];
                            }
                        }
                    },
                    tooltip: { enabled: false }
                }
            },
            plugins: [gaugePlugin]
        });
    </script>

