                            font: { size: 10 }
                        }
                    },

                    // ✅ SAME TEXT STYLING
                    datalabels: {
                        formatter: v => v.toFixed(1) + '%',
                        color: '#fff',
                        anchor: 'end',
                        align: 'bottom',
                        offset: 2,
                        rotation: -90,
                        textAlign: 'center',
                        font: {
                            size: 9,
                            weight: 'bold'
                        },
                        clamp: true
                    },

                    tooltip: { enabled: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            font: { size: 9 },
                            maxRotation: 0,
                            minRotation: 0
                        }
                    },
                    y: {
                        display: false,
                        beginAtZero: true,
                        suggestedMax: 100,   // 👈 Yield %
                        grid: {
                            display: false,
                            drawTicks: false
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>


