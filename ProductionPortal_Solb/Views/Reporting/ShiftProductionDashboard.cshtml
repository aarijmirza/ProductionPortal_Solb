                    {
                        foreach (var item in data)
                        {
                            decimal itemTotalWeight = item.TotalWeight ?? 0;
                            decimal itemTheoriticalWeight = item.TheoriticalWeight ?? 0;

                            decimal itemYield = itemTotalWeight > 0
                                ? (itemTotalWeight / itemTheoriticalWeight) * 100
                                : 0;

                            <tr>
                                <td>@item.DischargingSequence</td>
                                <td>@item.HeatNo</td>
                                <td>@item.SteelGrade</td>
                                <td>@item.Size</td>
                                <td>@item.TotalBillet</td>
                                <td>@item.TotalBillet</td>
                                <td>@item.Cobble</td>
                                <td>@item.HotOut</td>
                                <td>@itemTotalWeight.ToString("0.###")</td>
                                <td>@item.TotalBundleProduced</td>
                                <td>@(item.TotalBundleOnHold.HasValue ? item.TotalBundleOnHold.Value.ToString("0.00") : "0.00")</td>
                                <td>@(item.TotalRejectedBundle.HasValue ? item.TotalRejectedBundle.Value.ToString("0.00") : "0.00")</td>
                                <td>@(item.ShortBundleActualWeight.HasValue ? item.ShortBundleActualWeight.Value.ToString("0.00") : "0.00")</td>
                                <td>@itemTheoriticalWeight.ToString("0.###")</td>
                                <td>
                                    <span class="badge-soft-success">@itemYield.ToString("0.00")%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="text-center text-muted">
                                No production data found.
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="font-weight-bold">
                        <td colspan="4" class="text-right">Total</td>
                        <td>@totalDischarge</td>
                        <td>@totalRolled</td>
                        <td>@totalCobble</td>
                        <td>@totalHotOut</td>
                        <td>@totalWeight.ToString("0.###")</td>
                        <td>@totalBundles</td>
                        <td>@totalOnHold</td>
                        <td>@totalRejected</td>
                        <td>@totalShortWeight.ToString("0.00")</td>
                        <td>@theoriticalWeight.ToString("0.###")</td>
                        <td>@yieldValue.ToString("0.00")%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>

<script>
    Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
    Chart.defaults.color = "#444";

    var heatLabels = @Html.Raw(JsonConvert.SerializeObject(heatLabels));
    var billetRolledData = @Html.Raw(JsonConvert.SerializeObject(billetRolledData));
    var billetWeightData = @Html.Raw(JsonConvert.SerializeObject(billetWeightData));
    var finishedWeightData = @Html.Raw(JsonConvert.SerializeObject(finishedWeightData));
    var bundleData = @Html.Raw(JsonConvert.SerializeObject(bundleData));

    var downtimeAgencyLabels = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyLabels));
    var downtimeAgencyData = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyData));

    if (document.getElementById("downtimeAgencyChart")) {
        new Chart(document.getElementById("downtimeAgencyChart"), {
            type: "bar",
            data: {
                labels: downtimeAgencyLabels,
                datasets: [{
                    label: "Downtime Minutes",
                    data: downtimeAgencyData,
                    backgroundColor: "#c1121f",
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: "Minutes" }
                    }
                }
            }
        });
    }

    if (document.getElementById("heatWeightChart")) {
        new Chart(document.getElementById("heatWeightChart"), {
            type: "bar",
            data: {
                labels: heatLabels,
                datasets: [{
                    label: "Billet Discharge Wt. (MT)",
                    data: billetWeightData,
                    backgroundColor: "#0d6efd",
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: "MT" }
                    }
                }
            }
        });
    }

    if (document.getElementById("billetChart")) {
        new Chart(document.getElementById("billetChart"), {
            type: "line",
            data: {
                labels: heatLabels,
                datasets: [{
                    label: "Billet Rolled",
                    data: billetRolledData,
                    borderColor: "#198754",
                    backgroundColor: "rgba(25,135,84,0.15)",
                    tension: 0.35,
                    fill: true,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: "Nos." }
                    }
                }
            }
        });
    }

    if (document.getElementById("weightCompareChart")) {
        new Chart(document.getElementById("weightCompareChart"), {
            type: "bar",
            data: {
                labels: heatLabels,
                datasets: [
                    {
                        label: "Billet Wt. (MT)",
                        data: billetWeightData,
                        backgroundColor: "#0d6efd",
                        borderRadius: 8
                    },
                    {
                        label: "Finished Product Wt. (MT)",
                        data: finishedWeightData,
                        backgroundColor: "#198754",
                        borderRadius: 8
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: "MT" }
                    }
                }
            }
        });
    }
</script>