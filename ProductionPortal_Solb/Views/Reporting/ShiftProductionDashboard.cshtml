                    class="btn btn-sm btn-outline-secondary no-print"
                    id="btnToggleDowntime">
                <i class="fa fa-chevron-down"
                   id="downtimeToggleIcon"></i>
            </button>
        </div>

        <div id="downtimeDetailsBody" style="display:none;">
            <div class="card-body table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Start</th>
                            <th>Finish</th>
                            <th>Total Min</th>
                            <th>Delay Type</th>
                            <th>Agency</th>
                            <th>Equipment</th>
                            <th>Reason</th>
                            <th>Description</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (delays.Any())
                        {
                            foreach (var item in delays)
