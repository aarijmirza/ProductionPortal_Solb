        var productivityActualValue = @Html.Raw(JsonConvert.SerializeObject(productivityTonsHr));

        function numberLabel(value) {
            return Number(value || 0).toLocaleString();
        }

        var gaugeNeedlePlugin = {
            id: "gaugeNeedlePlugin",

            afterDatasetsDraw: function (
                chart,
                args,
                pluginOptions
            ) {
                if (!pluginOptions ||
                    !pluginOptions.enabled) {
                    return;
                }

                var meta = chart.getDatasetMeta(0);

                if (!meta ||
                    !meta.data ||
                    meta.data.length === 0) {
                    return;
                }

                var arc = meta.data[0];
                var ctx = chart.ctx;

                var actualValue =
                    Number(pluginOptions.actualValue || 0);

                var targetValue =
                    Number(pluginOptions.targetValue || 0);

                var maxValue =
                    Number(pluginOptions.maxValue || 1);

                if (maxValue <= 0) {
                    maxValue = 1;
                }

                function ratio(value) {
                    var result = value / maxValue;
                    if (result < 0) result = 0;
                    if (result > 1) result = 1;
                    return result;
                }

                var centerX = arc.x;
                var centerY = arc.y;

                // Target marker in maroon:
                // draw a clean radial line across the gauge ring.
                var targetAngle =
                    Math.PI +
                    (Math.PI * ratio(targetValue));

                var targetInnerRadius =
                    arc.innerRadius - 2;

                var targetOuterRadius =
                    arc.outerRadius + 2;

                var targetStartX =
                    centerX +
                    Math.cos(targetAngle) *
                    targetInnerRadius;

                var targetStartY =
                    centerY +
                    Math.sin(targetAngle) *
                    targetInnerRadius;

                var targetEndX =
                    centerX +
                    Math.cos(targetAngle) *
                    targetOuterRadius;

                var targetEndY =
                    centerY +
                    Math.sin(targetAngle) *
                    targetOuterRadius;

                ctx.save();
                ctx.beginPath();
                ctx.moveTo(
                    targetStartX,
                    targetStartY
                );
                ctx.lineTo(
                    targetEndX,
                    targetEndY
                );
                ctx.strokeStyle = "#a6173f";
                ctx.lineWidth = 5;
                ctx.lineCap = "round";
                ctx.stroke();
                ctx.restore();

                // Show target value beside the maroon target line.
                var unitLabel =
                    pluginOptions.unitLabel || "";

                var targetLabel =
                    "Target " +
                    Number(targetValue).toFixed(2) +
                    (unitLabel ? " " + unitLabel : "");

                var labelRadius =
                    arc.outerRadius + 17;

                var labelX =
                    centerX +
                    Math.cos(targetAngle) *
                    labelRadius;

                var labelY =
                    centerY +
                    Math.sin(targetAngle) *
                    labelRadius;

                ctx.save();
                ctx.font =
                    "700 10px Arial, Helvetica, sans-serif";

                var labelWidth =
                    ctx.measureText(targetLabel).width + 14;

                var labelHeight = 22;

                // Keep label inside the chart canvas.
                labelX = Math.max(
                    labelWidth / 2 + 3,
                    Math.min(
                        chart.width - labelWidth / 2 - 3,
                        labelX
                    )
                );

                labelY = Math.max(
                    labelHeight / 2 + 3,
                    Math.min(
                        chart.height - labelHeight / 2 - 3,
                        labelY
                    )
                );

                var boxX =
                    labelX - labelWidth / 2;

                var boxY =
                    labelY - labelHeight / 2;

                var radius = 6;

                ctx.beginPath();
                ctx.moveTo(boxX + radius, boxY);
                ctx.lineTo(
                    boxX + labelWidth - radius,
                    boxY
                );
                ctx.quadraticCurveTo(
                    boxX + labelWidth,
                    boxY,
                    boxX + labelWidth,
                    boxY + radius
                );
                ctx.lineTo(
                    boxX + labelWidth,
                    boxY + labelHeight - radius
                );
                ctx.quadraticCurveTo(
                    boxX + labelWidth,
                    boxY + labelHeight,
                    boxX + labelWidth - radius,
                    boxY + labelHeight
                );
                ctx.lineTo(
                    boxX + radius,
                    boxY + labelHeight
                );
                ctx.quadraticCurveTo(
                    boxX,
                    boxY + labelHeight,
                    boxX,
                    boxY + labelHeight - radius
                );
                ctx.lineTo(boxX, boxY + radius);
                ctx.quadraticCurveTo(
                    boxX,
                    boxY,
                    boxX + radius,
                    boxY
                );
                ctx.closePath();

                ctx.fillStyle =
                    "rgba(255,255,255,0.96)";
                ctx.fill();

                ctx.strokeStyle = "#a6173f";
                ctx.lineWidth = 1;
                ctx.stroke();

                ctx.fillStyle = "#a6173f";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText(
                    targetLabel,
                    labelX,
                    labelY + 0.5
                );

                ctx.restore();

                // Actual needle in grey.
                var actualAngle =
                    Math.PI +
                    (Math.PI * ratio(actualValue));

                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(actualAngle);

                ctx.beginPath();
                ctx.moveTo(0, -4);
                ctx.lineTo(
                    arc.outerRadius * 0.78,
                    0
                );
                ctx.lineTo(0, 4);
                ctx.closePath();

                ctx.fillStyle = "#6b7280";
                ctx.fill();

                ctx.beginPath();
                ctx.arc(0, 0, 8, 0, Math.PI * 2);
                ctx.fillStyle = "#6b7280";
                ctx.fill();

                ctx.beginPath();
                ctx.arc(0, 0, 3.5, 0, Math.PI * 2);
                ctx.fillStyle = "#ffffff";
                ctx.fill();

                ctx.restore();
            }
        };

        Chart.register(gaugeNeedlePlugin);

