                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 0,
                                font: {
                                    weight: "bold"
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grace: "20%",
                            grid: {
                                color: "rgba(0,0,0,0.08)"
                            },
                            title: {
                                display: true,
                                text: "Finished Production (MT)"
                            },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
