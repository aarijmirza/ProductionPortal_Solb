    }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 14px;
        flex-shrink: 0;
    }

    .bg-red {
        background: #c1121f;
    }

    .bg-green {
        background: #198754;
    }

    .bg-blue {
        background: #0d6efd;
    }

    .bg-orange {
        background: #fd7e14;
    }

    .bg-purple {
        background: #6f42c1;
    }

    .bg-teal {
        background: #0f766e;
    }

    .section-card {
        border: 1px solid rgba(148,163,184,0.18);
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15,23,42,0.07);
        margin-bottom: 22px;
        background: var(--solb-surface);
        overflow: hidden;
