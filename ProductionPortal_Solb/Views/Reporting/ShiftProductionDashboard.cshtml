        function createMonthlyDelayAgencyChart() {
            var canvas =
                document.getElementById(
                    "monthlyDelayAgencyChart"
                );

            if (!canvas) return;

            var labels =
                downtimeAgencyNames &&
                downtimeAgencyNames.length > 0
                    ? downtimeAgencyNames
                    : ["No Delay"];

            var targetValues =
                downtimeAgencyTargetData &&
                downtimeAgencyTargetData.length > 0
                    ? downtimeAgencyTargetData
                    : [0];

            var actualValues =
                downtimeAgencyActualData &&
                downtimeAgencyActualData.length > 0
                    ? downtimeAgencyActualData
                    : [0];

            var highestValue = Math.max.apply(
                null,
                targetValues
                    .concat(actualValues)
                    .map(function (value) {
                        return Number(value || 0);
                    })
            );

            var axisMaximum;

            if (highestValue <= 1) {
                axisMaximum = 1;
            }
            else if (highestValue <= 5) {
                axisMaximum = Math.ceil(
                    highestValue * 1.40
                );
            }
            else if (highestValue <= 10) {
                axisMaximum = Math.ceil(
                    highestValue * 1.25
                );
            }
            else {
                axisMaximum = Math.ceil(
                    highestValue * 1.15
                );
            }

            axisMaximum = Math.max(
                axisMaximum,
                1
            );

            new Chart(canvas, {
                type: "bar",

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: "Target",
                            data: targetValues,
                            backgroundColor: "#a6173f",
                            borderColor: "#7f1230",
                            borderWidth: 1,
                            borderRadius: 7,
                            maxBarThickness: 42
                        },
                        {
                            label: "Actual",
                            data: actualValues,
                            backgroundColor: "#9ca3af",
                            borderColor: "#6b7280",
                            borderWidth: 1,
                            borderRadius: 7,
                            maxBarThickness: 42
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    layout: {
                        padding: {
                            top: 18,
                            right: 12,
                            left: 8,
                            bottom: 4
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                color: "#374151",
                                maxRotation: 35,
                                minRotation: 0,
                                autoSkip: false,
                                font: {
                                    size: 9,
                                    weight: "700"
                                },

                                callback: function (
                                    value
                                ) {
                                    var label =
                                        this.getLabelForValue(
                                            value
                                        );

                                    return label.length > 15
                                        ? label.substring(
                                            0,
                                            15
                                        ) + "…"
                                        : label;
                                }
                            }
                        },

                        y: {
                            beginAtZero: true,
                            suggestedMax: axisMaximum,
                            max: axisMaximum,

                            title: {
                                display: true,
                                text:
                                    "Accumulated Delay Percentage (%)",
                                color: "#4b5563",
                                font: {
                                    size: 11,
                                    weight: "bold"
                                }
                            },

                            grid: {
                                color:
                                    "rgba(107,114,128,0.12)"
                            },

                            ticks: {
                                maxTicksLimit: 6,

                                callback: function (value) {
                                    return Number(
                                        value || 0
                                    ).toFixed(
                                        axisMaximum <= 5
                                            ? 1
                                            : 0
                                    ) + "%";
                                }
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            display: true,
                            position: "top",
                            align: "center",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                boxWidth: 9,
                                boxHeight: 9,
                                padding: 18,
                                color: "#374151",

                                font: {
                                    size: 11,
                                    weight: "700"
                                }
                            }
                        },

                        tooltip: {
                            callbacks: {
                                title: function (items) {
                                    if (!items ||
                                        items.length === 0) {
                                        return "";
                                    }

                                    return labels[
                                        items[0].dataIndex
                                    ];
                                },

                                label: function (context) {
                                    return context.dataset.label +
                                        ": " +
                                        Number(
                                            context.raw || 0
                                        ).toFixed(2) +
                                        "%";
                                }
                            }
                        },

                        datalabels: {
                            display: function (context) {
                                return Number(
                                    context.dataset.data[
                                        context.dataIndex
                                    ] || 0
                                ) > 0;
                            },

                            formatter: function (value) {
                                return Number(
                                    value || 0
                                ).toFixed(2) + "%";
                            },

                            color: function (context) {
                                return context.dataset.label ===
                                    "Target"
                                        ? "#7f1230"
                                        : "#4b5563";
                            },

                            anchor: "end",
                            align: "top",
                            offset: 3,
                            clamp: true,

                            font: {
                                size: 9,
                                weight: "bold"
                            }
                        }
                    }
                }
            });
        }

