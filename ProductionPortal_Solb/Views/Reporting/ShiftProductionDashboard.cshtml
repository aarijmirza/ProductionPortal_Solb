                    class="btn btn-sm btn-outline-secondary no-print"
                    id="btnToggleProduction">
                <i class="fa fa-chevron-down" id="productionToggleIcon"></i>
            </button>
        </div>

        <div id="productionDetailsBody" style="display:none;">
            <div class="card-body table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Seq.</th>
                            <th>Heat No</th>
                            <th>Grade</th>
                            <th>Size</th>
                            <th>Billet Discharge</th>
                            <th>Billet Rolled</th>
                            <th>Cobble</th>
                            <th>Hot Out</th>
                            <th>Discharge Wt.</th>
                            <th>Bundles</th>
                            <th>On-Hold</th>
                            <th>Reject</th>
                            <th>Short Wt.</th>
                            <th>Finished Product Wt.</th>
                            <th>Yield %</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (data != null && data.Any())
                        {
                            foreach (var item in data)
                            {
                                decimal itemTotalWeight = item.TotalWeight ?? 0;
                                decimal itemTheoriticalWeight =
                                    item.TheoriticalWeight ?? 0;

                                decimal itemYield = itemTotalWeight > 0
                                    ? (itemTheoriticalWeight / itemTotalWeight) * 100
                                    : 0;

                                <tr>
                                    <td>@item.DischargingSequence</td>
                                    <td>@item.HeatNo</td>
                                    <td>@item.SteelGrade</td>
                                    <td>@item.Size</td>
                                    <td>@item.TotalBillet</td>
                                    <td>@item.TotalBillet</td>
                                    <td>@item.Cobble</td>
                                    <td>@item.HotOut</td>
                                    <td>@itemTotalWeight.ToString("0.###")</td>
                                    <td>@item.TotalBundleProduced</td>

                                    <td>
                                        @(item.TotalBundleOnHold.HasValue
                                        ? item.TotalBundleOnHold.Value.ToString("0.00")
                                        : "0.00")
                                    </td>

                                    <td>
                                        @(item.TotalRejectedBundle.HasValue
                                        ? item.TotalRejectedBundle.Value.ToString("0.00")
                                        : "0.00")
                                    </td>

                                    <td>
                                        @(item.ShortBundleActualWeight.HasValue
                                        ? item.ShortBundleActualWeight.Value.ToString("0.00")
                                        : "0.00")
                                    </td>

                                    <td>@itemTheoriticalWeight.ToString("0.###")</td>

                                    <td>
                                        <span class="badge-soft-success">
                                            @itemYield.ToString("0.00")%
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted">
                                    No production data found.
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr class="font-weight-bold">
                            <td colspan="4" class="text-right">Total</td>
                            <td>@totalDischarge</td>
                            <td>@totalRolled</td>
                            <td>@totalCobble</td>
                            <td>@totalHotOut</td>
                            <td>@totalWeight.ToString("0.###")</td>
                            <td>@totalBundles</td>
                            <td>@totalOnHold</td>
                            <td>@totalRejected</td>
                            <td>@totalShortWeight.ToString("0.00")</td>
                            <td>@theoriticalWeight.ToString("0.###")</td>
                            <td>@yieldValue.ToString("0.00")%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>



</div>

<script>
    $(document).ready(function () {
        $("#btnToggleDowntime").on("click", function () {
            $("#downtimeDetailsBody").slideToggle(200);
            $("#downtimeToggleIcon")
                .toggleClass("fa-chevron-down fa-chevron-up");
        });

        $("#btnToggleProduction").on("click", function () {
            $("#productionDetailsBody").slideToggle(200);
            $("#productionToggleIcon")
                .toggleClass("fa-chevron-down fa-chevron-up");
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof Chart === "undefined") {
            console.error("Chart.js library is not loaded.");
            return;
        }

        Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
        Chart.defaults.color = "#444";

        // Register plugin before creating any chart.
        if (typeof ChartDataLabels !== "undefined") {
            Chart.register(ChartDataLabels);
        }

        var heatLabels = @Html.Raw(JsonConvert.SerializeObject(heatLabels));
        var billetRolledData = @Html.Raw(JsonConvert.SerializeObject(billetRolledData));
        var billetWeightData = @Html.Raw(JsonConvert.SerializeObject(billetWeightData));
        var finishedWeightData = @Html.Raw(JsonConvert.SerializeObject(finishedWeightData));

        var productivityDateLabels =
            @Html.Raw(JsonConvert.SerializeObject(productivityDateLabels));

        var productivityDayData =
            @Html.Raw(JsonConvert.SerializeObject(productivityDayData));

        var monthlySizeLabels =
            @Html.Raw(JsonConvert.SerializeObject(monthlySizeLabels));

        var monthlySizeProductionData =
            @Html.Raw(JsonConvert.SerializeObject(monthlySizeProductionData));

        var downtimeAgencyLabels = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyLabels));
        var downtimeAgencyNames = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyNames));
        var downtimeAgencyTargetData = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyTargetData));
        var downtimeAgencyActualData = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyActualData));
        var downtimeAgencyActualMinutes = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyActualMinutes));

        var monthlyDelayAgencyLabels =
            @Html.Raw(JsonConvert.SerializeObject(monthlyDelayAgencyLabels));

        var monthlyDelayAgencyPercentages =
            @Html.Raw(JsonConvert.SerializeObject(monthlyDelayAgencyPercentages));

        var productionTarget = @Html.Raw(JsonConvert.SerializeObject(productionTarget));
        var productionActual = @Html.Raw(JsonConvert.SerializeObject(productionActual));
        var productionDifference = @Html.Raw(JsonConvert.SerializeObject(productionDifference));

        var dailyProductionTargetValue = @Html.Raw(JsonConvert.SerializeObject(dailyProductionTarget));
        var dailyProductionActualValue = @Html.Raw(JsonConvert.SerializeObject(dailyProductionActual));
        var fuelConsumptionTargetValue = @Html.Raw(JsonConvert.SerializeObject(fuelConsumptionTarget));
        var fuelConsumptionActualValue = @Html.Raw(JsonConvert.SerializeObject(fuelConsumptionActual));

        var electricityConsumptionTargetValue = @Html.Raw(JsonConvert.SerializeObject(electricityConsumptionTarget));
        var electricityConsumptionActualValue = @Html.Raw(JsonConvert.SerializeObject(electricityConsumptionActual));
        var waterConsumptionTargetValue = @Html.Raw(JsonConvert.SerializeObject(waterConsumptionTarget));
        var waterConsumptionActualValue = @Html.Raw(JsonConvert.SerializeObject(waterConsumptionActual));

        var yieldTargetValue = @Html.Raw(JsonConvert.SerializeObject(yieldTarget));
        var yieldActualValue = @Html.Raw(JsonConvert.SerializeObject(yieldValue));
        var rrrTargetValue = @Html.Raw(JsonConvert.SerializeObject(rrrTarget));
        var rrrActualValue = @Html.Raw(JsonConvert.SerializeObject(rrrValue));

        var productivityTargetValue = @Html.Raw(JsonConvert.SerializeObject(productivityTarget));
        var productivityActualValue = @Html.Raw(JsonConvert.SerializeObject(productivityTonsHr));

        function numberLabel(value) {
            return Number(value || 0).toLocaleString();
        }

        var gaugeNeedlePlugin = {
            id: "gaugeNeedlePlugin",

            afterDatasetsDraw: function (
                chart,
                args,
                pluginOptions
            ) {
                if (!pluginOptions ||
                    !pluginOptions.enabled) {
                    return;
                }

                var meta = chart.getDatasetMeta(0);

                if (!meta ||
                    !meta.data ||
                    meta.data.length === 0) {
                    return;
                }

                var arc = meta.data[0];
                var ctx = chart.ctx;

                var actualValue =
                    Number(pluginOptions.actualValue || 0);

                var targetValue =
                    Number(pluginOptions.targetValue || 0);

                var maxValue =
                    Number(pluginOptions.maxValue || 1);

                if (maxValue <= 0) {
                    maxValue = 1;
                }

                function ratio(value) {
                    var result = value / maxValue;
                    if (result < 0) result = 0;
                    if (result > 1) result = 1;
                    return result;
                }

                var centerX = arc.x;
                var centerY = arc.y;

                // Target marker in maroon:
                // draw a clean radial line across the gauge ring.
                var targetAngle =
                    Math.PI +
                    (Math.PI * ratio(targetValue));

                var targetInnerRadius =
                    arc.innerRadius - 2;

                var targetOuterRadius =
                    arc.outerRadius + 2;

                var targetStartX =
                    centerX +
                    Math.cos(targetAngle) *
                    targetInnerRadius;

                var targetStartY =
                    centerY +
                    Math.sin(targetAngle) *
                    targetInnerRadius;

                var targetEndX =
                    centerX +
                    Math.cos(targetAngle) *
                    targetOuterRadius;

                var targetEndY =
                    centerY +
                    Math.sin(targetAngle) *
                    targetOuterRadius;

                ctx.save();
                ctx.beginPath();
                ctx.moveTo(
                    targetStartX,
                    targetStartY
                );
                ctx.lineTo(
                    targetEndX,
                    targetEndY
                );
                ctx.strokeStyle = "#a6173f";
                ctx.lineWidth = 5;
                ctx.lineCap = "round";
                ctx.stroke();
                ctx.restore();

                // Show target value beside the maroon target line.
                var unitLabel =
                    pluginOptions.unitLabel || "";

                var targetLabel =
                    "Target " +
                    Number(targetValue).toFixed(2) +
                    (unitLabel ? " " + unitLabel : "");

                var labelRadius =
                    arc.outerRadius + 17;

                var labelX =
                    centerX +
                    Math.cos(targetAngle) *
                    labelRadius;

                var labelY =
                    centerY +
                    Math.sin(targetAngle) *
                    labelRadius;

                ctx.save();
                ctx.font =
                    "700 10px Arial, Helvetica, sans-serif";

                var labelWidth =
                    ctx.measureText(targetLabel).width + 14;

                var labelHeight = 22;

                // Keep label inside the chart canvas.
                labelX = Math.max(
                    labelWidth / 2 + 3,
                    Math.min(
                        chart.width - labelWidth / 2 - 3,
                        labelX
                    )
                );

                labelY = Math.max(
                    labelHeight / 2 + 3,
                    Math.min(
                        chart.height - labelHeight / 2 - 3,
                        labelY
                    )
                );

                var boxX =
                    labelX - labelWidth / 2;

                var boxY =
                    labelY - labelHeight / 2;

                var radius = 6;

                ctx.beginPath();
                ctx.moveTo(boxX + radius, boxY);
                ctx.lineTo(
                    boxX + labelWidth - radius,
                    boxY
                );
                ctx.quadraticCurveTo(
                    boxX + labelWidth,
                    boxY,
                    boxX + labelWidth,
                    boxY + radius
                );
                ctx.lineTo(
                    boxX + labelWidth,
                    boxY + labelHeight - radius
                );
                ctx.quadraticCurveTo(
                    boxX + labelWidth,
                    boxY + labelHeight,
                    boxX + labelWidth - radius,
                    boxY + labelHeight
                );
                ctx.lineTo(
                    boxX + radius,
                    boxY + labelHeight
                );
                ctx.quadraticCurveTo(
                    boxX,
                    boxY + labelHeight,
                    boxX,
                    boxY + labelHeight - radius
                );
                ctx.lineTo(boxX, boxY + radius);
                ctx.quadraticCurveTo(
                    boxX,
                    boxY,
                    boxX + radius,
                    boxY
                );
                ctx.closePath();

                ctx.fillStyle =
                    "rgba(255,255,255,0.96)";
                ctx.fill();

                ctx.strokeStyle = "#a6173f";
                ctx.lineWidth = 1;
                ctx.stroke();

                ctx.fillStyle = "#a6173f";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText(
                    targetLabel,
                    labelX,
                    labelY + 0.5
                );

                ctx.restore();

                // Actual needle in grey.
                var actualAngle =
                    Math.PI +
                    (Math.PI * ratio(actualValue));

                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(actualAngle);

                ctx.beginPath();
                ctx.moveTo(0, -4);
                ctx.lineTo(
                    arc.outerRadius * 0.78,
                    0
                );
                ctx.lineTo(0, 4);
                ctx.closePath();

                ctx.fillStyle = "#6b7280";
                ctx.fill();

                ctx.beginPath();
                ctx.arc(0, 0, 8, 0, Math.PI * 2);
                ctx.fillStyle = "#6b7280";
                ctx.fill();

                ctx.beginPath();
                ctx.arc(0, 0, 3.5, 0, Math.PI * 2);
                ctx.fillStyle = "#ffffff";
                ctx.fill();

                ctx.restore();
            }
        };

        Chart.register(gaugeNeedlePlugin);

        function createDoubleSemiGaugeChart(
            canvasId,
            targetValue,
            actualValue,
            unitLabel,
            actualBackground,
            targetBackground
        ) {
            var canvas =
                document.getElementById(canvasId);

            if (!canvas) return;

            var target = Number(targetValue || 0);
            var actual = Number(actualValue || 0);

            var maximumValue = Math.max(
                target,
                actual,
                1
            ) * 1.10;

            var actualSafe = Math.max(
                0,
                Math.min(actual, maximumValue)
            );

            var targetSafe = Math.max(
                0,
                Math.min(target, maximumValue)
            );

            new Chart(canvas, {
                type: "doughnut",

                data: {
                    datasets: [
                        {
                            label: "Actual",
                            data: [
                                actualSafe,
                                Math.max(
                                    maximumValue - actualSafe,
                                    0
                                )
                            ],
                            backgroundColor: [
                                "#9ca3af",
                                actualBackground || "#e5e7eb"
                            ],
                            borderWidth: 0,
                            weight: 1.18
                        },
                        {
                            label: "Target",
                            data: [
                                targetSafe,
                                Math.max(
                                    maximumValue - targetSafe,
                                    0
                                )
                            ],
                            backgroundColor: [
                                "#a6173f",
                                targetBackground || "#f3d6df"
                            ],
                            borderWidth: 0,
                            weight: 0.88
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    rotation: -90,
                    circumference: 180,
                    cutout: "42%",

                    plugins: {
                        legend: {
                            display: false
                        },

                        tooltip: {
                            filter: function (item) {
                                return item.dataIndex === 0;
                            },

                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label +
                                        ": " +
                                        Number(context.raw || 0)
                                            .toFixed(2) +
                                        " " +
                                        unitLabel;
                                }
                            }
                        },

                        datalabels: {
                            display: false
                        }
                    }
                }
            });
        }

        function createGaugeChart(
            canvasId,
            targetValue,
            actualValue,
            unitLabel,
            lowerIsBetter,
            actualColor,
            remainingColor
        ) {
            var canvas =
                document.getElementById(canvasId);

            if (!canvas) return;

            var target = Number(targetValue || 0);
            var actual = Number(actualValue || 0);

            var maximumValue = Math.max(
                target,
                actual,
                1
            );

            maximumValue = maximumValue * 1.20;

            var actualRatio =
                actual / maximumValue;

            if (actualRatio < 0) actualRatio = 0;
            if (actualRatio > 1) actualRatio = 1;

            var actualPercent =
                actualRatio * 100;

            new Chart(canvas, {
                type: "doughnut",

                data: {
                    labels: [
                        "Actual",
                        "Remaining"
                    ],

                    datasets: [{
                        data: [
                            actualPercent,
                            100 - actualPercent
                        ],

                        backgroundColor: [
                            actualColor || "#9ca3af",
                            remainingColor || "#e5e7eb"
                        ],

                        borderWidth: 0,
                        hoverOffset: 0
                    }]
                },

