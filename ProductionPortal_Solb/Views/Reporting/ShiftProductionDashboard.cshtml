@model DAL.Models.ViewModel.ShiftProductionReportVM
@using System.Globalization
@using Newtonsoft.Json
@using System.Linq
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var monthlyData =
        Model != null && Model.MonthlyProductionData != null
            ? Model.MonthlyProductionData
            : new List<DAL.Models.BilletDischargingBLL>();

    var data = Model != null && Model.DischargedHeats != null
        ? Model.DischargedHeats
        : new List<DAL.Models.BilletDischargingBLL>();

    var delays = Model != null && Model.Delays != null
        ? Model.Delays
        : new List<DAL.Models.PlantDelayBLL>();

    decimal totalDischarge = data.Sum(x => x.TotalBillet ?? 0);
    decimal totalRolled = data.Sum(x => x.TotalBillet ?? 0);

    decimal totalCobble = data.Sum(x => Convert.ToDecimal(x.Cobble));
    decimal totalHotOut = data.Sum(x => Convert.ToDecimal(x.HotOut));

    decimal totalWeight = data.Sum(x => x.TotalWeight ?? 0);
    decimal totalBundles = data.Sum(x => x.TotalBundleProduced ?? 0);
    decimal theoriticalWeight = data.Sum(x => x.TheoriticalWeight ?? 0);

    decimal totalOnHold = data.Sum(x => x.TotalBundleOnHold ?? 0);
    decimal totalRejected = data.Sum(x => x.TotalRejectedBundle ?? 0);
    decimal totalShortWeight = data.Sum(x => x.ShortBundleActualWeight ?? 0);

    int totalDelayDuration = delays.Sum(x => x.TotalDuration ?? 0);
    int totalDelayCobble = delays.Sum(x => x.Cobble ?? 0);
    int totalDelayHotOut = delays.Sum(x => x.HotOut ?? 0);

    decimal yieldValue = totalWeight > 0
        ? (theoriticalWeight / totalWeight) * 100
        : 0;

    string sizes = data.Any()
        ? string.Join(", ", data
            .Where(x => !string.IsNullOrWhiteSpace(x.Size))
            .Select(x => x.Size.Trim())
            .Distinct())
        : "-";

    string profiles = data.Any()
        ? string.Join(", ", data
            .Where(x => !string.IsNullOrWhiteSpace(x.Profile))
            .Select(x => x.Profile.Trim())
            .Distinct())
        : "-";

    string sizeProfiles = data.Any()
        ? string.Join(", ", data
            .Where(x =>
                !string.IsNullOrWhiteSpace(x.Size) ||
                !string.IsNullOrWhiteSpace(x.Profile))
            .Select(x =>
            {
                string size = string.IsNullOrWhiteSpace(x.Size)
                    ? string.Empty
                    : x.Size.Trim();

                string profile = string.IsNullOrWhiteSpace(x.Profile)
                    ? string.Empty
                    : x.Profile.Trim();

                if (!string.IsNullOrWhiteSpace(size) &&
                    !string.IsNullOrWhiteSpace(profile))
                {
                    return size + " - " + profile;
                }

                return !string.IsNullOrWhiteSpace(size)
                    ? size
                    : profile;
            })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct())
        : "-";

    var heatLabels = data.Select(x => x.HeatNo ?? "").ToList();
    var billetRolledData = data.Select(x => x.TotalBillet ?? 0).ToList();
    var billetWeightData = data.Select(x => x.TotalWeight ?? 0).ToList();
    var finishedWeightData = data.Select(x => x.TheoriticalWeight ?? 0).ToList();
    var bundleData = data.Select(x => x.TotalBundleProduced ?? 0).ToList();

    // Daily production chart data
    var dailyProductionByDay = monthlyData
        .Where(x => x.Date != DateTime.MinValue)
        .GroupBy(x => x.Date.Date)
        .OrderBy(g => g.Key)
        .Select(g => new
        {
            Date = g.Key.ToString("dd-MMM-yyyy"),

            DailyProduction = Math.Round(
                g.Sum(x => x.TheoriticalWeight ?? 0),
                2
            )
        })
        .ToList();

    // Day-wise production: har date ki apni production, running total nahi.
    var productivityDateLabels = dailyProductionByDay
        .Select(x => x.Date)
        .ToList();

    var productivityDayData = dailyProductionByDay
        .Select(x => x.DailyProduction)
        .ToList();

    // Monthly size-wise finished production
    var monthlySizeProduction = monthlyData
        .Where(x => !string.IsNullOrWhiteSpace(x.Size))
        .GroupBy(x => x.Size.Trim())
        .OrderBy(x => x.Key)
        .Select(g => new
        {
            Size = g.Key,
            Production = Math.Round(
                g.Sum(x => x.TheoriticalWeight ?? 0),
                2
            )
        })
        .ToList();

    var monthlySizeLabels = monthlySizeProduction
        .Select(x => x.Size)
        .ToList();

    var monthlySizeProductionData = monthlySizeProduction
        .Select(x => x.Production)
        .ToList();

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    // ================= FORMULA CALCULATIONS =================

    decimal totalFinishedProd = theoriticalWeight;
    // Agar Finished Product = TotalWeight chahiye to above line ko replace karo:
    // decimal totalFinishedProd = totalWeight;

    // Target Vs Actual chart values
    decimal productionTarget = ViewBag.ProductionPlan != null
        ? Convert.ToDecimal(ViewBag.ProductionPlan)
        : 30000;

    // Monthly accumulated actual:
    // selected To Date se pehle jitni production hui hai uska total.
    DateTime selectedToDateForAccumulation;

    bool hasSelectedToDate = DateTime.TryParseExact(
        Convert.ToString(ViewBag.ToDate),
        "yyyy-MM-dd",
        CultureInfo.InvariantCulture,
        DateTimeStyles.None,
        out selectedToDateForAccumulation
    );

    if (!hasSelectedToDate)
    {
        selectedToDateForAccumulation = DateTime.Today;
    }

    decimal productionActual = monthlyData
        .Where(x =>
            x.Date != DateTime.MinValue &&
            x.Date.Date < selectedToDateForAccumulation.Date
        )
        .Sum(x => x.TheoriticalWeight ?? 0);

    // Monthly accumulated Finished Product up to and including
    // the selected report date.
    decimal monthlyAccumulatedFinishedProduct = monthlyData
        .Where(x =>
            x.Date != DateTime.MinValue &&
            x.Date.Date <= selectedToDateForAccumulation.Date
        )
        .Sum(x => x.TheoriticalWeight ?? 0);

    decimal productionDifference = Math.Abs(
        productionTarget - productionActual
    );

    string selectedShift = Convert.ToString(ViewBag.ReportShift ?? "").Trim();

    Func<string, decimal> GetShiftHours = shiftName =>
    {
        if (string.IsNullOrWhiteSpace(shiftName))
            return 0;

        shiftName = shiftName.Trim();

        if (shiftName.Equals("Morning", StringComparison.OrdinalIgnoreCase) ||
            shiftName.Equals("Evening", StringComparison.OrdinalIgnoreCase) ||
            shiftName.Equals("Night", StringComparison.OrdinalIgnoreCase))
        {
            return 8;
        }

        if (shiftName.Equals("Long Morning", StringComparison.OrdinalIgnoreCase) ||
            shiftName.Equals("Long Night", StringComparison.OrdinalIgnoreCase))
        {
            return 12;
        }

        return 0;
    };

    // Production list se shifts uthao
    var productionShifts = data
        .Where(x => !string.IsNullOrWhiteSpace(x.Shift))
        .Select(x => x.Shift.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Delay list se shifts uthao
    var delayShifts = delays
        .Where(x => !string.IsNullOrWhiteSpace(x.Shift))
        .Select(x => x.Shift.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Dono lists combine karo
    var allShifts = productionShifts
        .Union(delayShifts, StringComparer.OrdinalIgnoreCase)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    //string sizes = data.Any()
    //? string.Join(", ", data
    //    .Where(x => !string.IsNullOrWhiteSpace(x.Size))
    //    .Select(x => x.Size.Trim())
    //    .Distinct())
    //: "-";

    decimal totalHrsInShift = 0;

    if (allShifts.Any())
    {
        // Example:
        // Long Morning + Morning + Evening + Night
        // 12 + 8 + 8 + 8 = 36 hrs
        totalHrsInShift = allShifts.Sum(x => GetShiftHours(x));
    }
    else if (!string.IsNullOrWhiteSpace(selectedShift) &&
             !selectedShift.Equals("All", StringComparison.OrdinalIgnoreCase))
    {
        // Agar data list main shift na mile to selected shift se calculate karo
        totalHrsInShift = GetShiftHours(selectedShift);
    }
    else
    {
        // Default full day normal shifts
        totalHrsInShift = 8 + 8 + 8;
    }

    // Safety fallback
    if (totalHrsInShift <= 0)
    {
        totalHrsInShift = 8;
    }

    // Controller complete selected period ke shift-detail records se
    // total shift minutes calculate karta hai.
    decimal totalTimeMins = ViewBag.TotalShiftMinutes != null
        ? Convert.ToDecimal(ViewBag.TotalShiftMinutes)
        : totalHrsInShift * 60;

    // Header / display ke liye report shift text
    string reportShift = allShifts.Any()
        ? string.Join(", ", allShifts)
        : selectedShift;

    if (string.IsNullOrWhiteSpace(reportShift))
    {
        reportShift = "All";
    }

    // Planned Downtime = Scheduled Delay
    decimal plannedDowntime = delays
        .Where(x =>
            !string.IsNullOrWhiteSpace(x.DelayType) &&
            (
                x.DelayType.Trim().Equals("ScheduledDelay", StringComparison.OrdinalIgnoreCase) ||
                x.DelayType.Trim().Equals("Scheduled Delay", StringComparison.OrdinalIgnoreCase) ||
                x.DelayType.Trim().Equals("Scheduled", StringComparison.OrdinalIgnoreCase) ||
                x.DelayType.Trim().Equals("Planned Downtime", StringComparison.OrdinalIgnoreCase) ||
                x.DelayType.Trim().Equals("PlannedDownTime", StringComparison.OrdinalIgnoreCase)
            )
        )
        .Sum(x => Convert.ToDecimal(x.TotalDuration ?? 0));

    // ================= DOWNTIME AGENCY TARGET VS ACTUAL (%) =================

    var rollingMillTarget =
        Model != null && Model.RollingMillTarget != null
            ? Model.RollingMillTarget
            : new DAL.Models.RollingMillTargetsBLL();

    decimal dailyProductionTarget =
        ViewBag.DailyProductionTarget != null
            ? Convert.ToDecimal(ViewBag.DailyProductionTarget)
            : 0;

    decimal dailyProductionActual = totalFinishedProd;

    decimal dailyFuelConsumption =
        ViewBag.DailyFuelConsumption != null
            ? Convert.ToDecimal(ViewBag.DailyFuelConsumption)
            : 0;

    decimal fuelConsumptionActual =
        totalFinishedProd > 0
            ? dailyFuelConsumption / totalFinishedProd
            : 0;

    decimal fuelConsumptionTarget =
        rollingMillTarget.FuelOilTarget;

    // Favorable variance rules:
    // Production: Actual - Target (above target is positive)
    // Fuel: Target - Actual (lower consumption is positive)
    decimal productionVariance =
        dailyProductionActual - dailyProductionTarget;

    decimal fuelConsumptionVariance =
        fuelConsumptionTarget - fuelConsumptionActual;

    decimal productionVariancePercentage =
        dailyProductionTarget > 0
            ? (productionVariance / dailyProductionTarget) * 100
            : 0;

    decimal fuelConsumptionVariancePercentage =
        fuelConsumptionTarget > 0
            ? (fuelConsumptionVariance / fuelConsumptionTarget) * 100
            : 0;


    decimal electricityConsumptionTarget = rollingMillTarget.ElectricityTarget;
    decimal electricityConsumptionActual = ViewBag.ElectricityConsumptionActual != null
        ? Convert.ToDecimal(ViewBag.ElectricityConsumptionActual)
        : 0;

    decimal waterConsumptionTarget = rollingMillTarget.WaterTarget;
    decimal waterConsumptionActual = ViewBag.WaterConsumptionActual != null
        ? Convert.ToDecimal(ViewBag.WaterConsumptionActual)
        : 0;

    Func<decimal, decimal, decimal> ConsumptionPerformance = (target, actual) =>
        {
            if (target <= 0 || actual <= 0) return 0;
            decimal value = (target / actual) * 100;
            if (value < 0) value = 0;
            if (value > 100) value = 100;
            return Math.Round(value, 2);
        };

    Func<string, string> NormalizeAgencyCode = agency =>
    {
        if (string.IsNullOrWhiteSpace(agency))
            return "OTH";

        string value = agency
            .Trim()
            .Replace("/", "")
            .Replace("\\", "")
            .Replace(" ", "")
            .Replace("-", "")
            .Replace("_", "")
            .ToUpperInvariant();

        switch (value)
        {
            case "GUIDE":
            case "GUIDEPASS":
            case "GUIDEPASSCHANGE":
                return "GP";

            case "QUALITY":
            case "QUALITYMAINTENANCE":
                return "QA";

            case "MAINTENANCEDOWNDAY":
            case "DOWNDAY":
                return "MD";

            case "PRODUCTION":
                return "PRD";

            case "ROLLSHOP":
                return "RS";

            case "ELECTRICAL":
                return "EL";

            case "MECHANICAL":
                return "ME";

            case "CRANE":
                return "CR";

            case "DISPATCH":
                return "DP";

            case "UTILITY":
                return "UT";

            case "SIZECHANGE":
                return "SC";

            case "POWERFAILURE":
                return "PF";

            case "NOBILLET":
                return "NB";

            case "ANNUALSHUTDOWN":
                return "AS";

            default:
                return "OTH";
        }
    };

    // Available operating time:
    // Total shift minutes minus scheduled/planned delay minutes.
    decimal availableOperatingMinutes =
        totalTimeMins - plannedDowntime;

    if (availableOperatingMinutes < 0)
    {
        availableOperatingMinutes = 0;
    }

    // Scheduled and Unscheduled delays agency-wise group hongi.
    // Scheduled + Unscheduled delays are included agency-wise.
    var actualDowntimeLookup = delays
        .Where(x =>
            (x.TotalDuration ?? 0) > 0
        )
        .GroupBy(x => NormalizeAgencyCode(x.AgencyName))
        .Select(g => new
        {
            Code = g.Key,
            ActualMinutes = g.Sum(
                x => Convert.ToDecimal(x.TotalDuration ?? 0)
            )
        })
        .ToList();



    // Table values are already target percentages.
    var downtimeTargets = new[]
    {
        new { Code = "GP",  Name = "Guide / Pass Change", TargetPercentage = rollingMillTarget.GuidePassTarget },
        new { Code = "QA",  Name = "Quality",             TargetPercentage = rollingMillTarget.QualityTarget },
        new { Code = "MD",  Name = "Down Day",            TargetPercentage = rollingMillTarget.DownDayTarget },
        new { Code = "PRD", Name = "Production",          TargetPercentage = rollingMillTarget.ProductionTarget },
        new { Code = "RS",  Name = "Roll Shop",           TargetPercentage = rollingMillTarget.RollShopTarget },
        new { Code = "EL",  Name = "Electrical",          TargetPercentage = rollingMillTarget.ElectricalTarget },
        new { Code = "ME",  Name = "Mechanical",          TargetPercentage = rollingMillTarget.MechanicalTarget },
        new { Code = "CR",  Name = "Crane",               TargetPercentage = rollingMillTarget.CraneTarget },
        new { Code = "DP",  Name = "Dispatch",            TargetPercentage = rollingMillTarget.DispatchTarget },
        new { Code = "UT",  Name = "Utility",             TargetPercentage = rollingMillTarget.UtilityTarget },
        new { Code = "SC",  Name = "Size Change",         TargetPercentage = rollingMillTarget.SizeChangeTarget },
        new { Code = "PF",  Name = "Power Failure",       TargetPercentage = rollingMillTarget.PowerFailureTarget },
        new { Code = "NB",  Name = "No Billet",           TargetPercentage = rollingMillTarget.NoBilletTarget },
        new { Code = "AS",  Name = "Annual Shutdown",     TargetPercentage = rollingMillTarget.AnnualShutdownTarget },
        new { Code = "OTH", Name = "Others",              TargetPercentage = rollingMillTarget.OthersTarget }
    }.ToList();

    // Agencies with Scheduled or Unscheduled delay will be shown.
    var availableDowntimeTargets = downtimeTargets
        .Where(x =>
            actualDowntimeLookup.Any(a =>
                string.Equals(
                    a.Code,
                    x.Code,
                    StringComparison.OrdinalIgnoreCase
                ) &&
                a.ActualMinutes > 0
            )
        )
        .ToList();

    var downtimeAgencyLabels = availableDowntimeTargets
        .Select(x => x.Code)
        .ToList();

    var downtimeAgencyNames = availableDowntimeTargets
        .Select(x => x.Name)
        .ToList();

    // Target directly percentage table se.
    var downtimeAgencyTargetData = availableDowntimeTargets
        .Select(x => Math.Round(x.TargetPercentage, 2))
        .ToList();

    // Actual percentage =
    // Agency total delay minutes / total selected period minutes * 100.
    // Both Scheduled and Unscheduled delays are included.
    var downtimeAgencyActualData = availableDowntimeTargets
        .Select(x =>
        {
            decimal actualMinutes = actualDowntimeLookup
                .Where(a =>
                    string.Equals(
                        a.Code,
                        x.Code,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .Select(a => a.ActualMinutes)
                .FirstOrDefault();

            return totalTimeMins > 0
                ? Math.Round(
                    (actualMinutes / totalTimeMins) * 100,
                    2
                )
                : 0;
        })
        .ToList();

    var downtimeAgencyActualMinutes = availableDowntimeTargets
        .Select(x =>
            actualDowntimeLookup
                .Where(a =>
                    string.Equals(
                        a.Code,
                        x.Code,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .Select(a => a.ActualMinutes)
                .FirstOrDefault()
        )
        .ToList();

    // Monthly accumulated delays grouped agency-wise.
    var monthlyDelayAgencyData = delays
        .Where(x => (x.TotalDuration ?? 0) > 0)
        .GroupBy(x =>
            string.IsNullOrWhiteSpace(x.AgencyName)
                ? "Others"
                : x.AgencyName.Trim()
        )
        .Select(g => new
        {
            Agency = g.Key,
            TotalMinutes = g.Sum(
                x => Convert.ToDecimal(
                    x.TotalDuration ?? 0
                )
            )
        })
        .OrderByDescending(x => x.TotalMinutes)
        .ToList();

    decimal totalMonthlyDelayMinutes =
        monthlyDelayAgencyData.Sum(x => x.TotalMinutes);

    var monthlyDelayAgencyLabels = monthlyDelayAgencyData
        .Select(x => x.Agency)
        .ToList();

    // Correct accumulated percentage:
    // Agency delay minutes / total selected period minutes * 100.
    var monthlyDelayAgencyPercentages = monthlyDelayAgencyData
        .Select(x =>
            totalTimeMins > 0
                ? Math.Round(
                    (x.TotalMinutes /
                     totalTimeMins) * 100,
                    2
                )
                : 0
        )
        .ToList();

    // ActualRollingTime = TotalTime(mins) - TotalDelayDuration
    decimal actualRollingTime = totalTimeMins - Convert.ToDecimal(totalDelayDuration);

    if (actualRollingTime < 0)
    {
        actualRollingTime = 0;
    }

    // PlannedRollingTime = TotalTime(mins) - PlannedDowntime
    decimal plannedRollingTime = totalTimeMins - plannedDowntime;

    if (plannedRollingTime < 0)
    {
        plannedRollingTime = 0;
    }

    // Convert minutes to hours
    decimal actualRollingHours = actualRollingTime > 0
        ? actualRollingTime / 60
        : 0;

    // Productivity tons/hr = TotalFinishedProd / ActualRollingHours
    decimal productivityTonsHr = actualRollingHours > 0
        ? totalFinishedProd / actualRollingHours
        : 0;

    // RRR = ActualRollingTime / PlannedRollingTime * 100
    decimal rrrValue = plannedRollingTime > 0
        ? (actualRollingTime / plannedRollingTime) * 100
        : 0;

    // Yield and RRR targets should be supplied from the controller.
    // Approved Yield target is fixed at 105%.
    decimal yieldTarget = 105;

    decimal rrrTarget = ViewBag.RRRTarget != null
        ? Convert.ToDecimal(ViewBag.RRRTarget)
        : 0;

    // Favorable variance:
    // Higher is better: Production, Yield, RRR => Actual - Target
    // Lower is better: Fuel, Electricity, Water => Target - Actual
    decimal electricityConsumptionVariance =
        electricityConsumptionTarget - electricityConsumptionActual;

    decimal waterConsumptionVariance =
        waterConsumptionTarget - waterConsumptionActual;

    decimal yieldVariance =
        yieldValue - yieldTarget;

    decimal rrrVariance =
        rrrValue - rrrTarget;

    decimal electricityConsumptionVariancePercentage =
        electricityConsumptionTarget > 0
            ? (electricityConsumptionVariance /
               electricityConsumptionTarget) * 100
            : 0;

    decimal waterConsumptionVariancePercentage =
        waterConsumptionTarget > 0
            ? (waterConsumptionVariance /
               waterConsumptionTarget) * 100
            : 0;

    decimal yieldVariancePercentage =
        yieldTarget > 0
            ? (yieldVariance / yieldTarget) * 100
            : 0;

    decimal rrrVariancePercentage =
        rrrTarget > 0
            ? (rrrVariance / rrrTarget) * 100
            : 0;

    decimal productivityTarget =
        ViewBag.ProductivityTarget != null
            ? Convert.ToDecimal(ViewBag.ProductivityTarget)
            : 0;

    decimal productivityVariance =
        productivityTonsHr - productivityTarget;

    decimal productivityVariancePercentage =
        productivityTarget > 0
            ? (productivityVariance / productivityTarget) * 100
            : 0;

    // Bundles / Coils Produced
    decimal bundlesCoilsProduced = totalBundles;

}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<style>
