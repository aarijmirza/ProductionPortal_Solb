        }

        Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
        Chart.defaults.color = "#444";

        // Register plugin before creating any chart.
        if (typeof ChartDataLabels !== "undefined") {
            Chart.register(ChartDataLabels);
        }

        var heatLabels = @Html.Raw(JsonConvert.SerializeObject(heatLabels));
        var billetRolledData = @Html.Raw(JsonConvert.SerializeObject(billetRolledData));
