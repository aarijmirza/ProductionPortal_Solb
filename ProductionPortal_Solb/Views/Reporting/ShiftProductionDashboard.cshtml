        function createMonthlyDelayAgencyChart() {
            var canvas =
                document.getElementById(
                    "monthlyDelayAgencyChart"
                );

            if (!canvas) return;

            var labels =
                monthlyDelayAgencyLabels &&
                monthlyDelayAgencyLabels.length > 0
                    ? monthlyDelayAgencyLabels
                    : ["No Delay"];

            var targetValues =
                monthlyDelayAgencyTargetData &&
                monthlyDelayAgencyTargetData.length > 0
                    ? monthlyDelayAgencyTargetData
                    : [0];

            var actualValues =
                monthlyDelayAgencyPercentages &&
                monthlyDelayAgencyPercentages.length > 0
                    ? monthlyDelayAgencyPercentages
                    : [0];

            var highestValue = Math.max.apply(
                null,
                targetValues
                    .concat(actualValues)
                    .map(function (value) {
                        return Number(value || 0);
                    })
            );

            var axisMaximum;

            if (highestValue <= 1) {
                axisMaximum = 1;
            }
            else if (highestValue <= 5) {
                axisMaximum = Math.ceil(
                    highestValue * 1.40
                );
            }
            else if (highestValue <= 10) {
                axisMaximum = Math.ceil(
                    highestValue * 1.25
                );
            }
            else {
                axisMaximum = Math.ceil(
                    highestValue * 1.15
                );
            }

            axisMaximum = Math.max(
                axisMaximum,
                1
            );

            new Chart(canvas, {
                type: "bar",

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: "Target",
                            data: targetValues,
                            backgroundColor: "#a6173f",
                            borderColor: "#7f1230",
                            borderWidth: 1,
                            borderRadius: 7,
                            maxBarThickness: 42
                        },
                        {
                            label: "Actual",
                            data: actualValues,
                            backgroundColor: "#9ca3af",
                            borderColor: "#6b7280",
                            borderWidth: 1,
                            borderRadius: 7,
                            maxBarThickness: 42
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    layout: {
                        padding: {
                            top: 18,
                            right: 12,
                            left: 8,
                            bottom: 4
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                color: "#374151",
                                maxRotation: 35,
                                minRotation: 0,
                                autoSkip: false,
                                font: {
                                    size: 9,
                                    weight: "700"
                                },

                                callback: function (
                                    value
                                ) {
                                    var label =
                                        this.getLabelForValue(
                                            value
                                        );

                                    return label.length > 15
                                        ? label.substring(
                                            0,
                                            15
                                        ) + "…"
                                        : label;
                                }
                            }
                        },

                        y: {
                            beginAtZero: true,
                            suggestedMax: axisMaximum,
                            max: axisMaximum,

                            title: {
                                display: true,
                                text:
                                    "Accumulated Delay Percentage (%)",
                                color: "#4b5563",
                                font: {
                                    size: 11,
                                    weight: "bold"
                                }
                            },

                            grid: {
                                color:
                                    "rgba(107,114,128,0.12)"
                            },

                            ticks: {
                                maxTicksLimit: 6,

                                callback: function (value) {
                                    return Number(
                                        value || 0
                                    ).toFixed(
                                        axisMaximum <= 5
                                            ? 1
                                            : 0
                                    ) + "%";
                                }
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            display: true,
                            position: "top",
                            align: "center",

                            labels: {
                                usePointStyle: true,
                                pointStyle: "circle",
                                boxWidth: 9,
                                boxHeight: 9,
                                padding: 18,
                                color: "#374151",

                                font: {
                                    size: 11,
                                    weight: "700"
                                }
                            }
                        },

                        tooltip: {
                            callbacks: {
                                title: function (items) {
                                    if (!items ||
                                        items.length === 0) {
                                        return "";
                                    }

                                    return labels[
                                        items[0].dataIndex
                                    ];
                                },

                                label: function (context) {
                                    return context.dataset.label +
                                        ": " +
                                        Number(
                                            context.raw || 0
                                        ).toFixed(2) +
                                        "%";
                                }
                            }
                        },

                        datalabels: {
                            display: function (context) {
                                return Number(
                                    context.dataset.data[
                                        context.dataIndex
                                    ] || 0
                                ) > 0;
                            },

                            formatter: function (value) {
                                return Number(
                                    value || 0
                                ).toFixed(2) + "%";
                            },

                            color: function (context) {
                                return context.dataset.label ===
                                    "Target"
                                        ? "#7f1230"
                                        : "#4b5563";
                            },

                            anchor: "end",
                            align: "top",
                            offset: 3,
                            clamp: true,

                            font: {
                                size: 9,
                                weight: "bold"
                            }
                        }
                    }
                }
            });
        }

        function createAccumulatedProductionChart() {
            var canvas = document.getElementById("daywiseProductivityChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: productivityDateLabels,
                    datasets: [{
                        label: "Daily Production (MT)",
                        data: productivityDayData,
                        borderColor: "#a6173f",
                        backgroundColor: "#a6173f",
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: "#a6173f",
                        pointBorderColor: "#ffffff",
                        pointBorderWidth: 2,

                        datalabels: {
                            display: function (context) {
                                return Number(
                                    context.dataset.data[context.dataIndex] || 0
                                ) > 0;
                            },

                            formatter: function (value) {
                                return Number(value || 0).toFixed(2);
                            },

                            color: "#ffffff",

                            font: {
                                weight: "bolder",
                                size: 13
                            },

                            anchor: "center",
                            align: "center",
                            rotation: -90,
                            clamp: true
                        }
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: "top"
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "Daily Production: " +
                                        numberLabel(context.raw) +
                                        " MT";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            title: {
                                display: true,
                                text: "Production Date"
                            },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: "rgba(0,0,0,0.08)" },
                            title: {
                                display: true,
                                text: "Daily Production (MT)"
                            },
                            ticks: {
                                callback: function (value) {
                                    return numberLabel(value);
                                }
                            }
                        }
                    }
                }
            });
        }

        function createBilletRolledChart() {
            var canvas = document.getElementById("billetChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "line",
                data: {
                    labels: heatLabels,
                    datasets: [{
                        label: "Billet Rolled",
                        data: billetRolledData,
                        borderColor: "#198754",
                        backgroundColor: "rgba(25,135,84,0.15)",
                        borderWidth: 2,
                        tension: 0.35,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return "Billet Rolled: " + numberLabel(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                autoSkip: false,
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: "Nos." },
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        }

        function createMonthlySizeProductionChart() {
            var canvas = document.getElementById("monthlySizeProductionChart");
            if (!canvas) return;

            new Chart(canvas, {
                type: "bar",
                data: {
                    labels: monthlySizeLabels,
                    datasets: [{
                        label: "Finished Production (MT)",
                        data: monthlySizeProductionData,
                        backgroundColor: "#a6173f",
                        borderColor: "#8f1236",
                        borderWidth: 1,
                        borderRadius: 6,
                        barPercentage: 0.70,
                        categoryPercentage: 0.75,

                        datalabels: {
                            display: true,
                            formatter: function (value) {
                                return Number(value || 0).toFixed(2);
                            },
                            color: "#7f1230",
                            font: {
                                weight: "bold",
                                size: 11
                            },
                            anchor: "end",
                            align: "top",
                            offset: 4,
                            clamp: true,
                            clip: false
                        }
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            top: 28
                        }
                    },
                    interaction: {
                        mode: "index",
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: "top"
                        },
                        tooltip: {
                            callbacks: {
                                title: function (items) {
                                    if (!items || items.length === 0) return "";
                                    return "Size: " + items[0].label;
                                },
                                label: function (context) {
                                    return "Production: " +
                                        Number(context.raw || 0).toLocaleString() +
                                        " MT";
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            title: {
                                display: true,
                                text: "Finished Product Size"
