            data: {
                labels: ["D10", "D14", "WR11"],
                datasets: [{
                    label: "RRR %",
                    data: [58.7, 84.7, 50.0],
                    backgroundColor: "#b30000"
                }]
            },
            options: commonOptions("%", false)
        });

        new Chart(document.getElementById("productivityChart"), {
