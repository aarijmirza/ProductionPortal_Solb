@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>RM2 Daily Production Report</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 11px;
            margin: 0;
            padding: 0;
            background: #fff;
            color: #000;
        }

        .sheet {
            width: 100%;
            padding: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th, td {
            border: 1px solid #444;
            padding: 3px 4px;
            vertical-align: middle;
            word-wrap: break-word;
        }

        th {
            background: #5f5f5f;
            color: #fff;
            font-weight: bold;
            text-align: center;
        }

        .title-table td {
            border: 1px solid #444;
        }

        .logo-cell {
            width: 160px;
            text-align: center;
        }

            .logo-cell img {
                max-height: 55px;
            }

        .main-title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        .date-box {
            text-align: center;
            font-size: 13px;
            font-weight: bold;
        }

        .section-title {
            background: #5f5f5f;
            color: #fff;
            font-weight: bold;
            text-align: left;
            padding: 4px;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .red {
            color: #c00000;
            font-weight: bold;
        }

        .gray {
            background: #e7e7e7;
        }

        .light-gray {
            background: #f2f2f2;
        }

        .chart-grid {
            display: grid;
            grid-template-columns: 50% 50%;
            gap: 4px;
        }

        .chart-box {
            border: 1px solid #444;
            height: 215px;
            padding: 5px;
            position: relative;
        }

        .chart-title {
            text-align: center;
            font-weight: bold;
            margin-bottom: 3px;
        }

        canvas {
            width: 100% !important;
            height: 180px !important;
        }

        .small {
            font-size: 10px;
        }

        .very-small {
            font-size: 9px;
        }

        .no-border {
            border: none !important;
        }

            .no-border td {
                border: none !important;
            }

        .page-break {
            page-break-before: always;
        }

        @@media print {
            body {
                margin: 0;
            }

            .sheet {
                padding: 4px;
            }

            @@page {
                size: A4 landscape;
                margin: 5mm;
            }
        }
    </style>
</head>

