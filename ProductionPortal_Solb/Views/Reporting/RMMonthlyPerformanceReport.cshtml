    <!-- ================= CHART SCRIPTS ================= -->
    <script>
        Chart.defaults.font.family = "Calibri, Arial, sans-serif";
        Chart.defaults.color = "#000";

        function commonOptions(yTitle, showLegend) {
            return {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: { enabled: false },
                    legend: { display: showLegend }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: false,
                            text: yTitle
                        },
                        ticks: {
                            font: { size: 9 }
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 8 },
                            maxRotation: 70,
                            minRotation: 45
                        }
                    }
                }
            };
        }

        new Chart(document.getElementById("sizePlanActualChart"), {
            type: "bar",
            data: {
                labels: ["D10", "D14", "WR11"],
                datasets: [
                    {
                        label: "Plan",
                        data: [1850, 3764, 170],
                        backgroundColor: "#b30000"
                    },
                    {
                        label: "Actual",
                        data: [1860, 3764, 177.7],
                        backgroundColor: "#666666"
                    }
                ]
            },
            options: commonOptions("MT", true)
        });

        new Chart(document.getElementById("planVsActualChart"), {
            type: "bar",
            data: {
                labels: ["Plan", "Actual", "Difference"],
                datasets: [{
                    label: "MT",
                    data: [5784, 5802, 18],
                    backgroundColor: ["#666666", "#b30000", "#999999"]
                }]
            },
            options: commonOptions("MT", false)
        });

        new Chart(document.getElementById("yieldChart"), {
            type: "bar",
            data: {
                labels: ["D10", "D14", "WR11"],
                datasets: [{
                    label: "Yield %",
                    data: [100.5, 102.2, 98.3],
                    backgroundColor: "#b30000"
                }]
            },
            options: commonOptions("%", false)
        });

        new Chart(document.getElementById("rrrChart"), {
