                datasets: [{
                    label: "Productivity",
                    data: [75.1, 91.1, 88.8],
                    backgroundColor: "#b30000"
                }]
            },
            options: commonOptions("T/hr", false)
        });

        new Chart(document.getElementById("delayMinutesChart"), {
            type: "bar",
            data: {
                labels: ["Op", "RS", "MM", "ELEC.", "QC"],
                datasets: [{
                    label: "Delay Minutes",
                    data: [0, 0, 0, 0, 120],
                    backgroundColor: "#b30000"
                }]
