            options: commonOptions("Minutes", false)
        });

        new Chart(document.getElementById("downtimePieChart"), {
            type: "pie",
            data: {
                labels: ["QC", "Available / Other"],
                datasets: [{
                    data: [120, 1320],
                    backgroundColor: ["#4472c4", "#d9d9d9"]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: { enabled: false },
                    legend: {
                        display: true,
                        position: "bottom",
                        labels: {
