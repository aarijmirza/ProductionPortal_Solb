                        <th>Seq.</th>
                        <th>Heat No</th>
                        <th>Grade</th>
                        <th>Size</th>
                        <th>Billet Discharge</th>
                        <th>Billet Rolled</th>
                        <th>Cobble</th>
                        <th>Hot Out</th>
                        <th>Discharge Wt.</th>
                        <th>Bundles</th>
                        <th>On-Hold</th>
                        <th>Reject</th>
                        <th>Short Wt.</th>
                        <th>Finished Product Wt.</th>
                        <th>Yield %</th>
                    </tr>
                </thead>
                <tbody>
                    @if (data != null && data.Any())
                    {
                        foreach (var item in data)
                        {
                            decimal itemTotalWeight = item.TotalWeight ?? 0;
                            decimal itemTheoriticalWeight = item.TheoriticalWeight ?? 0;

                            decimal itemYield = itemTotalWeight > 0
                                ? (itemTheoriticalWeight / itemTotalWeight) * 100
                                : 0;

                            <tr>
                                <td>@item.DischargingSequence</td>
                                <td>@item.HeatNo</td>
                                <td>@item.SteelGrade</td>
                                <td>@item.Size</td>
                                <td>@item.TotalBillet</td>
                                <td>@item.TotalBillet</td>
                                <td>@item.Cobble</td>
                                <td>@item.HotOut</td>
                                <td>@itemTotalWeight.ToString("0.###")</td>
                                <td>@item.TotalBundleProduced</td>
                                <td>@(item.TotalBundleOnHold.HasValue ? item.TotalBundleOnHold.Value.ToString("0.00") : "0.00")</td>
                                <td>@(item.TotalRejectedBundle.HasValue ? item.TotalRejectedBundle.Value.ToString("0.00") : "0.00")</td>
                                <td>@(item.ShortBundleActualWeight.HasValue ? item.ShortBundleActualWeight.Value.ToString("0.00") : "0.00")</td>
                                <td>@itemTheoriticalWeight.ToString("0.###")</td>
                                <td>
                                    <span class="badge-soft-success">@itemYield.ToString("0.00")%</span>
