                    <div class="chart-box">
                        <canvas id="billetChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card section-card">
                <div class="card-header">Billet Weight vs Finished Product</div>
                <div class="card-body">
                    <div class="chart-box">
                        <canvas id="weightCompareChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card section-card">
        <div class="card-header">Downtime Details</div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Start</th>
                        <th>Finish</th>
                        <th>Total Min</th>
                        <th>Agency</th>
                        <th>Equipment</th>
                        <th>Reason</th>
                        <th>Description</th>
