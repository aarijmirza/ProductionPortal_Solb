                        <td>@totalWeight</td>
                        <td>@totalBundles</td>
                        <td>@totalOnHold</td>
                        <td>@totalRejected</td>
                        <td>@totalShortWeight.ToString("0.00")</td>
                        <td>@theoriticalWeight</td>
                        <td>@yieldValue.ToString("0.00")%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>

<script>
    Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
    Chart.defaults.color = "#444";

    var heatLabels = @Html.Raw(JsonConvert.SerializeObject(heatLabels));
    var billetRolledData = @Html.Raw(JsonConvert.SerializeObject(billetRolledData));
    var billetWeightData = @Html.Raw(JsonConvert.SerializeObject(billetWeightData));
    var finishedWeightData = @Html.Raw(JsonConvert.SerializeObject(finishedWeightData));
    var bundleData = @Html.Raw(JsonConvert.SerializeObject(bundleData));

    var downtimeAgencyLabels = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyLabels));
    var downtimeAgencyData = @Html.Raw(JsonConvert.SerializeObject(downtimeAgencyData));

    new Chart(document.getElementById("downtimeAgencyChart"), {
        type: "bar",
        data: {
            labels: downtimeAgencyLabels,
            datasets: [{
                label: "Downtime Minutes",
                data: downtimeAgencyData,
                backgroundColor: "#c1121f",
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: "Minutes" }
                }
            }
        }
    });

    new Chart(document.getElementById("heatWeightChart"), {
        type: "bar",
        data: {
            labels: heatLabels,
            datasets: [{
                label: "Billet Discharge Wt. (MT)",
                data: billetWeightData,
                backgroundColor: "#0d6efd",
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: "MT" }
                }
            }
        }
    });

    new Chart(document.getElementById("billetChart"), {
        type: "line",
        data: {
            labels: heatLabels,
            datasets: [{
                label: "Billet Rolled",
                data: billetRolledData,
                borderColor: "#198754",
                backgroundColor: "rgba(25,135,84,0.15)",
                tension: 0.35,
                fill: true,
                pointRadius: 5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: "Nos." }
                }
            }
        }
    });

    new Chart(document.getElementById("weightCompareChart"), {
        type: "bar",
        data: {
            labels: heatLabels,
            datasets: [
                {
                    label: "Billet Wt. (MT)",
                    data: billetWeightData,
                    backgroundColor: "#0d6efd",
                    borderRadius: 8
                },
                {
                    label: "Finished Product Wt. (MT)",
                    data: finishedWeightData,
                    backgroundColor: "#198754",
                    borderRadius: 8
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: "MT" }
                }
            }
        }
    });
</script>