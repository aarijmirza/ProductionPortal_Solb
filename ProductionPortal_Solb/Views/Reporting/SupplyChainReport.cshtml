    /* ============================================================
       A4 PDF / PRINT FIX
       ------------------------------------------------------------
       Screen dashboard is 980px wide. A4 portrait printable width
       is smaller, therefore Chrome was cutting the left/right side.

       For print/PDF only:
       - keep the original 980px dashboard layout
       - scale it to A4 portrait
       - remove Bootstrap/layout side spacing
       - preserve colors
       - keep the complete dashboard together as much as possible
       ============================================================ */
    @@media print {

        @@page {
            size: A4 portrait;
            margin: 5mm;
        }

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            width: auto !important;
            min-width: 0 !important;
            overflow: visible !important;
        }

        .no-print {
            display: none !important;
        }
        /*
         * Remove application-layout spacing which otherwise consumes
         * part of the printable width.
         */
        .xp-contentbar {
            margin: 0 !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
        }
        /*
         * Original dashboard = 980px.
         * 76% gives approx. 745px printable width, which safely fits
         * A4 portrait with 5mm margins.
         *
         * Chrome / Edge Save as PDF support zoom in print CSS.
         */
        .supply-dashboard {
            width: 980px !important;
            min-width: 980px !important;
            max-width: 980px !important;
            margin: 0 auto !important;
            zoom: 0.76;
            border: 1px solid var(--solb-red) !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            overflow: visible !important;
            page-break-inside: avoid !important;
            break-inside: avoid-page !important;
        }

        .dashboard-body {
            overflow: visible !important;
        }
        /*
         * Prevent individual blocks from being split whenever the
         * browser needs to paginate.
         */
        .screenshot-header,
        .inventory-grid,
        .inventory-box,
        .chart-panel,
        .dispatch-row,
        .dispatch-card,
        .performance-box,
        .received-grid,
        .byproduct-grid,
        .small-card {
            page-break-inside: avoid !important;
            break-inside: avoid-page !important;
        }
        /*
         * Canvas must remain inside its parent after print layout
         * changes.
         */
        .chart-wrap,
        .chart-wrap canvas {
            max-width: 100% !important;
        }

        :root {
            --solb-red: #74000a;
            --solb-dark: #520006;
            --border: #dddddd;
            --text: #111111;
            --muted: #555555;
        }

        * {
            box-sizing: border-box !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }
    }
</style>

