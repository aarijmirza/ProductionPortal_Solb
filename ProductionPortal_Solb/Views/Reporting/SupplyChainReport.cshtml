@model DAL.Models.SupplyChainDailyBLL
@using Newtonsoft.Json
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var report = Model ?? new DAL.Models.SupplyChainDailyBLL();

    var receivedMaterials =
        report.ReceivedMaterials
        ?? new List<DAL.Models.SupplyChainReceivedMaterialBLL>();

    var rawReceivedItems =
        receivedMaterials
            .Where(x =>
                x != null &&
                string.Equals(
                    (x.MaterialType ?? string.Empty).Trim(),
                    "Raw Material",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var subRawReceivedItems =
        receivedMaterials
            .Where(x =>
                x != null &&
                string.Equals(
                    (x.MaterialType ?? string.Empty).Trim(),
                    "Sub Raw Material",
                    StringComparison.OrdinalIgnoreCase
                )
            )
            .ToList();

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    Func<decimal?, string> F0 = value =>
    {
        return value.HasValue ? value.Value.ToString("N0") : "0";
    };

    Func<decimal?, string> F2 = value =>
    {
        return value.HasValue ? value.Value.ToString("N2") : "0.00";
    };

    Func<decimal?, string> F3 = value =>
    {
        return value.HasValue ? value.Value.ToString("N3") : "0.000";
    };

    Func<decimal?, decimal?, decimal> Percent = (actual, target) =>
    {
        decimal a = actual ?? 0;
        decimal t = target ?? 0;

        if (t <= 0)
        {
            return 0;
        }

        return (a / t) * 100;
    };

    decimal dailyPercent = Percent(report.DailyDispatch, report.DailyDispatchTarget);
    decimal wtdPercent = Percent(report.WTDDispatch, report.WTDDispatchTarget);
    decimal mtdPercent = Percent(report.MTDDispatch, report.MTDDispatchTarget);

    decimal dailyBarPercent = dailyPercent > 100 ? 100 : dailyPercent;

    decimal dailyGap = (report.DailyDispatch ?? 0) - (report.DailyDispatchTarget ?? 0);

    string gapText = dailyGap < 0
        ? dailyGap.ToString("N0") + " MT"
        : "+" + dailyGap.ToString("N0") + " MT";

    string gapStatus = dailyGap < 0 ? "Behind Target" : "Above Target";

    string reportDateText = report.ReportDate.HasValue
        ? report.ReportDate.Value.ToString("dd.MM.yyyy", gregorian)
        : DateTime.Today.ToString("dd.MM.yyyy", gregorian);

    string reportMonthText = report.ReportDate.HasValue
        ? report.ReportDate.Value.ToString("MMMM yyyy", gregorian).ToUpper()
        : DateTime.Today.ToString("MMMM yyyy", gregorian).ToUpper();

    string reportTimeText = report.ReportTime.HasValue
        ? DateTime.Today.Add(report.ReportTime.Value).ToString("hh:mm tt", gregorian)
        : DateTime.Now.ToString("hh:mm tt", gregorian);

    var inventoryLabels = new List<string>
{
        "Rebar",
        "Billet",
        "Wire Rod Coil",
        "Scrap",
        "Rebar in Coil",
        "Epoxy Rebar",
        "Short Bar",
        "DRI",
        "HBI"
    };

    var inventoryData = new List<decimal>
{
        report.Rebar ?? 0,
        report.Billet ?? 0,
        report.WireRodCoil ?? 0,
        report.Scrap ?? 0,
        report.RebarInCoil ?? 0,
        report.EpoxyRebar ?? 0,
        report.ShortBar ?? 0,
        report.DRI ?? 0,
        report.HBI ?? 0
    };
}

