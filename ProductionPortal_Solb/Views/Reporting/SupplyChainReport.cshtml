                    <canvas id="inventoryChart"></canvas>
                </div>
            </div>

            <!-- SECTION 2 -->
            <div class="section-title">
                <div class="section-no">2</div>
                <h3>Dispatch Performance (MT)</h3>
            </div>

            <div class="dispatch-row">

                <div class="dispatch-card">
                    <div class="dispatch-icon">
                        <img src="@Url.Content("~/assets/images/supply/truck.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="dispatch-title">Daily Dispatch</div>
                        <div class="dispatch-value">@F0(report.DailyDispatch) <span>MT</span> @report.DailyTruck <span>Trucks</span></div>
                        <div class="target-text">vs Target (@F0(report.DailyDispatchTarget) MT)</div>
                        <div class="target-text">vs Target Truck (@F0(report.DailyTruckTarget))</div>
                    </div>
                    <div class="percent">@dailyPercent.ToString("0")%</div>
                </div>

                <div class="dispatch-card">
                    <div class="dispatch-icon">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="dispatch-title">WTD Dispatch</div>

                        <div class="dispatch-value">
                            @F0(report.WTDDispatch)
                            <span>MT</span>

                            @F0(report.WTDTruck)
                            <span>Trucks</span>
                        </div>

                        <div class="target-text">
                            vs Target (@F0(report.WTDDispatchTarget) MT)
                        </div>

                        <div class="target-text">
                            vs Target Truck (@F0(report.WTDTruckTarget))
                        </div>
                    </div>
                    <div class="percent">@wtdPercent.ToString("0")%</div>
                </div>

                <div class="dispatch-card">
                    <div class="dispatch-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="dispatch-title">MTD Dispatch</div>

                        <div class="dispatch-value">
                            @F0(report.MTDDispatch)
                            <span>MT</span>

                            @F0(report.MTDTruck)
                            <span>Trucks</span>
                        </div>

                        <div class="target-text">
                            vs Target (@F0(report.MTDDispatchTarget) MT)
                        </div>

                        <div class="target-text">
                            vs Target Truck (@F0(report.MTDTruckTarget))
                        </div>
                    </div>
                    <div class="percent">@mtdPercent.ToString("0")%</div>
                </div>

            </div>

            <!-- DAILY DISPATCH BAR -->
            <div class="performance-box">
                <div style="padding-left: 20px;">
                    <div class="perf-title">
                        Daily Dispatch<br />
                        Performance
                    </div>
                    <div class="perf-target">Target: @F0(report.DailyDispatchTarget) MT</div>
                </div>

                <div style="padding-left: 20px;">
                    <div class="actual-text">
                        Actual: @F0(report.DailyDispatch) MT (@dailyPercent.ToString("0")%)
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill" style="width:@dailyBarPercent.ToString("0")%">
                            @dailyPercent.ToString("0")%
                        </div>
                    </div>

                    <div class="scale">
                        <span>0</span>
                        <span>@(((report.DailyDispatchTarget ?? 0) / 2).ToString("N0"))</span>
                        <span>@F0(report.DailyDispatchTarget)</span>
                    </div>
                </div>

                <div class="gap-box">
                    <div class="gap-title">Gap To Target</div>
                    <div class="gap-value">@gapText</div>
                    <div class="gap-sub">@gapStatus</div>
                </div>
            </div>

            <!-- SECTION 3 -->
            <div class="section-title">
                <div class="section-no">3</div>
                <h3>Received Materials (MT) – For Month of @reportMonthText</h3>
            </div>

            <div class="small-grid received-grid">

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/raw-material.png")"
                             class="material-img" />
                    </div>

                    <div style="padding-left: 20px;">
                        <div class="small-title">
                            Raw Materials
                        </div>

                        <div class="small-value">
                            @F3(report.RawMaterialsReceived)
                        </div>

                        <div class="small-unit">
                            MT
                        </div>

                        <div class="received-detail-list">

                            @if (rawReceivedItems.Count > 0)
                            {
                                foreach (var item in rawReceivedItems)
                                {
                                    <div class="received-detail-row">
                                        <span class="received-detail-name">
                                            @item.ItemName
                                        </span>

                                        <span class="received-detail-qty">
                                            @item.Quantity.ToString("N3") MT
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="received-empty">
                                    No item details for report ID @report.ID
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/sub-raw-material.png")"
                             class="material-img" />
                    </div>

                    <div style="padding-left: 20px;">
                        <div class="small-title">
                            Sub Raw Materials
                        </div>

                        <div class="small-value">
                            @F3(report.SubRawMaterialsReceived)
                        </div>

                        <div class="small-unit">
                            MT
                        </div>

                        <div class="received-detail-list">

                            @if (subRawReceivedItems.Count > 0)
                            {
                                foreach (var item in subRawReceivedItems)
                                {
                                    <div class="received-detail-row">
                                        <span class="received-detail-name">
                                            @item.ItemName
                                        </span>

                                        <span class="received-detail-qty">
                                            @item.Quantity.ToString("N3") MT
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="received-empty">
                                    No item details for report ID @report.ID
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/refractory-material.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Refractory Materials</div>
                        <div class="small-value">@F2(report.RefractoryMaterialsReceived)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/fuel-oil.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Fuel Oil</div>
                        <div class="small-value">@F2(report.FuelOilReceived)</div>
                        <div class="small-unit">L</div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/other.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Other</div>
                        <div class="small-value">@F2(report.OtherReceived)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

            </div>

            <!-- SECTION 4 -->
            <div class="section-title">
                <div class="section-no">4</div>
                <h3>By-Products Stock (MT) – For Month of @reportMonthText</h3>
            </div>

            <div class="small-grid byproduct-grid">

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/mill-scale.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Mill Scale</div>
                        <div class="small-value">@F2(report.MillScale)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/slag.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Slag</div>
                        <div class="small-value">@F2(report.Slag)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/dust.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Dust</div>
                        <div class="small-value">@F2(report.Dust)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

                <div class="small-card">
                    <div class="small-icon">
                        <img src="@Url.Content("~/assets/images/supply/sludge.png")" class="material-img" />
                    </div>
                    <div style="padding-left: 20px;">
                        <div class="small-title">Sludge</div>
                        <div class="small-value">@F2(report.Sludge)</div>
                        <div class="small-unit">MT</div>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>

<script>
    const inventoryLabels = @Html.Raw(JsonConvert.SerializeObject(inventoryLabels));
    const inventoryData = @Html.Raw(JsonConvert.SerializeObject(inventoryData));

    var maxInventory = Math.max.apply(null, inventoryData);

    var chartStep;

    if (maxInventory <= 1000) {
        chartStep = 200;
    }
    else if (maxInventory <= 5000) {
        chartStep = 500;
    }
    else if (maxInventory <= 15000) {
        chartStep = 1000;
    }
    else {
        chartStep = 5000;
    }

    var chartMax =
        maxInventory > 0
            ? Math.ceil((maxInventory * 1.20) / chartStep) * chartStep
            : 10000;

    var inventoryChartInstance = new Chart(document.getElementById("inventoryChart"), {
        type: "bar",
        data: {
            labels: inventoryLabels,
            datasets: [{
                data: inventoryData,
                backgroundColor: [
                    "#123c9c",
                    "#16803c",
                    "#f28c28",
                    "#6b6b6b",
                    "#0e8da8",
                    "#5b21b6",
                    "#7a4a12",
                    "#b91c1c",
                    "#2f5597"
                ],
                borderRadius: 2,
                barThickness: 18,
                maxBarThickness: 18,
                categoryPercentage: 0.78,
                barPercentage: 0.90
            }]
        },
        options: {
            indexAxis: "y",
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            layout: {
                padding: {
                    left: 4,
                    right: 18,
                    top: 4,
                    bottom: 0
                }
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    enabled: false
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    max: chartMax,
                    title: {
                        display: true,
                        text: "Stock (MT)",
                        color: "#111",
                        font: {
                            size: 12,
                            weight: "bold"
                        }
                    },
                    ticks: {
                        color: "#111",
                        stepSize: chartStep,
                        font: {
                            size: 11,
                            weight: "bold"
                        },
                        callback: function (value) {
                            return Number(value).toLocaleString();
                        }
                    },
                    grid: {
                        color: "#ececec"
                    }
                },
                y: {
                    ticks: {
                        color: "#111",
                        padding: 6,
                        font: {
                            size: 11,
                            weight: "bold"
                        }
                    },
                    grid: {
                        display: false
                    }
                }
            }
        },
        plugins: [{
            id: "valueLabels",
            afterDatasetsDraw(chart) {
                const ctx = chart.ctx;
                const chartArea = chart.chartArea;
                const meta = chart.getDatasetMeta(0);

                ctx.save();
                ctx.font = "bold 11px Segoe UI";
                ctx.textBaseline = "middle";

                chart.data.datasets[0].data.forEach(function (value, index) {
                    const bar = meta.data[index];

                    if (!bar) {
                        return;
                    }

                    const label = Number(value || 0).toLocaleString(undefined, {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 3
                    });

                    const labelWidth = ctx.measureText(label).width;
                    const outsideX = bar.x + 8;
                    const outsideFits =
                        outsideX + labelWidth <= chartArea.right - 2;

                    if (outsideFits) {
                        ctx.textAlign = "left";
                        ctx.fillStyle = "#111";
                        ctx.fillText(label, outsideX, bar.y);
                    }
                    else {
                        ctx.textAlign = "right";
                        ctx.fillStyle = "#ffffff";
                        ctx.fillText(
                            label,
                            Math.max(
                                bar.x - 8,
                                chartArea.left + labelWidth + 4
                            ),
                            bar.y
                        );
                    }
                });

                ctx.restore();
            }
        }]
    });
    /*
     * Re-size Chart.js after the browser applies print CSS.
     * This prevents the canvas from keeping its old screen width
     * and getting clipped in the generated PDF.
     */
    window.addEventListener("beforeprint", function () {

        if (
            typeof inventoryChartInstance !== "undefined" &&
            inventoryChartInstance
        ) {
            inventoryChartInstance.resize();
        }
    });


    window.addEventListener("afterprint", function () {

        if (
            typeof inventoryChartInstance !== "undefined" &&
            inventoryChartInstance
        ) {
            inventoryChartInstance.resize();
        }
    });


    function printSupplyChainReport() {

        /*
         * Force one layout pass before opening Chrome/Edge
         * Print / Save as PDF dialog.
         */
        if (
            typeof inventoryChartInstance !== "undefined" &&
            inventoryChartInstance
        ) {
            inventoryChartInstance.resize();
        }

        setTimeout(function () {
            window.print();
        }, 150);
    }

</script>