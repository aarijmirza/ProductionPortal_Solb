@model DAL.Models.CMDPerformanceDashboardVM
@using System
@using System.Globalization
@using System.Linq
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #a6173f;
        --primary-dark: #7d102f;
        --primary-2: #c1121f;
        --green: #198754;
        --blue: #0d6efd;
        --orange: #fd7e14;
        --purple: #6f42c1;
        --text: #222;
        --muted: #6c757d;
        --line: #e9ecef;
        --shadow: 0 4px 16px rgba(0,0,0,0.08);
        --shadow-lg: 0 8px 20px rgba(0,0,0,0.12);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #eef2f6;
        color: var(--text);
    }

    .xp-contentbar {
        padding-top: 15px;
    }

    .dashboard-header {
        background: linear-gradient(135deg, var(--primary-dark), var(--primary));
        color: #fff;
        border-radius: 14px;
        padding: 22px 25px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-lg);
    }

        .dashboard-header h3 {
            margin: 0;
            font-weight: 800;
            color: #fff;
            letter-spacing: .2px;
        }

        .dashboard-header small {
            color: rgba(255,255,255,.92);
            font-size: 13px;
        }

    .top-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .top-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        min-height: 250px;
        position: relative;
        padding: 0 14px 14px;
        overflow: hidden;
        border: none;
    }

    .red-head {
        background: #991b1b;
        color: #fff;
        text-align: center;
        font-size: 15px;
        font-weight: 800;
        padding: 10px 8px;
        margin: 0 -14px 12px;
    }

    .mini-values {
        font-size: 13px;
        font-weight: 800;
        line-height: 24px;
        color: #333;
        margin-bottom: 8px;
    }

    .compare-label {
        font-weight: 800;
        font-size: 13px;
        color: #555;
        margin-top: 8px;
    }

    .big-up {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .green {
        color: var(--green);
    }

    .bar-wrap {
        height: 120px;
        border-bottom: 1px solid #ddd;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 28px;
        padding: 0 15px;
        margin-top: 8px;
    }

    .bar-col {
        text-align: center;
        font-size: 11px;
        font-weight: 800;
        color: #333;
    }

    .bar {
        width: 42px;
        background: #c1121f;
        border-radius: 8px 8px 0 0;
        position: relative;
        display: block;
        margin: 0 auto 6px;
    }

        .bar span {
            position: absolute;
            top: -18px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            color: #111;
            font-weight: 900;
            white-space: nowrap;
        }

    .pie-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 8px;
    }

    .pie-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
        min-height: 230px;
        border: none;
    }

    .pie-title {
        margin: 0;
    }

    .pies {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 12px;
        align-items: center;
    }

    .pie-label {
        text-align: center;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 6px;
        color: #333;
    }

    .pie {
        width: 112px;
        height: 112px;
        margin: 0 auto;
        border-radius: 50%;
        background: conic-gradient(#0c4c58 0 31.3%, #accb8e 31.3% 55.8%, #f57c00 55.8% 82.9%, #a696bf 82.9% 100%);
        position: relative;
    }

        .pie .p1,
        .pie .p2,
        .pie .p3,
        .pie .p4 {
            position: absolute;
            color: #fff;
            font-size: 10px;
            font-weight: 900;
            text-shadow: 0 1px 2px rgba(0,0,0,.45);
        }

        .pie .p1 {
            top: 27px;
            right: 18px;
        }

        .pie .p2 {
            bottom: 27px;
            right: 25px;
        }

        .pie .p3 {
            bottom: 40px;
            left: 13px;
        }

        .pie .p4 {
            top: 36px;
            left: 16px;
        }

    .legend {
        background: #fff;
        border-radius: 14px;
        padding: 10px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
        text-align: center;
        font-size: 12px;
        font-weight: 800;
    }

    .sq {
        display: inline-block;
        width: 13px;
        height: 13px;
        vertical-align: middle;
        margin: 0 4px 0 12px;
        border-radius: 3px;
    }

    .mech {
        background: #accb8e;
    }

    .elec {
        background: #f57c00;
    }

    .cranes {
        background: #a696bf;
    }

    .util {
        background: #0c4c58;
    }

    .section-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .sub-heading {
        grid-column: 1 / 4;
        background: #fff;
        border-left: 5px solid #c1121f;
        border-radius: 14px;
        padding: 12px 15px;
        font-size: 16px;
        font-weight: 900;
        box-shadow: var(--shadow);
        margin-top: 5px;
    }

    .chart-panel {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        min-height: 205px;
        padding: 0 12px 12px;
        overflow: hidden;
        border: none;
    }

    .panel-title {
        background: #991b1b;
        color: #fff;
        text-align: center;
        font-size: 14px;
        font-weight: 900;
        padding: 9px 8px;
        margin: 0 -12px 12px;
    }

    .bars-five {
        height: 118px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 10px;
        padding: 0 10px;
        border-bottom: 1px solid #ddd;
    }

    .vbar {
        width: 38px;
        background: #c1121f;
        border-radius: 8px 8px 0 0;
        position: relative;
    }

        .vbar span {
            position: absolute;
            top: -17px;
            left: 50%;
            transform: translateX(-50%);
            font-weight: 900;
            font-size: 11px;
        }

    .xlabels {
        display: flex;
        justify-content: space-around;
        font-size: 7px;
        font-weight: 800;
        margin-top: 5px;
        gap: 3px;
        text-align: center;
        line-height: 1.1;
    }

    .legend-small {
        text-align: center;
        font-size: 10px;
        font-weight: 800;
        margin-top: 5px;
    }

    .hbar-row {
        display: grid;
        grid-template-columns: 125px 1fr 25px;
        align-items: center;
        font-size: 8px;
        font-weight: 800;
        margin: 6px 0;
        gap: 5px;
    }

    .hbar-bg {
        height: 10px;
        background: #e9ecef;
        border-radius: 20px;
        overflow: hidden;
    }

    .hbar {
        height: 10px;
        background: #0f2635;
        border-radius: 20px;
    }

    .line-chart {
        width: 100%;
        height: 120px;
        display: block;
    }

    .line-labels {
        display: flex;
        justify-content: space-around;
        font-size: 8px;
        font-weight: 800;
        margin-top: 3px;
    }

    .bottom-title {
        background: #fff;
        border-left: 5px solid #c1121f;
        border-radius: 14px;
        padding: 12px 15px;
        font-size: 16px;
        font-weight: 900;
        box-shadow: var(--shadow);
        margin-bottom: 10px;
    }

    table.delay-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--shadow);
        margin-bottom: 20px;
    }

    .delay-table th,
    .delay-table td {
        border: 1px solid #eee;
        padding: 8px 9px;
        text-align: center;
        vertical-align: middle;
    }

    .delay-table th {
        background: #991b1b;
        color: #fff;
        font-weight: 900;
        white-space: nowrap;
    }

    .delay-table td:nth-child(4),
    .delay-table td:nth-child(5),
    .delay-table td:nth-child(6),
    .delay-table td:nth-child(7) {
        text-align: left;
    }

    @@media print {
        @@page {
            size: A4 landscape;
            margin: 6mm;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        html,
        body {
            background: #eef2f6 !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .no-print,
        .xp-breadcrumbbar,
        .breadcrumb,
        .navbar,
        .sidebar,
        header,
        footer,
        .main-footer,
        .xp-footerbar {
            display: none !important;
        }

        .xp-contentbar {
            padding: 15px !important;
            margin: 0 !important;
            background: #eef2f6 !important;
            width: 100% !important;
        }

        .dashboard-header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary)) !important;
            color: #fff !important;
            border-radius: 14px !important;
            padding: 22px 25px !important;
            margin-bottom: 20px !important;
            box-shadow: var(--shadow-lg) !important;
            page-break-inside: avoid !important;
        }

            .dashboard-header h3,
            .dashboard-header small,
            .dashboard-header b {
                color: #fff !important;
            }

        .top-grid,
        .pie-grid,
        .section-grid {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 18px !important;
            page-break-inside: avoid !important;
        }

        .top-box,
        .pie-box,
        .legend,
        .chart-panel,
        .sub-heading,
        .bottom-title,
        .delay-table {
            box-shadow: var(--shadow) !important;
            page-break-inside: avoid !important;
        }

        .top-box {
            min-height: 250px !important;
            background: #fff !important;
            border-radius: 14px !important;
            overflow: hidden !important;
        }

        .pie-box {
            min-height: 230px !important;
            background: #fff !important;
            border-radius: 14px !important;
            overflow: hidden !important;
        }

        .chart-panel {
            min-height: 205px !important;
            background: #fff !important;
            border-radius: 14px !important;
            overflow: hidden !important;
        }

        .red-head,
        .panel-title,
        .delay-table th {
            background: #991b1b !important;
            color: #fff !important;
        }

        .bar,
        .vbar {
            background: #c1121f !important;
        }

        .hbar {
            background: #0f2635 !important;
        }

        .pie {
            background: conic-gradient(#0c4c58 0 31.3%, #accb8e 31.3% 55.8%, #f57c00 55.8% 82.9%, #a696bf 82.9% 100%) !important;
        }

        .legend,
        .sub-heading,
        .bottom-title,
        table.delay-table {
            background: #fff !important;
            border-radius: 14px !important;
        }

        table.delay-table {
            font-size: 12px !important;
            border-collapse: collapse !important;
            overflow: hidden !important;
            margin-bottom: 20px !important;
        }

        .delay-table th,
        .delay-table td {
            border: 1px solid #eee !important;
            padding: 8px 9px !important;
            vertical-align: middle !important;
        }
    }

    @@media (max-width: 1200px) {
        .top-grid,
        .pie-grid,
        .section-grid {
            grid-template-columns: 1fr;
        }

        .sub-heading {
            grid-column: 1;
        }
    }
</style>

<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-9">
            <h4 class="xp-page-title">CMD Daily Performance Dashboard</h4>
        </div>
        <div class="col-md-3 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">CMD Performance Report</li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3>SOLB Steel - CMD Daily Performance Dashboard</h3>
                <small>
                    <b>
                        Date: @Model.FromDate.ToString("dd MMM yyyy") - @Model.ToDate.ToString("dd MMM yyyy") |
                        Report: CMD Daily Performance Report
                    </b>
                </small>
            </div>

            <div class="col-md-4 text-right no-print">
                @using (Html.BeginForm("CMDPerformance", "Executive", FormMethod.Get, new { @class = "form-inline justify-content-end" }))
                {
                    @*<input type="date"
                           name="reportDate"
                           value="@Model.ReportDate.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm mr-2" />

                    <button type="submit" class="btn btn-light btn-sm mr-2">Load</button>*@
                    <button type="button" class="btn btn-light btn-sm" onclick="printCMDReport()">Print / Save PDF</button>
                }
            </div>
        </div>
    </div>

    <div class="top-grid">
        @{
            var cards = new[]
            {
                new { Title = "Daily Production in Tons", Compare = "VS Yesterday", Data = Model.DailyProduction },
                new { Title = "Production in Tons Month to Date", Compare = "VS Previous Month", Data = Model.MTDProduction },
                new { Title = "Production in Tons Year to Date", Compare = "VS Previous Year", Data = Model.YTDProduction }
            };
        }

        @foreach (var card in cards)
        {
            var p = card.Data ?? new DAL.Models.ProductionSummaryVM();
            var maxValue = Math.Max(p.SMP, Math.Max(p.RM1, p.RM2));
            var rm1Height = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.RM1 / maxValue) * 105)) : 0;
            var rm2Height = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.RM2 / maxValue) * 105)) : 0;
            var smpHeight = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.SMP / maxValue) * 105)) : 0;

            <div class="top-box">
                <div class="red-head">@card.Title</div>
                <div class="mini-values">
                    SMP <span style="color:#c1000b">@p.SMP.ToString("N0")</span> MT<br />
                    RM1 @p.RM1.ToString("N0") MT<br />
                    RM2 @p.RM2.ToString("N0") MT
                </div>
                <div class="compare-label">@card.Compare</div>
                <div class="big-up @(p.ComparisonPercentage >= 0 ? "green" : "text-danger")">
                    @(p.ComparisonPercentage >= 0 ? "▲" : "▼")
                    @Math.Abs(p.ComparisonPercentage).ToString("N1")%
                </div>
                <div class="bar-wrap">
                    <div class="bar-col"><div class="bar" style="height:@(rm1Height)px"><span>@p.RM1.ToString("N0")</span></div>RM1</div>
                    <div class="bar-col"><div class="bar" style="height:@(rm2Height)px"><span>@p.RM2.ToString("N0")</span></div>RM2</div>
                    <div class="bar-col"><div class="bar" style="height:@(smpHeight)px"><span>@p.SMP.ToString("N0")</span></div>SMP</div>
                </div>
            </div>
        }
    </div>

    <div class="pie-grid">
        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var d = Model.Downtime != null
                ? Model.Downtime.FirstOrDefault(x => x.Plant == plant)
                : null;

            if (d == null)
            {
                d = new DAL.Models.DowntimeSummaryVM { Plant = plant };
            }

            var dtd1 = d.DTDUtilities;
            var dtd2 = dtd1 + d.DTDMechanical;
            var dtd3 = dtd2 + d.DTDElectrical;

            var mtd1 = d.MTDUtilities;
            var mtd2 = mtd1 + d.MTDMechanical;
            var mtd3 = mtd2 + d.MTDElectrical;

            var dtdGradient = string.Format(
                CultureInfo.InvariantCulture,
                "conic-gradient(#0c4c58 0 {0}%, #accb8e {0}% {1}%, #f57c00 {1}% {2}%, #a696bf {2}% 100%)",
                dtd1, dtd2, dtd3
            );

            var mtdGradient = string.Format(
                CultureInfo.InvariantCulture,
                "conic-gradient(#0c4c58 0 {0}%, #accb8e {0}% {1}%, #f57c00 {1}% {2}%, #a696bf {2}% 100%)",
                mtd1, mtd2, mtd3
            );

            <div class="pie-box">
                <div class="red-head pie-title">@plant Downtime %</div>
                <div class="pies">
                    <div>
                        <div class="pie-label">Delays on Date (DTD)</div>
                        <div class="pie" style="background:@dtdGradient">
                            <span class="p1">@d.DTDUtilities.ToString("N1")%</span>
                            <span class="p2">@d.DTDMechanical.ToString("N1")%</span>
                            <span class="p3">@d.DTDElectrical.ToString("N1")%</span>
                            <span class="p4">@d.DTDCranes.ToString("N1")%</span>
                        </div>
                    </div>
                    <div>
                        <div class="pie-label">Month to Date (MTD)</div>
                        <div class="pie" style="background:@mtdGradient">
                            <span class="p1">@d.MTDUtilities.ToString("N1")%</span>
                            <span class="p2">@d.MTDMechanical.ToString("N1")%</span>
                            <span class="p3">@d.MTDElectrical.ToString("N1")%</span>
                            <span class="p4">@d.MTDCranes.ToString("N1")%</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="legend">
        <span class="sq mech"></span>MECHANICAL
        <span class="sq elec"></span>ELECTRICAL
        <span class="sq cranes"></span>CRANES
        <span class="sq util"></span>UTILITIES
    </div>

    <div class="section-grid">
        <div class="sub-heading">FAILURE EQUIPMENT WISE - TOP 5</div>

        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var items = (Model.EquipmentFailures ?? new List<DAL.Models.TopFailureVM>())
                .Where(x => x.Plant == plant)
                .OrderByDescending(x => x.DelayHours)
                .Take(5)
                .ToList();

            var max = items.Any() ? items.Max(x => x.DelayHours) : 0;

            <div class="chart-panel">
                <div class="panel-title">@plant</div>

                @if (items.Any())
                {
                    <div class="bars-five">
                        @foreach (var item in items)
                        {
                            var height = max > 0 ? Math.Max(8, Convert.ToInt32((item.DelayHours / max) * 94)) : 0;
                            <div class="vbar" style="height:@(height)px"><span>@item.DelayHours.ToString("N1")</span></div>
                        }
                    </div>
                    <div class="xlabels">
                        @foreach (var item in items)
                        {
                            <span>@item.Name</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-4">No equipment delay data.</div>
                }

                <div class="legend-small">■ Total Delay Hours</div>
            </div>
        }

        <div class="sub-heading">FAILURE RCA WISE (MTD) - TOP 5</div>

        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var items = (Model.RCAFailures ?? new List<DAL.Models.TopFailureVM>())
                .Where(x => x.Plant == plant)
                .OrderByDescending(x => x.DelayHours)
                .Take(5)
                .ToList();

            var max = items.Any() ? items.Max(x => x.DelayHours) : 0;

            <div class="chart-panel">
                <div class="panel-title">@plant</div>

                @if (items.Any())
                {
                    foreach (var item in items)
                    {
                        var width = max > 0 ? Math.Round((item.DelayHours / max) * 100, 2) : 0;
                        <div class="hbar-row">
                            <span>@item.Name</span>
                            <div class="hbar-bg">
                                <div class="hbar" style="width:@(width.ToString(CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <b>@item.DelayHours.ToString("N1")</b>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted p-4">No RCA delay data.</div>
                }
            </div>
        }

        <div class="sub-heading">Counter Measures Closure Rate %</div>

        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var items = (Model.ClosureRates ?? new List<DAL.Models.ClosureRateVM>())
                .Where(x => x.Plant == plant)
                .OrderBy(x => x.MonthNumber)
                .ToList();

            <div class="chart-panel">
                <div class="panel-title">@plant</div>

                @if (items.Any())
                {
                    foreach (var item in items)
                    {
                        var width = Math.Max(0, Math.Min(100, item.ClosurePercentage));
                        <div class="hbar-row">
                            <span>@item.MonthName - @item.Department</span>
                            <div class="hbar-bg">
                                <div class="hbar" style="width:@(width.ToString(CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <b>@item.ClosurePercentage.ToString("N0")%</b>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted p-4">Closure-rate data is not connected.</div>
                }
            </div>
        }
    </div>

    <div class="bottom-title">Description of Top Delays on Date</div>

    <table class="delay-table">
        <thead>
            <tr>
                <th>SHIFT</th>
                <th>Total</th>
                <th>Delay Code</th>
                <th>Equipment Code</th>
                <th>Description</th>
                <th>Reason for Occurrence</th>
                <th>Action Taken</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TopDelays != null && Model.TopDelays.Any())
            {
                foreach (var item in Model.TopDelays)
                {
                    <tr>
                        <td>@item.Shift</td>
                        <td>@item.TotalDuration.ToString("N1")</td>
                        <td>@item.DelayCode</td>
                        <td>@item.EquipmentCode</td>
                        <td>@item.Description</td>
                        <td>@item.ReasonForOccurrence</td>
                        <td>@item.ActionTaken</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">No delay records found for @Model.ReportDate.ToString("dd MMM yyyy").</td>
                </tr>
            }
        </tbody>
    </table>

</div>

<script>
    function printCMDReport() {
        window.print();
    }
</script>