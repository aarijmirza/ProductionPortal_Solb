@model DAL.Models.CMDPerformanceDashboardVM
@using System
@using System.Globalization
@using System.Linq
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    :root {
        --primary: #a6173f;
        --primary-dark: #7d102f;
        --primary-2: #c1121f;
        --green: #198754;
        --blue: #0d6efd;
        --orange: #fd7e14;
        --purple: #6f42c1;
        --text: #222;
        --muted: #6c757d;
        --line: #e9ecef;
        --shadow: 0 4px 16px rgba(0,0,0,0.08);
        --shadow-lg: 0 8px 20px rgba(0,0,0,0.12);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #eef2f6;
        color: var(--text);
    }

    .xp-contentbar {
        padding-top: 15px;
    }

    .dashboard-header {
        background: linear-gradient(135deg, var(--primary-dark), var(--primary));
        color: #fff;
        border-radius: 14px;
        padding: 22px 25px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-lg);
    }

        .dashboard-header h3 {
            margin: 0;
            font-weight: 800;
            color: #fff;
            letter-spacing: .2px;
        }

        .dashboard-header small {
            color: rgba(255,255,255,.92);
            font-size: 13px;
        }

    .top-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .top-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        min-height: 355px;
        position: relative;
        padding: 0 14px 14px;
        overflow: hidden;
        border: none;
    }

    .red-head {
        background: #991b1b;
        color: #fff;
        text-align: center;
        font-size: 15px;
        font-weight: 800;
        padding: 10px 8px;
        margin: 0 -14px 12px;
    }

    .mini-values {
        font-size: 13px;
        font-weight: 800;
        line-height: 24px;
        color: #333;
        margin-bottom: 8px;
    }

    .compare-label {
        font-weight: 800;
        font-size: 13px;
        color: #555;
        margin-top: 8px;
    }

    .big-up {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .green {
        color: var(--green);
    }

    .plan-actual-box {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f4f7 100%);
        border: 1px solid #e3e8ee;
        border-radius: 10px;
        display: grid;
        gap: 5px 10px;
        grid-template-columns: 1fr 1fr 1.15fr;
        margin: 6px 0 8px;
        padding: 9px 10px;
    }

    .plan-actual-title {
        color: #5b6672;
        font-size: 10px;
        font-weight: 900;
        grid-column: 1 / -1;
        letter-spacing: .25px;
        text-transform: uppercase;
    }

    .plan-actual-metric {
        color: #69737e;
        font-size: 9px;
        font-weight: 800;
        line-height: 1.25;
        text-transform: uppercase;
    }

        .plan-actual-metric strong {
            color: #17212b;
            display: block;
            font-size: 13px;
            margin-top: 2px;
            text-transform: none;
        }

        .plan-actual-metric.positive strong {
            color: #198754;
        }

        .plan-actual-metric.negative strong {
            color: #c1121f;
        }

    .variance-arrow {
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        display: inline-block;
        height: 0;
        margin-right: 4px;
        vertical-align: 1px;
        width: 0;
    }

        .variance-arrow.up {
            border-bottom: 8px solid #198754;
        }

        .variance-arrow.down {
            border-top: 8px solid #c1121f;
        }

    .bar-wrap {
        height: 120px;
        border-bottom: 1px solid #ddd;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 28px;
        padding: 0 15px;
        margin-top: 8px;
    }

    .bar-col {
        text-align: center;
        font-size: 11px;
        font-weight: 800;
        color: #333;
    }

    .bar {
        width: 42px;
        background: #c1121f;
        border-radius: 8px 8px 0 0;
        position: relative;
        display: block;
        margin: 0 auto 6px;
    }

        .bar span {
            position: absolute;
            top: -18px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            color: #111;
            font-weight: 900;
            white-space: nowrap;
        }

    .pie-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 8px;
    }

    .pie-box {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
        min-height: 230px;
        border: none;
    }

    .pie-title {
        margin: 0;
    }

    .pies {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 12px;
        align-items: center;
    }

    .pie-label {
        text-align: center;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 6px;
        color: #333;
    }

    .pie {
        width: 112px;
        height: 112px;
        margin: 0 auto;
        border-radius: 50%;
        background: conic-gradient(#0c4c58 0 31.3%, #accb8e 31.3% 55.8%, #f57c00 55.8% 82.9%, #a696bf 82.9% 100%);
        position: relative;
    }

        .pie .p1,
        .pie .p2,
        .pie .p3,
        .pie .p4 {
            position: absolute;
            color: #fff;
            font-size: 10px;
            font-weight: 900;
            text-shadow: 0 1px 2px rgba(0,0,0,.45);
        }

        .pie .p1 {
            top: 27px;
            right: 18px;
        }

        .pie .p2 {
            bottom: 27px;
            right: 25px;
        }

        .pie .p3 {
            bottom: 40px;
            left: 13px;
        }

        .pie .p4 {
            top: 36px;
            left: 16px;
        }

    .downtime-card {
        min-height: 500px;
    }

    .downtime-body {
        padding: 40px 14px 14px;
    }

    .downtime-caption {
        color: #66717d;
        font-size: 10px;
        font-weight: 700;
        margin: -2px 0 9px;
        text-align: center;
    }

    .downtime-donuts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .donut-panel {
        background: linear-gradient(180deg, #fbfcfd 0%, #f5f7f9 100%);
        border: 1px solid #e5e9ee;
        border-radius: 12px;
        padding: 8px 5px 10px;
        text-align: center;
    }

    .donut-title {
        color: #3f4a55;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .3px;
        margin-bottom: 6px;
        text-transform: uppercase;
    }

    .donut-chart {
        background: #e3e7eb;
        border-radius: 50%;
        box-shadow: 0 5px 14px rgba(31,41,51,.15);
        height: 132px;
        margin: 0 auto;
        overflow: hidden;
        position: relative;
        width: 132px;
    }

    .donut-chart-svg {
        display: block;
        height: 132px;
        transform: rotate(-90deg);
        width: 132px;
    }

    .donut-track,
    .donut-slice {
        fill: none;
        stroke-width: 28;
    }

    .donut-track {
        stroke: #e3e7eb;
    }

    .donut-slice {
        stroke-linecap: butt;
    }

    .donut-center {
        align-items: center;
        background: #fff;
        border: 1px solid #edf0f2;
        border-radius: 50%;
        box-shadow: inset 0 1px 3px rgba(0,0,0,.06);
        display: flex;
        flex-direction: column;
        height: 76px;
        justify-content: center;
        left: 28px;
        position: absolute;
        top: 28px;
        width: 76px;
        z-index: 2;
    }

        .donut-center strong {
            color: #17212b;
            font-size: 17px;
            font-weight: 900;
            line-height: 1;
        }

        .donut-center span {
            color: #77818c;
            font-size: 8px;
            font-weight: 800;
            margin-top: 4px;
            text-transform: uppercase;
        }

    .donut-subtitle {
        color: #7a8590;
        font-size: 8px;
        font-weight: 700;
        margin-top: 6px;
    }

    .donut-values {
        display: grid;
        gap: 7px;
        grid-template-columns: 1fr;
        margin-top: 10px;
    }

    .donut-value-item {
        align-items: center;
        background: #f7f8fa;
        border: 1px solid #e8ebef;
        border-radius: 9px;
        display: grid;
        font-size: 13px;
        grid-template-columns: 13px minmax(0, 1fr) auto;
        gap: 9px;
        padding: 9px 11px;
    }

    .donut-value-dot {
        background: var(--agency-color);
        border-radius: 50%;
        height: 12px;
        width: 12px;
    }

    .donut-value-name {
        color: #36414c;
        font-weight: 900;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .donut-value-numbers {
        color: #1d2731;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .downtime-available {
        background: #f4f6f8;
        border: 1px solid #e7eaee;
        border-radius: 9px;
        color: #66717d;
        font-size: 8px;
        font-weight: 700;
        line-height: 1.45;
        margin-top: 8px;
        padding: 6px 8px;
        text-align: center;
    }

    .downtime-formula {
        color: #4e5965;
        font-size: 10px;
        font-weight: 800;
    }

    .legend {
        background: #fff;
        border-radius: 14px;
        padding: 14px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
        text-align: center;
        font-size: 15px;
        font-weight: 900;
    }

    .sq {
        display: inline-block;
        width: 16px;
        height: 16px;
        vertical-align: middle;
        margin: 0 4px 0 12px;
        border-radius: 3px;
    }

    .mech {
        background: #4f8a10;
    }

    .elec {
        background: #e66b00;
    }

    .cranes {
        background: #7250a8;
    }

    .util {
        background: #0c6370;
    }

    .section-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .sub-heading {
        grid-column: 1 / 4;
        background: #fff;
        border-left: 5px solid #c1121f;
        border-radius: 14px;
        padding: 12px 15px;
        font-size: 16px;
        font-weight: 900;
        box-shadow: var(--shadow);
        margin-top: 5px;
    }

        .sub-heading small {
            color: #75808b;
            display: block;
            font-size: 10px;
            font-weight: 700;
            margin-top: 3px;
        }

    .chart-panel {
        background: #fff;
        border-radius: 14px;
        box-shadow: var(--shadow);
        min-height: 205px;
        padding: 0 12px 12px;
        overflow: hidden;
        border: none;
    }

    .panel-title {
        background: #991b1b;
        color: #fff;
        text-align: center;
        font-size: 14px;
        font-weight: 900;
        padding: 9px 8px;
        margin: 0 -12px 12px;
    }

    .bars-five {
        height: 118px;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        gap: 10px;
        padding: 0 10px;
        border-bottom: 1px solid #ddd;
    }

    .vbar {
        width: 38px;
        background: #c1121f;
        border-radius: 8px 8px 0 0;
        position: relative;
    }

        .vbar span {
            position: absolute;
            top: -17px;
            left: 50%;
            transform: translateX(-50%);
            font-weight: 900;
            font-size: 11px;
        }

    .xlabels {
        display: flex;
        justify-content: space-around;
        font-size: 7px;
        font-weight: 800;
        margin-top: 5px;
        gap: 3px;
        text-align: center;
        line-height: 1.1;
    }

    .legend-small {
        text-align: center;
        font-size: 10px;
        font-weight: 800;
        margin-top: 5px;
    }

    .hbar-row {
        display: grid;
        grid-template-columns: 125px 1fr 25px;
        align-items: center;
        font-size: 8px;
        font-weight: 800;
        margin: 6px 0;
        gap: 5px;
    }

    .hbar-bg {
        height: 10px;
        background: #e9ecef;
        border-radius: 20px;
        overflow: hidden;
    }

    .hbar {
        height: 10px;
        background: #0f2635;
        border-radius: 20px;
    }

    .rca-chart-panel {
        border: 1px solid #dbe3ea;
        min-height: 330px;
        overflow: visible;
    }

    /*        .rca-chart-panel .panel-title {
            background: linear-gradient(135deg, #a30f18 0%, #cf0000 100%);
            font-size: 16px;
            letter-spacing: .25px;
            text-transform: uppercase;
        }*/

    .rca-horizontal-chart {
        padding: 9px 7px 2px;
    }

    .rca-horizontal-row {
        align-items: center;
        display: grid;
        gap: 10px;
        grid-template-columns: minmax(105px, 34%) minmax(80px, 1fr) 48px;
        margin: 20px 0;
    }

    .rca-horizontal-label {
        color: #18212b;
        font-size: 11px;
        font-weight: 850;
        line-height: 1.2;
        overflow: hidden;
        text-align: right;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rca-track {
        background: linear-gradient(180deg, #f4f7fa 0%, #e6ebf0 100%);
        border: 1px solid #dbe3e9;
        border-radius: 3px;
        height: 24px;
        position: relative;
    }

    .rca-bar {
        background: linear-gradient(180deg, #1d3d5f 0%, #102a46 57%, #091d32 100%);
        border-radius: 2px;
        box-shadow: inset 0 3px 0 rgba(255,255,255,.17), inset 0 -4px 0 rgba(0,0,0,.18), 5px 4px 0 #071725, 0 7px 10px rgba(7,23,37,.22);
        height: 100%;
        min-width: 6px;
        position: relative;
    }

        .rca-bar::after {
            background: #071725;
            clip-path: polygon(0 0, 100% 18%, 100% 82%, 0 100%);
            content: "";
            height: 100%;
            position: absolute;
            right: -6px;
            top: 2px;
            width: 6px;
        }

    .rca-horizontal-value {
        color: #111827;
        font-size: 13px;
        font-weight: 950;
        padding-left: 20px;
        white-space: nowrap;
    }

    .rca-axis-title {
        border-top: 1px solid #d8dee5;
        color: #17202a;
        font-size: 13px;
        font-weight: 950;
        margin: 12px 6px 0;
        padding-top: 9px;
        text-align: center;
    }

    .counter-measure-heading {
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid #dce4eb;
        border-left: 6px solid #c1121f;
        border-radius: 14px;
        box-shadow: var(--shadow);
        color: #111827;
        font-size: 24px;
        line-height: 1.05;
        margin: 12px 0 2px;
        padding: 13px 16px;
    }

        .counter-measure-heading small {
            color: #66717e;
            font-size: 11px;
            margin-top: 6px;
        }

    .line-chart {
        background: #fff;
        border: 0;
        border-radius: 0;
        display: block;
        height: 235px;
        overflow: visible;
        width: 100%;
    }

        .line-chart .grid-line {
            stroke: #dce5ec;
            stroke-dasharray: 4 5;
            stroke-width: 1;
        }

        .line-chart .axis-line {
            stroke: #d2d2d2;
            stroke-width: 1.5;
        }

        .line-chart .axis-label {
            fill: #647180;
            font-size: 15px;
            font-weight: 800;
        }

        .line-chart .series-line {
            fill: none;
            filter: drop-shadow(0 4px 4px rgba(127,29,29,.25));
            stroke-width: 8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .line-chart .series-point {
            stroke: #fff;
            stroke-width: 4;
        }

        .line-chart .point-label {
            fill: #111827;
            font-size: 17px;
            font-weight: 950;
            paint-order: stroke;
            stroke: #fff;
            stroke-linejoin: round;
            stroke-width: 7px;
            text-anchor: middle;
        }

    .closure-chart-panel {
        border: 1px solid #d8e1e9;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(15,23,42,.09);
        min-height: 545px;
        overflow: hidden;
        padding: 0 9px 12px;
    }

        .closure-chart-panel .panel-title {
            background: linear-gradient(135deg, #a30f18 0%, #cf0000 100%);
            color: #fff;
            font-size: 18px;
            letter-spacing: .2px;
            margin: 0 -9px 7px;
            padding: 11px 8px;
            text-transform: uppercase;
        }

    .closure-period-summary {
        background: linear-gradient(135deg, #f8fafc 0%, #eef3f7 100%);
        border: 1px solid #dce4eb;
        border-radius: 12px;
        margin: 9px 3px 4px;
        padding: 8px;
    }

    .closure-period-title {
        color: #4b5663;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .25px;
        margin-bottom: 7px;
        text-align: center;
        text-transform: uppercase;
    }

    .closure-period-grid {
        display: grid;
        gap: 6px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .closure-total-kpi {
        align-items: center;
        background: linear-gradient(135deg, #991b1b 0%, #c1121f 100%);
        border-radius: 10px;
        color: #fff;
        display: flex;
        justify-content: space-between;
        margin-bottom: 7px;
        padding: 7px 11px;
    }

        .closure-total-kpi span {
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .2px;
            text-transform: uppercase;
        }

        .closure-total-kpi strong {
            color: #fff;
            font-size: 19px;
            font-weight: 950;
        }

    .closure-period-item {
        align-items: center;
        background: #fff;
        border: 1px solid #e0e6ec;
        border-radius: 9px;
        display: flex;
        gap: 6px;
        justify-content: center;
        min-width: 0;
        padding: 7px 5px;
    }

    .closure-period-dot {
        background: var(--series-color);
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(15,23,42,.05);
        flex: 0 0 auto;
        height: 8px;
        width: 8px;
    }

    .closure-period-copy {
        line-height: 1.05;
        min-width: 0;
        text-align: left;
    }

        .closure-period-copy span {
            color: #687482;
            display: block;
            font-size: 8px;
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .closure-period-copy strong {
            color: #111827;
            display: block;
            font-size: 16px;
            font-weight: 950;
            margin-top: 2px;
        }

    .line-chart .closure-bar {
        filter: drop-shadow(2px 3px 2px rgba(15,23,42,.2));
        opacity: .96;
        stroke: rgba(255,255,255,.7);
        stroke-width: 1;
    }

    .line-chart .closure-bar-label {
        fill: #1f2937;
        font-size: 20px;
        font-weight: 950;
        paint-order: stroke;
        stroke: #fff;
        stroke-linejoin: round;
        stroke-width: 7px;
        text-anchor: middle;
    }

    .closure-empty-state {
        align-items: center;
        background: #f8f9fb;
        border: 1px dashed #d7dde3;
        border-radius: 10px;
        color: #77828e;
        display: flex;
        font-size: 11px;
        font-weight: 700;
        justify-content: center;
        margin: 15px 5px;
        min-height: 245px;
        padding: 20px;
        text-align: center;
    }

    .line-legend {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 7px;
        margin: 4px 3px 0;
        font-size: 11px;
        font-weight: 900;
        color: #555;
    }

    .line-legend-item {
        background: #f7f9fb;
        border: 1px solid #e0e6ec;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 8px;
        white-space: nowrap;
    }

        .line-legend-item strong {
            color: #16202b;
            display: inline;
            font-size: 11px;
        }

        .line-legend-item em {
            color: #6b7785;
            display: inline;
            font-size: 9px;
            font-style: normal;
            font-weight: 750;
        }

    .line-legend-color {
        background: var(--series-color);
        border-radius: 3px;
        display: inline-block;
        height: 4px;
        position: relative;
        width: 22px;
    }

        .line-legend-color::after {
            background: var(--series-color);
            border-radius: 50%;
            content: "";
            height: 9px;
            left: 10px;
            position: absolute;
            top: -3px;
            width: 9px;
        }

    .bottom-title {
        background: #fff;
        border-left: 5px solid #c1121f;
        border-radius: 14px;
        padding: 12px 15px;
        font-size: 16px;
        font-weight: 900;
        box-shadow: var(--shadow);
        margin-bottom: 10px;
    }

    table.delay-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--shadow);
        margin-bottom: 20px;
    }

    .delay-table th,
    .delay-table td {
        border: 1px solid #eee;
        padding: 8px 9px;
        text-align: center;
        vertical-align: middle;
    }

    .delay-table th {
        background: #991b1b;
        color: #fff;
        font-weight: 900;
        white-space: nowrap;
    }

    .delay-table td:nth-child(4),
    .delay-table td:nth-child(5),
