<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-9">
            <h4 class="xp-page-title">CMD Daily Performance Dashboard</h4>
        </div>
        <div class="col-md-3 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">CMD Performance Report</li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </div>
    </div>
</div>

<div class="xp-contentbar" id="cmdDashboardPDF">

    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3>SOLB Steel - CMD Daily Performance Dashboard</h3>
                <small>
                    <b>
                        Date: @Model.FromDate.ToString("dd MMM yyyy") - @Model.ToDate.ToString("dd MMM yyyy") |
                        Report: CMD Daily Performance Report
                    </b>
                </small>
            </div>

            <div class="col-md-4 text-right no-print">
                <form method="get"
                      action="@Url.Action("CMDDailyReport")"
                      class="form-inline justify-content-end">

                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm mr-2" />

                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm mr-2" />

                    <button type="submit"
                            class="btn btn-light btn-sm mr-2">
                        Load
                    </button>

                    <button type="button"
                            class="btn btn-light btn-sm"
                            onclick="printCMDReport(event)">
                        <i class="fa fa-file-pdf-o"></i>
                        Download PDF
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="top-grid">
        @{
            bool isSingleDay =
                Model.FromDate.Date == Model.ToDate.Date;

            var cards = new[]
            {
                new
                {
                    Title = isSingleDay
                        ? "Daily Production in Tons"
                        : "Selected Period Production in Tons",

                    Compare = isSingleDay
                        ? "SMP Daily Plan vs Actual"
                        : "SMP Period Plan vs Actual",

                    Data = Model.DailyProduction
                },
                new { Title = "Production in Tons Month to Date", Compare = "SMP MTD Plan vs Actual", Data = Model.MTDProduction },
                new { Title = "Production in Tons Year to Date", Compare = "SMP YTD Plan vs Actual", Data = Model.YTDProduction }
            };
        }

        @foreach (var card in cards)
        {
            var p = card.Data ?? new DAL.Models.ProductionSummaryVM();
            var maxValue = Math.Max(p.SMP, Math.Max(p.RM1, p.RM2));
            var rm1Height = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.RM1 / maxValue) * 105)) : 0;
            var rm2Height = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.RM2 / maxValue) * 105)) : 0;
            var smpHeight = maxValue > 0 ? Math.Max(8, Convert.ToInt32((p.SMP / maxValue) * 105)) : 0;
            decimal smpPlan = Math.Max(0m, Convert.ToDecimal(p.ComparisonPercentage));
            decimal smpVariance = p.SMP - smpPlan;
            decimal smpVariancePercentage = smpPlan > 0
                ? Math.Round((smpVariance / smpPlan) * 100m, 1)
                : 0m;
            bool isPositiveVariance = smpVariance >= 0;

            <div class="top-box">
                <div class="red-head">@card.Title</div>
                <div class="mini-values">
                    SMP <span style="color:#c1000b">@p.SMP.ToString("N0")</span> MT<br />
                    RM1 @p.RM1.ToString("N0") MT<br />
                    RM2 @p.RM2.ToString("N0") MT
                </div>



                <!--<div class="plan-actual-box">
                    <div class="plan-actual-title">@card.Compare</div>

                    <div class="plan-actual-metric">
                        Plan
                        <strong>@smpPlan.ToString("N0") MT</strong>
                    </div>

                    <div class="plan-actual-metric">
                        Actual
                        <strong>@p.SMP.ToString("N0") MT</strong>
                    </div>-->
                @*<div class="plan-actual-metric @(isPositiveVariance ? "positive" : "negative")">
                        Variance
                        <strong>
                            <span class="variance-arrow @(isPositiveVariance ? "up" : "down")"></span>
                            @smpVariance.ToString("+#,##0;-#,##0;0") MT
                            @if (smpPlan > 0)
                            {
                                <small>(@smpVariancePercentage.ToString("+#,##0.0;-#,##0.0;0.0")%)</small>
                            }
                        </strong>
                    </div>*@
                <!--</div>-->

                <div class="bar-wrap">
                    <div class="bar-col"><div class="bar" style="height:@(rm1Height)px"><span>@p.RM1.ToString("N0")</span></div>RM1</div>
                    <div class="bar-col"><div class="bar" style="height:@(rm2Height)px"><span>@p.RM2.ToString("N0")</span></div>RM2</div>
                    <div class="bar-col"><div class="bar" style="height:@(smpHeight)px"><span>@p.SMP.ToString("N0")</span></div>SMP</div>
                </div>
            </div>
        }
    </div>

    <div class="pie-grid">
        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var d = Model.Downtime != null
                ? Model.Downtime.FirstOrDefault(x => x.Plant == plant)
                : null;

            if (d == null)
            {
                d = new DAL.Models.DowntimeSummaryVM { Plant = plant };
            }

            var downtimeRows = new[]
            {
                new { Agency = "Mechanical", DTD = d.DTDMechanical, MTD = d.MTDMechanical, Color = "#4f8a10" },
                new { Agency = "Electrical", DTD = d.DTDElectrical, MTD = d.MTDElectrical, Color = "#e66b00" },
                new { Agency = "Cranes", DTD = d.DTDCranes, MTD = d.MTDCranes, Color = "#7250a8" },
                new { Agency = "Utility", DTD = d.DTDUtilities, MTD = d.MTDUtilities, Color = "#0c6370" }
            };

            decimal dtdTotal = downtimeRows.Sum(x => Math.Max(0m, x.DTD));
            decimal mtdTotal = downtimeRows.Sum(x => Math.Max(0m, x.MTD));

            <div class="pie-box downtime-card">
                <div class="red-head pie-title">@plant Downtime %</div>

                <div class="downtime-body">
                    @*<div class="downtime-caption">
                            Pie = agency share of total downtime | Centre = actual total downtime %
                        </div>*@

                    <div class="downtime-donuts">
                        <div class="donut-panel">
                            <div class="donut-title">DTD</div>
                            <div class="donut-chart"
                                 title="DTD agency share of total downtime">
                                <svg class="donut-chart-svg"
                                     viewBox="0 0 132 132"
                                     role="img"
                                     aria-label="DTD agency share of total downtime">
                                    <circle class="donut-track"
                                            cx="66"
                                            cy="66"
                                            r="49"></circle>
                                    @{
                                        decimal dtdOffset = 0m;
                                    }
                                    @foreach (var row in downtimeRows)
                                    {
                                        decimal dtdSlice = dtdTotal > 0m
                                            ? Math.Max(0m, row.DTD) * 100m / dtdTotal
                                            : 0m;
                                        string dtdDashArray = string.Format(
                                            CultureInfo.InvariantCulture,
                                            "{0:0.####} {1:0.####}",
                                            dtdSlice,
                                            100m - dtdSlice
                                        );
                                        string dtdDashOffset = (-dtdOffset)
                                            .ToString("0.####", CultureInfo.InvariantCulture);

                                        if (dtdSlice > 0m)
                                        {
                                            <circle class="donut-slice"
                                                    cx="66"
                                                    cy="66"
                                                    r="49"
                                                    pathLength="100"
                                                    stroke="@row.Color"
                                                    stroke-dasharray="@dtdDashArray"
                                                    stroke-dashoffset="@dtdDashOffset"></circle>
                                        }

                                        dtdOffset += dtdSlice;
                                    }
                                </svg>
                                <div class="donut-center">
                                    <strong>@dtdTotal.ToString("N2")%</strong>
                                    <span>Total DT</span>
                                </div>
                            </div>
                            <div class="donut-subtitle">Selected date</div>
                        </div>

                        <div class="donut-panel">
                            <div class="donut-title">MTD</div>
                            <div class="donut-chart"
                                 title="MTD agency share of total downtime">
                                <svg class="donut-chart-svg"
                                     viewBox="0 0 132 132"
                                     role="img"
                                     aria-label="MTD agency share of total downtime">
                                    <circle class="donut-track"
                                            cx="66"
                                            cy="66"
                                            r="49"></circle>
                                    @{
                                        decimal mtdOffset = 0m;
                                    }
                                    @foreach (var row in downtimeRows)
                                    {
                                        decimal mtdSlice = mtdTotal > 0m
                                            ? Math.Max(0m, row.MTD) * 100m / mtdTotal
                                            : 0m;
                                        string mtdDashArray = string.Format(
                                            CultureInfo.InvariantCulture,
                                            "{0:0.####} {1:0.####}",
                                            mtdSlice,
                                            100m - mtdSlice
                                        );
                                        string mtdDashOffset = (-mtdOffset)
                                            .ToString("0.####", CultureInfo.InvariantCulture);

                                        if (mtdSlice > 0m)
                                        {
                                            <circle class="donut-slice"
                                                    cx="66"
                                                    cy="66"
                                                    r="49"
                                                    pathLength="100"
                                                    stroke="@row.Color"
                                                    stroke-dasharray="@mtdDashArray"
                                                    stroke-dashoffset="@mtdDashOffset"></circle>
                                        }

                                        mtdOffset += mtdSlice;
                                    }
                                </svg>
                                <div class="donut-center">
                                    <strong>@mtdTotal.ToString("N2")%</strong>
                                    <span>Total DT</span>
                                </div>
                            </div>
                            <div class="donut-subtitle">Month to date</div>
                        </div>
                    </div>

                    <div class="donut-values">
                        @foreach (var row in downtimeRows)
                        {
                            string agencyStyle = "--agency-color:" + row.Color + ";";

                            <div class="donut-value-item" style="@agencyStyle">
                                <span class="donut-value-dot"></span>
                                <span class="donut-value-name">@row.Agency</span>
                                <span class="donut-value-numbers">
                                    DTD - @row.DTD.ToString("N2")% · MTD - @row.MTD.ToString("N2")%
                                </span>
                            </div>
                        }
                    </div>

                    @*<div class="downtime-available">
                            DTD Available = 1,440 − Scheduled Delay Minutes<br />
                            MTD Available = (Elapsed Days × 1,440) − Scheduled Delay Minutes
                        </div>*@
                </div>
            </div>
        }
    </div>

    <div class="legend">
        <span class="sq mech"></span>MECHANICAL
        <span class="sq elec"></span>ELECTRICAL
        <span class="sq cranes"></span>CRANES
        <span class="sq util"></span>UTILITY
        <br />
        @*<span class="downtime-formula">
                Downtime % = Unscheduled Agency Delay Minutes / Available Minutes × 100
            </span>*@
    </div>

    <div class="section-grid">
        <div class="sub-heading">FAILURE EQUIPMENT WISE - TOP 5</div>

        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var items = (Model.EquipmentFailures ?? new List<DAL.Models.TopFailureVM>())
                .Where(x => x.Plant == plant)
                .OrderByDescending(x => x.DelayHours)
                .Take(5)
                .ToList();

            var max = items.Any() ? items.Max(x => x.DelayHours) : 0;

            <div class="chart-panel">
                <div class="panel-title">@plant</div>

                @if (items.Any())
                {
                    <div class="bars-five">
                        @foreach (var item in items)
                        {
                            var height = max > 0 ? Math.Max(8, Convert.ToInt32((item.DelayHours / max) * 94)) : 0;
                            <div class="vbar" style="height:@(height)px"><span>@item.DelayHours.ToString("N1")</span></div>
                        }
                    </div>
                    <div class="xlabels">
                        @foreach (var item in items)
                        {
                            <span>@item.Name</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-4">No equipment delay data.</div>
                }

                <div class="legend-small">■ Total Delay Hours</div>
            </div>
        }

        <div class="sub-heading">FAILURE RCA WISE (MTD) - TOP 5</div>

        @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
        {
            var items = (Model.RCAFailures ?? new List<DAL.Models.TopFailureVM>())
                .Where(x => x.Plant == plant)
                .OrderByDescending(x => x.DelayHours)
                .Take(5)
                .ToList();

            var max = items.Any() ? items.Max(x => x.DelayHours) : 0;
            string rcaPlantTitle = plant == "SMP"
                ? "STEEL MAKING PLANT"
                : (plant == "RM1" ? "ROLLING MILL 1" : "ROLLING MILL 2");

            <div class="chart-panel rca-chart-panel">
                <div class="panel-title">@rcaPlantTitle</div>

                @if (items.Any())
                {
                    <div class="rca-horizontal-chart">
                        @foreach (var item in items)
                        {
                            decimal barWidth = max > 0
                                ? Math.Max(3m, (item.DelayHours / max) * 96m)
                                : 0m;
                            string barStyle = string.Format(
                                CultureInfo.InvariantCulture,
                                "width:{0:0.##}%;",
                                barWidth
                            );

                            string barTitle = string.Format(
                                CultureInfo.CurrentCulture,
                                "{0} - {1:N1} hours",
                                item.Name,
                                item.DelayHours
                            );

                            <div class="rca-horizontal-row">
                                <div class="rca-horizontal-label" title="@item.Name">
                                    @item.Name
                                </div>
                                <div class="rca-track" title="@barTitle">
                                    <div class="rca-bar"
                                         style="@barStyle">
                                    </div>
                                </div>
                                <div class="rca-horizontal-value">
                                    @item.DelayHours.ToString("N1")
                                </div>
                            </div>
                        }

                        <div class="rca-axis-title">Total Delay Hours</div>
                    </div>
                }
                else
                {
                    <div class="closure-empty-state">No RCA delay data for this plant.</div>
                }
            </div>
        }

    </div>

    <section class="dashboard-toggle-section"
             id="counterMeasureToggleSection">
        <button type="button"
                class="dashboard-toggle-header"
                aria-expanded="false"
                aria-controls="counterMeasureToggleBody"
                onclick="toggleCMDDashboardSection(this)">
            <span class="dashboard-toggle-title">
                Counter Measures Closure Rate
                <small>Accumulated position - each agency shown separately</small>
            </span>
            <span class="dashboard-toggle-icon" aria-hidden="true">
                <i class="fa fa-chevron-down"></i>
            </span>
        </button>

        <div class="dashboard-toggle-body"
             id="counterMeasureToggleBody"
             hidden>
            <div class="section-grid">

                @foreach (var plant in new[] { "SMP", "RM1", "RM2" })
                {
                    var plantClosureRows = (Model.ClosureRates ?? new List<DAL.Models.ClosureRateVM>())
                        .Where(x => x.Plant == plant)
                        .ToList();

                    var items = plantClosureRows
                        .Where(x => x.MonthNumber == Model.ToDate.Month)
                        .Where(x => !string.Equals(
                            string.IsNullOrWhiteSpace(x.Department) ? "" : x.Department.Trim(),
                            "Total",
                            StringComparison.OrdinalIgnoreCase
                        ))
                        .OrderBy(x => x.MonthNumber)
                        .ToList();

                    var dateWiseItems = plantClosureRows
                        .Where(x => x.MonthNumber == 13)
                        .Where(x => !string.Equals(
                            string.IsNullOrWhiteSpace(x.Department) ? "" : x.Department.Trim(),
                            "Total",
                            StringComparison.OrdinalIgnoreCase
                        ))
                        .ToList();

                    var totalDateWiseItem = plantClosureRows
                        .FirstOrDefault(x =>
                            x.MonthNumber == 13 &&
                            string.Equals(
                                string.IsNullOrWhiteSpace(x.Department) ? "" : x.Department.Trim(),
                                "Total",
                                StringComparison.OrdinalIgnoreCase
                            )
                        );

                    string totalDateWisePercentage = totalDateWiseItem != null
                        ? totalDateWiseItem.ClosurePercentage.ToString("N1") + "%"
                        : "No data";

                    var months = items
                        .Select(x => x.MonthNumber)
                        .Where(x => x >= 1 && x <= 12)
                        .Distinct()
                        .OrderBy(x => x)
                        .ToList();

                    var departments = new[]
                    {
                "Mechanical",
                "Electrical",
                "Utility",
                "Cranes"
            }.ToList();

                    var lineColors = new[]
                    {
                "#4f8a10", // Mechanical
                "#e66b00", // Electrical
                "#0c6370", // Utility
                "#7250a8"  // Cranes
            };

                    string plantTitle = plant == "SMP"
                        ? "STEEL MAKING PLANT"
                        : (plant == "RM1" ? "ROLLING MILL 1" : "ROLLING MILL 2");

                    string selectedPeriodTitle = Model.FromDate.Date == Model.ToDate.Date
                        ? "Selected date: " + Model.FromDate.ToString("dd MMM yyyy")
                        : "Selected period: " +
                          Model.FromDate.ToString("dd MMM yyyy") +
                          " to " +
                          Model.ToDate.ToString("dd MMM yyyy");

                    const decimal svgWidth = 720m;
                    const decimal svgHeight = 380m;
                    const decimal plotLeft = 54m;
                    const decimal plotTop = 27m;
                    const decimal plotRight = 22m;
                    const decimal plotBottom = 60m;

                    decimal plotWidth = svgWidth - plotLeft - plotRight;
                    decimal plotHeight = svgHeight - plotTop - plotBottom;

                    var totalChartValues = items
                        .Select(x => Math.Max(
                            0m,
                            Math.Min(100m, Convert.ToDecimal(x.ClosurePercentage))
                        ))
                        .ToList();

                    decimal chartMinimum = 0m;
                    decimal chartMaximum = 100m;

                    if (totalChartValues.Any())
                    {
                        decimal rawMaximum = totalChartValues.Max();

                        chartMaximum = Math.Min(
                            100m,
                            Math.Max(
                                10m,
                                Math.Ceiling((rawMaximum + 8m) / 10m) * 10m
                            )
                        );
                    }

                    decimal chartRange = Math.Max(10m, chartMaximum - chartMinimum);
                    decimal monthGroupWidth = months.Any()
                        ? plotWidth / months.Count
                        : plotWidth;
                    decimal barGap = months.Count == 1 ? 34m : 5m;
                    decimal barWidth = months.Count == 1
                        ? 62m
                        : Math.Max(
                            6m,
                            Math.Min(
                                18m,
                                (monthGroupWidth - 12m - (departments.Count - 1) * barGap)
                                / departments.Count
                            )
                        );
                    decimal groupBarsWidth =
                        departments.Count * barWidth +
                        (departments.Count - 1) * barGap;

                    <div class="chart-panel closure-chart-panel">
                        <div class="panel-title">@plantTitle</div>

                        <div class="closure-period-summary">
                            @*<div class="closure-period-title">
                                    @selectedPeriodTitle · date-wise closure %
                                </div>*@
                            <div class="closure-total-kpi">
                                <span>Combined Total Closure</span>
                                <strong>@totalDateWisePercentage</strong>
                            </div>
                            <div class="closure-period-grid">
                                @for (int dateDepartmentIndex = 0; dateDepartmentIndex < departments.Count; dateDepartmentIndex++)
                                {
                                    string dateDepartment = departments[dateDepartmentIndex];
                                    string dateSeriesColor = lineColors[dateDepartmentIndex % lineColors.Length];
                                    string dateItemStyle = "--series-color:" + dateSeriesColor + ";";
                                    var dateItem = dateWiseItems
                                        .FirstOrDefault(x => string.Equals(
                                            string.IsNullOrWhiteSpace(x.Department) ? "Overall" : x.Department.Trim(),
                                            dateDepartment,
                                            StringComparison.OrdinalIgnoreCase
                                        ));
                                    string datePercentage = dateItem != null
                                        ? dateItem.ClosurePercentage.ToString("N1") + "%"
                                        : "No data";

                                    <div class="closure-period-item" style="@dateItemStyle">
                                        <span class="closure-period-dot"></span>
                                        <div class="closure-period-copy">
                                            <span>@dateDepartment</span>
                                            <strong>@datePercentage</strong>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (items.Any())
                        {
                            <svg class="line-chart"
                                 viewBox="0 0 720 380"
                                 preserveAspectRatio="xMidYMid meet"
                                 role="img"
                                 aria-label="@plant counter measures accumulated closure rate grouped bar chart">

                                @for (int tickIndex = 0; tickIndex <= 4; tickIndex++)
                                {
                                    decimal percentageTick = chartMinimum +
                                        (chartRange * tickIndex / 4m);
                                    decimal tickY = plotTop +
                                        ((chartMaximum - percentageTick) / chartRange * plotHeight);

                                    <line class="grid-line"
                                          x1="@plotLeft.ToString(CultureInfo.InvariantCulture)"
                                          y1="@tickY.ToString(CultureInfo.InvariantCulture)"
                                          x2="@((plotLeft + plotWidth).ToString(CultureInfo.InvariantCulture))"
                                          y2="@tickY.ToString(CultureInfo.InvariantCulture)"></line>

                                    @Html.Raw(
                                        string.Format(
                                            CultureInfo.InvariantCulture,
                                            "<text class=\"axis-label\" x=\"{0:0.##}\" y=\"{1:0.##}\" text-anchor=\"end\">{2}%</text>",
                                            plotLeft - 9m,
                                            tickY + 4m,
                                            Math.Round(percentageTick, 0)
                                        )
                                    )
                                }

                                <line class="axis-line"
                                      x1="@plotLeft.ToString(CultureInfo.InvariantCulture)"
                                      y1="@((plotTop + plotHeight).ToString(CultureInfo.InvariantCulture))"
                                      x2="@((plotLeft + plotWidth).ToString(CultureInfo.InvariantCulture))"
                                      y2="@((plotTop + plotHeight).ToString(CultureInfo.InvariantCulture))"></line>

                                @for (int monthIndex = 0; monthIndex < months.Count; monthIndex++)
                                {
                                    int monthNumber = months[monthIndex];
                                    string monthLabel = new DateTime(
                                        Model.ToDate.Year,
                                        monthNumber,
                                        1
                                    ).ToString(
                                        "MMM yy",
                                        CultureInfo.InvariantCulture
                                    );

                                    decimal monthX =
                                        plotLeft +
                                        monthIndex * monthGroupWidth +
                                        monthGroupWidth / 2m;

                                    <line class="grid-line"
                                          x1="@monthX.ToString(CultureInfo.InvariantCulture)"
                                          y1="@((plotTop + plotHeight - 8m).ToString(CultureInfo.InvariantCulture))"
                                          x2="@monthX.ToString(CultureInfo.InvariantCulture)"
                                          y2="@((plotTop + plotHeight).ToString(CultureInfo.InvariantCulture))"></line>

                                    @Html.Raw(
                                        string.Format(
                                            CultureInfo.InvariantCulture,
                                            "<text class=\"axis-label\" x=\"{0:0.##}\" y=\"{1:0.##}\" text-anchor=\"middle\">{2}</text>",
                                            monthX,
                                            plotTop + plotHeight + 25m,
                                            System.Web.HttpUtility.HtmlEncode(monthLabel)
                                        )
                                    )
                                }

                                @for (int monthIndex = 0; monthIndex < months.Count; monthIndex++)
                                {
                                    int monthNumber = months[monthIndex];
                                    decimal groupStartX =
                                        plotLeft +
                                        monthIndex * monthGroupWidth +
                                        (monthGroupWidth - groupBarsWidth) / 2m;

                                    for (int departmentIndex = 0; departmentIndex < departments.Count; departmentIndex++)
                                    {
                                        string department = departments[departmentIndex];
                                        string barColor = lineColors[departmentIndex % lineColors.Length];
                                        var barItem = items.FirstOrDefault(x =>
                                            x.MonthNumber == monthNumber &&
                                            string.Equals(
                                                string.IsNullOrWhiteSpace(x.Department) ? "" : x.Department.Trim(),
                                                department,
                                                StringComparison.OrdinalIgnoreCase
                                            )
                                        );

                                        if (barItem != null)
                                        {
                                            decimal safePercentage = Math.Max(
                                                0m,
                                                Math.Min(
                                                    chartMaximum,
                                                    Convert.ToDecimal(barItem.ClosurePercentage)
                                                )
                                            );
                                            decimal actualBarHeight =
                                                safePercentage / chartRange * plotHeight;
                                            decimal visibleBarHeight = safePercentage > 0m
                                                ? Math.Max(3m, actualBarHeight)
                                                : 2m;
                                            decimal barX = groupStartX +
                                                departmentIndex * (barWidth + barGap);
                                            decimal barY = plotTop + plotHeight - visibleBarHeight;
                                            decimal barCenterX = barX + barWidth / 2m;
                                            bool showBarLabel =
                                                safePercentage > 0m &&
                                                (
                                                    months.Count <= 4 ||
                                                    monthIndex == months.Count - 1
                                                );
                                            decimal barLabelY = Math.Max(
                                                plotTop + 10m,
                                                barY - 10m
                                            );

                                            <rect class="closure-bar"
                                                  x="@barX.ToString(CultureInfo.InvariantCulture)"
                                                  y="@barY.ToString(CultureInfo.InvariantCulture)"
                                                  width="@barWidth.ToString(CultureInfo.InvariantCulture)"
                                                  height="@visibleBarHeight.ToString(CultureInfo.InvariantCulture)"
                                                  rx="3"
                                                  fill="@barColor">
                                                <title>
                                                    @department · @barItem.MonthName @Model.ToDate.Year · @barItem.ClosurePercentage.ToString("N1")%
                                                </title>
                                            </rect>

                                            if (showBarLabel)
                                            {
                                                @Html.Raw(
                                                    string.Format(
                                                        CultureInfo.InvariantCulture,
                                                        "<text class=\"closure-bar-label\" x=\"{0:0.##}\" y=\"{1:0.##}\">{2:0}%</text>",
                                                        barCenterX,
                                                        barLabelY,
                                                        barItem.ClosurePercentage
                                                    )
                                                )
                                            }
                                        }
                                    }
                                }
                            </svg>

                            <div class="line-legend">
                                @for (int departmentIndex = 0; departmentIndex < departments.Count; departmentIndex++)
                                {
                                    string department = departments[departmentIndex];
                                    string seriesColor = lineColors[departmentIndex % lineColors.Length];
                                    string legendStyle = "--series-color:" + seriesColor + ";";
                                    var latest = items
                                        .Where(x => string.Equals(
                                            string.IsNullOrWhiteSpace(x.Department) ? "Overall" : x.Department.Trim(),
                                            department,
                                            StringComparison.OrdinalIgnoreCase
                                        ))
                                        .OrderByDescending(x => x.MonthNumber)
                                        .FirstOrDefault();
                                    string latestValue = latest != null
                                        ? latest.ClosurePercentage.ToString("N1") + "%"
                                        : "No data";
                                    string latestMonth = latest != null
                                        ? new DateTime(Model.ToDate.Year, latest.MonthNumber, 1)
                                            .ToString("MMM", CultureInfo.InvariantCulture)
                                        : "";

                                    <span class="line-legend-item" style="@legendStyle">
                                        <span class="line-legend-color"></span>
                                        <span>@department</span>
                                        <strong>@latestValue</strong>
                                        @if (!string.IsNullOrWhiteSpace(latestMonth))
                                        {
                                            <em>(Accum. @latestMonth)</em>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="closure-empty-state">
                                No accumulated counter-measure records found for this plant in @Model.ToDate.Year.
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="dashboard-toggle-section"
             id="topDelayToggleSection">
        <button type="button"
                class="dashboard-toggle-header"
                aria-expanded="false"
                aria-controls="topDelayToggleBody"
                onclick="toggleCMDDashboardSection(this)">
            <span class="dashboard-toggle-title">
                Description of Top 5 Delays on Date
                <small>Click to show or hide the delay details</small>
            </span>
            <span class="dashboard-toggle-icon" aria-hidden="true">
                <i class="fa fa-chevron-down"></i>
            </span>
        </button>

        <div class="dashboard-toggle-body"
             id="topDelayToggleBody"
             hidden>

            @{
                var topFiveDelays =
                    (Model.TopDelays ?? new List<DAL.Models.CMDTopDelayVM>())
                        .OrderByDescending(x => x.TotalDuration)
                        .Take(5)
                        .ToList();
            }

            <table class="delay-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Plant</th>
                        <th>Shift</th>
                        <th>Agency</th>
                        <th>Total (Min)</th>
                        <th>Delay Code</th>
                        <th>Equipment Code</th>
                        <th>Description</th>
                        <th>Reason for Occurrence</th>
                        <th>Action Taken</th>
                    </tr>
                </thead>
                <tbody>
                    @if (topFiveDelays.Any())
                    {
                        int delayRank = 1;

                        foreach (var item in topFiveDelays)
                        {
                            <tr>
                                <td>@delayRank</td>
                                <td>@item.Plant</td>
                                <td>@item.Shift</td>
                                <td>@item.AgencyName</td>
                                <td>@item.TotalDuration.ToString("N1")</td>
                                <td>@item.DelayCode</td>
                                <td>@item.EquipmentCode</td>
                                <td>@item.Description</td>
                                <td>@item.ReasonForOccurrence</td>
                                <td>@item.ActionTaken</td>
                            </tr>

                            delayRank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10">
                                No delay records found for selected date range.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
    function toggleCMDDashboardSection(button) {
        if (!button) {
            return;
        }

        var targetID = button.getAttribute('aria-controls');
        var body = document.getElementById(targetID);
        var section = button.closest('.dashboard-toggle-section');

        if (!body || !section) {
            return;
        }

        var isOpen =
            button.getAttribute('aria-expanded') === 'true';

        button.setAttribute(
            'aria-expanded',
            isOpen ? 'false' : 'true'
        );

        if (isOpen) {
            body.setAttribute('hidden', 'hidden');
            section.classList.remove('is-open');
        }
        else {
            body.removeAttribute('hidden');
            section.classList.add('is-open');
        }
    }

    async function printCMDReport(e) {

        var btn = e && e.currentTarget
            ? e.currentTarget
            : null;

        var element =
            document.getElementById('cmdDashboardPDF');

        var noPrintElements = [];
        var oldWidth = '';
        var oldMaxWidth = '';
        var oldBackground = '';

        try {

            if (!element) {
                throw new Error('Dashboard section not found.');
            }

            if (!window.html2canvas ||
                !window.jspdf ||
                !window.jspdf.jsPDF) {
                throw new Error('PDF libraries could not be loaded.');
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML =
                    '<i class="fa fa-spinner fa-spin"></i> Preparing PDF...';
            }

            noPrintElements =
                Array.prototype.slice.call(
                    element.querySelectorAll('.no-print')
                );

            noPrintElements.forEach(function (x) {
                x.setAttribute(
                    'data-pdf-old-display',
                    x.style.display || ''
                );

                x.style.display = 'none';
            });

            oldWidth = element.style.width;
            oldMaxWidth = element.style.maxWidth;
            oldBackground = element.style.background;

            /*
             * Keep the desktop dashboard proportions during capture.
             */
            element.classList.add('pdf-exporting');
            element.style.width = '1600px';
            element.style.maxWidth = '1600px';
            element.style.background = '#eef2f6';

            await new Promise(function (resolve) {
                setTimeout(resolve, 350);
            });

            var captureWidth =
                Math.ceil(element.scrollWidth);

            var captureHeight =
                Math.ceil(element.scrollHeight);

            var canvas = await html2canvas(
                element,
                {
                    scale: 2,
                    useCORS: true,
                    allowTaint: true,
                    backgroundColor: '#eef2f6',
                    width: captureWidth,
                    height: captureHeight,
                    windowWidth: 1600,
                    windowHeight: captureHeight,
                    scrollX: 0,
                    scrollY: 0,
                    logging: false
                }
            );

            var imageData =
                canvas.toDataURL('image/jpeg', 0.96);

            var jsPDF = window.jspdf.jsPDF;
            var canvasRatio = canvas.width / canvas.height;

            /*
             * Use a custom single-page landscape size matching the
             * dashboard ratio. This removes unused right-side space
             * without cropping or splitting any dashboard content.
             */
            var margin = 2;
            var maximumPageWidth = 420;
            var maximumPageHeight = 297;
            var contentWidth = maximumPageWidth - (margin * 2);
            var contentHeight = contentWidth / canvasRatio;

            if (contentHeight > maximumPageHeight - (margin * 2)) {
                contentHeight = maximumPageHeight - (margin * 2);
                contentWidth = contentHeight * canvasRatio;
            }

            var pageWidth = contentWidth + (margin * 2);
            var pageHeight = contentHeight + (margin * 2);

            var pdf = new jsPDF({
                orientation: pageWidth >= pageHeight
                    ? 'landscape'
                    : 'portrait',
                unit: 'mm',
                format: [pageWidth, pageHeight],
                compress: true
            });

            pdf.addImage(
                imageData,
                'JPEG',
                margin,
                margin,
                contentWidth,
                contentHeight,
                undefined,
                'FAST'
            );

            /* Safety check: the generated document must remain one page. */
            while (pdf.getNumberOfPages() > 1) {
                pdf.deletePage(pdf.getNumberOfPages());
            }

            var fromDate =
                '@Model.FromDate.ToString("yyyy-MM-dd")';

            var toDate =
                '@Model.ToDate.ToString("yyyy-MM-dd")';

            pdf.save(
                'CMD_Daily_Performance_'
                + fromDate
                + '_to_'
                + toDate
                + '.pdf'
            );
        }
        catch (ex) {

            console.error(ex);

            alert(
                ex && ex.message
                    ? ex.message
                    : 'PDF generation failed. Please check browser console.'
            );
        }
        finally {

            if (element) {
                element.classList.remove('pdf-exporting');
                element.style.width = oldWidth;
                element.style.maxWidth = oldMaxWidth;
                element.style.background = oldBackground;
            }

            noPrintElements.forEach(function (x) {
                x.style.display =
                    x.getAttribute('data-pdf-old-display') || '';

                x.removeAttribute('data-pdf-old-display');
            });

            if (btn) {
                btn.disabled = false;
                btn.innerHTML =
                    '<i class="fa fa-file-pdf-o"></i> Download PDF';
            }
        }
    }
</script>
