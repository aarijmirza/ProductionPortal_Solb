@model DAL.Models.SupplyChainDailyBLL

@using System
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rawMaterialItems =
        Model != null &&
        Model.ReceivedMaterials != null
            ? Model.ReceivedMaterials
                .Where(x => x.MaterialType == "Raw Material")
                .ToList()
            : new List<DAL.Models.SupplyChainReceivedMaterialBLL>();

    var subRawMaterialItems =
        Model != null &&
        Model.ReceivedMaterials != null
            ? Model.ReceivedMaterials
                .Where(x => x.MaterialType == "Sub Raw Material")
                .ToList()
            : new List<DAL.Models.SupplyChainReceivedMaterialBLL>();
}

<style>
    .sc-header {
        background: #7f1010;
        color: #fff;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px rgba(0,0,0,.10);
    }

    .sc-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        margin-bottom: 18px;
        overflow: hidden;
    }

        .sc-card .card-header {
            background: #991b1b;
            color: #fff;
            font-weight: 700;
            padding: 12px 16px;
        }

    .form-group label {
        font-size: 13px;
        font-weight: 700;
        color: #555;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-save {
        min-width: 150px;
        border-radius: 8px;
    }

    .dynamic-material-box {
        border: 1px solid #e3e6ea;
        border-radius: 10px;
        padding: 12px;
        background: #fafafa;
        margin-bottom: 12px;
    }

    .dynamic-material-title {
        font-size: 13px;
        font-weight: 800;
        color: #7f1010;
        margin-bottom: 10px;
    }

    .material-row {
        margin-bottom: 8px;
    }

        .material-row:last-child {
            margin-bottom: 0;
        }

    .btn-remove-material {
        width: 100%;
        min-height: 38px;
    }

    .material-total {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px dashed #ccc;
        font-weight: 800;
        text-align: right;
    }
</style>

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">Supply Chain Dashboard</h4>
            <small>All quantities in MT except Fuel Oil where applicable.</small>
        </div>

        <div class="col-md-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home")">
                            <i class="icon-home"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Supply Chain
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @using (
        Html.BeginForm(
            "Add",
            "SupplyChain",
            FormMethod.Post,
            new
            {
                id = "supplyChainForm"
            }
        )
    )
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.ID)

        <div class="card sc-card">
            <div class="card-header">
                Report Information
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Report Date</label>

                            <input type="date"
                                   name="ReportDate"
                                   class="form-control"
                                   required
                                   value="@(Model != null && Model.ReportDate.HasValue
                                       ? Model.ReportDate.Value.ToString("yyyy-MM-dd")
                                       : "")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">
                Inventory Status - Raw Materials
            </div>

            <div class="card-body">
                <div class="row">
                    @InputBox("Scrap", "Scrap", Model != null ? Model.Scrap : null)
                    @InputBox("DRI", "DRI", Model != null ? Model.DRI : null)
                    @InputBox("HBI", "HBI", Model != null ? Model.HBI : null)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">
                Inventory Status - Finished Goods Materials
            </div>

            <div class="card-body">
                <div class="row">
                    @InputBox("Billet", "Billet", Model != null ? Model.Billet : null)
                    @InputBox("Rebar", "Rebar", Model != null ? Model.Rebar : null)
                    @InputBox("WireRodCoil", "Wire Rod Coil", Model != null ? Model.WireRodCoil : null)
                    @InputBox("RebarInCoil", "Rebar in Coil", Model != null ? Model.RebarInCoil : null)
                    @InputBox("EpoxyRebar", "Epoxy Rebar", Model != null ? Model.EpoxyRebar : null)
                    @InputBox("ShortBar", "Short Bar", Model != null ? Model.ShortBar : null)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">
                Dispatch Performance
            </div>

            <div class="card-body">
                <div class="row">
                    @InputBox("DailyDispatch", "Daily Dispatch", Model != null ? Model.DailyDispatch : null)
                    @InputBox("DailyDispatchTarget", "Daily Dispatch Target", Model != null ? Model.DailyDispatchTarget : null)
                    @InputBox("DailyTruck", "Daily Truck", Model != null ? Model.DailyTruck : null)
                    @InputBox("DailyTruckTarget", "Daily Truck Target", Model != null ? Model.DailyTruckTarget : null)
                    @InputBox("WTDDispatch", "WTD Dispatch", Model != null ? Model.WTDDispatch : null)
                    @InputBox("WTDDispatchTarget", "WTD Dispatch Target", Model != null ? Model.WTDDispatchTarget : null)
                    @InputBox("WTDTruck", "WTD Truck", Model != null ? Model.WTDTruck : null)
                    @InputBox("WTDTruckTarget", "WTD Truck Target", Model != null ? Model.WTDTruckTarget : null)
                    @InputBox("MTDDispatch", "MTD Dispatch", Model != null ? Model.MTDDispatch : null)
                    @InputBox("MTDDispatchTarget", "MTD Dispatch Target", Model != null ? Model.MTDDispatchTarget : null)
                    @InputBox("MTDTruck", "MTD Truck", Model != null ? Model.MTDTruck : null)
                    @InputBox("MTDTruckTarget", "MTD Truck Target", Model != null ? Model.MTDTruckTarget : null)
                </div>
            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">
                Received Materials
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">
                        <div class="dynamic-material-box">

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="dynamic-material-title">
                                    Raw Materials
                                </div>

                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        id="btnAddRawMaterial">
                                    <i class="fa fa-plus"></i>
                                    Add Item
                                </button>
                            </div>

                            <div class="form-group">
                                <label>Raw Materials</label>
                                <input type="number"
                                       step="0.001"
                                       id="RawMaterialsReceived"
                                       name="RawMaterialsReceived"
                                       class="form-control"
                                       value="@(Model != null && Model.RawMaterialsReceived.HasValue
                                           ? Model.RawMaterialsReceived.Value.ToString("0.###")
                                           : "0.000")"
                                       readonly />
                                <small class="text-muted">
                                    Total will be calculated from the item quantities below.
                                </small>
                            </div>

                            <div id="rawMaterialRows">

                                @if (rawMaterialItems.Count > 0)
                                {
                                    for (int i = 0; i < rawMaterialItems.Count; i++)
                                    {
                                        <div class="row material-row">

                                            <input type="hidden"
                                                   class="material-type"
                                                   value="Raw Material" />

                                            <input type="hidden"
                                                   class="material-id"
                                                   value="@rawMaterialItems[i].ID" />

                                            <div class="col-md-7">
                                                <input type="text"
                                                       class="form-control material-item"
                                                       value="@rawMaterialItems[i].ItemName"
                                                       placeholder="Item name"
                                                       required />
                                            </div>

                                            <div class="col-md-3">
                                                <input type="number"
                                                       step="0.001"
                                                       min="0"
                                                       class="form-control material-qty raw-material-qty"
                                                       value="@rawMaterialItems[i].Quantity.ToString("0.###")"
                                                       placeholder="Qty"
                                                       required />
                                            </div>

                                            <div class="col-md-2">
                                                <button type="button"
                                                        class="btn btn-danger btn-remove-material">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                            <div class="material-total">
                                Total Raw Materials:
                                <span id="rawMaterialTotal">0.000</span>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="dynamic-material-box">

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="dynamic-material-title">
                                    Sub Raw Materials
                                </div>

                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        id="btnAddSubRawMaterial">
                                    <i class="fa fa-plus"></i>
                                    Add Item
                                </button>
                            </div>

                            <div class="form-group">
                                <label>Sub Raw Materials</label>
                                <input type="number"
                                       step="0.001"
                                       id="SubRawMaterialsReceived"
                                       name="SubRawMaterialsReceived"
                                       class="form-control"
                                       value="@(Model != null && Model.SubRawMaterialsReceived.HasValue
                                           ? Model.SubRawMaterialsReceived.Value.ToString("0.###")
                                           : "0.000")"
                                       readonly />
                                <small class="text-muted">
                                    Total will be calculated from the item quantities below.
                                </small>
                            </div>

                            <div id="subRawMaterialRows">

                                @if (subRawMaterialItems.Count > 0)
                                {
                                    for (int i = 0; i < subRawMaterialItems.Count; i++)
                                    {
                                        <div class="row material-row">

                                            <input type="hidden"
                                                   class="material-type"
                                                   value="Sub Raw Material" />

                                            <input type="hidden"
                                                   class="material-id"
                                                   value="@subRawMaterialItems[i].ID" />

                                            <div class="col-md-7">
                                                <input type="text"
                                                       class="form-control material-item"
                                                       value="@subRawMaterialItems[i].ItemName"
                                                       placeholder="Item name"
                                                       required />
                                            </div>

                                            <div class="col-md-3">
                                                <input type="number"
                                                       step="0.001"
                                                       min="0"
                                                       class="form-control material-qty sub-raw-material-qty"
                                                       value="@subRawMaterialItems[i].Quantity.ToString("0.###")"
                                                       placeholder="Qty"
                                                       required />
                                            </div>

                                            <div class="col-md-2">
                                                <button type="button"
                                                        class="btn btn-danger btn-remove-material">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>

                                        </div>
                                    }
                                }

                            </div>

                            <div class="material-total">
                                Total Sub Raw Materials:
                                <span id="subRawMaterialTotal">0.000</span>
                            </div>

                        </div>
                    </div>

                </div>

                <div class="row">
                    @InputBox("RefractoryMaterialsReceived", "Refractory Materials", Model != null ? Model.RefractoryMaterialsReceived : null)
                    @InputBox("FuelOilReceived", "Fuel Oil", Model != null ? Model.FuelOilReceived : null)
                    @InputBox("OtherReceived", "Other", Model != null ? Model.OtherReceived : null)
                </div>

                <div id="receivedMaterialHiddenFields"></div>

            </div>
        </div>

        <div class="card sc-card">
            <div class="card-header">
                By-Products
            </div>

            <div class="card-body">
                <div class="row">
                    @InputBox("MillScale", "Mill Scale", Model != null ? Model.MillScale : null)
                    @InputBox("Slag", "Slag", Model != null ? Model.Slag : null)
                    @InputBox("Dust", "Dust", Model != null ? Model.Dust : null)
                    @InputBox("Sludge", "Sludge", Model != null ? Model.Sludge : null)
                </div>
            </div>
        </div>

        <div class="text-right mb-4">
            <button type="submit"
                    class="btn btn-primary btn-save">
                Save
            </button>

            <a href="@Url.Action("Index", "Reporting")"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    }

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        function createMaterialRow(
            materialType,
            qtyClass) {

            return `
                <div class="row material-row">

                    <input type="hidden"
                           class="material-type"
                           value="${materialType}" />

                    <input type="hidden"
                           class="material-id"
                           value="0" />

                    <div class="col-md-7">
                        <input type="text"
                               class="form-control material-item"
                               placeholder="Item name"
                               required />
                    </div>

                    <div class="col-md-3">
                        <input type="number"
                               step="0.001"
                               min="0"
                               class="form-control material-qty ${qtyClass}"
                               placeholder="Qty"
                               required />
                    </div>

                    <div class="col-md-2">
                        <button type="button"
                                class="btn btn-danger btn-remove-material">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>

                </div>`;
        }

        $("#btnAddRawMaterial").on(
            "click",
            function () {
                $("#rawMaterialRows").append(
                    createMaterialRow(
                        "Raw Material",
                        "raw-material-qty"
                    )
                );
            }
        );

        $("#btnAddSubRawMaterial").on(
            "click",
            function () {
                $("#subRawMaterialRows").append(
                    createMaterialRow(
                        "Sub Raw Material",
                        "sub-raw-material-qty"
                    )
                );
            }
        );

        $(document).on(
            "click",
            ".btn-remove-material",
            function () {
                $(this)
                    .closest(".material-row")
                    .remove();

                calculateMaterialTotals();
            }
        );

        $(document).on(
            "input",
            ".material-qty",
            calculateMaterialTotals
        );

        function calculateMaterialTotals() {

            var rawTotal =
                0;

            $(".raw-material-qty").each(
                function () {
                    rawTotal +=
                        parseFloat(
                            $(this).val()
                        ) || 0;
                }
            );

            var subRawTotal =
                0;

            $(".sub-raw-material-qty").each(
                function () {
                    subRawTotal +=
                        parseFloat(
                            $(this).val()
                        ) || 0;
                }
            );

            $("#rawMaterialTotal").text(
                rawTotal.toFixed(3)
            );

            $("#subRawMaterialTotal").text(
                subRawTotal.toFixed(3)
            );

            $("#RawMaterialsReceived").val(
                rawTotal.toFixed(3)
            );

            $("#SubRawMaterialsReceived").val(
                subRawTotal.toFixed(3)
            );
        }

        function buildReceivedMaterialFields() {

            var hiddenContainer =
                $("#receivedMaterialHiddenFields");

            hiddenContainer.empty();

            $(".material-row").each(
                function (index) {

                    var row =
                        $(this);

                    var id =
                        row.find(".material-id").val() || 0;

                    var materialType =
                        row.find(".material-type").val() || "";

                    var itemName =
                        row.find(".material-item").val() || "";

                    var quantity =
                        row.find(".material-qty").val() || 0;

                    hiddenContainer.append(`
                        <input type="hidden"
                               name="ReceivedMaterials[${index}].ID"
                               value="${id}" />

                        <input type="hidden"
                               name="ReceivedMaterials[${index}].MaterialType"
                               value="${materialType}" />

                        <input type="hidden"
                               name="ReceivedMaterials[${index}].ItemName"
                               value="${$("<div>").text(itemName).html()}" />

                        <input type="hidden"
                               name="ReceivedMaterials[${index}].Quantity"
                               value="${quantity}" />
                    `);
                }
            );
        }

        $("#supplyChainForm").on(
            "submit",
            function () {

                calculateMaterialTotals();
                buildReceivedMaterialFields();

                return true;
            }
        );

        if (!hasExistingRawItems) {
            $("#rawMaterialRows").append(
                createMaterialRow(
                    "Raw Material",
                    "raw-material-qty"
                )
            );
        }

        if (!hasExistingSubRawItems) {
            $("#subRawMaterialRows").append(
                createMaterialRow(
                    "Sub Raw Material",
                    "sub-raw-material-qty"
                )
            );
        }

        calculateMaterialTotals();
    });</script>

@helper InputBox(
    string name,
    string label,
    decimal? value)
{
    <div class="col-md-3">
        <div class="form-group">
            <label>@label</label>

            <input type="number"
                   step="0.001"
                   name="@name"
                   class="form-control"
                   value="@(value.HasValue
                       ? value.Value.ToString("0.###")
                       : "")"
                   placeholder="0.000" />
        </div>
    </div>
}
