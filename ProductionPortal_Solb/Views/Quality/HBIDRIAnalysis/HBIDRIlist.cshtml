@model List<DAL.Models.QCHBIDRIAnalysisBLL>
@using System.Globalization

@{
    ViewBag.Title = "HBI / DRI Analysis";

    var gregorian =
        new CultureInfo("en-US");

    gregorian.DateTimeFormat.Calendar =
        new GregorianCalendar();
}

<div class="xp-breadcrumbbar">

    <div class="row">

        <div class="col-md-6 col-lg-6">

            <h4 class="xp-page-title">
                DRI / HBI Analysis
            </h4>

        </div>

        <div class="col-md-6 col-lg-6">

            <div class="xp-breadcrumb">

                <ol class="breadcrumb">

                    <li class="breadcrumb-item">

                        <a href="@Url.Action("Index", "Home")">
                            <i class="icon-home"></i>
                        </a>

                    </li>

                    <li class="breadcrumb-item active">
                        DRI / HBI Analysis
                    </li>

                </ol>

            </div>

        </div>

    </div>

</div>


<div class="xp-breadcrumbbar"
     style="padding: 30px 30px 0 30px;">

    <div class="row">

        <div class="col-lg-12">

            <div class="card mb-3">

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-2">

                            <div class="form-group">

                                <label>From</label>

                                <input type="date"
                                       id="fromDate"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="col-md-2">

                            <div class="form-group">

                                <label>To</label>

                                <input type="date"
                                       id="toDate"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="col-md-3">

                            <div class="form-group">

                                <label>&nbsp;</label>

                                <div>

                                    <button type="button"
                                            id="filterBtn"
                                            class="btn btn-primary">

                                        <i class="mdi mdi-filter"></i>
                                        Filter

                                    </button>


                                    <button type="button"
                                            id="clearBtn"
                                            class="btn btn-secondary">

                                        Clear

                                    </button>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-5">

                            <div class="form-group text-right">

                                <label>&nbsp;</label>

                                <div>

                                    <a class="btn btn-info text-white"
                                       href="@Url.Action(
                                           "AddHBIDRIAnalysis",
                                           "Quality"
                                       )">

                                        <i class="fa fa-plus-circle"></i>
                                        Add DRI / HBI Analysis

                                    </a>


                                    <button type="button"
                                            id="exportPdf"
                                            class="btn btn-danger">

                                        <i class="fa fa-file-pdf-o"></i>
                                        Export PDF

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<div class="xp-contentbar">

    <div class="row">

        <div class="col-lg-12">

            <div class="card m-b-30">

                <div class="card-body">

                    <div class="table-responsive">

                        <table id="xp-default-datatable"
                               class="display table table-striped table-bordered">

                            <thead>

                                <tr>

                                    <th>Receiving Date</th>

                                    <th>Material</th>

                                    <th>Shipment Code</th>

                                    <th>Supplier</th>

                                    <th>Quantity</th>

                                    <th>Analysis Date</th>

                                    <th>Reference No</th>

                                    <th style="width:140px;">
                                        Action
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>

                                            <td data-order="@(item.ReceivingDate?.ToString("yyyy-MM-dd"))">

                                                @(item.ReceivingDate?.ToString(
                                                    "dd-MM-yyyy",
                                                    gregorian
                                                ))

                                            </td>


                                            <td>
                                                @item.Material
                                            </td>


                                            <td>
                                                @item.ShipmentCodeNo
                                            </td>


                                            <td>
                                                @item.Supplier
                                            </td>


                                            <td>
                                                @item.Quantity
                                            </td>


                                            <td>

                                                @(item.AnalysisDate?.ToString(
                                                    "dd-MM-yyyy",
                                                    gregorian
                                                ))

                                            </td>


                                            <td>
                                                @item.ReferenceNo
                                            </td>


                                            <td>

                                                <!-- Edit -->

                                                <a href="@Url.Action(
                                                    "AddHBIDRIAnalysis",
                                                    "Quality",
                                                    new
                                                    {
                                                        id = item.ID
                                                    }
                                                )"
                                                   class="btn btn-sm btn-primary"
                                                   title="Edit">

                                                    <i class="mdi mdi-pencil"></i>

                                                </a>


                                                <!-- Detail -->

                                                <a href="@Url.Action(
                                                    "HBIDRIAnalysisDetail",
                                                    "Quality",
                                                    new
                                                    {
                                                        id = item.ID
                                                    }
                                                )"
                                                   class="btn btn-sm btn-info"
                                                   title="Details">

                                                    <i class="mdi mdi-account-card-details"></i>

                                                </a>


                                                <!-- Delete -->

                                                <button type="button"
                                                        class="btn btn-sm btn-danger deleteBtn"
                                                        data-id="@item.ID"
                                                        title="Delete">

                                                    <i class="mdi mdi-trash-can"></i>

                                                </button>


                                                <form id="deleteForm_@item.ID"
                                                      action="@Url.Action(
                                                          "HBIDRIAnalysisDelete",
                                                          "Quality"
                                                      )"
                                                      method="post"
                                                      style="display:none;">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.ID" />

                                                </form>

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

 var hbiTable;

$(document).ready(function () {

    if (!$.fn.DataTable) {
        console.error('DataTables library is not loaded.');
        return;
    }

    // DataTables custom date filter
    $.fn.dataTable.ext.search.push(function (
        settings,
        data,
        dataIndex
    ) {

        if (settings.nTable.id !== 'xp-default-datatable') {
            return true;
        }

        var from = $('#fromDate').val();
        var to = $('#toDate').val();

        if (!from && !to) {
            return true;
        }

        // Receiving Date column is dd-MM-yyyy
        var dateText = data[0] || '';
        var parts = dateText.split('-');

        if (parts.length !== 3) {
            return true;
        }

        var rowDate = new Date(
            parseInt(parts[2], 10),
            parseInt(parts[1], 10) - 1,
            parseInt(parts[0], 10)
        );

        rowDate.setHours(0, 0, 0, 0);

        if (from) {
            var fromDate = new Date(from + 'T00:00:00');

            if (rowDate < fromDate) {
                return false;
            }
        }

        if (to) {
            var toDate = new Date(to + 'T00:00:00');

            if (rowDate > toDate) {
                return false;
            }
        }

        return true;
    });


    hbiTable = $('#xp-default-datatable').DataTable();


    // Default dates
    var today = new Date();

    var firstDay = new Date(
        today.getFullYear(),
        today.getMonth(),
        1
    );

    $('#fromDate').val(formatDate(firstDay));
    $('#toDate').val(formatDate(today));

    hbiTable.draw();


    $('#filterBtn').on('click', function () {
        hbiTable.draw();
    });


    $('#clearBtn').on('click', function () {

        $('#fromDate').val('');
        $('#toDate').val('');

        hbiTable.draw();
    });


    $('#exportPdf').on('click', function () {

        var from = $('#fromDate').val() || '';
        var to = $('#toDate').val() || '';

        var url =
            '@Url.Action("HBIDRIAnalysisPDF", "Quality")'
            + '?from='
            + encodeURIComponent(from)
            + '&to='
            + encodeURIComponent(to);

        window.open(url, '_blank');
    });


    $('.deleteBtn').on('click', function () {

        var id = $(this).data('id');

        Swal.fire({
            title: 'Are you sure?',
            text: 'This HBI / DRI Analysis will be deleted.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then(function (result) {

            if (result.isConfirmed) {
                $('#deleteForm_' + id).submit();
            }

        });
    });

});


function formatDate(date) {

    var month =
        String(date.getMonth() + 1)
            .padStart(2, '0');

    var day =
        String(date.getDate())
            .padStart(2, '0');

    return (
        date.getFullYear()
        + '-'
        + month
        + '-'
        + day
    );
}

</script>