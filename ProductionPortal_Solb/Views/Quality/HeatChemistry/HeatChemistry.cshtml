@model List<DAL.Models.HeatChemistryBLL>
@using System.Globalization
@{
    ViewBag.Title = "add";
    var chemistry = Model as List<DAL.Models.HeatChemistryBLL>;
    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    //bool showGrade = Model.Any(m => !string.IsNullOrEmpty(m.Grade));
    bool showSize = Model.Any(m => !string.IsNullOrEmpty(m.Size));
    bool showWeight = Model.Any(m => m.Weight != null);
    //bool showTime = Model.Any(m => !string.IsNullOrEmpty(m.Time));
    bool showArea = Model.Any(m => !string.IsNullOrEmpty(m.Area));
    bool showShift = Model.Any(m => !string.IsNullOrEmpty(m.Shift));
}
<style>
    /* Styling to make the parent rows look distinct */
    .group-header {
        cursor: pointer;
        font-weight: bold;
        background-color: #f0f0f0; /* Light grey background for the header row */
    }

    .group-detail {
        /* Optional: Style to visually indent or distinguish detail rows */
        background-color: #fafafa;
    }

    .bucket-header-cell {
        /* Ensure the Bucket header stands out for the detail rows */
        width: 15%;
    }

    .chemistry-scroll {
        max-height: 500px; /* vertical scroll */
        overflow-x: auto; /* horizontal scroll */
        overflow-y: auto; /* vertical scroll */
        white-space: nowrap; /* prevent wrapping so horizontal scroll appears */
    }

    #chemistryListTable th,
    #chemistryListTable td {
        white-space: nowrap; /* required for horizontal scroll */
    }
</style>
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Heat Chemistry</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index" ,"Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Heat Chemistry</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Records</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="fromDate" class="mr-2">From</label>
                                <input type="date" id="fromDate" class="form-control" />
                            </div>

                            <div class="form-group mr-3">
                                <label for="toDate" class="mr-2">To</label>
                                <input type="date" id="toDate" class="form-control" />
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="button" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("AddChemistry", "Quality")">
                                    <i class="fa fa-plus-circle"></i> Add Sample
                                </a>
                            </div>
                            <div class="form-group d-flex align-items-end">
                                @*<button type="button" id="exportExcel" class="btn btn-success mr-2">
                                    <i class="fa fa-file-excel-o"></i> Export Excel
                                </button>*@
                                <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                    <i class="fa fa-file-pdf-o"></i> Export PDF
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover chemistry-scroll" id="chemistryListTable">
                            <thead>
                                <tr>
                                    <th>Heat#</th>
                                    @if (showWeight)
                                    {
                                        <th>Weight</th>
                                    }
                                    @if (showArea)
                                    {
                                        <th>Area</th>
                                    }
                                    <th>Samples</th>
                                    <th>C</th>
                                    <th>Si</th>
                                    <th>Mn</th>
                                    <th>P</th>
                                    <th>S</th>
                                    <th>Ni</th>
                                    <th>Cr</th>
                                    <th>Mo</th>
                                    <th>V</th>
                                    <th>Cu</th>
                                    <th>Ti</th>
                                    <th>Sn</th>
                                    <th>Al</th>
                                    <th>Pb</th>
                                    <th>B</th>
                                    <th>Zn</th>
                                    <th>N</th>
                                    <th>Mn/S</th>
                                    <th>Ceq</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Group the data by the common header fields (Date, Time, HeatNo) *@
                                @{
                                    var groupedRecords = Model.GroupBy(r => new { r.Date, r.Time, r.HeatNo })
                                                              .ToList();
                                }
                                @foreach (var group in groupedRecords)
                                {
                                    var headerItem = group.First();
                                    <tr>
                                        <td>@headerItem.HeatNo</td>
                                        @if (showWeight)
                                        {
                                            <td>@headerItem.Weight</td>
                                        }
                                        @if (showArea)
                                        {
                                            <td>@headerItem.Area</td>
                                        }
                                        <td>
                                            <i class="icon-minus-square expand-icon"></i>
                                            @group.Count() SampleNo
                                        </td>
                                        <td>@headerItem.C</td>
                                        <td>@headerItem.Si</td>
                                        <td>@headerItem.Mn</td>
                                        <td>@headerItem.P</td>
                                        <td>@headerItem.S</td>
                                        <td>@headerItem.Ni</td>
                                        <td>@headerItem.Cr</td>
                                        <td>@headerItem.Mo</td>
                                        <td>@headerItem.V</td>
                                        <td>@headerItem.Cu</td>
                                        <td>@headerItem.Ti</td>
                                        <td>@headerItem.Sn</td>
                                        <td>@headerItem.Al</td>
                                        <td>@headerItem.Pb</td>
                                        <td>@headerItem.B</td>
                                        <td>@headerItem.Zn</td>
                                        <td>@headerItem.N</td>
                                        <td>@headerItem.Mn/S</td>
                                        <td>@headerItem.Ceq</td>

                                        @*<td>
                                                <a href="@Url.Action("Chemistrydetails", "Quality", new { heatNo = headerItem.HeatNo })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i> Heat Detail
                                                </a>
                                            </td>*@
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {
        var table = $('#chemistryListTable').DataTable();

        // Custom filter function
        function filterTable() {
            var from = $('#fromDate').val();
            var to = $('#toDate').val();

            // Convert date inputs to comparable format
            var fromDate = from ? new Date(from) : null;
            var toDate = to ? new Date(to) : null;

            table.rows().every(function () {
                var data = this.data();
                var dateStr = data[0]; // "yyyy-MM-dd"

                var rowDate = new Date(dateStr);
                var visible = true;

                // Filter by Date Range
                if (fromDate && rowDate < fromDate) visible = false;
                if (toDate && rowDate > toDate) visible = false;

                if (visible) $(this.node()).show();
                else $(this.node()).hide();
            });
        }

        // Apply Filter Button
        $('#filterBtn').on('click', function () {
            filterTable();
        });

        // Clear Filters Button
        $('#clearBtn').on('click', function () {
            $('#fromDate').val('');
            $('#toDate').val('');
            $('#filterBtn').click(); // Refresh table
        });
    });

    $(document).ready(function () {
    // 1️⃣ Set default dates: from = 1st of current month, to = today
    var today = new Date();
    var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

    function formatDate(d) {
        var month = (d.getMonth() + 1).toString().padStart(2, '0');
        var day = d.getDate().toString().padStart(2, '0');
        return d.getFullYear() + '-' + month + '-' + day;
    }

    $('#fromDate').val(formatDate(firstDay));
    $('#toDate').val(formatDate(today));

    // 2️⃣ Get URL for export dynamically
    var exportExcelUrl = '@Url.Action("ExportExcel", "Scrapyard")';
    var exportPDFUrl = '@Url.Action("ExportPDF", "Scrapyard")';

    // 3️⃣ Handle export button click
    $('#exportExcel').click(function () {
    var from = $('#fromDate').val() || '';      // default to empty
    var to = $('#toDate').val() || '';          // default to empty

    // Build URL with query parameters
    var url = exportExcelUrl +
    '&from=' + encodeURIComponent(from) +
    '&to=' + encodeURIComponent(to);

    console.log('Export Excel URL:', url); // debug: check URL in console

    // Redirect to trigger Excel download
    window.location.href = url;
    });

    // 3️⃣ Handle export button click
    // 3️⃣ Handle export button click
    $('#exportPdf').click(function () {
        var from = $('#fromDate').val() || '';
        var to   = $('#toDate').val() || '';

        var url = '@Url.Action("HeatChemistryPDF", "Quality")'
                + '?from=' + encodeURIComponent(from)
                + '&to='   + encodeURIComponent(to);

        window.location.href = url;
    });
});
</script>