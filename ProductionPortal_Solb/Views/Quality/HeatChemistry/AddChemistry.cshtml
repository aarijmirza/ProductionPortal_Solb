                    <div class="card-header bg-white d-flex" style="justify-content: space-between;">
                        <h5 class="text-black">Plant & Heat Details</h5>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                    <div class="card-body">
                        <div class="form-row mb-4">
                            <div class="form-group col-md-2">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="radioEAF" name="PlantName" class="custom-control-input plant-radio" value="Electric Arc Furnace" checked>
                                    <label class="custom-control-label" for="radioEAF">Electric Arc Furnace</label>
                                </div>
                            </div>
                            <div class="form-group col-md-2">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="radioLF" name="PlantName" class="custom-control-input plant-radio" value="Laddle Furnace">
                                    <label class="custom-control-label" for="radioLF">Laddle Furnace</label>
                                </div>
                            </div>
                            <div class="form-group col-md-2">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="radioCCM" name="PlantName" class="custom-control-input plant-radio" value="CCM">
                                    <label class="custom-control-label" for="radioCCM">CCM</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-row plant-details-row" id="furnaceFormRow">
                            <div class="form-group col-md-2">
                                <label for="date">Date</label>
                                <input type="date" class="form-control" id="date" name="Date" readonly>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="heat">Shift</label>
                                <select class="form-control" name="Shift">
                                    <option selected disabled>-- please select --</option>
                                    <option value="Morning">Morning</option>
                                    <option value="Evening">Evening</option>
                                    <option value="Night">Night</option>
                                </select>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="heat">Heat #</label>
                                <input type="text" class="form-control" name="HeatNo" placeholder="Heat #">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="grade">Lenght (m)</label>
                                <input type="number" step="0.01" class="form-control" name="Lenght" placeholder="Lenght (m)">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="weight">Cross Section (mm)</label>
                                <input type="number" step="0.01" class="form-control" name="CrossSection" placeholder="Cross Section (mm)">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="area">Steel Grade</label>
                                <input type="text" class="form-control" name="SteelGrade" placeholder="Steel Grade">
                            </div>
                        </div>

                        @*<div class="form-row plant-details-row" id="rollingMillFormRow" style="display: none;">
                                <div class="form-group col-md-2">
                                    <label for="date2">Date</label>
                                    <input type="date" class="form-control" id="date2" name="Date" readonly disabled>
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="heat2">Heat #</label>
                                    <input type="text" class="form-control" name="HeatNo" placeholder="Heat #" disabled>
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="size">Size</label>
                                    <input type="text" class="form-control" name="Size" placeholder="Size" disabled>
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="time">Time</label>
                                    <input type="time" class="form-control" name="Time" disabled>
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="shift">Shift</label>
                                    <select class="form-control" name="Shift" disabled>
                                        <option disabled selected>Please Select</option>
                                        <option value="Morning">Morning</option>
                                        <option value="Evening">Evening</option>
                                        <option value="Night">Night</option>
                                    </select>
                                </div>
                                <input type="hidden" name="Grade" value="" disabled>
                                <input type="hidden" name="Weight" value="" disabled>
                                <input type="hidden" name="Area" value="" disabled>
                            </div>*@
                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white">
                        <h5 class="card-title text-black">Chemical Analysis % (Multiple Samples)</h5>
                        <button type="button" id="addRowBtn" class="btn btn-primary" style="float: inline-end;">
                            <i class="fa fa-plus"></i> Add New Sample
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="chemistryTable" class="table table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Sample No</th>
                                        <th>C</th>
                                        <th>Si</th>
                                        <th>Mn</th>
                                        <th>P</th>
                                        <th>S</th>
                                        <th>Cr</th>
                                        <th>Ni</th>
                                        <th>Mo</th>
                                        <th>Al</th>
                                        <th>Cu</th>
                                        <th>V</th>
                                        <th>Pb</th>
                                        <th>Sn</th>
                                        @*<th>Pb</th>
                                            <th>B</th>
                                            <th>Zn</th>*@
                                        <th>N</th>
                                        @*<th>Mn/S</th>*@
                                        <th>Ceq</th>
                                    </tr>
                                </thead>
                                <tbody id="chemistryBody">
                                </tbody>
                            </table>
                        </div>

                        <template id="sampleRowTemplate">
                            <tr>
                                <td><input type="text" name="SampleNo" class="form-control form-control-sm" value="[Auto]" readonly></td>
                                <td><input type="number" step="0.001" name="C" class="form-control form-control-sm sample-input" oninput="calculateMnS(this); calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="Si" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="Mn" class="form-control form-control-sm sample-input" oninput="calculateMnS(this); calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="P" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="S" class="form-control form-control-sm sample-input" oninput="calculateMnS(this);"></td>
                                <td><input type="number" step="0.001" name="Cr" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="Ni" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="Mo" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="Al" class="form-control form-control-sm sample-input"></td>
                                <td><input type="number" step="0.001" name="Cu" class="form-control form-control-sm sample-input" oninput="calculateCeq(this);"></td>
                                <td><input type="number" step="0.001" name="V" class="form-control form-control-sm sample-input"></td>
                                @*<td><input type="number" step="0.001" name="Ti" class="form-control form-control-sm sample-input"></td>*@
                                <td><input type="number" step="0.001" name="Pb" class="form-control form-control-sm sample-input"></td>
                                <td><input type="number" step="0.001" name="Sn" class="form-control form-control-sm sample-input"></td>
                                @*<td><input type="number" step="0.001" name="B" class="form-control form-control-sm sample-input"></td>
                                    <td><input type="number" step="0.001" name="Zn" class="form-control form-control-sm sample-input"></td>*@
                                <td><input type="number" step="0.001" name="N" class="form-control form-control-sm sample-input"></td>
                                @*<td><input type="text" name="MnS" class="form-control form-control-sm readonly-field" readonly></td>*@
                                <td><input type="text" name="Ceq" class="form-control form-control-sm readonly-field" readonly></td>
                            </tr>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    // Default Date
    const today = new Date().toISOString().split('T')[0];
    document.getElementById("date").value = today;

    // FIND INPUT BY PROPERTY NAME
    function findInput(row, name) {
        return row.find(`input[name$=".${name}"]`);
    }

    // Mn / S CALCULATION
    function calculateMnS(el) {
        const row = $(el).closest('tr');
        const Mn = parseFloat(findInput(row, "Mn").val()) || 0;
        const S = parseFloat(findInput(row, "S").val()) || 0;
        const MnSField = findInput(row, "MnS");

        if (MnSField.length === 0) return;   // if removed, don't calculate
        if (S <= 0) return MnSField.val("Div/0");

        MnSField.val((Mn / S).toFixed(3));
    }

    // CE CALCULATION
    function calculateCeq(el) {
        const row = $(el).closest('tr');

        const C = parseFloat(findInput(row, "C").val()) || 0;
        const Mn = parseFloat(findInput(row, "Mn").val()) || 0;
        const Cr = parseFloat(findInput(row, "Cr").val()) || 0;
        const Mo = parseFloat(findInput(row, "Mo").val()) || 0;
        const V = parseFloat(findInput(row, "V").val()) || 0;
        const Cu = parseFloat(findInput(row, "Cu").val()) || 0;
        const Ni = parseFloat(findInput(row, "Ni").val()) || 0;

        const Ceq = C + (Mn / 6) + ((Cr + Mo + V) / 5) + ((Cu + Ni) / 15);
        findInput(row, "Ceq").val(Ceq.toFixed(4));
    }

    // ADD ROW
    function addSampleRow() {
        let template = document.getElementById('sampleRowTemplate');
        let newRow = template.content.cloneNode(true);
        let index = $('#chemistryBody tr').length;

        $(newRow).find('input').each(function () {
            let name = $(this).attr('name');
            $(this).attr('name', `data[${index}].${name}`);

            if (!$(this).is('[readonly]')) $(this).val('');
        });

        $('#chemistryBody').append(newRow);
        $('#chemistryBody tr:last-child input[name$=".SampleNo"]').val('Sample ' + (index + 1));
    }

    // INIT
    $(document).ready(function () {
        addSampleRow();

        $('#addRowBtn').click(function () {
            addSampleRow();
        });

        // RADIO BASED VISIBILITY
        function toggleInputs(row, isEnabled) {
            row.find('input, select').prop('disabled', !isEnabled);
        }

        function updatePlantDetails(id) {
            if (id === "radioRM1" || id === "radioRM2") {
                $('#furnaceFormRow').hide();
                $('#rollingMillFormRow').show();
                toggleInputs($('#furnaceFormRow'), false);
                toggleInputs($('#rollingMillFormRow'), true);
            } else {
                $('#rollingMillFormRow').hide();
                $('#furnaceFormRow').show();
                toggleInputs($('#rollingMillFormRow'), false);
                toggleInputs($('#furnaceFormRow'), true);
            }
        }

        $('.plant-radio').on('change', function () {
            updatePlantDetails(this.id);
        });

        updatePlantDetails($('.plant-radio:checked').attr('id'));
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>
