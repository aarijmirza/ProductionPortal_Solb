@using System.Globalization
@model DAL.Models.ViewModel.BilletBoardingPDFVM
@{
    Layout = null;

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Billet Boarding Summary</title>

    <!-- Fevicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.png">
    <!-- Start CSS --> <!-- Chartist Chart CSS -->
    <link rel="stylesheet" href="~/assets/plugins/chartist-js/chartist.min.css">
    <!-- Switchery CSS -->
    <link href="~/assets/plugins/switchery/switchery.min.css" rel="stylesheet">
    <!-- Datepicker CSS -->
    <link href="~/assets/plugins/datepicker/datepicker.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/css/icons.css" rel="stylesheet" type="text/css">
    <link href="~/assets/css/style.css" rel="stylesheet" type="text/css">
    <!-- End CSS --> <!-- DataTables CSS -->
    <link href="~/assets/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <!-- Responsive Datatable CSS -->
    <link href="~/assets/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />


    <style>

        @@media print {
            canvas {
                max-width: 100% !important;
                height: 100% !important;
            }

            .card {
                page-break-inside: avoid;
            }

            .piechart2 {
                height: 225px !important;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 11px;
            margin: 0;
            color: #000 !important;
            padding: 0;
        }

        .card {
            border: 1px solid lightgray;
        }

        p {
            line-height: 1.3;
            font-size: 15px;
            font-weight: bolder;
            margin-bottom: 10px;
        }

        .sheet {
            margin: 10px auto;
            border: 1px solid #000;
            padding: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #000;
            padding: 2px 3px;
            vertical-align: middle;
        }

        .no-border td,
        .no-border th {
            border: none !important;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .header-title {
            font-size: 25px;
            font-weight: bold;
        }

        .sub-header {
            font-size: 22px;
            font-weight: bold;
        }

        .small {
            font-size: 12px;
        }

        .section-title {
            font-weight: bold;
            background-color: #f2f2f2;
            font-size: 15px;
        }

        .red {
            color: #c00000;
            font-weight: bold;
        }

        .text-top {
            vertical-align: top;
        }

        .logo-cell img {
            max-height: 70px;
            margin-top: 10px;
        }

        .total-row {
            font-weight: bold;
            background-color: #f9f9f9;
        }

        .legend-cell {
            font-size: 9px;
        }

        @@media print {
            body {
                margin: 0;
            }

            .sheet {
                margin: 0;
                border: none;
            }
        }
    </style>
</head>
<body>
    <div class="sheet">

        <!-- LOGO + TITLES -->
        <table class="no-border">
            <tr>
                <td class="logo-cell" style="width: 90px;">
                    <img src="~/assets/images/logo.png" />
                </td>

                <td class="center">
                    <div class="header-title">SOLB STEEL COMPANY</div>
                    <div class="sub-header">BILLET BOARDING REPORT</div>
                </td>
            </tr>
        </table>

        <table style="margin-top:25px;">
            <tr>
                <td colspan="28" class="section-title">BILLET BOARDING DESCRIPTION</td>
            </tr>

            <!-- Column Header Row -->
            <tr class="small bold">
                <!-- SMALL COLUMNS (same width) -->
                <td style="width:65px;">Date</td>
                <td style="width:65px;">Heat #</td>
                <td style="width:65px;">Billet Boarding #</td>
                <td style="width:65px;">Plant</td>
                <td style="width:65px;">Shift</td>
                <td style="width:65px;">Product Specs</td>
                <td style="width:65px;">Grade</td>
                <td style="width:65px;">Billet Length</td>
                <td style="width:65px;">Cross Section</td>
                <td style="width:65px;">Billet Weight</td>
                <td style="width:65px;">Size</td>
                <td style="width:65px;">Profile</td>
                <td style="width:125px;">Remarks</td>
            </tr>

            @if (Model?.BilletBoards != null)
            {
                foreach (var item in Model.BilletBoards)
                {
                    <tr style="height:22px;">
                        <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                        <td>@item.HeatNo</td>
                        <td>@item.BilletBoarding</td>
                        <td>@item.PlantName</td>
                        <td>@item.Shift</td>
                        <td>@item.ProductSpecs</td>
                        <td>@item.Grade</td>
                        <td>@item.BilletLength</td>
                        <td>@item.CrossSection</td>
                        <td>@item.BilletWeight</td>
                        <td>@item.Size</td>
                        <td>@item.Profile</td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            }
        </table>

        <div class="row">
            <div class="col-md-1">
            </div>
            <div class="col-md-10">
                <table style="margin-top:25px;">
                    <tr>
                        <td colspan="28" class="section-title">HEAT CHEMISTRY DESCRIPTION</td>
                    </tr>
                    <!-- Column Header Row -->
                    <tr class="small bold">
                        <!-- SMALL COLUMNS (same width) -->
                        <td style="width:65px;">Heat #</td>
                        <td style="width:65px;">No. of Billets</td>
                        <td style="width:65px;">C</td>
                        <td style="width:65px;">Si</td>
                        <td style="width:65px;">Mn</td>
                        <td style="width:65px;">S</td>
                        <td style="width:65px;">P</td>
                        <td style="width:65px;">N</td>
                        <td style="width:65px;">Ceq</td>
                    </tr>
                    @if (Model?.BilletBoards != null)
                    {
                        foreach (var item in Model.Samples)
                        {
                            <tr style="height:22px;">
                                <td>@item.HeatNo</td>
                                <td>@item.NoOfBillets</td>
                                <td>@item.C</td>
                                <td>@item.Si</td>
                                <td>@item.Mn</td>
                                <td>@item.S</td>
                                <td>@item.P</td>
                                <td>@item.N</td>
                                <td>@item.Ceq</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>



    </div>
</body>
</html>
