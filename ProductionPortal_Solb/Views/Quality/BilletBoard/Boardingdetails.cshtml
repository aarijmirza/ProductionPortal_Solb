@model DAL.Models.BilletBoardBLL
@using System.Globalization
@using System.Linq
@{
    ViewBag.Title = "Billet Boarding Detail";
    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    decimal totalChemistryBillets =
        Model != null &&
        Model.Chemistry != null
            ? Model.Chemistry.Sum(
                x => Convert.ToDecimal(
                    x.NoOfBillets
                )
            )
            : 0;
}


<style>
    .print-template {
        display: none;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printTemplate,
        #printTemplate * {
            visibility: visible !important;
        }

        #printTemplate {
            display: block !important;
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 20px;
            font-family: Arial, sans-serif;
            color: #000;
        }

        .no-print,
        .xp-breadcrumbbar {
            display: none !important;
        }

        .print-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }

            .print-header h2 {
                margin: 0;
                font-size: 24px;
                font-weight: bold;
            }

            .print-header h4 {
                margin: 5px 0 0 0;
                font-size: 16px;
            }

        .print-doc-info {
            font-size: 13px;
            text-align: right;
            line-height: 22px;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 20px;
            font-size: 12px;
        }

            .info-table td {
                border: 1px solid #000;
                padding: 7px;
            }

                .info-table td:nth-child(1),
                .info-table td:nth-child(3) {
                    background: #f2f2f2;
                    width: 18%;
                }

        .section-title {
            margin-top: 15px;
            margin-bottom: 8px;
            font-size: 15px;
            background: #e9e9e9;
            padding: 6px;
            border: 1px solid #000;
        }

        .print-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

            .print-table th,
            .print-table td {
                border: 1px solid #000;
                padding: 5px;
                text-align: center;
            }

            .print-table th {
                background: #f2f2f2;
                font-weight: bold;
            }

        .remarks-box {
            min-height: 45px;
            border: 1px solid #000;
            padding: 8px;
            font-size: 12px;
        }

        .signature-area {
            display: flex;
            justify-content: space-between;
            margin-top: 45px;
            font-size: 12px;
            text-align: center;
        }

            .signature-area div {
                width: 30%;
            }

        @@page {
            size: A4 portrait;
            margin: 12mm;
        }
    }
</style>

<script>
    function printBilletTemplate() {
        window.print();
    }
</script>


<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Billet Boarding Detail</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("BilletBoard", "Quality")">Billet Boarding</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">
    <div class="row no-print">
        <div class="col-lg-12 text-right mb-3">
            <a href="@Url.Action("BilletBoard", "Quality")" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Back
            </a>

            @*<button type="button" class="btn btn-primary" onclick="printBilletDetail()">*@
            <button type="button" class="btn btn-primary" onclick="printBilletTemplate()">
                <i class="fa fa-print"></i> Print
            </button>
        </div>
    </div>

    <div id="printArea">
        <div class="row">

            <!-- Billet / Heat Information -->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">Billet Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label>Date</label>
                                <p class="form-control-static"><strong>@(Model.Date?.ToString("dd-MM-yyyy", gregorian))</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Billet Boarding #</label>
                                <p class="form-control-static"><strong>@Model.BilletBoarding</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Heat No</label>
                                <p class="form-control-static"><strong>@Model.HeatNo</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Plant</label>
                                <p class="form-control-static"><strong>@Model.PlantName</strong></p>
                            </div>

                            <div class="form-group col-md-3">
                                <label>Shift</label>
                                <p class="form-control-static"><strong>@Model.Shift</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Product Spec / Grade</label>
                                <p class="form-control-static"><strong>@Model.ProductSpecs</strong></p>
                            </div>
                            @*<div class="form-group col-md-3">
                                    <label>Steel Grade</label>
                                    <p class="form-control-static"><strong>@Model.SteelGrade</strong></p>
                                </div>*@

                            <div class="form-group col-md-3">
                                <label>Billet Length (m)</label>
                                <p class="form-control-static"><strong>@Model.BilletLength</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Cross Section (mm)</label>
                                <p class="form-control-static"><strong>@Model.CrossSection</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Billet Weight</label>
                                <p class="form-control-static"><strong>@Model.BilletWeight</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Size</label>
                                <p class="form-control-static"><strong>@Model.Size</strong></p>
                            </div>
                            <div class="form-group col-md-3">
                                <label>Profile</label>
                                <p class="form-control-static"><strong>@Model.Profile</strong></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chemical Analysis -->
            <!-- Chemical Analysis -->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            RM Chemical Analysis
                            @if (!string.IsNullOrWhiteSpace(Model.BilletBoarding))
                            {
                                <span>- Billet Boarding #: @Model.BilletBoarding</span>
                            }
                        </h5>
                    </div>

                    <div class="card-body">
                        @if (Model.Chemistry != null && Model.Chemistry.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped table-sm text-center">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Sr#</th>
                                            <th>Heat #</th>
                                            <th>No. of Billet</th>
                                            <th>C</th>
                                            <th>Si</th>
                                            <th>Mn</th>
                                            <th>S</th>
                                            <th>P</th>
                                            <th>N</th>
                                            <th>Ceq</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int chemSr = 1;
                                        }

                                        @foreach (var item in Model.Chemistry)
                                        {
                                            <tr>
                                                <td>@chemSr</td>
                                                <td>@item.HeatNo</td>
                                                <td>@item.NoOfBillets</td>
                                                <td>@item.C</td>
                                                <td>@item.Si</td>
                                                <td>@item.Mn</td>
                                                <td>@item.S</td>
                                                <td>@item.P</td>
                                                <td>@item.N</td>
                                                <td>@item.Ceq</td>
                                            </tr>

                                            chemSr++;
                                        }
                                    </tbody>

                                    <tfoot>
                                        <tr class="font-weight-bold bg-light">
                                            <td colspan="2" class="text-right">
                                                Total Billets
                                            </td>
                                            <td>
                                                @totalChemistryBillets.ToString("0.##")
                                            </td>
                                            <td colspan="7"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                No RM Chemical Analysis found against this Billet Boarding number.
                            </div>
                        }
                    </div>
                </div>
            </div>

            @*<div class="col-lg-12">
                    <div class="card m-b-30">
                        <div class="card-header bg-success text-white">
                            <h5 class="card-title mb-0">Chemical Analysis</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Chemistry != null && Model.Chemistry.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Heat #</th>
                                                <th>No. of Billet</th>
                                                <th>C</th>
                                                <th>Si</th>
                                                <th>Mn</th>
                                                <th>S</th>
                                                <th>P</th>
                                                <th>N</th>
                                                <th>Ceq</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Chemistry)
                                            {
                                                <tr>
                                                    <td>@item.HeatNo</td>
                                                    <td>@item.NoOfBillets</td>
                                                    <td>@item.C</td>
                                                    <td>@item.Si</td>
                                                    <td>@item.Mn</td>
                                                    <td>@item.S</td>
                                                    <td>@item.P</td>
                                                    <td>@item.N</td>
                                                    <td>@item.Ceq</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="mb-0 text-muted">No chemical analysis found against this Heat No.</p>
                            }
                        </div>
                    </div>
                </div>*@

            <!-- Remarks -->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">Remarks</h5>
                    </div>
                    <div class="card-body">
                        <p class="form-control-static">@Model.Remarks</p>
                    </div>
                </div>
            </div>

            <!-- System Information -->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">System Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>Created By</label>
                                <p class="form-control-static">@Model.CreatedBy</p>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Created Date</label>
                                <p class="form-control-static">@(Model.CreatedDate?.ToString("dd-MM-yyyy", gregorian))</p>
                            </div>
                            @*<div class="form-group col-md-4">
                                    <label>Updated Date</label>
                                    <p class="form-control-static">@(Model.UpdatedDate?.ToString("dd-MM-yyyy", gregorian))</p>
                                </div>*@
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="printTemplate" class="print-template">

    <div class="print-header">
        <div>
            <h2>
                <img src="~/assets/images/logo.png" style="width: 150px;" />
            </h2>
            <h4>Billet Boarding Report</h4>
        </div>

        <div class="print-doc-info">
            <strong>Billet Boarding #:</strong> @Model.BilletBoarding<br />
            <strong>Date:</strong> @(Model.Date?.ToString("dd-MM-yyyy", gregorian))
        </div>
    </div>

    <hr />

    <table class="info-table">
        <tr>
            <td><strong>Plant</strong></td>
            <td>@Model.PlantName</td>
            <td><strong>Shift</strong></td>
            <td>@Model.Shift</td>
        </tr>
        <tr>
            <td><strong>Product Spec / Grade</strong></td>
            <td>@Model.ProductSpecs</td>
            <td><strong>Billet Length</strong></td>
            <td>@Model.BilletLength</td>
        </tr>
        <tr>
            <td><strong>Cross Section</strong></td>
            <td>@Model.CrossSection</td>
            <td><strong>Billet Weight</strong></td>
            <td>@Model.BilletWeight</td>
        </tr>
        <tr>
            <td><strong>Size</strong></td>
            <td>@Model.Size</td>
            <td><strong>Profile</strong></td>
            <td>@Model.Profile</td>
        </tr>
    </table>

    <h4 class="section-title">RM Chemical Analysis</h4>

    @if (Model.Chemistry != null && Model.Chemistry.Any())
    {
        <table class="print-table">
            <thead>
                <tr>
                    <th>Sr#</th>
                    <th>Heat #</th>
                    <th>No. of Billet</th>
                    <th>C</th>
                    <th>Si</th>
                    <th>Mn</th>
                    <th>S</th>
                    <th>P</th>
                    <th>N</th>
                    <th>Ceq</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int pSr = 1;
                }

                @foreach (var item in Model.Chemistry)
                {
                    <tr>
                        <td>@pSr</td>
                        <td>@item.HeatNo</td>
                        <td>@item.NoOfBillets</td>
                        <td>@item.C</td>
                        <td>@item.Si</td>
                        <td>@item.Mn</td>
                        <td>@item.S</td>
                        <td>@item.P</td>
                        <td>@item.N</td>
                        <td>@item.Ceq</td>
                    </tr>

                    pSr++;
                }
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="2" style="text-align:right; font-weight:bold;">
                        Total Billets
                    </td>
                    <td style="font-weight:bold;">
                        @totalChemistryBillets.ToString("0.##")
                    </td>
                    <td colspan="7"></td>
                </tr>
            </tfoot>
        </table>
    }

    <h4 class="section-title">Remarks</h4>
    <div class="remarks-box">
        @Model.Remarks
    </div>

    <div class="signature-area">
        <div>
            ______________________
            <br /><br />
            <strong>Prepared By</strong>
        </div>

        <div>
            ______________________
            <br /><br />
            <strong>Checked By</strong>
        </div>

        <div>
            ______________________
            <br /><br />
            <strong>Approved By</strong>
        </div>
    </div>

</div>