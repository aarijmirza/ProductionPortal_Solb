                        {
                            <button type="button"
                                    id="deleteBilletButton"
                                    class="btn btn-danger mr-2">
                                <i class="fa fa-trash"></i>
                                Delete
                            </button>
                        }

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa fa-save"></i>

                            @(billet.ID > 0
                                ? "Update Billet"
                                : "Save Billet")

                        </button>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label for="date">Date</label>
                                <input type="date" class="form-control" id="date" name="date" placeholder="Date" value="@(billet.Date.HasValue ? billet.Date.Value.ToString("yyyy-MM-dd") : "")">
                            </div>
                            <div class="form-group col-md-3">
                                <label for="billetboarding">Billet Boarding #</label>
                                <input type="text" class="form-control" id="billetboarding" name="billetboarding" placeholder="" value="@billet.BilletBoarding">
                            </div>
                            <div class="form-group col-md-3">
                                <label for="plantname">Plant</label>
                                <select class="form-control" id="plantname" name="plantname">
                                    <option value="">Please Select</option>
                                    <option value="RM1" @(billet.PlantName == "RM1" ? "selected" : "")>RM1</option>
                                    <option value="RM2" @(billet.PlantName == "RM2" ? "selected" : "")>RM2</option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <label for="shift">Shift</label>
                                <select class="form-control" id="shift" name="shift">
                                    <option value="">Please Select</option>
                                    <option value="Morning" @(billet.Shift == "Morning" ? "selected" : "")>Morning</option>
                                    <option value="Long Morning" @(billet.Shift == "Long Morning" ? "selected" : "")>Long Morning</option>
                                    <option value="Evening" @(billet.Shift == "Evening" ? "selected" : "")>Evening</option>
                                    <option value="Night" @(billet.Shift == "Night" ? "selected" : "")>Night</option>
                                    <option value="Long Night" @(billet.Shift == "Long Night" ? "selected" : "")>Long Night</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-3 dropdown-container">
                                <label for="productSpec">Product Spec/Grade</label>
                                @* 2. VISIBLE INPUT FIELD *@
                                <div class="input-group">
                                    <input type="text"
                                           id="productSpec"
                                           class="form-control"
                                           placeholder="-- Select Product Grade --"
                                           readonly
                                           name="productspecs" value="@billet.ProductSpecs">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" id="toggleDropdownBtn">
                                            <i class="fa fa-caret-down"></i>
                                        </button>
                                    </div>
                                </div>

                                @* 3. CUSTOM MULTI-COLUMN DROPDOWN TABLE *@
