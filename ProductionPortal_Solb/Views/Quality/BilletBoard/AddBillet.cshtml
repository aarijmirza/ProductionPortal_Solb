                                    <table class="table table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 30%;">Spec/Grade</th>
                                                <th style="width: 30%;">Steel Grade</th>
                                                <th style="width: 10%;">L</th>
                                                <th style="width: 10%;">W</th>
                                                <th style="width: 20%;">Billet Length (m)</th>
                                            </tr>
