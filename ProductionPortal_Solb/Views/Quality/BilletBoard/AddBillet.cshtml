<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    // Add mode mein hi current date set karo.
    // Edit mode mein DB wali date preserve hogi.
    const today = new Date().toISOString().split('T')[0];

    if (!document.getElementById("date").value) {
        document.getElementById("date").value = today;
    }

    // JAVASCRIPT FOR MULTI-COLUMN DROPDOWN
    $(document).ready(function () {

        const gradeDataJson = '@Html.Raw(ViewBag.GradeDataJson)';
        let gradeData = [];

        try {
            gradeData = JSON.parse(gradeDataJson);
        } catch (e) {
            console.error("Error parsing Grade Data JSON:", e);
            return;
        }

        const $specGradeBody = $('#specGradeBody');
        const $inputField = $('#productSpec');
        const $dropdownTable = $('#multiColumnDropdown');
        const $toggleBtn = $('#toggleDropdownBtn');
        const $hiddenIdField = $('#hiddenProductID');
        const $billetLengthField = $('#billetLength');
        const $crossSectionField = $('#crosssection');
        const $steelGradeField = $('#steelGrade');   // ✅ add this input in HTML

        // ----------------------------
        // POPULATE DROPDOWN TABLE
        // ----------------------------
        gradeData.forEach(item => {
            const row = `
                <tr
                    data-id="${item.ProductID}"
                    data-spec="${item.SpecGrade}"
                    data-grade="${item.SteelGrade}"
                    data-l="${item.Length}"
                    data-w="${item.Width}"
                    data-billet="${item.BilletLength}">
                    <td>${item.SpecGrade}</td>
                    <td>${item.SteelGrade}</td>
                    <td>${item.Length}</td>
                    <td>${item.Width}</td>
                    <td>${item.BilletLength}</td>
                </tr>`;
            $specGradeBody.append(row);
        });

        // ----------------------------
        // TOGGLE DROPDOWN
        // ----------------------------
        $toggleBtn.on('click', function () {
            $dropdownTable.toggle();
        });

        // ----------------------------
        // ROW CLICK EVENT
        // ----------------------------
        $specGradeBody.on('click', 'tr', function () {

            const $row = $(this);

            const selectedId = $row.data('id');
            const selectedSpec = $row.data('spec');
            const selectedGrade = $row.data('grade');
            const billetLength = $row.data('billet');

            const length = $row.data('l');
            const width = $row.data('w');
            const crossSectionValue = length + 'x' + width;

            // ✅ SET VALUES
            debugger
            $inputField.val(selectedSpec);
            $hiddenIdField.val(selectedId);
            $billetLengthField.val(billetLength);
            $crossSectionField.val(crossSectionValue);
            $steelGradeField.val(selectedGrade);     // ✅ Fixed variable

            $dropdownTable.hide();
        });

        // ----------------------------
        // HIDE DROPDOWN IF CLICK OUTSIDE
        // ----------------------------
        $(document).on('click', function (e) {
            if (!$dropdownTable.is(e.target) &&
                $dropdownTable.has(e.target).length === 0 &&
                !$toggleBtn.is(e.target) &&
                !$inputField.is(e.target)) {
                $dropdownTable.hide();
            }
        });
    });
</script>

<script>
    $(document).ready(function () {

        let rowIndex =
            $('#chemBody tr').length;

        // Sirf tab blank row add karo jab existing chemistry na ho.
        if (rowIndex === 0) {
            addChemRow();
        }

        // Add new row
        $('#addChemRow').click(function () {
            addChemRow();
        });

        // Remove row
        $('#chemBody').on('click', '.removeRow', function () {
            $(this).closest('tr').remove();
            reindexRows();
        });

        function addChemRow() {

            const row = `
        <tr>
            <td class="text-center chemistry-srno">${rowIndex + 1}</td>

            <td class="text-center">
            <input type="hidden" class="chemistry-id" name="Chemistry[${rowIndex}].ID" value="0">
            <input type="text" class="form-control" name="Chemistry[${rowIndex}].HeatNo" autocomplete="off" placeholder="">
            </td>

            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].NoOfBillets" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].C" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].Si" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].Mn" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].S" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].P" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].N" /></td>
            <td><input type="text" class="form-control" name="Chemistry[${rowIndex}].Ceq" /></td>

            <td>
                <select class="form-control" name="Chemistry[${rowIndex}].HeatStatus">
                    <option value="">-- select --</option>
                    <option value="100">Complete</option>
                    <option value="101">Cancelled</option>
                    <option value="102">Charging</option>
                    <option value="103">In Process</option>
                    <option value="104">New</option>
                    <option value="105">Rolled</option>
                    <option value="106">Rolling</option>
                </select>
            </td>

            <td class="text-center">
                <button type="button" class="btn btn-sm btn-danger removeRow">X</button>
            </td>
        </tr>`;

            $('#chemBody').append(row);
            rowIndex++;
            reindexRows();
        }

        function reindexRows() {

            $('#chemBody tr').each(
                function (i) {

                    $(this)
                        .find('.chemistry-srno')
                        .text(i + 1);

                    $(this)
                        .find('input, select')
                        .each(function () {

                            var name =
                                $(this).attr('name');

                            if (!name) {
                                return;
                            }

                            name =
                                name.replace(
                                    /Chemistry\[\d+\]/,
                                    'Chemistry[' + i + ']'
                                );

                            $(this).attr(
                                'name',
                                name
                            );
                        });
                }
            );

            rowIndex =
                $('#chemBody tr').length;
        }

    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function () {

        var errorMessage = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["ErrorMessage"])))';
        var successMessage = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["SuccessMessage"])))';

        if (errorMessage && errorMessage !== '') {
            Swal.fire({
                title: 'Error',
                text: errorMessage,
                icon: 'error',
                confirmButtonText: 'OK'
            });
        }

        if (successMessage && successMessage !== '') {
            Swal.fire({
                title: 'Success',
                text: successMessage,
                icon: 'success',
                confirmButtonText: 'OK'
            });
        }

    });
</script>
<script>
    $(document).ready(function () {

        let isSubmitting = false;

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault();

            if (isSubmitting) {
                return;
            }

            var billetBoarding =
                ($("#billetboarding").val() || "").trim();

            if (billetBoarding === "") {
                Swal.fire({
                    title: 'Error',
                    text: 'Billet Boarding number is required.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });

                return;
            }


            var heatNos = [];
            var duplicateHeatNos = [];


            $("#chemBody")
                .find("input[name*='.HeatNo']")
                .each(function () {

                    var heatNo =
                        ($(this).val() || "")
                            .trim()
                            .toUpperCase();

                    if (heatNo !== "") {

                        if (
                            heatNos.indexOf(
                                heatNo
                            ) >= 0
                        ) {
                            duplicateHeatNos.push(
                                heatNo
                            );
                        }
                        else {
                            heatNos.push(
                                heatNo
                            );
                        }
                    }
                });


            if (heatNos.length === 0) {

                Swal.fire({
                    title: 'Error',
                    text: 'Please enter at least one Heat No.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });

                return;
            }


            /*
             * Duplicate inside current screen.
             */
            if (duplicateHeatNos.length > 0) {

                Swal.fire({
                    title: 'Duplicate Heat No',
                    text:
                        'Duplicate Heat No found in current form: '
                        +
                        duplicateHeatNos.join(', '),
                    icon: 'error',
                    confirmButtonText: 'OK'
                });

                return;
            }


            /*
             * =====================================================
             * DATABASE DUPLICATE CHECK BEFORE FORM SUBMIT
             *
             * StatusID = 1 => blocked
             * StatusID = 3 => allowed
             * =====================================================
             */

            var currentID =
                parseInt(
                    $("#ID").val() || "0"
                );

            // Existing chemistry IDs must be excluded during Edit.
            // Newly added rows have ID = 0 and are intentionally not excluded.
            var excludedIDs = [];

            $("#chemBody .chemistry-id").each(function () {
                var chemistryID = parseInt($(this).val() || "0");

                if (chemistryID > 0) {
                    excludedIDs.push(chemistryID);
                }
            });


            /*
             * ADD AND EDIT:
             * Validate against active BilletBoard AND
             * RMChemicalAnalysis records.
             * In Edit, the current boarding/chemistry rows are excluded.
             */
            $.ajax({
                url:
                    '@Url.Action("CheckDuplicateHeatNos", "BilletBoard")',

                type:
                    'POST',

                traditional:
                    true,

                data:
                {
                    heatNos: heatNos,
                    excludedIDs: excludedIDs,
                    currentID: currentID,
                    __RequestVerificationToken:
                        $('#addprofileform input[name="__RequestVerificationToken"]').val()
                },

                success:
                    function (response) {

                        if (
                            !response ||
                            response.success !== true
                        ) {

                            Swal.fire({
                                title: 'Error',
                                text:
                                    response &&
                                    response.message
                                        ? response.message
                                        : 'Unable to validate Heat No.',
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });

                            return;
                        }


                        if (
                            response.duplicates &&
                            response.duplicates.length > 0
                        ) {

                            Swal.fire({
                                title: 'Duplicate Heat No',
                                text:
                                    'These Heat No(s) already exist as active in Billet Board or Chemical Analysis: '
                                    +
                                    response.duplicates.join(', '),
                                icon: 'error',
                                confirmButtonText: 'OK'
                            });

                            return;
                        }


                        Swal.fire({
                            title: 'Confirm Submission',
                            text:
                                currentID > 0
                                    ? 'Are you sure you want to update this Billet Boarding?'
                                    : 'Are you sure you want to submit this Billet Boarding?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText:
                                currentID > 0
                                    ? 'Yes, Update'
                                    : 'Yes, Submit',
                            cancelButtonText: 'Cancel',
                            allowOutsideClick: false,
                            allowEscapeKey: false

                        }).then(function (result) {

                            if (
                                result.isConfirmed
                            ) {

                                isSubmitting =
                                    true;


                                $("#addprofileform")
                                    .find(
                                        "button[type='submit']"
                                    )
                                    .prop(
                                        "disabled",
                                        true
                                    )
                                    .text(
                                        currentID > 0
                                            ? "Updating..."
                                            : "Submitting..."
                                    );


                                /*
                                 * Native submit bypasses this jQuery handler,
                                 * preventing recursive submit.
                                 */
                                document
                                    .getElementById(
                                        "addprofileform"
                                    )
                                    .submit();
                            }
                        });
                    },

                error:
                    function (xhr) {

                        var message =
                            'Unable to validate duplicate Heat No.';


                        if (
                            xhr &&
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {
                            message =
                                xhr.responseJSON.message;
                        }


                        Swal.fire({
                            title: 'Validation Error',
                            text: message,
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
            });
        });

    });
</script>
@if (billet.ID > 0)
{
    <script>
        $(document).ready(function () {
            $("#deleteBilletButton").on("click", function () {
                var currentID = parseInt($("#ID").val() || "0");

                if (currentID <= 0) {
                    return;
                }

                Swal.fire({
                    title: 'Delete Billet Boarding?',
                    text: 'All linked active Heat rows in BilletBoard and RMChemicalAnalysis will be set to StatusID = 3.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (!result.isConfirmed) {
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("Delete", "BilletBoard")',
                        type: 'POST',
                        data: {
                            id: currentID,
                            __RequestVerificationToken:
                                $('#addprofileform input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (!response || response.success !== true) {
                                Swal.fire(
                                    'Delete Failed',
                                    response && response.message
                                        ? response.message
                                        : 'Record could not be deleted.',
                                    'error'
                                );
                                return;
                            }

                            Swal.fire({
                                title: 'Deleted',
                                text: response.message,
                                icon: 'success',
                                confirmButtonText: 'OK'
                            }).then(function () {
                                window.location.href = response.redirectUrl;
                            });
                        },
                        error: function (xhr) {
                            var message =
                                xhr && xhr.responseJSON && xhr.responseJSON.message
                                    ? xhr.responseJSON.message
                                    : 'Record could not be deleted.';

                            Swal.fire('Delete Failed', message, 'error');
                        }
                    });
                });
            });
        });
    </script>
}
