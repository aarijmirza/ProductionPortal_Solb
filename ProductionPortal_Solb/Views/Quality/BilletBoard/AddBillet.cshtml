@model DAL.Models.BilletBoardBLL
@{
    ViewBag.Title =
        Model != null && Model.ID > 0
            ? "Edit Billet"
            : "Add Billet";

    var billet =
        Model ?? new DAL.Models.BilletBoardBLL();

    var chemistryRows =
        billet.Chemistry ??
        new List<DAL.Models.RMChemicalAnalysisBLL>();
}

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Billet Board</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index" ,"Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Billet Board</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(billet.ID > 0 ? "Edit Billet Boarding" : "Add Billet Boarding")</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<style>
    .dropdown-container {
        position: relative;
    }

    .dropdown-menu-custom {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        width: 100%;
        max-width: 500px;
        /* 💥 INCREASE THIS VALUE 💥 */
        max-height: 250px; /* Increased height */
        overflow-y: auto; /* Keep scrollbar */
        border: 1px solid #ccc;
        background-color: white;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
        font-size: 12px;
    }

        .dropdown-menu-custom table {
            table-layout: fixed; /* Ensures fixed column widths */
        }

        .dropdown-menu-custom tbody tr {
            cursor: pointer;
        }

            .dropdown-menu-custom tbody tr:hover {
                background-color: #f5f5f5;
            }
            /* Style for selected row, if needed */
            .dropdown-menu-custom tbody tr.selected {
                background-color: #007bff;
                color: white;
            }

        /* Ensures headers are bold */
        .dropdown-menu-custom th {
            font-weight: bold;
            /* Add a border to the right of the header cells for alignment */
            border-right: 1px solid #ccc;
        }

            /* Remove the border from the last header cell */
            .dropdown-menu-custom th:last-child {
                border-right: none;
            }

        /* 💥 VERTICAL AND HORIZONTAL SEPARATORS 💥 */
        .dropdown-menu-custom td {
            /* Horizontal Separator (bottom) */
            border-bottom: 1px solid #ddd;
            /* Vertical Separator (right) */
            border-right: 1px solid #ccc; /* Light vertical line between columns */
        }

            /* Ensure the last column (last td in each row) does not have a right border */
            .dropdown-menu-custom td:last-child {
                border-right: none;
            }

        /* Ensure the last row doesn't have a bottom border, keeping it clean */
        .dropdown-menu-custom tr:last-child td {
            border-bottom: none;
        }
    /* ... (Keep existing hover styles) ... */

    /* ================= CHEMICAL ANALYSIS REDESIGN ================= */
    .chem-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
    }

    .chem-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }

    .chem-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chem-title-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f8e8ee;
        color: #a6173f;
        font-size: 16px;
    }

    .chem-title {
        margin: 0;
        color: #111827;
        font-size: 15px;
        font-weight: 800;
    }

    .chem-subtitle {
        margin: 2px 0 0;
        color: #6b7280;
        font-size: 11px;
    }

    .chem-table-wrap {
        width: 100%;
        overflow-x: auto;
        padding: 14px 14px 4px;
    }

    .chem-table {
        width: 100%;
        min-width: 1500px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .chem-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 5px;
            border-top: 1px solid #d1d5db;
            border-bottom: 1px solid #d1d5db;
            background: #f8fafc;
            color: #374151;
            font-size: 10px;
            font-weight: 800;
            text-align: center;
            white-space: nowrap;
        }

            .chem-table thead th:first-child {
                border-left: 1px solid #d1d5db;
                border-radius: 8px 0 0 0;
            }

            .chem-table thead th:last-child {
                border-right: 1px solid #d1d5db;
                border-radius: 0 8px 0 0;
            }

        .chem-table tbody td {
            padding: 5px;
            border-bottom: 1px solid #e5e7eb;
            background: #fff;
            vertical-align: middle;
        }

        .chem-table tbody tr:nth-child(even) td {
            background: #fbfbfc;
        }

        .chem-table tbody tr:hover td {
            background: #fff8fa;
        }

        .chem-table .form-control {
            height: 34px;
            padding: 5px 7px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            background: #fff;
            color: #111827;
            font-size: 11px;
            text-align: center;
            box-shadow: none;
        }

            .chem-table .form-control:focus {
                border-color: #a6173f;
                box-shadow: 0 0 0 2px rgba(166, 23, 63, .10);
            }

        .chem-table .heat-input {
            text-align: left;
            font-weight: 700;
            min-width: 105px;
        }

        .chem-table .billet-input {
            min-width: 74px;
        }

        .chem-table .chem-input {
            min-width: 62px;
        }

        .chem-table .status-select {
            min-width: 115px;
            text-align: left;
        }

    .chem-srno {
        width: 52px;
        color: #4b5563;
        font-weight: 800;
        text-align: center;
    }

    .chem-action-cell {
        width: 58px;
        text-align: center;
    }

    .chem-remove-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 15px;
        font-weight: 800;
    }

        .chem-remove-btn:hover {
            background: #fecaca;
            color: #991b1b;
        }

    .chem-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 14px 14px;
    }

    .chem-add-btn {
        border: 1px solid #a6173f;
        border-radius: 8px;
        padding: 7px 13px;
        background: #a6173f;
        color: #fff;
        font-size: 12px;
        font-weight: 800;
    }

        .chem-add-btn:hover {
            border-color: #7f1230;
            background: #7f1230;
            color: #fff;
        }

    .chem-sequence-note {
        color: #6b7280;
        font-size: 10px;
        font-weight: 600;
    }

    @@media(max-width: 767px) {
        .chem-card-header,
        .chem-footer {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="xp-contentbar">
    <form action="@Url.Action("Save", "BilletBoard")" id="addprofileform" method="post" enctype="multipart/form-data">
        <input type="hidden"
               id="ID"
               name="ID"
               value="@billet.ID" />
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white" style="ALIGN-SELF: end;">
                        @if (billet.ID > 0)
                        {
                            <button type="button"
                                    id="deleteBilletButton"
                                    class="btn btn-danger mr-2">
                                <i class="fa fa-trash"></i>
                                Delete
                            </button>
                        }

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa fa-save"></i>

                            @(billet.ID > 0
                                ? "Update Billet"
                                : "Save Billet")

                        </button>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label for="date">Date</label>
                                <input type="date" class="form-control" id="date" name="date" placeholder="Date" value="@(billet.Date.HasValue ? billet.Date.Value.ToString("yyyy-MM-dd") : "")">
                            </div>
                            <div class="form-group col-md-3">
                                <label for="billetboarding">Billet Boarding #</label>
                                <input type="text" class="form-control" id="billetboarding" name="billetboarding" placeholder="" value="@billet.BilletBoarding">
                            </div>
                            <div class="form-group col-md-3">
                                <label for="plantname">Plant</label>
                                <select class="form-control" id="plantname" name="plantname">
                                    <option value="">Please Select</option>
                                    <option value="RM1" @(billet.PlantName == "RM1" ? "selected" : "")>RM1</option>
                                    <option value="RM2" @(billet.PlantName == "RM2" ? "selected" : "")>RM2</option>
                                </select>
                            </div>
                            <div class="form-group col-md-3">
                                <label for="shift">Shift</label>
                                <select class="form-control" id="shift" name="shift">
                                    <option value="">Please Select</option>
                                    <option value="Morning" @(billet.Shift == "Morning" ? "selected" : "")>Morning</option>
                                    <option value="Long Morning" @(billet.Shift == "Long Morning" ? "selected" : "")>Long Morning</option>
                                    <option value="Evening" @(billet.Shift == "Evening" ? "selected" : "")>Evening</option>
                                    <option value="Night" @(billet.Shift == "Night" ? "selected" : "")>Night</option>
                                    <option value="Long Night" @(billet.Shift == "Long Night" ? "selected" : "")>Long Night</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-3 dropdown-container">
                                <label for="productSpec">Product Spec/Grade</label>
                                @* 2. VISIBLE INPUT FIELD *@
                                <div class="input-group">
                                    <input type="text"
                                           id="productSpec"
                                           class="form-control"
                                           placeholder="-- Select Product Grade --"
                                           readonly
                                           name="productspecs" value="@billet.ProductSpecs">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary" type="button" id="toggleDropdownBtn">
                                            <i class="fa fa-caret-down"></i>
                                        </button>
                                    </div>
                                </div>

                                @* 3. CUSTOM MULTI-COLUMN DROPDOWN TABLE *@
                                <div id="multiColumnDropdown" class="dropdown-menu-custom shadow" style="display: none;">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 30%;">Spec/Grade</th>
                                                <th style="width: 30%;">Steel Grade</th>
                                                <th style="width: 10%;">L</th>
                                                <th style="width: 10%;">W</th>
                                                <th style="width: 20%;">Billet Length (m)</th>
                                            </tr>
                                        </thead>
                                        <tbody id="specGradeBody">
                                            @* DATA ROWS WILL BE POPULATED BY JAVASCRIPT *@
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            @* 4. ASSOCIATED FIELDS (Billet Length) *@
                            <div class="form-group col-md-3">
                                <label for="billetLength">Billet Length (m)</label>
                                <input type="text" id="billetLength" class="form-control" name="billetlength" value="@billet.BilletLength" readonly>
                            </div>
                            @* Add other associated fields here (L, W, Steel Grade) *@
                            <div class="form-group col-md-3">
                                <label for="crosssection">Cross Section (mm)</label>
                                <input type="text" id="crosssection" class="form-control" name="crosssection" value="@billet.CrossSection" readonly>
                            </div>
                            <div class="form-group col-md-3">
                                <label for="steelGrade">Grade</label>
                                <input type="text"
                                       id="steelGrade"
                                       class="form-control"
                                       name="SteelGrade"
                                       value="@(string.IsNullOrWhiteSpace(billet.SteelGrade) ? billet.Grade : billet.SteelGrade)"
                                       readonly>
                            </div>
                        </div>

                        <div class="form-row">

                            <div class="form-group col-md-3">
                                <label for="size">Size</label>
                                <select class="form-control" id="size" name="size">
                                    <option value="">Please Select</option>
                                    <option value="08mm" @(billet.Size == "08mm" ? "selected" : "")>08mm</option>
                                    <option value="10mm" @(billet.Size == "10mm" ? "selected" : "")>10mm</option>
                                    <option value="12mm" @(billet.Size == "12mm" ? "selected" : "")>12mm</option>
                                    <option value="14mm" @(billet.Size == "14mm" ? "selected" : "")>14mm</option>
                                    <option value="16mm" @(billet.Size == "16mm" ? "selected" : "")>16mm</option>
                                    <option value="18mm" @(billet.Size == "18mm" ? "selected" : "")>18mm</option>
                                    <option value="20mm" @(billet.Size == "20mm" ? "selected" : "")>20mm</option>
                                    <option value="22mm" @(billet.Size == "22mm" ? "selected" : "")>22mm</option>
                                    <option value="25mm" @(billet.Size == "25mm" ? "selected" : "")>25mm</option>
                                    <option value="28mm" @(billet.Size == "28mm" ? "selected" : "")>28mm</option>
                                    <option value="30mm" @(billet.Size == "30mm" ? "selected" : "")>30mm</option>
                                    <option value="32mm" @(billet.Size == "32mm" ? "selected" : "")>32mm</option>
                                    <option value="40mm" @(billet.Size == "40mm" ? "selected" : "")>40mm</option>
                                    <option value="09mm" @(billet.Size == "09mm" ? "selected" : "")>09mm</option>
                                    <option value="5.5mm" @(billet.Size == "5.5mm" ? "selected" : "")>5.5mm</option>
                                    <option value="6.5mm" @(billet.Size == "6.5mm" ? "selected" : "")>6.5mm</option>
                                    <option value="07mm" @(billet.Size == "07mm" ? "selected" : "")>07mm</option>
                                    <option value="11mm" @(billet.Size == "11mm" ? "selected" : "")>11mm</option>
                                    <option value="7.5mm" @(billet.Size == "7.5mm" ? "selected" : "")>7.5mm</option>
                                    <option value="36mm" @(billet.Size == "36mm" ? "selected" : "")>36mm</option>
                                </select>
                            </div>

                            <div class="form-group col-md-3">
                                <label for="profile">Profile</label>
                                <select class="form-control" id="profile" name="profile">
                                    <option value="">-- please select --</option>
                                    <option value="RB" @(billet.Profile == "RB" ? "selected" : "")>RB</option>
                                    <option value="WR" @(billet.Profile == "WR" ? "selected" : "")>WR</option>
                                    <option value="RC" @(billet.Profile == "RC" ? "selected" : "")>RC</option>
                                    <option value="PB" @(billet.Profile == "PB" ? "selected" : "")>PB</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6 dropdown-container">
                                <label for="productSpec">Remarks</label>
                                <textarea class="form-control" rows="2" name="Remarks">@billet.Remarks</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="chem-card m-b-30">

                    <div class="chem-card-header">
                        <div class="chem-title-wrap">
                            <span class="chem-title-icon">
                                <i class="fa fa-flask"></i>
                            </span>

                            <div>
                                <h5 class="chem-title">
                                    Chemical Analysis
                                </h5>

                                <div class="chem-subtitle">
                                    Enter heat-wise billet count and chemistry results.
                                </div>
                            </div>
                        </div>

                        <div class="chem-sequence-note">
                            Sequence:
                            C · Si · Mn · P · S · Cu · Ni · Cr · Mo · V · B · N · CE%
                        </div>
                    </div>

                    <div class="chem-table-wrap">
                        <table class="chem-table">
                            <thead>
                                <tr>
                                    <th style="width:52px;">Sr No</th>
                                    <th style="width:120px;">Heat #</th>
                                    <th style="width:90px;">No. Of Billet</th>

                                    <th>C</th>
                                    <th>Si</th>
                                    <th>Mn</th>
                                    <th>P</th>
                                    <th>S</th>
                                    <th>Cu</th>
                                    <th>Ni</th>
                                    <th>Cr</th>
                                    <th>Mo</th>
                                    <th>V</th>
                                    <th>B</th>
                                    <th>N</th>
                                    <th>CE%</th>

                                    <th style="width:125px;">Status</th>
                                    <th style="width:60px;">Action</th>
                                </tr>
                            </thead>

                            <tbody id="chemBody">
                                @if (chemistryRows.Count > 0)
                                {
                                    for (int i = 0; i < chemistryRows.Count; i++)
                                    {
                                        var chem = chemistryRows[i];
                                        string heatStatus = Convert.ToString(chem.HeatStatus);

                                        <tr>
                                            <td class="chem-srno chemistry-srno">
                                                @(i + 1)
                                            </td>

                                            <td>
                                                <input type="hidden"
                                                       class="chemistry-id"
                                                       name="Chemistry[@i].ID"
                                                       value="@chem.ID" />

                                                <input type="text"
                                                       class="form-control heat-input"
                                                       name="Chemistry[@i].HeatNo"
                                                       autocomplete="off"
                                                       value="@chem.HeatNo" />
                                            </td>

                                            <td>
                                                <input type="text"
                                                       class="form-control billet-input"
                                                       name="Chemistry[@i].NoOfBillets"
                                                       value="@chem.NoOfBillets" />
                                            </td>

                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].C" value="@chem.C" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Si" value="@chem.Si" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Mn" value="@chem.Mn" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].P" value="@chem.P" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].S" value="@chem.S" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Cu" value="@chem.Cu" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Ni" value="@chem.Ni" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Cr" value="@chem.Cr" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Mo" value="@chem.Mo" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].V" value="@chem.V" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].B" value="@chem.B" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].N" value="@chem.N" /></td>
                                            <td><input type="text" class="form-control chem-input" name="Chemistry[@i].Ceq" value="@chem.Ceq" /></td>

                                            <td>
                                                <select class="form-control status-select"
                                                        name="Chemistry[@i].HeatStatus">
                                                    <option value="">-- select --</option>
                                                    <option value="100" @(heatStatus == "100" || heatStatus == "Complete" ? "selected" : "")>Complete</option>
                                                    <option value="101" @(heatStatus == "101" || heatStatus == "Cancelled" ? "selected" : "")>Cancelled</option>
                                                    <option value="102" @(heatStatus == "102" || heatStatus == "Charging" ? "selected" : "")>Charging</option>
                                                    <option value="103" @(heatStatus == "103" || heatStatus == "In Process" || heatStatus == "In-Process" ? "selected" : "")>In Process</option>
                                                    <option value="104" @(heatStatus == "104" || heatStatus == "New" ? "selected" : "")>New</option>
                                                    <option value="105" @(heatStatus == "105" || heatStatus == "Rolled" ? "selected" : "")>Rolled</option>
                                                    <option value="106" @(heatStatus == "106" || heatStatus == "Rolling" ? "selected" : "")>Rolling</option>
                                                </select>
                                            </td>

                                            <td class="chem-action-cell">
                                                <button type="button"
                                                        class="chem-remove-btn removeRow"
                                                        title="Remove row">
                                                    ×
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="chem-footer">
                        <button type="button"
                                class="chem-add-btn"
                                id="addChemRow">
                            <i class="fa fa-plus"></i>
                            Add Row
                        </button>

                        <span class="chem-sequence-note">
                            Scroll horizontally to view all chemistry parameters.
                        </span>
                    </div>

                </div>
            </div>
        </div>

</div>

    </form>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    // Add mode mein hi current date set karo.
    // Edit mode mein DB wali date preserve hogi.
    const today = new Date().toISOString().split('T')[0];

    if (!document.getElementById("date").value) {
        document.getElementById("date").value = today;
    }

    // JAVASCRIPT FOR MULTI-COLUMN DROPDOWN
    $(document).ready(function () {

        const gradeDataJson = '@Html.Raw(ViewBag.GradeDataJson)';
        let gradeData = [];

        try {
            gradeData = JSON.parse(gradeDataJson);
        } catch (e) {
            console.error("Error parsing Grade Data JSON:", e);
            return;
        }

        const $specGradeBody = $('#specGradeBody');
        const $inputField = $('#productSpec');
        const $dropdownTable = $('#multiColumnDropdown');
        const $toggleBtn = $('#toggleDropdownBtn');
        const $hiddenIdField = $('#hiddenProductID');
        const $billetLengthField = $('#billetLength');
        const $crossSectionField = $('#crosssection');
        const $steelGradeField = $('#steelGrade');   // ✅ add this input in HTML

        // ----------------------------
        // POPULATE DROPDOWN TABLE
        // ----------------------------
        gradeData.forEach(item => {
            const row = `
                <tr
                    data-id="${item.ProductID}"
                    data-spec="${item.SpecGrade}"
                    data-grade="${item.SteelGrade}"
                    data-l="${item.Length}"
                    data-w="${item.Width}"
                    data-billet="${item.BilletLength}">
                    <td>${item.SpecGrade}</td>
                    <td>${item.SteelGrade}</td>
                    <td>${item.Length}</td>
                    <td>${item.Width}</td>
                    <td>${item.BilletLength}</td>
                </tr>`;
            $specGradeBody.append(row);
        });

        // ----------------------------
        // TOGGLE DROPDOWN
        // ----------------------------
        $toggleBtn.on('click', function () {
            $dropdownTable.toggle();
        });

        // ----------------------------
        // ROW CLICK EVENT
        // ----------------------------
        $specGradeBody.on('click', 'tr', function () {

            const $row = $(this);

            const selectedId = $row.data('id');
            const selectedSpec = $row.data('spec');
            const selectedGrade = $row.data('grade');
            const billetLength = $row.data('billet');

            const length = $row.data('l');
            const width = $row.data('w');
            const crossSectionValue = length + 'x' + width;

            // ✅ SET VALUES
            $inputField.val(selectedSpec);
            $hiddenIdField.val(selectedId);
            $billetLengthField.val(billetLength);
            $crossSectionField.val(crossSectionValue);
            $steelGradeField.val(selectedGrade);     // ✅ Fixed variable

            $dropdownTable.hide();
        });

        // ----------------------------
        // HIDE DROPDOWN IF CLICK OUTSIDE
        // ----------------------------
        $(document).on('click', function (e) {
            if (!$dropdownTable.is(e.target) &&
                $dropdownTable.has(e.target).length === 0 &&
                !$toggleBtn.is(e.target) &&
                !$inputField.is(e.target)) {
                $dropdownTable.hide();
            }
        });
    });
</script>

<script>
    $(document).ready(function () {

        let rowIndex =
            $('#chemBody tr').length;

        if (rowIndex === 0) {
            addChemRow();
        }

        $('#addChemRow').click(function () {
            addChemRow();
        });

        $('#chemBody').on('click', '.removeRow', function () {
            $(this).closest('tr').remove();
            reindexRows();
        });

        function addChemRow() {

            const row = `
                <tr>
                    <td class="chem-srno chemistry-srno">${rowIndex + 1}</td>

                    <td>
                        <input type="hidden"
                               class="chemistry-id"
                               name="Chemistry[${rowIndex}].ID"
                               value="0">

                        <input type="text"
                               class="form-control heat-input"
                               name="Chemistry[${rowIndex}].HeatNo"
                               autocomplete="off">
                    </td>

                    <td>
                        <input type="text"
                               class="form-control billet-input"
                               name="Chemistry[${rowIndex}].NoOfBillets">
                    </td>

                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].C"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Si"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Mn"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].P"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].S"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Cu"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Ni"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Cr"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Mo"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].V"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].B"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].N"></td>
                    <td><input type="text" class="form-control chem-input" name="Chemistry[${rowIndex}].Ceq"></td>

                    <td>
                        <select class="form-control status-select"
                                name="Chemistry[${rowIndex}].HeatStatus">
                            <option value="">-- select --</option>
                            <option value="100">Complete</option>
                            <option value="101">Cancelled</option>
                            <option value="102">Charging</option>
                            <option value="103">In Process</option>
                            <option value="104">New</option>
                            <option value="105">Rolled</option>
                            <option value="106">Rolling</option>
                        </select>
                    </td>

                    <td class="chem-action-cell">
                        <button type="button"
                                class="chem-remove-btn removeRow"
                                title="Remove row">
                            ×
                        </button>
                    </td>
                </tr>`;

            $('#chemBody').append(row);

            rowIndex++;

            reindexRows();
        }

        function reindexRows() {

            $('#chemBody tr').each(function (i) {

                $(this)
                    .find('.chemistry-srno')
                    .text(i + 1);

                $(this)
                    .find('input, select')
                    .each(function () {

                        var name =
                            $(this).attr('name');

                        if (!name) {
                            return;
                        }

                        name =
                            name.replace(
                                /Chemistry\[\d+\]/,
                                'Chemistry[' + i + ']'
                            );

                        $(this).attr(
                            'name',
                            name
                        );
                    });
            });

            rowIndex =
                $('#chemBody tr').length;
        }

    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
