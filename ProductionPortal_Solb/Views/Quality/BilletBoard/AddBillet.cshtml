                                        <button class="btn btn-outline-secondary" type="button" id="toggleDropdownBtn">
                                            <i class="fa fa-caret-down"></i>
                                        </button>
                                    </div>
                                </div>

                                @* 3. CUSTOM MULTI-COLUMN DROPDOWN TABLE *@
                                <div id="multiColumnDropdown" class="dropdown-menu-custom shadow" style="display: none;">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th style="width: 30%;">Spec/Grade</th>
                                                <th style="width: 30%;">Steel Grade</th>
                                                <th style="width: 10%;">L</th>
                                                <th style="width: 10%;">W</th>
                                                <th style="width: 20%;">Billet Length (m)</th>
                                            </tr>
