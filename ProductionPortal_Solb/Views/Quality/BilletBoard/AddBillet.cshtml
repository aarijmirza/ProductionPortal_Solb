@model DAL.Models.BilletBoardBLL
@{
    ViewBag.Title =
        Model != null && Model.ID > 0
            ? "Edit Billet"
            : "Add Billet";

    var billet =
        Model ?? new DAL.Models.BilletBoardBLL();

    var chemistryRows =
        billet.Chemistry ??
        new List<DAL.Models.RMChemicalAnalysisBLL>();
}

<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Billet Board</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index" ,"Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Billet Board</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@(billet.ID > 0 ? "Edit Billet Boarding" : "Add Billet Boarding")</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<style>
    .dropdown-container {
        position: relative;
    }

    .dropdown-menu-custom {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        width: 100%;
        max-width: 500px;
        /* 💥 INCREASE THIS VALUE 💥 */
        max-height: 250px; /* Increased height */
        overflow-y: auto; /* Keep scrollbar */
        border: 1px solid #ccc;
        background-color: white;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
        font-size: 12px;
    }

        .dropdown-menu-custom table {
            table-layout: fixed; /* Ensures fixed column widths */
        }

        .dropdown-menu-custom tbody tr {
            cursor: pointer;
        }

            .dropdown-menu-custom tbody tr:hover {
                background-color: #f5f5f5;
            }
            /* Style for selected row, if needed */
            .dropdown-menu-custom tbody tr.selected {
                background-color: #007bff;
                color: white;
            }

        /* Ensures headers are bold */
        .dropdown-menu-custom th {
            font-weight: bold;
            /* Add a border to the right of the header cells for alignment */
            border-right: 1px solid #ccc;
        }

            /* Remove the border from the last header cell */
            .dropdown-menu-custom th:last-child {
                border-right: none;
            }

        /* 💥 VERTICAL AND HORIZONTAL SEPARATORS 💥 */
        .dropdown-menu-custom td {
            /* Horizontal Separator (bottom) */
            border-bottom: 1px solid #ddd;
            /* Vertical Separator (right) */
            border-right: 1px solid #ccc; /* Light vertical line between columns */
        }

            /* Ensure the last column (last td in each row) does not have a right border */
            .dropdown-menu-custom td:last-child {
                border-right: none;
            }

        /* Ensure the last row doesn't have a bottom border, keeping it clean */
        .dropdown-menu-custom tr:last-child td {
            border-bottom: none;
        }
    /* ... (Keep existing hover styles) ... */
</style>

<div class="xp-contentbar">
    <form action="@Url.Action("Save", "BilletBoard")" id="addprofileform" method="post" enctype="multipart/form-data">
        <input type="hidden"
               id="ID"
               name="ID"
               value="@billet.ID" />
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-12">
