                                    <option value="18mm" @(billet.Size == "18mm" ? "selected" : "")>18mm</option>
                                    <option value="20mm" @(billet.Size == "20mm" ? "selected" : "")>20mm</option>
                                    <option value="22mm" @(billet.Size == "22mm" ? "selected" : "")>22mm</option>
                                    <option value="25mm" @(billet.Size == "25mm" ? "selected" : "")>25mm</option>
                                    <option value="28mm" @(billet.Size == "28mm" ? "selected" : "")>28mm</option>
                                    <option value="30mm" @(billet.Size == "30mm" ? "selected" : "")>30mm</option>
                                    <option value="32mm" @(billet.Size == "32mm" ? "selected" : "")>32mm</option>
                                    <option value="40mm" @(billet.Size == "40mm" ? "selected" : "")>40mm</option>
                                    <option value="09mm" @(billet.Size == "09mm" ? "selected" : "")>09mm</option>
                                    <option value="5.5mm" @(billet.Size == "5.5mm" ? "selected" : "")>5.5mm</option>
                                    <option value="6.5mm" @(billet.Size == "6.5mm" ? "selected" : "")>6.5mm</option>
                                    <option value="07mm" @(billet.Size == "07mm" ? "selected" : "")>07mm</option>
                                    <option value="11mm" @(billet.Size == "11mm" ? "selected" : "")>11mm</option>
                                    <option value="7.5mm" @(billet.Size == "7.5mm" ? "selected" : "")>7.5mm</option>
                                    <option value="36mm" @(billet.Size == "36mm" ? "selected" : "")>36mm</option>
                                </select>
                            </div>

                            <div class="form-group col-md-3">
                                <label for="profile">Profile</label>
                                <select class="form-control" id="profile" name="profile">
                                    <option value="">-- please select --</option>
                                    <option value="RB" @(billet.Profile == "RB" ? "selected" : "")>RB</option>
                                    <option value="WR" @(billet.Profile == "WR" ? "selected" : "")>WR</option>
                                    <option value="RC" @(billet.Profile == "RC" ? "selected" : "")>RC</option>
                                    <option value="PB" @(billet.Profile == "PB" ? "selected" : "")>PB</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6 dropdown-container">
                                <label for="productSpec">Remarks</label>
                                <textarea class="form-control" rows="2" name="Remarks">@billet.Remarks</textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white">
                        <h5 class="card-title text-black">Chemical Analysis</h5>
                    </div>
                    <div class="card-body">

                        <div class="table-responsive m-b-30">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col">Heat #</th>
                                        <th scope="col">No. Of Billet</th>
                                        <th scope="col">C</th>
