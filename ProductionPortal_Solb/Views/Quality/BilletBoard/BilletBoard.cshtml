@model List<DAL.Models.BilletBoardBLL>
@using System.Globalization
@{
    ViewBag.Title = "list";
    var billets = Model ?? new List<DAL.Models.BilletBoardBLL>();
    string selectedFromDate = Convert.ToString(ViewBag.FromDate ?? "");
    string selectedToDate = Convert.ToString(ViewBag.ToDate ?? "");
    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Billet Board</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index" ,"Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Billet Board</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Records</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
@if (User.IsInRole("Administrator") || User.IsInRole("QC User"))
{
    <div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
        <div class="row">
            <div class="col-lg-12">
                <div class="card mb-3">
                    <div class="card-body">
                        <form id="filterForm" method="get" action="@Url.Action("BilletBoard", "Quality")" class="d-flex justify-content-between">

                            <div class="d-flex">
                                <div class="form-group mr-3">
                                    <label for="fromDate" class="mr-2">From</label>
                                    <input type="date" id="fromDate" name="fromDate" value="@selectedFromDate" class="form-control" />
                                </div>

                                <div class="form-group mr-3">
                                    <label for="toDate" class="mr-2">To</label>
                                    <input type="date" id="toDate" name="toDate" value="@selectedToDate" class="form-control" />
                                </div>

                                <div class="form-group d-flex align-items-end mr-3">
                                    <button type="submit" id="filterBtn" class="btn btn-primary mr-2">Filter</button>
                                    <a href="@Url.Action("BilletBoard", "Quality")" id="clearBtn" class="btn btn-secondary">Clear</a>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <div class="form-group d-flex align-items-end mr-3">
                                    <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("AddBillet", "Quality")">
                                        <i class="fa fa-plus-circle"></i> Add Billet
                                    </a>
                                </div>
                                <div class="form-group d-flex align-items-end">
                                    @*<button type="button" id="exportExcel" class="btn btn-success mr-2">
                                            <i class="fa fa-file-excel-o"></i> Export Excel
                                        </button>*@
                                    <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                        <i class="fa fa-file-pdf-o"></i> Export PDF
                                    </button>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <!-- Start XP Row -->
    <div class="row">
        <!-- Start XP Col -->
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="xp-default-datatable" class="display table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    @*<th>Heat#</th>*@
                                    <th>Billet Boarding #</th>
                                    <th>Plant</th>
                                    <th>Shift</th>
                                    <th>Product Spec/Grade</th>
                                    <th>Billet Length</th>
                                    <th>Size</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in billets)
                                {
                                    <tr>
                                        <td>@(item.Date?.ToString("yyyy-MM-dd", gregorian))</td>
                                        @*<td>@item.HeatNo</td>*@
                                        <td>@item.BilletBoarding</td>
                                        <td>@item.PlantName</td>
                                        <td>@item.Shift</td>
                                        <td>@item.ProductSpecs</td>
                                        <td>@item.BilletLength</td>
                                        <td>@item.Size</td>
                                        <td>
                                            <a href="@Url.Action("Boardingdetails", "Quality", new { ID = item.ID })"
                                               class="btn btn-sm btn-info"
                                               onclick="event.stopPropagation();">
                                                <i class="mdi mdi-book-open-page-variant"></i> Detail
                                            </a>

                                            @if (User.IsInRole("Administrator") || User.IsInRole("QC User"))
                                            {
                                                <a href="@Url.Action("AddBillet", "Quality", new { id = item.ID })"
                                                   class="btn btn-sm btn-warning"
                                                   onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-pencil"></i> Edit
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- End XP Col -->
    </div>
    <!-- End XP Row -->
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        var msg = '@TempData["SuccessMessage"]';
        var errorMsg = '@TempData["ErrorMessage"]';

        if (msg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: msg,
                confirmButtonColor: '#3085d6'
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMsg,
                confirmButtonColor: '#d33'
            });
        }
    });

    function confirmDelete(heatNo) {

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                // Redirect to delete action
                window.location.href = '/CCM/delete?heatNo=' + heatNo;
            }
        });
    }
</script>