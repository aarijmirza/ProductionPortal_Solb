<style>
    body {
        background: #e9ecef;
        font-size: 12px;
    }

    .panel {
        background: #f5f5f5;
        border: 1px solid #ccc;
        padding: 10px;
    }

    .grid-box {
        background: #dbe5f1;
        height: 500px;
        overflow-y: auto;
        border: 1px solid #999;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

        table th {
            background: #efefef;
            border: 1px solid #999;
            padding: 5px;
        }

        table td {
            border: 1px solid #ccc;
            padding: 4px;
        }

    .arrow-btn {
        margin: 10px 0;
        width: 35px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }
</style>

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Quality Control</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Quality Control</a></li>
                    <li class="breadcrumb-item active" aria-current="page">CAST / Mill Certificate</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->


<div class="xp-contentbar">

    <div class="row">

        <!-- 🔥 TABS -->
        <div class="col-md-12">
            <ul class="nav nav-tabs mb-3" id="mtcTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#generateMTC">Generate MTC</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#generatedMTC">MTC Generated By Dispatch Team</a>
                </li>
            </ul>
        </div>

        <div class="tab-content col-md-12">

            <!-- 🔥 TAB 1 -->
            <div class="tab-pane fade show active" id="generateMTC">

                <!-- 🔥 TOP BAR -->
                <div class="row mb-2">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body d-flex justify-content-between align-items-center">

                                <!-- SEARCH -->
                                <div class="d-flex align-items-center">
                                    <label class="mr-2 mb-0"><b>Search Heat ID:</b></label>

                                    <input type="text" id="searchHeat"
                                           class="form-control form-control-sm mr-2"
                                           style="width:180px;" placeholder="Enter Heat No" />

                                    <button class="btn btn-sm btn-primary">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>

                                <!-- BUTTONS -->
                                <div>
                                    <button class="btn btn-success btn-sm mr-1">
                                        Generate
                                    </button>
                                    <button class="btn btn-dark btn-sm">
                                        Print
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- 🔥 MAIN CONTENT -->
                <div class="row">

                    <!-- LEFT TABLE -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body" style="height:500px; overflow-y:auto;">

                                <table class="table table-bordered table-sm text-center">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th>Heat No</th>
                                            <th>Steel Grade</th>
                                            <th>Bar Size</th>
                                            <th>No.Of Bundles</th>
                                            <th>Wire Rod?</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* DATA *@
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">

                                <!-- FORM -->
                                <div class="form-row">

                                    <div class="form-group col-md-6">
                                        <label>Customer Name</label>
                                        <input type="text" id="customerName" class="form-control" />
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label>D.N. No.</label>
                                        <input type="text" id="dnNo" class="form-control" />
                                    </div>

                                </div>

                                <div class="form-group">
                                    <label>Shipping Address</label>
                                    <input type="text" id="address" class="form-control" />
                                </div>

                                <div class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" id="wireRodMtc">
                                    <label class="form-check-label" for="wireRodMtc">Wire Rod MTC</label>
                                </div>

                                <!-- RIGHT TABLE -->
                                <div style="height:300px; overflow-y:auto;">
                                    <table class="table table-bordered table-sm text-center">
                                        <thead class="bg-primary">
                                            <tr>
                                                <th>Heat No</th>
                                                <th>Steel Grade</th>
                                                <th>Bar Size</th>
                                                <th>No.Of Bundles</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <!-- 🔥 TAB 2 -->
            <div class="tab-pane fade" id="generatedMTC">
                <div class="card">
                    <div class="card-body text-center">
                        Coming Soon...
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>