@using System.Globalization
@model IEnumerable<DAL.Models.LaddleFurnaceBLL>
@{
    ViewBag.Title = "list";

    var lfList =
        Model != null
            ? Model.ToList()
            : new List<DAL.Models.LaddleFurnaceBLL>();

    string fromDateValue =
        Convert.ToString(ViewBag.FromDate);

    string toDateValue =
        Convert.ToString(ViewBag.ToDate);
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Laddle Furnace</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Laddle Furnace</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Records</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm"
                          method="get"
                          action="@Url.Action("LFlist", "Meltshop")">

                        <div class="row align-items-end">

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="fromDate">From Date</label>
                                    <input type="date"
                                           id="fromDate"
                                           name="fromDate"
                                           class="form-control"
                                           value="@fromDateValue" />
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label for="toDate">To Date</label>
                                    <input type="date"
                                           id="toDate"
                                           name="toDate"
                                           class="form-control"
                                           value="@toDateValue" />
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <button type="submit"
                                            class="btn btn-primary mr-2">
                                        <i class="fa fa-filter"></i>
                                        Filter
                                    </button>

                                    <a href="@Url.Action("LFlist", "Meltshop")"
                                       class="btn btn-secondary">
                                        <i class="fa fa-times"></i>
                                        Clear
                                    </a>
                                </div>
                            </div>

                            <div class="col-md-3 text-right">
                                <div class="form-group">
                                    <a id="addSampleBtn"
                                       class="btn btn-info text-white"
                                       href="@Url.Action("LFadd", "Meltshop")">
                                        <i class="fa fa-plus-circle"></i>
                                        Add Record
                                    </a>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <!-- Start XP Row -->
    <div class="row">
        <!-- End XP Col -->
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="xp-default-datatable" class="display table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Heat #</th>
                                    <th>Grade</th>
                                    <th>Total Alloy</th>
                                    <th>KWH (per Ton)</th>
                                    <th>Argon (Nm³)</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in lfList)
                                {
                                    var gregorian = new CultureInfo("en-US");
                                    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
                                    <tr>
                                        <td data-order="@(item.Date.HasValue ? item.Date.Value.ToString("yyyy-MM-dd") : "")">
                                            @(item.Date.HasValue
                                                ? item.Date.Value.ToString("dd-MM-yyyy", gregorian)
                                                : "")
                                        </td>
                                        <td>@item.HeatNo</td>
                                        <td>@item.Grade</td>
                                        <td>@item.TotalAlloys</td>
                                        <td>@item.KWH</td>
                                        <td>@item.Argon</td>
                                        <td>
                                            <a href="@Url.Action("LFdetails", "Meltshop", new { heatNo = item.HeatNo })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                <i class="mdi mdi-book-open-page-variant"></i>
                                            </a>

                                            <a href="javascript:void(0);"
                                               onclick="confirmDelete('@item.HeatNo')"
                                               class="btn btn-sm btn-danger">
                                                <i class="mdi mdi-trash-can"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- End XP Col -->
        <!-- Start XP Col -->
    </div>
    <!-- End XP Row -->
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        var tableSelector =
            "#xp-default-datatable";

        if (
            $.fn.DataTable.isDataTable(
                tableSelector
            )
        ) {
            $(tableSelector)
                .DataTable()
                .destroy();
        }

        $(tableSelector).DataTable({
            pageLength: 10,
            lengthMenu: [
                [10, 25, 50, 100, -1],
                [10, 25, 50, 100, "All"]
            ],
            ordering: true,
            searching: true,
            responsive: true,
            autoWidth: false,
            order: [[0, "desc"]]
        });
    });
</script>