                            <div class="form-group col-md-2">
                                <label for="heatno">Heat #</label>
                                <input type="text" class="form-control" id="heatno" name="heatno" placeholder="Heat #">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Group</label>
                                <select class="form-control" name="Group">
                                    <option selected disabled>-- please select --</option>
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                </select>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="heatno">Shift</label>
                                <select class="form-control" name="Shift">
                                    <option selected disabled>-- please select --</option>
                                    <option value="Morning">Morning</option>
                                    <option value="Evening">Evening</option>
                                    <option value="Night">Night</option>
                                </select>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Grade</label>
                                <input type="text" class="form-control" id="date" name="Grade" placeholder="Grade">
                            </div>
                            @*<div class="form-group col-md-2">
                                <label for="heatno">Heat #</label>
                                <input type="text" class="form-control" id="heatno" name="heatno" placeholder="Heat #">
                            </div>*@
                        </div>
                    </div>
                    <div class="card-header bg-white">
                        <h5 class="card-title text-black">METTALIC CHARGE</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-2">
