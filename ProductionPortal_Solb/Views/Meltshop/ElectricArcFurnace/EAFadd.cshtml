                                <input type="number" step="0.001" class="form-control" id="date" name="Coke" placeholder="Coke">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Magnisia</label>
                                <input type="number" step="0.001" class="form-control" id="date" name="Magnisia" placeholder="Magnisia">
                            </div>
                            <div class="form-group col-md-2">
