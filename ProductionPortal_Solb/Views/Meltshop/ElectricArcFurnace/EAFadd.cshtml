                            </div>
                            <div class="form-group col-md-2">
                                <label for="heatno">DRI (Ton)</label>
                                <input type="number" step="0.001" class="form-control" id="DRI" name="DRI" placeholder="DRI (Ton)">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">OLD HBI / DRI (Ton)</label>
                                <input type="number" step="0.001" class="form-control" id="oldHBI" name="OldHBIDRI" placeholder="OLD HBI / DRI">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">HBI (Ton)</label>
                                <input type="number" step="0.001" class="form-control" id="HBI" name="HBI" placeholder="HBI (Ton)">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-2">
