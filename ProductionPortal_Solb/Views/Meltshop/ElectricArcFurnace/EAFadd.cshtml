    <!-- End XP Row -->
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    $("input[type='number']").attr("step", "any");

    const today = new Date().toISOString().split('T')[0];
    document.getElementById("date").value = today;
</script>
<script>
    function toNum(val) {
        return parseFloat(val) || 0;
    }

    function calcAll() {

        // --- Total Alloys ---
        let FeMn = toNum($("#FeMn").val());
        let FeSi = toNum($("#FeSi").val());
        let SiMn = toNum($("#SiMn").val());
        $("#TotalAlloys").val((FeMn + FeSi + SiMn).toFixed(2));

        // --- Total Dry Charge ---
        let scrap = toNum($("#scrap").val());
        let DRI = toNum($("#DRI").val());
        let oldHBI = toNum($("#oldHBI").val());
        let HBI = toNum($("#HBI").val());
        $("#totalcharge").val((scrap + DRI + oldHBI + HBI).toFixed(2));

        // --- Total Dry Charge ---
        let totalcharge = toNum($("#totalcharge").val());
        let liquidsteel = toNum($("#liquidsteel").val());
        $("#yeild").val((liquidsteel / totalcharge * 100).toFixed(2));

        // --- Lime ---
        let Lime3 = toNum($("#Lime312mm").val());
        let Lime5 = toNum($("#Lime550mm").val());
        $("#Lime").val((Lime3 + Lime5).toFixed(2));

        // --- Total Delay ---
        let eff = toNum($("#EffectiveDelay").val());
        let un = toNum($("#UnscheduleDelay").val());
        $("#TotalDelay").val((eff + un).toFixed(2));
    }

    // Trigger auto calculation on keyup
    $("input").on("keyup change", function () {
        calcAll();
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>
