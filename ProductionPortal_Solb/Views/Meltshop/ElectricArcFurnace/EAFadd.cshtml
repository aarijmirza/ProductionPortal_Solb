                    </div>
                    <div class="card-header bg-white">
                        <h5 class="card-title text-black">ADDITIVES</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label for="date">Carbon (kg)</label>
