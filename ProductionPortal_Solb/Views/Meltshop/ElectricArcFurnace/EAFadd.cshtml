                    <li class="breadcrumb-item"><a href="#">Electric Arc Furnace</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Heat Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <!-- Start XP Row -->
    <form action="/Meltshop/EAFadd" id="addprofileform" method="post" enctype="multipart/form-data">
