                                <input type="number" step="0.001" class="form-control" id="date" name="AluminumLamps" placeholder="Aluminum Lamps">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Lime (3~12mm) (kg)</label>
                                <input type="number" step="0.001" class="form-control" id="Lime312mm" name="Lime312mm" placeholder="Lime (3~12mm) (kg)">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Lime (5~50mm) (kg)</label>
                                <input type="number" step="0.001" class="form-control" id="Lime550mm" name="Lime550mm" placeholder="Lime (5~50mm) (kg)">
