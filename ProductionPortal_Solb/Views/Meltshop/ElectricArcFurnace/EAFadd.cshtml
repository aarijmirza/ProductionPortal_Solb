                                <label for="date">Dumped</label>
                                <input type="number" step="0.001" class="form-control" id="date" name="Dumped" placeholder="Dumped">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="date">Lime (kg)</label>
                                <input type="number" step="0.001" class="form-control" name="Lime" placeholder="Lime (kg)">
                            </div>
                            <div class="form-group col-md-2">
