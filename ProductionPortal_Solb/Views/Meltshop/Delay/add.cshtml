@model DAL.Models.DelaysVM
@using System.Linq
@{
    ViewBag.Title = "add";
}

<style>
    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--single {
            height: 36px !important;
            border: 1px solid #e8edf3 !important;
            border-radius: 5px !important;
            background-color: #f3f5f8 !important;
            display: flex !important;
            align-items: center !important;
        }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #8798ad !important;
        font-size: 15px !important;
        line-height: 36px !important;
        padding-left: 12px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
        right: 8px !important;
    }
</style>

@*Start XP Breadcrumbbar*@
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record Form</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delay</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
@*End XP Breadcrumbbar*@

<div class="xp-contentbar">
    <form action="/delay/SMPadd" id="addprofileform" method="post">

        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label>Date</label>
                                <input type="date" class="form-control" id="date" name="Date">
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Plant</label>
                                @Html.DropDownListFor(m => m.Plant, new List<SelectListItem>
                                                                        {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Electric Arc Furnace (EAF)", Value = "EAF" },
                                    new SelectListItem { Text = "Laddle Furnace (LF)", Value = "LF" },
                                    new SelectListItem { Text = "Continous Casting Machine (CCM)", Value = "CCM" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Shift</label>
                                @Html.DropDownListFor(m => m.Shift, new List<SelectListItem>
                                                                        {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Morning", Value = "Morning" },
                                    new SelectListItem { Text = "Afternoon", Value = "Afternoon" },
                                    new SelectListItem { Text = "Night", Value = "Night" },
                                    new SelectListItem { Text = "Long Morning", Value = "Long Morning" },
                                    new SelectListItem { Text = "Long Night", Value = "Long Night" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Team</label>
                                @Html.DropDownListFor(m => m.Team, new List<SelectListItem>
                                                                        {
                                    new SelectListItem { Text = "-- please select --", Value = "" },
                                    new SelectListItem { Text = "Team A", Value = "Team A" },
                                    new SelectListItem { Text = "Team B", Value = "Team B" },
                                    new SelectListItem { Text = "Team C", Value = "Team C" }
                                }, new { @class = "form-control" })
                            </div>
                            <div class="form-group col-md-3">
                                <label for="date">Shift Incharge</label>
                                @Html.DropDownListFor(
                                              m => m.ShiftIncharge,
                                              new List<SelectListItem>
                                              {
                                        new SelectListItem { Text = "-- please select --", Value = "" },
                                        new SelectListItem { Text = "Syed Ali", Value = "Syed Ali" },
                                        new SelectListItem { Text = "Mamdoh Saleem", Value = "Mamdoh Saleem" },
                                        new SelectListItem { Text = "Sooban Wahidi", Value = "Sooban Wahidi" },
                                        new SelectListItem { Text = "Saad Saady", Value = "Saad Saady" },
                                        new SelectListItem { Text = "Ekrami Al Baraka", Value = "Ekrami Al Baraka" },
                                        new SelectListItem { Text = "Emad Abdul Maqsood", Value = "Emad Abdul Maqsood" },
                                        new SelectListItem { Text = "Heny Munir", Value = "Heny Munir" }
      },
                                              new
                                              {
                                                  @class = "form-control"
                                              }
                                          )
                            </div>
                            <div class="form-group col-md-3">
                                <label>Break Out</label>
                                <input type="text" class="form-control" name="HotOut" value="0" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Agency</label>
                                <select id="AgencyDropdown" name="AgencyName" class="form-control">
                                    <option value="">-- Select Agency --</option>
                                    @foreach (var a in (IEnumerable<DAL.Models.PlantDelayBLL>)ViewBag.Agencies)
                                    {
                                        <option value="@a.AgencyCode"
                                                data-department="@a.Area"
                                                data-delaytype="@a.DelayType">
                                            @a.AgencyName
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-1">
                                <label>Code</label>
                                <input type="text" id="AgencyCodeInput" class="form-control" name="AgencyCode" readonly />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Start Time</label>
                                <input type="time" class="form-control" name="StartTime" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>End Time</label>
                                <input type="time" class="form-control" name="EndTime" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Area</label>
                                <select class="form-control"
                                        name="Area"
                                        id="ddlArea">

                                    <option value="">
                                        -- please select --
                                    </option>

                                    <option value="2">EAF</option>
                                    <option value="3">LF</option>
                                    <option value="4">CCM</option>
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label>Equipment</label>
                                <select id="ddlEquipments"
                                        name="Equipments"
                                        class="form-control select2"
                                        disabled>

                                    <option value="">
                                        -- Select Equipment --
                                    </option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Component Failed</label>
                                <input type="text" class="form-control" name="Components" />

                                @*@Html.DropDownListFor(model => model.Components,
                                    ViewBag.Component as SelectList,
                                    "-- Select Components --",
                                    new { @class = "form-control select2", id = "ddlComponents", @disabled = "disabled" })*@
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Reason</label>
                                <textarea class="form-control" rows="1" name="Reason"></textarea>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Delay Description</label>
                                <textarea class="form-control" rows="1" name="DelayDescription"></textarea>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Reason For Occurence</label>
                                <textarea class="form-control" rows="3" name="ReasonForOccurence"></textarea>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Action Taken</label>
                                <textarea class="form-control" rows="3" name="ActionTaken"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>

@*SCRIPTS*@
<!-- 1️⃣ jQuery (ONLY ONE, no duplicates) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function () {

        // Set current date
        if (!$("#date").val()) {
            var today =
                new Date()
                    .toISOString()
                    .split("T")[0];

            $("#date").val(today);
        }

        // Initialize Equipment Select2
        $("#ddlEquipments").select2({
            placeholder:
                "-- Select Equipment --",

            allowClear:
                true,

            width:
                "100%"
        });

        // Area change → load Equipment
        $("#ddlArea").on(
            "change",
            function () {

                var areaId =
                    $(this).val();

                var equipmentDropdown =
                    $("#ddlEquipments");

                equipmentDropdown
                    .empty()
                    .append(
                        new Option(
                            "-- Select Equipment --",
                            "",
                            true,
                            true
                        )
                    )
                    .prop(
                        "disabled",
                        true
                    )
                    .trigger(
                        "change"
                    );

                if (!areaId) {
                    return;
                }

                $.ajax({
                    url:
                        '@Url.Action(
                            "GetEquipmentByArea",
                            "Delay"
                        )',

                    type:
                        "GET",

                    data:
                    {
                        areaId:
                            areaId
                    },

                    cache:
                        false,

                    success:
                        function (response) {

                            var items =
                                response &&
                                response.data
                                    ? response.data
                                    : response;

                            equipmentDropdown
                                .empty()
                                .append(
                                    new Option(
                                        "-- Select Equipment --",
                                        "",
                                        true,
                                        true
                                    )
                                );

                            if (
                                items &&
                                items.length > 0
                            ) {
                                $.each(
                                    items,
                                    function (
                                        index,
                                        item
                                    ) {

                                        var text =
                                            item.Text ||
                                            item.text ||
                                            item.Description ||
                                            "";

                                        var value =
                                            item.Value ||
                                            item.value ||
                                            item.Code ||
                                            text;

                                        equipmentDropdown.append(
                                            new Option(
                                                text,
                                                value,
                                                false,
                                                false
                                            )
                                        );
                                    }
                                );
                            }

                            equipmentDropdown
                                .prop(
                                    "disabled",
                                    false
                                )
                                .trigger(
                                    "change"
                                );
                        },

                    error:
                        function (xhr) {

                            equipmentDropdown
                                .prop(
                                    "disabled",
                                    true
                                )
                                .trigger(
                                    "change"
                                );

                            var errorMessage =
                                "Unable to load equipment.";

                            if (
                                xhr.responseJSON &&
                                xhr.responseJSON.message
                            ) {
                                errorMessage =
                                    xhr.responseJSON.message;
                            }

                            Swal.fire({
                                icon:
                                    "error",

                                title:
                                    "Error",

                                text:
                                    errorMessage
                            });
                        }
                });
            }
        );

        // Agency select → set Agency Code
        $("#AgencyDropdown").on(
            "change",
            function () {

                $("#AgencyCodeInput").val(
                    $(this).val() || ""
                );
            }
        );

        let isSubmitting =
            false;

        $("#addprofileform").on(
            "submit",
            function (e) {

                e.preventDefault();

                if (isSubmitting) {
                    return;
                }

                Swal.fire({
                    title:
                        "Confirm Submission",

                    text:
                        "Are you sure you want to submit this delay record?",

                    icon:
                        "warning",

                    showCancelButton:
                        true,

                    confirmButtonText:
                        "Yes, Submit",

                    cancelButtonText:
                        "Cancel",

                    allowOutsideClick:
                        false,

                    allowEscapeKey:
                        false
                })
                .then(
                    function (result) {

                        if (!result.isConfirmed) {
                            return;
                        }

                        isSubmitting =
                            true;

                        $("#addprofileform")
                            .find(
                                "button[type='submit']"
                            )
                            .prop(
                                "disabled",
                                true
                            )
                            .text(
                                "Submitting..."
                            );

                        $("#addprofileform")[0]
                            .submit();
                    }
                );
            }
        );

    });
</script>
