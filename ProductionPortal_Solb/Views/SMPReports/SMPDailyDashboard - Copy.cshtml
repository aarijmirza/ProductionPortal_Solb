@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --brand: #8b1029;
        --brand-dark: #52000f;
        --brand-soft: #f8e8ed;
        --bg: #f2f4f7;
        --panel: #ffffff;
        --panel-dark: #151923;
        --border: #dde3eb;
        --text: #1f2937;
        --muted: #667085;
        --green: #13895a;
        --amber: #d89000;
        --blue: #1d65a6;
        --red: #c1121f;
        --gray: #98a2b3;
        --shadow: 0 10px 26px rgba(15, 23, 42, .07);
        --radius: 16px;
    }

    body {
        background: var(--bg);
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .xp-contentbar {
        background: var(--bg) !important;
        padding: 22px !important;
    }

    .smp-board {
        max-width: 1500px;
        margin: 0 auto;
        color: var(--text);
    }

    /* ================= HEADER ================= */

    .board-header {
        background: linear-gradient(135deg, #151923 0%, #2b1119 55%, #8b1029 100%);
        border-radius: 18px;
        padding: 22px 24px;
        color: #fff;
        box-shadow: var(--shadow);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 20px;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .board-header:after {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
            right: -90px;
            top: -120px;
        }

    .header-left {
        position: relative;
        z-index: 2;
    }

    .plant-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 11px;
    }

    .board-header h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 900;
        letter-spacing: .2px;
    }

    .board-header p {
        margin: 7px 0 0;
        font-size: 13px;
        color: rgba(255,255,255,.86);
        font-weight: 600;
    }

    .header-meta {
        position: relative;
        z-index: 2;
        text-align: right;
        display: grid;
        gap: 8px;
    }

    .meta-card {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 14px;
        padding: 10px 14px;
        min-width: 185px;
    }

    .meta-label {
        font-size: 11px;
        color: rgba(255,255,255,.72);
        font-weight: 700;
        text-transform: uppercase;
    }

    .meta-value {
        margin-top: 3px;
        font-size: 16px;
        font-weight: 900;
        color: #fff;
    }

    /* ================= EXEC SUMMARY ================= */

    .exec-strip {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-top: 14px;
    }

    .exec-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 15px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .exec-title {
        color: var(--muted);
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .45px;
    }

    .exec-value {
        color: var(--text);
        font-size: 23px;
        font-weight: 900;
        margin-top: 4px;
        line-height: 1;
    }

    .exec-sub {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        margin-top: 5px;
    }

    .exec-icon {
        width: 45px;
        height: 45px;
        border-radius: 14px;
        background: var(--brand-soft);
        color: var(--brand);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .exec-card.good .exec-icon {
        background: #e8f5ef;
        color: var(--green);
    }

    .exec-card.warn .exec-icon {
        background: #fff4dc;
        color: var(--amber);
    }

    /* ================= KPI ================= */

    .kpi-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 12px;
    }

    .kpi-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px;
        min-height: 128px;
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

        .kpi-card:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 4px;
            width: 100%;
            background: var(--gray);
        }

        .kpi-card.good:before {
            background: var(--green);
        }

        .kpi-card.warn:before {
            background: var(--amber);
        }

        .kpi-card.bad:before {
            background: var(--brand);
        }

    .kpi-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }

    .kpi-name {
        font-size: 11px;
        font-weight: 900;
        color: var(--muted);
        text-transform: uppercase;
        line-height: 1.25;
    }

    .kpi-badge {
        width: 28px;
        height: 28px;
        border-radius: 10px;
        background: #f4f6f8;
        color: var(--brand);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .kpi-value {
        margin-top: 12px;
        font-size: 24px;
        line-height: 1;
        font-weight: 900;
        color: var(--text);
    }

    .kpi-target {
        margin-top: 6px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
    }

    .kpi-track {
        margin-top: 11px;
        height: 6px;
        border-radius: 999px;
        background: #edf0f4;
        overflow: hidden;
    }

    .kpi-fill {
        height: 100%;
        background: var(--brand);
        border-radius: 999px;
        display: block;
    }

    .kpi-card.good .kpi-fill {
        background: var(--green);
    }

    .kpi-card.warn .kpi-fill {
        background: var(--amber);
    }

    /* ================= MAIN GRID ================= */

    .main-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1.05fr 1.05fr 360px;
        gap: 14px;
        align-items: start;
    }

    .column {
        display: grid;
        gap: 14px;
    }

    .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 16px;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 11px;
        border-bottom: 1px solid var(--border);
    }

    .panel-title {
        margin: 0;
        font-size: 16px;
        font-weight: 900;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .panel-title i {
            color: var(--brand);
            font-size: 15px;
        }

    .panel-note {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .chart-box {
        height: 260px;
        position: relative;
    }

        .chart-box.small {
            height: 235px;
        }

    /* ================= VARIANCE TABLE ================= */

    .variance-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid var(--border);
        border-radius: 13px;
        overflow: hidden;
    }

        .variance-table th {
            background: #f0f3f7;
            color: var(--text);
            padding: 12px;
            font-size: 12px;
            font-weight: 900;
            text-align: center;
        }

        .variance-table td {
            padding: 13px 12px;
            border-top: 1px solid #edf0f4;
            font-size: 13px;
            font-weight: 800;
            text-align: center;
            color: var(--text);
        }

            .variance-table td:first-child {
                text-align: left;
                color: var(--muted);
                font-weight: 900;
            }

    .positive {
        color: var(--green) !important;
    }

    .negative {
        color: var(--red) !important;
    }

    /* ================= DELAYS ================= */

    .delay-list {
        display: grid;
        gap: 9px;
    }

    .delay-row {
        display: grid;
        grid-template-columns: 34px 1fr 92px 48px;
        gap: 10px;
        align-items: center;
        padding: 10px;
        border-radius: 12px;
        background: #fbfcfd;
        border: 1px solid #edf0f4;
    }

    .delay-rank {
        width: 26px;
        height: 26px;
        border-radius: 9px;
        background: var(--brand);
        color: #fff;
        font-size: 11px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .delay-rank.top {
            background: var(--amber);
        }

    .delay-name {
        font-size: 12px;
        font-weight: 900;
        color: var(--text);
    }

    .delay-area {
        font-size: 10px;
        color: var(--muted);
        font-weight: 700;
        margin-top: 2px;
    }

    .delay-bar {
        height: 7px;
        border-radius: 999px;
        background: #edf0f4;
        overflow: hidden;
    }

        .delay-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: var(--brand);
        }

        .delay-bar.top span {
            background: var(--amber);
        }

    .delay-min {
        text-align: right;
        font-size: 13px;
        font-weight: 900;
        color: var(--text);
    }

    /* ================= RIGHT PANEL ================= */

    .right-column {
        display: grid;
        gap: 14px;
    }

    .health-panel {
        text-align: center;
    }

    .health-title {
        font-size: 14px;
        font-weight: 900;
        color: var(--text);
        margin-bottom: 13px;
    }

    .donut-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
    }

    .donut {
        width: 132px;
        height: 132px;
        border-radius: 50%;
        background: conic-gradient(var(--brand) 0 70%, #d8d8d8 70% 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .donut.charge {
            background: conic-gradient(var(--brand) 0 42%, var(--blue) 42% 74%, #c9c9c9 74% 100%);
        }

        .donut.availability {
            background: conic-gradient(var(--brand) 0 38%, var(--blue) 38% 64%, #c9c9c9 64% 100%);
        }

    .donut-inner {
        width: 76px;
        height: 76px;
        background: var(--bg);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
        font-size: 24px;
        font-weight: 900;
    }

    .legend-list {
        display: grid;
        gap: 7px;
        text-align: left;
        font-size: 11px;
        color: var(--text);
        font-weight: 800;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        display: inline-block;
    }

    /* ================= PRODUCTION CHART ================= */

    .production-panel {
        margin-top: 14px;
    }

    .production-chart {
        height: 285px;
        position: relative;
    }

    .footer-line {
        margin-top: 14px;
        padding: 14px;
        border-top: 1px solid var(--border);
        text-align: right;
        font-size: 12px;
        color: var(--muted);
        font-weight: 700;
    }

    .print-btn {
        background: #ffffff;
        color: #8b1029;
        border: 1px solid rgba(255,255,255,.45);
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

        .print-btn i {
            margin-right: 6px;
        }

        .print-btn:hover {
            background: #f8e8ed;
            color: #52000f;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1400px) {
        .exec-strip {
            grid-template-columns: repeat(3, 1fr);
        }

        .kpi-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .main-grid {
            grid-template-columns: 1fr 1fr;
        }

        .right-column {
            grid-column: 1 / -1;
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 992px) {
        .board-header {
            grid-template-columns: 1fr;
        }

        .header-meta {
            text-align: left;
        }

        .exec-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .main-grid,
        .right-column {
            grid-template-columns: 1fr;
        }

        .donut-wrap {
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {
        .xp-contentbar {
            padding: 10px !important;
        }

        .board-header h2 {
            font-size: 23px;
        }

        .exec-strip,
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .delay-row {
            grid-template-columns: 34px 1fr 48px;
        }

        .delay-bar {
            display: none;
        }
    }

    @@media print {
        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .xp-breadcrumbbar,
        .no-print {
            display: none !important;
        }

        body,
        .xp-contentbar {
            background: #fff !important;
        }

        .panel,
        .kpi-card,
        .exec-card,
        .board-header {
            box-shadow: none !important;
        }
    }

