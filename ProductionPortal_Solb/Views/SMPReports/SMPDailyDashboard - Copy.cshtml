</style>

<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-9">
            <h4 class="xp-page-title">SMP Daily Dashboard</h4>
        </div>
        <div class="col-md-3 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">Steel Melting Plant</li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </div>
    </div>
    <div class="row">
        <div class="col-md-10">
        </div>
        <div class="col-md-2">
            <div class="no-print" style="position:relative; z-index:2; text-align:right; margin-top:8px;">
                <button type="button" class="print-btn" onclick="printSMPDashboard()">
                    <i class="fa-solid fa-print"></i> Print / Save PDF
                </button>
            </div>
        </div>
    </div>
</div>

<div class="xp-contentbar">

    <div class="smp-board">


        <!-- HEADER -->
        <div class="board-header">
            <div class="header-left">
                <div class="plant-tag">
                    <i class="fa-solid fa-industry"></i>
                    Steel Melting Plant
                </div>
                <h2>SMP Operations Performance Dashboard</h2>
                <p>Executive overview of production, delays, utilities, charge mix and operational reliability.</p>
            </div>

            <div class="header-meta">
                <div class="meta-card">
                    <div class="meta-label">Report Date</div>
                    <div class="meta-value">10-Jun-2026</div>
                </div>
                <div class="meta-card">
                    <div class="meta-label">Report Type</div>
                    <div class="meta-value">Daily Management View</div>
                </div>
            </div>
        </div>

        <!-- EXECUTIVE SUMMARY -->
        <div class="exec-strip">
            <div class="exec-card good">
                <div>
                    <div class="exec-title">Daily Output</div>
                    <div class="exec-value">2,980 MT</div>
                    <div class="exec-sub">Target: 3,000 MT</div>
                </div>
                <div class="exec-icon"><i class="fa-solid fa-cubes"></i></div>
            </div>

            <div class="exec-card">
                <div>
                    <div class="exec-title">Yield</div>
                    <div class="exec-value">86.9%</div>
                    <div class="exec-sub">Target: 87%</div>
                </div>
                <div class="exec-icon"><i class="fa-solid fa-percent"></i></div>
            </div>

            <div class="exec-card warn">
                <div>
                    <div class="exec-title">Total Delay</div>
                    <div class="exec-value">590 Min</div>
                    <div class="exec-sub">Top delay: Planned DT</div>
                </div>
                <div class="exec-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            </div>

            <div class="exec-card good">
                <div>
                    <div class="exec-title">Availability</div>
                    <div class="exec-value">90%</div>
                    <div class="exec-sub">Stable operation</div>
                </div>
                <div class="exec-icon"><i class="fa-solid fa-shield-halved"></i></div>
            </div>

            <div class="exec-card">
                <div>
                    <div class="exec-title">Year Achievement</div>
                    <div class="exec-value">70%</div>
                    <div class="exec-sub">YTD progress</div>
                </div>
                <div class="exec-icon"><i class="fa-solid fa-chart-pie"></i></div>
            </div>
        </div>

        <!-- KPI CARDS -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-name">Heat Count</div>
                    <div class="kpi-badge"><i class="fa-solid fa-fire"></i></div>
                </div>
                <div class="kpi-value">22</div>
                <div class="kpi-target">Target: 24 heats</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:92%;"></span></div>
            </div>

            <div class="kpi-card good">
                <div class="kpi-top">
                    <div class="kpi-name">Billet Output</div>
                    <div class="kpi-badge"><i class="fa-solid fa-cubes"></i></div>
                </div>
                <div class="kpi-value">2,980</div>
                <div class="kpi-target">Target: 3,000 MT</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:99%;"></span></div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-name">Yield</div>
                    <div class="kpi-badge"><i class="fa-solid fa-percent"></i></div>
                </div>
                <div class="kpi-value">86.9%</div>
                <div class="kpi-target">Target: 87%</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:99%;"></span></div>
            </div>

            <div class="kpi-card good">
                <div class="kpi-top">
                    <div class="kpi-name">Productivity</div>
                    <div class="kpi-badge"><i class="fa-solid fa-gauge-high"></i></div>
                </div>
                <div class="kpi-value">141</div>
                <div class="kpi-target">Target: 140 t/hr</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:100%;"></span></div>
            </div>

            <div class="kpi-card warn">
                <div class="kpi-top">
                    <div class="kpi-name">Power Consumption</div>
                    <div class="kpi-badge"><i class="fa-solid fa-bolt"></i></div>
                </div>
                <div class="kpi-value">608</div>
                <div class="kpi-target">Target: 602 kWh/t</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:100%;"></span></div>
            </div>

            <div class="kpi-card">
                <div class="kpi-top">
                    <div class="kpi-name">TTT Time</div>
                    <div class="kpi-badge"><i class="fa-regular fa-clock"></i></div>
                </div>
                <div class="kpi-value">60.2</div>
                <div class="kpi-target">Target: 60 min</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:100%;"></span></div>
            </div>

            <div class="kpi-card warn">
                <div class="kpi-top">
                    <div class="kpi-name">Power-on Time</div>
                    <div class="kpi-badge"><i class="fa-solid fa-plug-circle-bolt"></i></div>
                </div>
                <div class="kpi-value">60.2</div>
                <div class="kpi-target">Target: 48 min</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:100%;"></span></div>
            </div>

            <div class="kpi-card warn">
                <div class="kpi-top">
                    <div class="kpi-name">Heat Weight</div>
                    <div class="kpi-badge"><i class="fa-solid fa-weight-hanging"></i></div>
                </div>
                <div class="kpi-value">136</div>
                <div class="kpi-target">Target: 140 t</div>
                <div class="kpi-track"><span class="kpi-fill" style="width:97%;"></span></div>
            </div>
        </div>

        <!-- MAIN -->
        <div class="main-grid">

            <!-- LEFT -->
