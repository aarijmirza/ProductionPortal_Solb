@using System
@using System.Globalization
@using System.Collections.Generic
@model DAL.Models.ViewModel.CCMMeltShopReportVM

@{
    Layout = null;

    var list = Model != null && Model.CCM != null
        ? Model.CCM
        : new List<DAL.Models.CCMBLL>();

    var chemistry =
        Model != null &&
        Model.ChemicalAnalysis != null
            ? Model.ChemicalAnalysis
            : new List<DAL.Models.CCMChemicalAnalysisBLL>();

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    Func<decimal?, string> D0 = value =>
    {
        return value.HasValue ? value.Value.ToString("N0") : "0";
    };

    Func<decimal?, string> D2 = value =>
    {
        return value.HasValue ? value.Value.ToString("N2") : "0.00";
    };

    Func<TimeSpan?, string> T = value =>
    {
        return value.HasValue ? value.Value.ToString(@"hh\:mm") : "";
    };

    Func<DAL.Models.CCMBLL, int> StrandCount = item =>
    {
        if (item == null)
        {
            return 0;
        }

        int count = 0;

        if (!string.IsNullOrWhiteSpace(item.Strand1)) count++;
        if (!string.IsNullOrWhiteSpace(item.Strand2)) count++;
        if (!string.IsNullOrWhiteSpace(item.Strand3)) count++;
        if (!string.IsNullOrWhiteSpace(item.Strand4)) count++;
        if (!string.IsNullOrWhiteSpace(item.Strand5)) count++;

        return count;
    };

    DateTime fromDate =
        Model != null && Model.FromDate != DateTime.MinValue
            ? Model.FromDate
            : DateTime.Today;

    DateTime toDate =
        Model != null && Model.ToDate != DateTime.MinValue
            ? Model.ToDate
            : DateTime.Today;

    string reportFromDate =
        fromDate.ToString("dd-MM-yyyy", gregorian);

    string reportToDate =
        toDate.ToString("dd-MM-yyyy", gregorian);

    int totalHeats = list.Count;

    decimal totalDuration = 0;
    decimal totalLadleStart = 0;
    decimal totalLadleEnd = 0;

    decimal totalPrime1Length = 0;
    decimal totalPrime1Pcs = 0;
    decimal totalPrime2Length = 0;
    decimal totalPrime2Pcs = 0;

    decimal totalVarLengthPcs = 0;
    decimal totalEndCutPcs = 0;

    decimal totalPrime1Wt = 0;
    decimal totalPrime2Wt = 0;
    decimal totalVLenWt = 0;
    decimal totalEndWt = 0;

    decimal totalYield = 0;
    int yieldCount = 0;

    for (int i = 0; i < list.Count; i++)
    {
        var item = list[i];

        totalDuration += item.CastingTime ?? 0;
        totalLadleStart += item.LadleWeightStart ?? 0;
        totalLadleEnd += item.LadleWeightEnd ?? 0;

        totalPrime1Length += item.Prime1Length ?? 0;
        totalPrime1Pcs += item.Prime1Pcs ?? 0;

        totalPrime2Length += item.Prime2Length ?? 0;
        totalPrime2Pcs += item.Prime2Pcs ?? 0;

        totalVarLengthPcs += item.VarLengthPcs ?? 0;
        totalEndCutPcs += item.EndCutPcs ?? 0;

        totalPrime1Wt += item.Prime1Wt ?? 0;
        totalPrime2Wt += item.Prime2Wt ?? 0;
        totalVLenWt += item.VLenWt ?? 0;
        totalEndWt += item.EndWt ?? 0;

        decimal? yieldValue = item.Yeild ?? item.Yield;

        if (yieldValue.HasValue)
        {
            totalYield += yieldValue.Value;
            yieldCount++;
        }
    }

    decimal avgDuration =
        totalHeats > 0
            ? totalDuration / totalHeats
            : 0;

    decimal avgLadleStart =
        totalHeats > 0
            ? totalLadleStart / totalHeats
            : 0;

    decimal avgLadleEnd =
        totalHeats > 0
            ? totalLadleEnd / totalHeats
            : 0;

    decimal avgYield =
        yieldCount > 0
            ? totalYield / yieldCount
            : 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Continuous Casting Machine [CCM] Daily Heat Summary Report</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
            background: #ffffff;
        }

        .print-btn {
            margin: 10px;
            padding: 7px 15px;
            background: #74000a;
            color: #ffffff;
            border: none;
            border-radius: 3px;
            font-weight: bold;
            cursor: pointer;
        }


        .filter-bar {
            margin: 10px;
            padding: 12px;
            border: 1px solid #ddd;
            background: #f8f9fa;
            display: flex;
            align-items: end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .filter-group label {
                font-weight: bold;
                font-size: 12px;
            }

            .filter-group input {
                height: 34px;
                padding: 5px 8px;
                border: 1px solid #bbb;
                border-radius: 3px;
            }

        .filter-action {
            margin: 0;
            height: 34px;
        }

        .sheet {
            margin: 10px auto;
            border: 1px solid #000;
            padding: 4px;
            width: 100%;
            background: #ffffff;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 2px 3px;
            vertical-align: middle;
        }

        .no-border td,
        .no-border th {
            border: none !important;
        }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
        }

        .bold {
            font-weight: bold;
        }

        .header-title {
            font-size: 30px;
            font-weight: bold;
        }

        .sub-header {
            font-size: 20px;
            font-weight: bold;
        }

        .small {
            font-size: 11px;
        }

        .section-title {
            font-weight: bold;
            background-color: #f2f2f2;
            font-size: medium;
        }

        .logo-cell img {
            max-height: 90px;
            margin-top: 10px;
        }

        .total-row {
            font-weight: bold;
            background-color: #f9f9f9;
        }

        .nowrap {
            white-space: nowrap;
        }

        @@page {
            size: A4 landscape;
            margin: 6mm;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                margin: 0;
                padding: 0;
                background: #ffffff !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .sheet {
                margin: 0;
                border: none;
                padding: 0;
                width: 100%;
            }

            th,
            td {
                font-size: 9px;
                padding: 2px;
            }

            .header-title {
                font-size: 24px;
            }

            .sub-header {
                font-size: 16px;
            }

            .section-title {
                background-color: #f2f2f2 !important;
            }

            .total-row {
                background-color: #f9f9f9 !important;
            }
        }
    </style>
</head>

<body>

    <div class="filter-bar no-print">
        <form method="get"
              action="@Url.Action("CCMDailyHeatSummary", "CCM")"
              style="display:flex; align-items:end; gap:12px; flex-wrap:wrap;">

            <div class="filter-group">
                <label>From Date</label>
                <input type="date"
                       name="fromDate"
                       value="@fromDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-group">
                <label>To Date</label>
                <input type="date"
                       name="toDate"
                       value="@toDate.ToString("yyyy-MM-dd")" />
            </div>

            <button type="submit"
                    class="print-btn filter-action">
                Load Report
            </button>

            <button type="button"
                    class="print-btn filter-action"
                    onclick="window.print()">
                Print / Save PDF
            </button>
        </form>
    </div>

    <div class="sheet">

        <!-- LOGO + TITLES -->
        <table class="no-border">
            <tr>
                <td class="logo-cell" style="width:180px;">
                    <img src="~/assets/images/logo.png" />
                </td>

                <td class="center">
                    <div class="header-title">SOLB STEEL COMPANY</div>
                    <div class="sub-header">CONTINUOUS CASTING MACHINE [CCM] DEPARTMENT</div>
                    <div class="sub-header">DAILY HEAT SUMMARY REPORT</div>
                </td>
            </tr>
        </table>

        <!-- DATE RANGE -->
        <table>
            <tr>
                <td class="bold nowrap" style="width:100px;">From Date:</td>
                <td style="width:120px;">@reportFromDate</td>

                <td class="bold nowrap" style="width:90px;">To Date:</td>
                <td style="width:120px;">@reportToDate</td>

                <td class="bold nowrap" style="width:90px;">Total Heats:</td>
                <td class="center" style="width:80px;">@totalHeats</td>

                <td></td>
            </tr>
        </table>

        <!-- PRODUCTION DESCRIPTION -->
        <table style="margin-top:4px;">
            <tr>
                <td colspan="22" class="section-title">PRODUCTION DESCRIPTION</td>
            </tr>

            <tr class="center small bold">
                <td rowspan="2">Sr. No.</td>
                <td rowspan="2">Heat No.</td>
                <td rowspan="2">Steel Grade</td>
                <td rowspan="2">Ladle No.</td>
                <td rowspan="2">No. In Seq</td>
                <td rowspan="2">Strands</td>

                <td colspan="3">Times</td>

                <td colspan="2">Ladle Weight</td>

                <td rowspan="2">Yield</td>

                <td colspan="10">Billets</td>
            </tr>

            <tr class="center small bold">
                <td>Cast Start</td>
                <td>Cast Stop</td>
                <td>Duration<br />(mins.)</td>

                <td>Start<br />(t)</td>
                <td>End<br />(t)</td>

                <td>Prime 1<br />Length (m)</td>
                <td>Prime 1<br />(pcs)</td>

                <td>Prime 2<br />Length (m)</td>
                <td>Prime 2<br />(pcs)</td>

                <td>Var. Length<br />(pcs)</td>
                <td>End Cut<br />(pcs)</td>

                <td>Prime 1 Wt<br />(t)</td>
                <td>Prime 2 Wt<br />(t)</td>
                <td>V. Len Wt<br />(t)</td>
                <td>End Wt<br />(t)</td>
            </tr>

            @if (list != null && list.Count > 0)
            {
                for (int i = 0; i < list.Count; i++)
                {
                    var item = list[i];

                    <tr class="small">
                        <td class="center">@(i + 1)</td>

                        <td class="center">@(item.HeatNo ?? "-")</td>
                        <td class="center">@(item.Grade ?? item.GRADE_ID ?? "-")</td>
                        <td class="center">@D0(item.LadleNo)</td>
                        <td class="center">@D0(item.SequenceHeat)</td>
                        <td class="center">@StrandCount(item)</td>

                        <td class="center">@T(item.OpenTime)</td>
                        <td class="center">@T(item.CloseTime)</td>
                        <td class="center">@D2(item.CastingTime)</td>

                        <td class="center">@D2(item.LadleWeightStart)</td>
                        <td class="center">@D2(item.LadleWeightEnd)</td>

                        <td class="center">@D2(item.Yeild ?? item.Yield)</td>

                        <td class="center">@D2(item.Prime1Length)</td>
                        <td class="center">@D0(item.Prime1Pcs)</td>

                        <td class="center">@D2(item.Prime2Length)</td>
                        <td class="center">@D0(item.Prime2Pcs)</td>

                        <td class="center">@D0(item.VarLengthPcs)</td>
                        <td class="center">@D0(item.EndCutPcs)</td>

                        <td class="center">@D2(item.Prime1Wt)</td>
                        <td class="center">@D2(item.Prime2Wt)</td>
                        <td class="center">@D2(item.VLenWt)</td>
                        <td class="center">@D2(item.EndWt)</td>
                    </tr>
                }
            }
            else
            {
                <tr class="small">
                    <td class="center">1</td>
                    <td class="center">-</td>
                    <td class="center">-</td>
                    <td class="center">0</td>
                    <td class="center">0</td>
                    <td class="center">0</td>

                    <td class="center"></td>
                    <td class="center"></td>
                    <td class="center">0.00</td>

                    <td class="center">0.00</td>
                    <td class="center">0.00</td>

                    <td class="center">0.00</td>

                    <td class="center">0.00</td>
                    <td class="center">0</td>

                    <td class="center">0.00</td>
                    <td class="center">0</td>

                    <td class="center">0</td>
                    <td class="center">0</td>

                    <td class="center">0.00</td>
                    <td class="center">0.00</td>
                    <td class="center">0.00</td>
                    <td class="center">0.00</td>
                </tr>
            }

            <!-- AVERAGE -->
            <tr class="total-row small">
                <td colspan="8" class="right bold">Average</td>

                <td class="center">@avgDuration.ToString("N2")</td>
                <td class="center">@avgLadleStart.ToString("N2")</td>
                <td class="center">@avgLadleEnd.ToString("N2")</td>
                <td class="center">@avgYield.ToString("N2")</td>

                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>

                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>
                <td class="center">-</td>
            </tr>

            <!-- TOTAL -->
            <tr class="total-row small">
                <td colspan="8" class="right bold">Total</td>

                <td class="center">@totalDuration.ToString("N2")</td>
                <td class="center">@totalLadleStart.ToString("N2")</td>
                <td class="center">@totalLadleEnd.ToString("N2")</td>
                <td class="center">-</td>

                <td class="center">@totalPrime1Length.ToString("N2")</td>
                <td class="center">@totalPrime1Pcs.ToString("N0")</td>

                <td class="center">@totalPrime2Length.ToString("N2")</td>
                <td class="center">@totalPrime2Pcs.ToString("N0")</td>

                <td class="center">@totalVarLengthPcs.ToString("N0")</td>
                <td class="center">@totalEndCutPcs.ToString("N0")</td>

                <td class="center">@totalPrime1Wt.ToString("N2")</td>
                <td class="center">@totalPrime2Wt.ToString("N2")</td>
                <td class="center">@totalVLenWt.ToString("N2")</td>
                <td class="center">@totalEndWt.ToString("N2")</td>
            </tr>
        </table>

        <!-- CCM CHEMICAL ANALYSIS -->
        <table style="margin-top:8px;">
            <tr>
                <td colspan="9" class="section-title">
                    CCM CHEMICAL ANALYSIS
                </td>
            </tr>

            <tr class="center small bold">
                <td>Sr. No.</td>
                <td>Heat No.</td>
                <td>Sample</td>
                <td>C</td>
                <td>Si</td>
                <td>Mn</td>
                <td>P</td>
                <td>S</td>
                <td>TE</td>
            </tr>

            @if (chemistry != null && chemistry.Count > 0)
            {
                for (int i = 0; i < chemistry.Count; i++)
                {
                    var chem = chemistry[i];

                    <tr class="center small">
                        <td>@(i + 1)</td>
                        <td>@(chem.HeatNo ?? "-")</td>
                        <td>@(chem.Sample ?? "-")</td>
                        <td>@chem.C</td>
                        <td>@chem.Si</td>
                        <td>@chem.Mn</td>
                        <td>@chem.P</td>
                        <td>@chem.S</td>
                        <td>@chem.TE</td>
                    </tr>
                }
            }
            else
            {
                <tr class="center small">
                    <td colspan="9">No Chemical Analysis Found</td>
                </tr>
            }
        </table>

    </div>

</body>
</html>