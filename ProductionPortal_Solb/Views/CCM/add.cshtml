@model DAL.Models.ViewModel.CCMMeltShopVM

@{
    bool isEdit = Model?.Master != null && !string.IsNullOrEmpty(Model.Master.HeatNo);
    ViewBag.Title = isEdit ? "Edit CCM MeltShop Record" : "Add CCM MeltShop Record";
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            .
            <h4 class="xp-page-title">CCM MeltShop</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CCM MeltShop</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->


<div class="xp-contentbar">
    <form action="/CCM/add" id="addprofileform" method="post">
        @Html.HiddenFor(m => m.Master.ID)
        <div class="row">

            <!---------------------------- BASIC INFORMATION --------------------------------->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>

                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-1">
                                <label>Date <br /> <br /></label>
                                @Html.TextBoxFor(m => m.Master.Date,
                                    "{0:yyyy-MM-dd}",
                                    new { @class = "form-control", type = "date" })

                                @*<input type="date" class="form-control" id="date" name="Date">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Shift <br /> <br /></label>
                                @Html.DropDownListFor(
                                    m => m.Master.Shift,
                                    new SelectList(
                                        new[] { "Morning", "Evening", "Night", "Long Morning", "Long Night" },
                                        Model.Master?.Shift
                                    ),
                                    "Choose...",
                                    new { @class = "form-control" }
                                )
                            </div>

                            <div class="form-group col-md-1">
                                <label>Grade <br /><br /></label>
                                @*<select class="form-control" name="GRADE_ID" required>
                                        <option disabled selected>-- please select</option>
                                        <option value="BS-4449">BS-4449</option>
                                        <option value="GR-60">GR-60</option>
                                        <option value="SAE-1008">SAE-1008</option>
                                        <option value="SAE-1006">SAE-1006</option>
                                        <option value="A-706">A-706</option>
                                    </select>*@
                                @Html.DropDownListFor(
                                    m => m.Master.Grade,
                                    new SelectList(
                                        new[] { "BS-4449", "GR-40", "GR-60", "SAE-1008", "SAE-1006", "A-706" },
                                        Model.Master?.Grade   // ✅ selected value
                                    ),
                                    "-- Select Grade --",
                                    new { @class = "form-control" }
                                )
                            </div>

                            <div class="form-group col-md-1">
                                <label>Heat #  <br /> <br /></label>
                                @Html.TextBoxFor(m => m.Master.HeatNo,
                                    new { @class = "form-control", type = "text" })

                                @*@Html.DropDownListFor(
                                         m => m.Master.HeatNo,
                                         (SelectList)ViewBag.HeatNo,
                                         "-- Select Heat # --",
                                         new { @class = "form-control" }
                                     )

                                @Html.ValidationMessageFor(m => m.Master.HeatNo, "", new { @class = "text-danger" })*@
                            </div>


                            <div class="form-group col-md-1">
                                <label>Sequence <br /> Heat</label>
                                @Html.TextBoxFor(m => m.Master.SequenceHeat,
                                    new { @class = "form-control", type = "number" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Ladle No <br /><br /></label>
                                @Html.TextBoxFor(m => m.Master.LadleNo,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="LadleNo">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Ladle <br /> Temp (°C)</label>
                                @Html.TextBoxFor(m => m.Master.LadleTemperature,
                                    new { @class = "form-control", type = "number" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Molten <br /> Steel (ton)</label>
                                @Html.TextBoxFor(m => m.Master.MoltenSteel,
                                    new { @class = "form-control", type = "number", step = "any", name = "MoltenSteel" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Time on <br /> Turret</label>
                                @Html.TextBoxFor(m => m.Master.TimeOnTurret,
                                    new { @class = "form-control", type = "time" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Plate <br /> Life</label>
                                @Html.TextBoxFor(m => m.Master.PlateLife,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="PlateLife">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Open <br /> Time</label>
                                @Html.TextBoxFor(m => m.Master.OpenTime,
                                    new { @class = "form-control", type = "time", id = "OpenTime" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Close <br /> Time</label>
                                @Html.TextBoxFor(m => m.Master.CloseTime,
                                    new { @class = "form-control", type = "time", id = "CloseTime" })
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-1">
                                <label>Tundish <br /> No</label>
                                @Html.TextBoxFor(m => m.Master.TundishNo,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="TundishNo">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Tundish Life (Heats)</label>
                                @Html.TextBoxFor(m => m.Master.TundishLife,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="TundishLife">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Shroud Life (Heats)</label>
                                @Html.TextBoxFor(m => m.Master.ShroudLife,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="ShroudLife">*@
                            </div>

                            <div class="form-group col-md-2">
                                <label>Steel Temperature <br /> (°C)</label>
                                <div id="steelTempsContainer">
                                    <div class="input-group mb-1">
                                        <input type="number" class="form-control" name="SteelTemperature[]" placeholder="Temp 1">
                                        <button type="button" class="btn btn-sm btn-success add-temp">+</button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-md-2">
                                <label>Strand <br /> <br /></label>
                                <div id="strand">
                                    <div class="input-group mb-1">
                                        <input type="number" class="form-control" name="Strand[]" placeholder="Strand 1">
                                        <button type="button" class="btn btn-sm btn-success add-strand">+</button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-md-1">
                                <label>Billet Size <br /> (mm²)</label>
                                @Html.TextBoxFor(m => m.Master.BilletSize,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="BilletSize">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Billet Length (m)</label>
                                @Html.TextBoxFor(m => m.Master.BilletLength,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="BilletLength">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Casting Time (min)</label>
                                @Html.TextBoxFor(
                                    m => m.Master.CastingTime,
                                    new { @class = "form-control", type = "number", id = "CastingTime", @readonly = "readonly" })

                                @*<input type="number" class="form-control" id="CastingTime" name="CastingTime" readonly>*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Billet <br /> Number</label>
                                @Html.TextBoxFor(m => m.Master.BilletNumber,
                                    new { @class = "form-control", type = "number", name = "BilletNumber" })
                                @*<input type="number" class="form-control" name="BilletNumber">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Billet <br /> Weight</label>
                                @Html.TextBoxFor(m => m.Master.BilletTotalWeight,
                                    new { @class = "form-control", type = "number", name = "BilletTotalWeight", step = "any" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Productivity (ton/hr)</label>
                                @Html.TextBoxFor(m => m.Master.Productivitytonhr,
                                    new { @class = "form-control", type = "number", name = "Productivitytonhr", @readonly = "readonly", step = "any" })
                            </div>

                            <div class="form-group col-md-1">
                                <label>Yeild (%) <br />  <br /> </label>
                                @Html.TextBoxFor(
                                    m => m.Master.Yeild,
                                    new { @class = "form-control", type = "number", name = "Yeild", @readonly = "readonly", step = "any" })
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!---------------------------- LF LEAVE ANALYSIS --------------------------------->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white">
                        <h5>LF Leave Analysis</h5>
                    </div>

                    <div class="card-body">
                        <div class="form-row">

                            <div class="form-group col-md-1">
                                <label>C %</label>
                                @Html.TextBoxFor(m => m.Master.LF_C,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="LF_C">*@
                            </div>
                            <div class="form-group col-md-1">
                                <label>Si %</label>
                                @Html.TextBoxFor(m => m.Master.LF_Si,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control lf-analysis-si" name="LF_Si">*@
                            </div>
                            <div class="form-group col-md-1">
                                <label>Mn %</label>
                                @Html.TextBoxFor(m => m.Master.LF_Mn,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control lf-analysis-mn" name="LF_Mn">*@
                            </div>
                            <div class="form-group col-md-1">
                                <label>S %</label>
                                @Html.TextBoxFor(m => m.Master.LF_S,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control lf-analysis-s" name="LF_S">*@
                            </div>
                            <div class="form-group col-md-1">
                                <label>T.E %</label>
                                @Html.TextBoxFor(m => m.Master.LF_TE,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control" name="LF_TE">*@
                            </div>

                            <div class="form-group col-md-1">
                                <label>Mn / Si</label>
                                @Html.TextBoxFor(m => m.Master.LF_MnSi,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control lf-analysis-mn-si" name="LF_MnSi" readonly>*@
                            </div>
                            <div class="form-group col-md-1">
                                <label>Mn / S</label>
                                @Html.TextBoxFor(m => m.Master.LF_MnS,
                                    new { @class = "form-control", type = "number" })
                                @*<input type="number" class="form-control lf-analysis-mn-s" name="LF_MnS" readonly>*@
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!---------------------------- CCM CHEMICAL ANALYSIS ------------------------------->
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white">
                        <h5>CCM Chemical Analysis</h5>
                    </div>

                    <div class="card-body">
                        <div class="form-row">

                            <table class="table table-bordered" id="chemTable">
                                <thead>
                                    <tr>
                                        <th>Sample</th>
                                        <th>C %</th>
                                        <th>Si %</th>
                                        <th>Mn %</th>
                                        <th>P %</th>
                                        <th>S %</th>
                                        <th>TE %</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr>
                                        <td class="sample-no" name="Analysis[0].Sample">Sample 1</td>

                                        <td><input type="number" class="form-control" name="Analysis[0].C"></td>
                                        <td><input type="number" class="form-control" name="Analysis[0].Si"></td>
                                        <td><input type="number" class="form-control" name="Analysis[0].Mn"></td>
                                        <td><input type="number" class="form-control" name="Analysis[0].P"></td>
                                        <td><input type="number" class="form-control" name="Analysis[0].S"></td>
                                        <td><input type="number" class="form-control" name="Analysis[0].TE"></td>

                                        <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
                                    </tr>
                                </tbody>
                            </table>

                            <button type="button" id="addRow" class="btn btn-primary">Add Row</button>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>


<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        $("input[type='number']").attr("step", "any");

        /* ------------------------------------------------------
         * 1️⃣ SET TODAY'S DATE
         * ------------------------------------------------------ */
        $("#date").val(new Date().toISOString().split('T')[0]);


        /* ------------------------------------------------------
         * 2️⃣ CASTING TIME CALCULATION
         * ------------------------------------------------------ */
        function calculateCastingTime() {
            let open = $("#OpenTime").val();
            let close = $("#CloseTime").val();

            if (open && close) {
                let openTime = new Date("1970-01-01T" + open + ":00");
                let closeTime = new Date("1970-01-01T" + close + ":00");

                let diff = (closeTime - openTime) / 60000; // minutes

                $("#CastingTime").val(diff >= 0 ? diff : "");
                calculateYieldProductivity();
            }
        }
        $("#OpenTime, #CloseTime").on("change", calculateCastingTime);


        /* ------------------------------------------------------
         * 3️⃣ DYNAMIC CHEMICAL ANALYSIS TABLE
         * ------------------------------------------------------ */
        let tableBody = $("#chemTable tbody");
        let sampleCount = tableBody.find("tr").length || 0;

        // Re-index rows
        function reIndexRows() {
            tableBody.find("tr").each(function (index) {
                let sampleNumber = index + 1;

                // Sample cell + hidden field
                let sampleCell = $(this).find(".sample-no");
                sampleCell.html(`
                Sample ${sampleNumber}
                <input type="hidden" name="Analysis[${index}].Sample" value="Sample ${sampleNumber}" />
            `);

                // Fix input names
                $(this).find("input[type='number']").each(function () {
                    let oldName = $(this).attr("name");
                    if (oldName) {
                        let newName = oldName.replace(/Analysis\[\d+\]/, `Analysis[${index}]`);
                        $(this).attr("name", newName);
                    }
                });
            });

            sampleCount = tableBody.find("tr").length;
        }

        // Add new row
        function addAnalysisRow() {
            let index = sampleCount;
            let number = index + 1;

            let row = `
        <tr>
            <td class="sample-no">
                Sample ${number}
                <input type="hidden" name="Analysis[${index}].Sample" value="Sample ${number}" />
            </td>
            <td><input type="number" class="form-control" name="Analysis[${index}].C"></td>
            <td><input type="number" class="form-control" name="Analysis[${index}].Si"></td>
            <td><input type="number" class="form-control" name="Analysis[${index}].Mn"></td>
            <td><input type="number" class="form-control" name="Analysis[${index}].P"></td>
            <td><input type="number" class="form-control" name="Analysis[${index}].S"></td>
            <td><input type="number" class="form-control" name="Analysis[${index}].TE"></td>
            <td><button type="button" class="btn btn-danger btn-sm remove-row">X</button></td>
        </tr>
        `;
            tableBody.append(row);
            sampleCount++;
        }

        $("#addRow").click(addAnalysisRow);

        // Remove row
        $(document).on("click", ".remove-row", function () {
            if (tableBody.find("tr").length > 1) {
                $(this).closest("tr").remove();
                reIndexRows();
            } else {
                alert("At least one sample is required.");
            }
        });


        /* ------------------------------------------------------
         * 4️⃣ YIELD & PRODUCTIVITY CALCULATION
         * ------------------------------------------------------ */
        function calculateYieldProductivity() {

            let billetWeight = parseFloat($("input[name='Master.BilletTotalWeight']").val()) || 0;
            let moltenSteel = parseFloat($("input[name='Master.MoltenSteel']").val()) || 0;
            let castingTime = parseFloat($("#CastingTime").val()) || 0;

            // Yield (%)
            $("input[name='Master.Yeild']").val(
                billetWeight > 0 && moltenSteel > 0
                    ? ((billetWeight / moltenSteel) * 100).toFixed(2)
                    : ""
            );

            // Productivity (ton/hr)
            $("input[name='Master.Productivitytonhr']").val(
                billetWeight > 0 && castingTime > 0
                    ? ((billetWeight / castingTime) * 60).toFixed(2)
                    : ""
            );
        }

        $(document).on(
            "input change",
            "input[name='Master.BilletTotalWeight'], input[name='Master.MoltenSteel'], #CastingTime",
            calculateYieldProductivity
        );


        /* ------------------------------------------------------
         * 5️⃣ LF ANALYSIS CALCULATIONS
         * ------------------------------------------------------ */
        function calculateLF(card) {
            let mn = parseFloat(card.find('.lf-analysis-mn').val()) || 0;
            let si = parseFloat(card.find('.lf-analysis-si').val()) || 0;
            let s = parseFloat(card.find('.lf-analysis-s').val()) || 0;

            let safeDivide = (num, den) => (den === 0 ? "" : (num / den).toFixed(3));

            card.find('.lf-analysis-mn-si').val(safeDivide(mn, si));
            card.find('.lf-analysis-mn-s').val(safeDivide(mn, s));
        }

        $(document).on("input", ".lf-analysis-mn, .lf-analysis-si, .lf-analysis-s", function () {
            let card = $(this).closest(".card-body");
            calculateLF(card);
        });


        /* DYNAMIC STEEL TEMPERATURE INPUTS */
        let tempIndex = $("#steelTempsContainer input[name='SteelTemperature[]']").length || 1;

        // Add
        $(document).on('click', '.add-temp', function () {
            tempIndex++;

            const newInput = `
                <div class="form-group col-md-12 steel-temp-group">
                    <div class="input-group">
                        <input type="number" class="form-control" name="SteelTemperature[]" placeholder="Temp ${tempIndex}">
                        <button type="button" class="btn btn-sm btn-danger remove-temp">-</button>
                    </div>
                </div>`;

            $('#steelTempsContainer').append(newInput);
        });

        // Remove
        $(document).on('click', '.remove-strand', function () {
            const groups = $('#strand .strandgroup').length;

            if (groups <= 1) {
                alert("At least 1 Strand is required.");
                return;
            }

            $(this).closest('.strandgroup').remove();
        });


        /* DYNAMIC STRAND INPUTS */
        let strandIndex = $("#strand input[name='Strand[]']").length || 1;

        // Add
        $(document).on('click', '.add-strand', function () {
            strandIndex++;

            const newInput = `
            <div class="form-group col-md-12 strandgroup">
                <div class="input-group">
                    <input type="number" class="form-control" name="Strand[]" placeholder="Strand ${strandIndex}">
                    <button type="button" class="btn btn-sm btn-danger remove-temp">-</button>
                </div>
            </div>`;

            $('#strand').append(newInput);
        });

        // Remove
        $(document).on('click', '.remove-temp', function () {
            const groups = $('#strand .strandgroup').length;

            if (groups >= 1) {
                alert("At least 1 strand is required.");
                return;
            }

            $(this).closest('.strandgroup').remove();
        });

    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>
