
@{
    ViewBag.Title = "AddYieldRecord";
}

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">CCM Yield Break Down</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CCM Yield Break Down</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<div class="xp-contentbar">
    <form action="/CCM/AddYieldRecord" id="addprofileform" method="post">
        <div class="row">
            <div class="col-lg-12">
                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Date</label>
                                <input type="date" class="form-control" id="date" name="Date" readonly />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Heat #</label>
                                <input type="text" class="form-control" name="HeatNo">
                            </div>
                            <div class="form-group col-md-2">
                                <label>Tundish Skull</label>
                                <input type="number" step="0.001" class="form-control" name="TundishSkull">
                            </div>
                            <div class="form-group col-md-2">
                                <label>Process Rejected Billet</label>
                                <input type="number" step="0.001" class="form-control" name="ProcessRejectedBillet">
                            </div>
                            <div class="form-group col-md-2">
                                <label>Short Billet < 6m</label>
                                <input type="number" step="0.001" class="form-control" name="ShortBillet6m">
                            </div>
                            <div class="form-group col-md-2">
                                <label>Head & Tail</label>
                                <input type="number" step="0.001" class="form-control" name="HeadTail">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>Comments</label>
                                <textarea class="form-control" name="Comment"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        $("input[type='number']").attr("step", "any");

        $("#date").val(new Date().toISOString().split('T')[0]);
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let isSubmitting = false;   // 🔐 double-submit lock

        $("#addprofileform").on("submit", function (e) {
            e.preventDefault(); // ❗ pehle submit roko

            if (isSubmitting) return; // already submitting

            Swal.fire({
                title: 'Confirm Submission',
                text: 'Are you sure you want to submit this Heat Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {

                    isSubmitting = true; // 🔒 lock

                    // Disable submit button
                    $("#addprofileform")
                        .find("button[type='submit']")
                        .prop("disabled", true)
                        .text("Submitting...");

                    // Finally submit form
                    $("#addprofileform")[0].submit();
                }
            });
        });

    });
</script>
