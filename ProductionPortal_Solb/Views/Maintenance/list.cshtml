@using System.Globalization
@{
    ViewBag.Title = "list";

    var delay =
        Model as List<DAL.Models.PlantDelayBLL>;

    var failureAnalysisStatus =
        ViewBag.FailureAnalysisStatus
            as Dictionary<int, bool>
        ?? new Dictionary<int, bool>();

    string selectedDelayTypesCsv =
        Convert.ToString(ViewBag.DelayType);

    string selectedAgenciesCsv =
        Convert.ToString(ViewBag.Agency);

    var selectedDelayTypes =
        string.IsNullOrWhiteSpace(selectedDelayTypesCsv)
            ? new List<string>()
            : selectedDelayTypesCsv
                .Split(
                    new[] { ',' },
                    StringSplitOptions.RemoveEmptyEntries
                )
                .Select(
                    x => x.Trim()
                )
                .ToList();

    var selectedAgencies =
string.IsNullOrWhiteSpace(selectedAgenciesCsv)
    ? new List<string>()
    : selectedAgenciesCsv
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .ToList();

    string selectedPlantsCsv =
        Convert.ToString(ViewBag.Plant);

    var selectedPlants =
        string.IsNullOrWhiteSpace(selectedPlantsCsv)
            ? new List<string>()
            : selectedPlantsCsv
                .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .ToList();
}
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Failure Analysis</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">CMD Maintenance</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Maintenance Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
      rel="stylesheet" />
<style>
    .maintenance-filter-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .06);
    }

        .maintenance-filter-card label {
            color: #4b5563;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

    .delay-type-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        min-height: 40px;
        padding: 5px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        background: #f9fafb;
    }

    .delay-radio {
        position: relative;
        margin: 0;
    }

        .delay-radio input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .delay-radio label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 92px;
            min-height: 30px;
            margin: 0;
            padding: 6px 12px;
            border: 1px solid #d1d5db;
            border-radius: 20px;
            background: #ffffff;
            color: #4b5563;
            cursor: pointer;
            font-size: 10px;
            font-weight: 800;
            text-transform: none;
            letter-spacing: 0;
            transition: all .18s ease;
        }

        .delay-radio input:checked + label {
            border-color: #a6173f;
            background: #a6173f;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(166, 23, 63, .18);
        }

    .select2-container {
        width: 100% !important;
        display: block;
    }

    .select2-container--default .select2-selection--multiple {
        min-height: 44px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        padding: 5px 8px;
        background: #ffffff;
        box-shadow: none;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        overflow: visible;
    }

    .select2-container--default.select2-container--focus
    .select2-selection--multiple {
        border-color: #a6173f;
        box-shadow: 0 0 0 3px rgba(166, 23, 63, .10);
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__rendered {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        width: 100%;
        min-height: 32px;
        padding: 0;
        margin: 0;
        line-height: normal;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-search--inline {
        flex: 1 1 120px;
        margin: 0;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-search__field {
        width: 100% !important;
        height: 30px;
        min-width: 120px;
        margin: 0;
        padding: 4px 2px;
        border: 0 !important;
        outline: 0;
        color: #374151;
        font-size: 13px;
        line-height: 22px;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__choice {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        margin: 0;
        padding: 4px 9px 4px 25px;
        border: 1px solid #d7a7b6;
        border-radius: 16px;
        background: #faeef2;
        color: #75102d;
        font-size: 11px;
        font-weight: 700;
        line-height: 18px;
    }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__choice__remove {
        top: 50%;
        left: 7px;
        transform: translateY(-50%);
        border-right: 0;
        color: #a6173f;
        font-size: 16px;
        line-height: 1;
    }

        .select2-container--default
        .select2-selection--multiple
        .select2-selection__choice__remove:hover {
            background: transparent;
            color: #7f1230;
        }

    .select2-container--default
    .select2-selection--multiple
    .select2-selection__clear {
        margin-top: 0;
        margin-right: 3px;
        color: #6b7280;
        font-size: 18px;
        line-height: 1;
    }

    .select2-dropdown {
        border: 1px solid #d1d5db;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .12);
    }

    .select2-container--default
    .select2-results__option--highlighted[aria-selected] {
        background: #a6173f;
        color: #ffffff;
    }

    .select2-container--default
    .select2-results__option[aria-selected=true] {
        background: #faeef2;
        color: #75102d;
    }

    .filter-select-group {
        margin-bottom: 12px;
    }

        .filter-select-group label {
            display: block;
            margin-bottom: 7px;
        }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
    }

    .btn-filter {
        border-color: #a6173f;
        background: #a6173f;
        color: #ffffff;
        font-weight: 700;
    }

        .btn-filter:hover,
        .btn-filter:focus {
            border-color: #7f1230;
            background: #7f1230;
            color: #ffffff;
        }

    @@media(max-width: 767px) {
        .filter-actions {
            margin-top: 8px;
        }

        .delay-radio label {
            min-width: 82px;
        }
    }

    .failure-analysis-indicator {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 82px;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .failure-analysis-light {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        flex: 0 0 11px;
    }

    .failure-analysis-filled {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

        .failure-analysis-filled .failure-analysis-light {
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .18);
        }

    .failure-analysis-pending {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }

        .failure-analysis-pending .failure-analysis-light {
            background: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, .18);
        }
</style>

<div class="xp-breadcrumbbar"
     style="padding: 35px 30px 0 30px;">

    <div class="row">
        <div class="col-lg-12">

            <div class="card maintenance-filter-card mb-3">
                <div class="card-body">

                    <form id="filterForm"
                          method="get"
                          action="@Url.Action("list", "Maintenance")">

                        <div class="row align-items-end">

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="fromDate">
                                        From Date
                                    </label>

                                    <input type="date"
                                           id="fromDate"
                                           name="fromDate"
                                           class="form-control"
                                           value="@ViewBag.FromDate" />
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4">
                                <div class="form-group">
                                    <label for="toDate">
                                        To Date
                                    </label>

                                    <input type="date"
                                           id="toDate"
                                           name="toDate"
                                           class="form-control"
                                           value="@ViewBag.ToDate" />
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">
                                    <label for="plant">
                                        Plant
                                    </label>

                                    <select id="plant"
                                            name="plant"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select plants">

                                        <option value="Rolling Mill 1"
                                                @(selectedPlants.Any(x => x.Equals("Rolling Mill 1", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Rolling Mill 1
                                        </option>

                                        <option value="Rolling Mill 2"
                                                @(selectedPlants.Any(x => x.Equals("Rolling Mill 2", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Rolling Mill 2
                                        </option>

                                        <option value="EAF"
                                                @(selectedPlants.Any(x => x.Equals("EAF", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            EAF
                                        </option>

                                        <option value="LF"
                                                @(selectedPlants.Any(x => x.Equals("LF", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            LF
                                        </option>

                                        <option value="CCM"
                                                @(selectedPlants.Any(x => x.Equals("CCM", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            CCM
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="form-group filter-select-group">

                                    <label for="agency">
                                        Agency
                                    </label>

                                    <select id="agency"
                                            name="agency"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select agencies">

                                        @if (ViewBag.Agencies != null)
                                        {
                                            foreach (
                                                var a
                                                in (IEnumerable<DAL.Models.PlantDelayBLL>)ViewBag.Agencies
                                            )
                                            {
                                                string agencyValue =
                                                    !string.IsNullOrWhiteSpace(
                                                        a.AgencyName
                                                    )
                                                        ? a.AgencyName.Trim()
                                                        : "";

                                                bool isSelected =
                                                    selectedAgencies != null
                                                    &&
                                                    selectedAgencies.Any(
                                                        x =>
                                                            x.Equals(
                                                                agencyValue,
                                                                StringComparison.OrdinalIgnoreCase
                                                            )
                                                    );

                                                <option value="@agencyValue"
                                                        data-code="@a.AgencyCode"
                                                        data-department="@a.Area"
                                                        data-delaytype="@a.DelayType"
                                                        @(isSelected ? "selected" : "")>

                                                    @a.AgencyName

                                                </option>
                                            }
                                        }

                                    </select>

                                </div>
                            </div>

                            <div class="col-xl-3 col-md-8">
                                <div class="form-group">
                                    <label>
                                        Delay Type
                                    </label>

                                    <select id="delayType"
                                            name="delayType"
                                            class="form-control multi-select"
                                            multiple="multiple"
                                            data-placeholder="Select delay types">

                                        <option value="Scheduled"
                                                @(selectedDelayTypes.Any(x => x.Equals("Scheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Scheduled
                                        </option>

                                        <option value="Unscheduled"
                                                @(selectedDelayTypes.Any(x => x.Equals("Unscheduled", StringComparison.OrdinalIgnoreCase)) ? "selected" : "")>
                                            Unscheduled
                                        </option>

                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-md-4">
                            <div class="form-group">
                                <div class="filter-actions">

                                    <button type="submit"
                                            class="btn btn-filter"
                                            title="Apply Filters">
                                        <i class="fa fa-filter"></i>
                                    </button>

                                    <a href="@Url.Action(
                                            "list",
                                            "Maintenance"
                                        )"
                                       class="btn btn-secondary"
                                       title="Clear Filters">
                                        <i class="fa fa-times"></i>
                                    </a>

                                    <button type="submit"
                                            class="btn btn-success"
                                            title="Download Failure Analysis"
                                            formaction="@Url.Action(
                                                    "ExportFailureAnalysisExcel",
                                                    "Maintenance"
                                                )"
                                            formmethod="get">
                                        <i class="fa fa-file-excel-o"></i>
                                        Failure Analysis Report
                                    </button>

                                </div>
                            </div>
                        </div>

                </div>

                </form>

            </div>
        </div>

    </div>
</div>

<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="maintenanceTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Plant</th>
                                    <th>Shift</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Total Duration</th>
                                    <th>Delay Type</th>
                                    <th>Agency</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Description</th>
                                    <th>Failure Analysis</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (delay != null && delay.Any())
                                {
                                    foreach (var item in delay)
                                    {
                                        var gregorian = new CultureInfo("en-US");
                                        gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

                                        bool failureAnalysisFilled =
                                            failureAnalysisStatus.ContainsKey(item.ID) &&
                                            failureAnalysisStatus[item.ID];

                                        <tr>
                                            <td>@(item.Date?.ToString("dd-MM-yyyy", gregorian))</td>
                                            <td>@item.Plant</td>
                                            <td>@item.Area</td>
                                            <td>@item.Shift</td>
                                            <td>@item.StartTime</td>
                                            <td>@item.EndTime</td>
                                            <td>@item.TotalDuration</td>
                                            <td>@item.DelayType</td>
                                            <td>@item.AgencyName</td>
                                            <td>@item.Delaycode</td>
                                            <td>@item.Equipments</td>
                                            <td>@item.DelayDescription</td>
                                            <td class="text-center"
                                                data-order="@(failureAnalysisFilled ? 1 : 0)"
                                                data-search="@(failureAnalysisFilled ? "Filled" : "Pending")">
                                                <span class="failure-analysis-indicator @(failureAnalysisFilled ? "failure-analysis-filled" : "failure-analysis-pending")"
                                                      title="@(failureAnalysisFilled ? "Failure analysis is filled" : "Failure analysis is not filled")">
                                                    <span class="failure-analysis-light"></span>
                                                    <span>
                                                        @(failureAnalysisFilled ? "Filled" : "Pending")
                                                    </span>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action(
                                                        "add",
                                                        "DelayCounterMeasure",
                                                        new
                                                        {
                                                            plantDelayID = item.ID
                                                        }
                                                    )"
                                                   class="btn btn-sm btn-warning"
                                                   title="Countermeasures">

                                                    <i class="fa fa-tasks"></i>
                                                </a>
                                                @*<a href="javascript:void(0);"
                                                       class="btn btn-sm btn-danger btn-delete"
                                                       data-id="@item.ID">
                                                        <i class="mdi mdi-trash-can"></i>
                                                    </a>*@
                                                <a href="@Url.Action("detail", "Maintenance", new { ID = item.ID })" class="btn btn-sm btn-info" onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="14" class="text-center text-muted font-italic">
                                            No data available
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End XP Contentbar -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function () {

        $(".multi-select").each(function () {
            var $select = $(this);

            $select.select2({
                width: "100%",
                closeOnSelect: false,
                allowClear: true,
                placeholder:
                    $select.data("placeholder") ||
                    "Select options"
            });
        });

        // ==============================
        // DATATABLE INIT
        // ==============================
        if ($.fn.DataTable.isDataTable("#maintenanceTable")) {
            $("#maintenanceTable").DataTable().destroy();
        }

        $("#maintenanceTable").DataTable({
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            ordering: true,
            searching: true,
            responsive: true,
            autoWidth: false,
            order: [[0, "desc"]],
            dom: "Bfrtip",
            buttons: [
                {
                    extend: "excelHtml5",
                    text: "Export Excel",
                    className: "btn btn-success btn-sm",
                    title: "Maintenance Record"
                },
                {
                    extend: "pdfHtml5",
                    text: "Export PDF",
                    className: "btn btn-danger btn-sm",
                    title: "Maintenance Record",
                    orientation: "landscape",
                    pageSize: "A4",
                    exportOptions: {
                        columns: ":not(:last-child)"
                    }
                },
                {
                    extend: "print",
                    text: "Print",
                    className: "btn btn-secondary btn-sm",
                    title: "Maintenance Record",
                    exportOptions: {
                        columns: ":not(:last-child)"
                    }
                }
            ],
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ records",
                info: "Showing _START_ to _END_ of _TOTAL_ records",
                emptyTable: "No data available"
            }
        });

        // ==============================
        // CUSTOM EXPORT PDF BUTTON
        // ==============================
        $("#exportPdf").on("click", function () {
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            if (!fromDate) {
                alert("Please select From Date");
                return;
            }

            if (!toDate) {
                alert("Please select To Date");
                return;
            }

            var url = '@Url.Action("ExportMaintenancePdf", "Maintenance")'
                + '?fromDate=' + encodeURIComponent(fromDate)
                + '&toDate=' + encodeURIComponent(toDate);

            window.open(url, "_blank");
        });

    });
</script>