                        </li>

                        <li>
                            <span class="info-label">Cobble</span>
                            <span class="info-value">@(Model.Cobble.HasValue ? Model.Cobble.Value.ToString() : "0")</span>
                        </li>

                        <li>
                            <span class="info-label">Hot Out</span>
