@model DAL.Models.PlantDelayBLL
@using System.Globalization

@{
    ViewBag.Title = "Maintenance Detail";

    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

    var analysis = ViewBag.Analysis as DAL.Models.FailureAnalysisBLL;

    bool hasAnalysis = analysis != null && analysis.ID > 0;

    bool hasLastPMDate = analysis != null && analysis.LastPMDate.HasValue;
    bool hasFailureReportStatus = analysis != null && !string.IsNullOrWhiteSpace(analysis.FailureReportStatus);
    bool hasIncreaseMTBF = analysis != null && !string.IsNullOrWhiteSpace(analysis.IncreaseMTBF);
    bool hasIncreaseMTBF1 = analysis != null && !string.IsNullOrWhiteSpace(analysis.IncreaseMTBF1);
    bool hasDecreaseMTTR = analysis != null && !string.IsNullOrWhiteSpace(analysis.DecreaseMTTR);
    bool hasDecreaseMTTR1 = analysis != null && !string.IsNullOrWhiteSpace(analysis.DecreaseMTTR1);
    bool hasSAPBreakdownOrder = analysis != null && !string.IsNullOrWhiteSpace(analysis.SAPBreakdownOrder);
    bool hasFailureCategory1Component = analysis != null && !string.IsNullOrWhiteSpace(analysis.FailureCategory1Component);
    bool hasFailureCategory2RootCause = analysis != null && !string.IsNullOrWhiteSpace(analysis.FailureCategory2RootCause);

    var actions = ViewBag.Actions as List<DAL.Models.FailureAnalysisBLL>
    ?? new List<DAL.Models.FailureAnalysisBLL>();

    bool showFailureReportStatus = Model != null
        && Model.TotalDuration.HasValue
        && Model.TotalDuration.Value >= 60;
}

<style>
    .detail-wrap {
        padding: 20px;
    }

    .main-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,.06);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .main-card-header {
        background: #7f1010;
        color: #fff;
        padding: 14px 18px;
        font-size: 18px;
        font-weight: 700;
    }

    .main-card-body {
        padding: 18px;
    }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .info-list li {
            display: flex;
            /*justify-content: space-between;*/
            gap: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

            .info-list li:last-child {
                border-bottom: none;
            }

    .info-label {
        color: #6b7280;
        font-weight: 700;
        min-width: 160px;
    }

    .info-value {
        color: #222;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .text-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 15px;
        min-height: 120px;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
        margin-bottom: 15px;
    }

    .text-card-title {
        color: #7f1010;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .text-card-value {
        color: #222;
        font-size: 14px;
        font-weight: 600;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-active {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-inactive {
        background: #f8d7da;
        color: #842029;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .detail-wrap {
            padding: 0;
        }

        .main-card,
        .text-card {
            box-shadow: none;
        }
    }

    .mtbf-mttr-wrapper {
        width: 100%;
    }

    .mtbf-mttr-row {
        margin-bottom: 10px;
        padding: 10px 0;
        border-bottom: 1px dashed #e5e7eb;
    }

        .mtbf-mttr-row:first-child {
            padding-top: 0;
        }

        .mtbf-mttr-row textarea {
            min-height: 58px;
            resize: vertical;
        }

    .mtbf-mttr-remove {
        margin-top: -5px;
        margin-bottom: 10px;
    }

    @@media (max-width: 767px) {
        .mtbf-mttr-remove {
            text-align: left !important;
        }
    }
</style>

@if (Model == null)
{
    <div class="xp-contentbar">
        <div class="alert alert-danger">Record not found.</div>
        <a href="@Url.Action("list", "Maintenance")" class="btn btn-secondary">Back</a>
    </div>
    return;
}

<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">Maintenance Detail</h4>
        </div>
        <div class="col-md-6">
