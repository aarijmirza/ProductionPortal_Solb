                        </li>

                        <li>
                            <span class="info-label">Delay Type</span>
                            <span class="info-value">@(Model.DelayType ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Agency Name</span>
                            <span class="info-value">@(Model.AgencyName ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Agency Code</span>
                            <span class="info-value">@(Model.AgencyCode ?? "-")</span>
                        </li>
                        <li>
                            <span class="info-label">Created Date</span>
                            <span class="info-value">
                                @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt", gregorian) : "-")
                            </span>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- EQUIPMENT CARD -->
    <div class="main-card">
        <div class="main-card-header">
            Equipment Information
        </div>

        <div class="main-card-body">
            <div class="row">

                <div class="col-md-6">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Equipment</span>
                            <span class="info-value">@(Model.Equipments ?? "-")</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Delay Description</span>
                            <span class="info-value">@(Model.DelayDescription ?? "-")</span>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Reason for Occurence</span>
                            <span class="info-value">@(Model.ReasonForOccurence ?? "-")</span>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Action Taken</span>
                            <span class="info-value">@(Model.ActionTaken ?? "-")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- DELAY CORRECTION / UPDATE FORM -->
        <div class="main-card">
            <div class="main-card-header">
                Delay Correction / Additional Remarks
            </div>

            <div class="main-card-body">

                @using (Html.BeginForm("UpdateDelayCorrection", "Maintenance", FormMethod.Post, new { id = "delayCorrectionForm" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="DelayID" value="@Model.ID" />

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Delay Description</label>
                                <textarea class="form-control"
                                          rows="4"
                                          name="DelayDescription1"
                                          placeholder="Enter delay description"
                                          value="@Model.DelayDescription1">@Model.DelayDescription1</textarea>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Reason for Occurrence</label>
                                <textarea class="form-control"
                                          rows="4"
                                          name="ReasonforOccurence1"
                                          placeholder="Enter reason for occurrence"
                                          value="@Model.ReasonForOccurence1">@Model.ReasonForOccurence1</textarea>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Action Taken</label>
                                <textarea class="form-control"
                                          rows="4"
                                          name="ActionTaken1"
                                          placeholder="Enter action taken"
                                          value="@Model.ActionTaken1">@Model.ActionTaken1</textarea>
                            </div>
                        </div>
                    </div>

                    <div class="text-right mt-2">
                        <button type="submit" class="btn btn-success">
                            Update Delay Remarks
                        </button>
                    </div>
                }

            </div>
        </div>
  



    <!-- MAINTENANCE ANALYSIS INPUT FORM -->
    <div class="main-card">
        <div class="main-card-header">
            Maintenance Analysis Form
        </div>

        <div class="main-card-body">

            @using (Html.BeginForm("InsertMaintenanceAnalysis", "Maintenance", FormMethod.Post, new { id = "analysisForm" }))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="ID" value="@(analysis != null ? analysis.ID : 0)" />
                <input type="hidden" name="DelayID" value="@Model.ID" />
                <input type="hidden" name="StatusID" value="1" />

                if (hasAnalysis)
                {
                    <div class="alert alert-info">
                        Existing analysis found. Filled fields are locked. Empty fields are available for input.
                        <br />
                        <b>Analysis Code:</b> @(analysis.AnalysisCode ?? "-")
                    </div>
                }

                <div class="row">

                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Last PM Date</label>
                            <input type="date"
                                   name="LastPMDate"
                                   class="form-control"
                                   value="@(hasLastPMDate ? analysis.LastPMDate.Value.ToString("yyyy-MM-dd") : "")"/>
                        </div>
                    </div>

                    @if (showFailureReportStatus)
                    {
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Failure Report Status</label>

                                @if (hasFailureReportStatus)
                                {
                                    <input type="text"
                                           class="form-control"
                                           value="@analysis.FailureReportStatus"
                                           readonly />

                                    <input type="hidden"
                                           name="FailureReportStatus"
                                           value="@analysis.FailureReportStatus" />
                                }
                                else
                                {
                                    <select name="FailureReportStatus" class="form-control">
                                        <option value="">-- Select Status --</option>
                                        <option value="Open">Open</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                }
                            </div>
                        </div>
                    }

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>SAP Breakdown Order</label>
                            <input type="text"
                                   name="SAPBreakdownOrder"
                                   class="form-control"
                                   maxlength="50"
                                   value="@(hasSAPBreakdownOrder ? analysis.SAPBreakdownOrder : "")"
                                   placeholder="Enter SAP Breakdown Order"/>
                        </div>
                    </div>

                </div>

                <div class="mtbf-mttr-wrapper">

                    <div id="mtbfMttrRows">

                        <div class="row mtbf-mttr-row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Long Term Action Taken to Increase MTBF</label>

                                    <textarea name="IncreaseMTBF"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter MTBF improvement remarks">@(analysis != null ? analysis.IncreaseMTBF : "")</textarea>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Long Term Action Taken to Decrease MTTR</label>

                                    <textarea name="DecreaseMTTR"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter MTTR reduction details">@(analysis != null ? analysis.DecreaseMTTR : "")</textarea>
                                </div>
                            </div>

                        </div>

                        @if (hasIncreaseMTBF1 || hasDecreaseMTTR1)
                        {
                            <div class="row mtbf-mttr-row">

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Additional Action to Increase MTBF</label>

                                        <textarea name="IncreaseMTBF1"
                                                  class="form-control"
                                                  rows="3"
                                                  placeholder="Enter additional MTBF action">@(analysis != null ? analysis.IncreaseMTBF1 : "")</textarea>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Additional Action to Decrease MTTR</label>

                                        <textarea name="DecreaseMTTR1"
                                                  class="form-control"
                                                  rows="3"
                                                  placeholder="Enter additional MTTR action">@(analysis != null ? analysis.DecreaseMTTR1 : "")</textarea>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>

                    @if (!hasIncreaseMTBF1 && !hasDecreaseMTTR1)
                    {
                        <div class="row">
                            <div class="col-md-12 text-right mb-3">
                                <button type="button"
                                        id="btnAddMtbfMttr"
                                        class="btn btn-sm btn-success">
                                    + Add More
                                </button>
                            </div>
                        </div>
                    }

                </div>

                <!--<div class="row mtbf-mttr-row" id="mtbfMttrRows">

        <div class="col-md-5">
            <div class="form-group">
                <label>Action Taken to Increase MTBF</label>
                <textarea name="IncreaseMTBFAction[]"
                          class="form-control"
                          rows="2"
                          placeholder="Enter MTBF improvement remarks"></textarea>
            </div>
        </div>

        <div class="col-md-5">
            <div class="form-group">
                <label>Action Taken Decrease MTTR</label>
                <textarea name="DecreaseMTTRAction[]"
                          class="form-control"
                          rows="2"
                          placeholder="Enter MTTR reduction details"></textarea>
            </div>
        </div>


        <div class="col-md-2" style=" align-content: center;">
            <div class="col-md-12 text-right">
                <button type="button" id="btnAddMtbfMttr" class="btn btn-sm btn-success">
                    + Add More
                </button>
            </div>
        </div>-->

                @*<div class="col-md-6">
                <div class="form-group">
                    <label>Action Taken to Increase MTBF</label>
                    <textarea name="IncreaseMTBF1"
                              class="form-control"
                              rows="2"
                              placeholder="Enter MTBF improvement remarks"
                              @(hasIncreaseMTBF1 ? "readonly" : "")>@(hasIncreaseMTBF1 ? analysis.IncreaseMTBF1 : "")</textarea>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Action Taken Decrease MTTR</label>
                    <textarea name="DecreaseMTTR"
