                            <span class="info-value">
                                @(Model.Date.HasValue ? Model.Date.Value.ToString("dd-MMM-yyyy", gregorian) : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">Delay Code</span>
                            <span class="info-value">@(Model.Delaycode ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Area</span>
                            <span class="info-value">@(Model.Area ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Plant</span>
                            <span class="info-value">@(Model.Plant ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Shift</span>
                            <span class="info-value">@(Model.Shift ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Team</span>
                            <span class="info-value">@(Model.Team ?? "-")</span>
                        </li>

                        <li>
                            <span class="info-label">Shift Incharge</span>
                            <span class="info-value">@(Model.ShiftIncharge ?? "-")</span>
                        </li>
                        <li>
                            <span class="info-label">Created By</span>
                            <span class="info-value">@(Model.CreatedBy ?? "-")</span>
                        </li>
                    </ul>
                </div>

                <!-- RIGHT LIST -->
                <div class="col-md-6">
                    <ul class="info-list">
                        <li>
                            <span class="info-label">Start Time</span>
                            <span class="info-value">
                                @(Model.StartTime.HasValue ? Model.StartTime.Value.ToString(@"hh\:mm") : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">End Time</span>
                            <span class="info-value">
                                @(Model.EndTime.HasValue ? Model.EndTime.Value.ToString(@"hh\:mm") : "-")
                            </span>
                        </li>

                        <li>
                            <span class="info-label">Total Duration</span>
                            <span class="info-value">
                                @(Model.TotalDuration.HasValue ? Model.TotalDuration.Value + " Min" : "-")
