                <!--</div>-->

                <div class="row">

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Failure Category 1 - Component</label>
                            <textarea name="FailureCategory1Component"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Enter component failure category">@(hasFailureCategory1Component ? analysis.FailureCategory1Component : "")</textarea>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Failure Category 2 - Root Cause</label>

                            @if (hasFailureCategory2RootCause)
                            {
                                <input type="text"
                                       class="form-control"
                                       value="@analysis.FailureCategory2RootCause"/>

                                <input type="hidden"
                                       name="FailureCategory2RootCause"
                                       value="@analysis.FailureCategory2RootCause" />
                            }
                            else
                            {
                                <select class="form-control" name="FailureCategory2RootCause">
                                    <option value="">-- please select --</option>
                                    <option value="Shortage of Spares">Shortage of Spares</option>
                                    <option value="Can Be avoided">Can Be avoided</option>
                                    <option value="Machine Poor Condition">Machine Poor Condition</option>
                                    <option value="Undetectable failure">Undetectable failure</option>
                                    <option value="Poor Operation Condition">Poor Operation Condition</option>
                                    <option value="Human Mistake">Human Mistake</option>
                                    <option value="Design issues">Design issues</option>
                                </select>
                            }
                        </div>
                    </div>

                </div>

                <div class="text-right mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        @(hasAnalysis ? "Update Missing Information" : "Save Analysis")
                    </button>
                </div>
            }

        </div>
    </div>

    <div class="text-right no-print">
        <a href="@Url.Action("list", "Maintenance")" class="btn btn-secondary">
            Back
        </a>

        <button type="button" class="btn btn-danger" onclick="window.print()">
            Print
        </button>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        $("#analysisForm").on("submit", function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Confirm Submission",
                text: "Are you sure you want to save this maintenance analysis?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, Save",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33"
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#analysisForm")[0].submit();
                }
            });
        });

    });
</script>
<script>
    $(document).ready(function () {

        $("#btnAddMtbfMttr").on("click", function () {

            if ($("#additionalMtbfMttrRow").length > 0) {
                return;
            }

            var html = `
                <div class="mtbf-mttr-row" id="additionalMtbfMttrRow">
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Additional Action to Increase MTBF</label>

                                <textarea name="IncreaseMTBF1"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter additional MTBF action"></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Additional Action to Decrease MTTR</label>

                                <textarea name="DecreaseMTTR1"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter additional MTTR action"></textarea>
                            </div>
                        </div>

                        <div class="col-md-12 text-right mtbf-mttr-remove">
                            <button type="button"
                                    class="btn btn-sm btn-danger btnRemoveMtbfMttr">
                                Remove
                            </button>
                        </div>

                    </div>
                </div>
            `;

            $("#mtbfMttrRows").append(html);
            $("#btnAddMtbfMttr").hide();
        });

        $(document).on("click", ".btnRemoveMtbfMttr", function () {
            $(this).closest(".mtbf-mttr-row").remove();
            $("#btnAddMtbfMttr").show();
        });

    });
</script>