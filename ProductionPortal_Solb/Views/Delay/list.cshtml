                                            <td>@item.Area</td>
                                            <td>@item.Shift</td>
                                            <td>@item.StartTime</td>
                                            <td>@item.EndTime</td>
                                            <td>@item.TotalDuration</td>
                                            <td>@item.AgencyName</td>
                                            <td>@item.Equipments</td>
                                            <td>@item.Reason</td>
                                            <td>
                                                @*<a href="javascript:void(0);"
                                                   onclick="openDelayPopup('@item.ID', '@(item.Date?.ToString("yyyy-MM-dd"))', '@item.Area' )"
                                                   class="btn btn-sm btn-success">
                                                    <i class="mdi mdi-plus"></i>
                                                </a>*@

                                                @*<a href="@Url.Action("details", "CCM", new { ID = item.ID })"
                                                   class="btn btn-sm btn-info"
                                                   onclick="event.stopPropagation();">
                                                    <i class="mdi mdi-book-open-page-variant"></i>
                                                </a>*@

                                                <a href="javascript:void(0);"
                                                   class="btn btn-sm btn-danger btn-delete"
                                                   data-id="@item.ID">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted font-italic">
                                            No data available
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
