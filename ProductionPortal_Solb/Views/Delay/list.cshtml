@using System.Globalization
@{
    ViewBag.Title = "list";
    var delay = Model as List<DAL.Models.PlantDelayBLL>;
}
<style>
    .kpi-box {
        padding: 10px 12px;
        border-radius: 6px;
        color: #fff;
        height: 70px;
    }

    .kpi-title {
        font-size: 12px;
        opacity: 0.8;
    }

    .kpi-value {
        font-size: 20px;
        font-weight: bold;
        margin-top: 3px;
    }

    .bg-primary {
        background-color: #007bff;
    }

    .bg-success {
        background-color: #28a745;
    }
</style>

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Delays Record</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Delays</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Record</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- Filters Section -->
<div class="xp-breadcrumbbar" style="padding: 50px 30px 0 30px;">
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-3">
                <div class="card-body">
                    <form id="filterForm" method="get" action="@Url.Action("list", "Delay")" class="d-flex justify-content-between">

                        <div class="d-flex">
                            <div class="form-group mr-3">
                                <label for="filterDate" class="mr-2">Select Date</label>
                                <input type="date"
                                       id="filterDate"
                                       name="date"
                                       class="form-control"
                                       value="@ViewBag.SelectedDate" />
                            </div>

                            <div class="col-md-2">
                                <label>Plant</label>
                                <select id="plantFilter" class="form-control">
                                    <option value="">All</option>
                                    <option value="Rolling Mill 1">RM1</option>
                                    <option value="Rolling Mill 2">RM2</option>
                                </select>
                            </div>

                            <div class="form-group mr-3">
                                <label for="shiftFilter">Shift</label>
                                <select id="shiftFilter" name="shift" class="form-control">
                                    <option value="" @(ViewBag.Shift == "" ? "selected" : "")>All</option>
                                    <option value="Morning" @(ViewBag.Shift == "Morning" ? "selected" : "")>Morning</option>
                                    <option value="Afternoon" @(ViewBag.Shift == "Evening" ? "selected" : "")>Afternoon</option>
                                    <option value="Night" @(ViewBag.Shift == "Night" ? "selected" : "")>Night</option>
                                    <option value="Long Morning" @(ViewBag.Shift == "Long Morning" ? "selected" : "")>Long Morning</option>
                                    <option value="Long Night" @(ViewBag.Shift == "Long Night" ? "selected" : "")>Long Night</option>
                                </select>
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <button type="submit" class="btn btn-primary mr-2">Filter</button>

                                <a href="@Url.Action("list", "Delay")" class="btn btn-secondary">
                                    Clear
                                </a>
                            </div>

                            <div class="form-group d-flex align-items-end mr-3">
                                <div>
                                    <small>Total Records</small><br />
                                    <span class="badge badge-primary p-2" id="totalRecordCount">0</span>
                                </div>

                                <div style="padding-left: 25px;">
                                    <small>Total Delay Time</small><br />
                                    <span class="badge badge-success p-2" id="totalDelayTime">0</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <div class="form-group d-flex align-items-end mr-3">
                                <a id="addSampleBtn" class="btn btn-info text-white" href="@Url.Action("add", "Delay")">
                                    <i class="fa fa-plus-circle"></i> Add Delay
                                </a>
                            </div>

                            <div class="form-group d-flex align-items-end">
                                <button type="button" id="exportPdf" class="btn btn-danger mr-2">
                                    <i class="fa fa-file-pdf-o"></i> Export PDF
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Filter Section -->
<!-- Start XP Contentbar -->
<div class="xp-contentbar">
    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="delayListTable">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Area</th>
                                    <th>Shift</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Total Duration</th>
                                    <th>Delay Code</th>
                                    <th>Equipment</th>
                                    <th>Reason</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (delay != null)
                                {
                                    foreach (var item in delay)
                                    {
                                        var gregorian = new CultureInfo("en-US");
                                        gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

                                        <tr>
