<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var table;

    $(document).ready(function () {

        // ==============================
        // DATATABLE INIT - ONLY ONCE
        // ==============================
        if ($.fn.DataTable.isDataTable('#delayListTable')) {
            table = $('#delayListTable').DataTable();
        } else {
            table = $('#delayListTable').DataTable({
                order: [[0, 'desc']],
                pageLength: 10
            });
        }

        updateSummary();

        table.on('draw', function () {
            updateSummary();
        });

        // ==============================
        // FILTER FORM VALIDATION
        // Single date only
        // ==============================
        $('#filterForm').on('submit', function (e) {

            var selectedDate = $('#filterDate').val();

            if (!selectedDate) {
                e.preventDefault();

                Swal.fire({
                    icon: 'error',
                    title: 'Date Required',
                    text: 'Please select date.'
                });

                return false;
            }

            return true;
        });

        // ==============================
        // EXPORT PDF - SINGLE DATE
        // ==============================
        $('#exportPdf').on('click', function () {

            var selectedDate = $('#filterDate').val() || '';
            var shift = $('#shiftFilter').val() || '';

            if (!selectedDate) {
                Swal.fire({
                    icon: 'error',
                    title: 'Date Required',
                    text: 'Please select date before exporting.'
                });
                return;
            }

            var url = '@Url.Action("GenerateDelayReportPDF", "RollingMill")'
                + '?startdate=' + encodeURIComponent(selectedDate)
                + '&enddate=' + encodeURIComponent(selectedDate)
                + '&shift=' + encodeURIComponent(shift);

            window.open(url, '_blank');
        });

        // ==============================
        // DELETE BUTTON
        // ==============================
        $(document).on('click', '.btn-delete', function (e) {
            e.preventDefault();
            e.stopPropagation();

            var id = $(this).data('id');

            Swal.fire({
                title: 'Are you sure?',
                text: 'This record will be permanently deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {

                if (result.isConfirmed) {
                    window.location.href = '/delay/delete?ID=' + id;
                }
            });
        });

        // ==============================
        // MODAL DURATION CALCULATION
        // ==============================
        $(document).on('change keyup', "input[name='StartTime'], input[name='EndTime']", function () {

            var start = $("input[name='StartTime']").val();
            var end = $("input[name='EndTime']").val();

            if (start && end) {
                var startDate = new Date('2000-01-01T' + start);
                var endDate = new Date('2000-01-01T' + end);

                if (endDate < startDate) {
                    endDate.setDate(endDate.getDate() + 1);
                }

                var diffMs = endDate - startDate;
                var diffMins = Math.floor(diffMs / 60000);

                var hours = Math.floor(diffMins / 60);
                var minutes = diffMins % 60;

                $('#popupDuration').val(hours + 'h ' + minutes + 'm');
            }
        });

    });

    // ==============================
    // OPEN FAILURE ANALYSIS POPUP
    // ==============================
    function openDelayPopup(id, date, area) {
        $('#popupDelayID').val(id);
        $('#popupDate').val(date);
        $('#popupArea').val(area);
        $('#popupDuration').val('');

        $('#delayPopupModal').modal('show');
    }

    // ==============================
    // SUMMARY CALCULATION
    // ==============================
    function updateSummary() {
        if (!table) return;

        var data = table.rows({ search: 'applied' }).data();

        var totalRecords = data.length;
        var totalDuration = 0;

        for (var i = 0; i < data.length; i++) {
            var durationText = $('<div>').html(data[i][5]).text().trim();
            totalDuration += parseDurationToMinutes(durationText);
        }

        $('#totalRecordCount').text(totalRecords);
        $('#totalDelayTime').text(formatMinutes(totalDuration));
    }

    function parseDurationToMinutes(value) {
        if (!value) return 0;

        value = value.toString().trim();

        if (/^\d+(\.\d+)?$/.test(value)) {
            return parseFloat(value);
        }

        if (value.indexOf(':') > -1) {
            var parts = value.split(':').map(Number);

            if (parts.length === 3) {
                return (parts[0] * 60) + parts[1] + (parts[2] / 60);
            }

            if (parts.length === 2) {
                return (parts[0] * 60) + parts[1];
            }
        }

        var hourMatch = value.match(/(\d+)\s*h/i);
        var minMatch = value.match(/(\d+)\s*m/i);

        var hours = hourMatch ? parseInt(hourMatch[1], 10) : 0;
        var mins = minMatch ? parseInt(minMatch[1], 10) : 0;

        return (hours * 60) + mins;
    }

    function formatMinutes(totalMinutes) {
        totalMinutes = Math.round(totalMinutes);

        var hours = Math.floor(totalMinutes / 60);
        var minutes = totalMinutes % 60;

        if (hours > 0) {
            return hours + 'h ' + minutes + 'm';
        }

        return minutes + ' min';
    }
</script>



<!-- Add Extra Delay Detail Modal -->
<div class="modal fade" id="delayPopupModal" tabindex="-1" role="dialog" aria-labelledby="delayPopupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <form action="/Delay/AddDelayPopupDetail" method="post" id="delayPopupForm">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="delayPopupModalLabel">Failure Analysis Detail</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="popupDelayID" name="DelayID" />

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Last P.M Date</label>
                            <input type="date" id="popupDate" name="LastPMDate" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Report Status</label>
                            <select class="form-control" name="FailureReportStatus">
                                <option selected disabled>-- please select --</option>
                                <option value="Done">Done</option>
                                <option value="Not Done">Not Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>
                                Long term Action To increase MTBF
                            </label>
                            <textarea class="form-control" rows="3" name="IncreaseMTBF"></textarea>
                        </div>

                        <div class="form-group col-md-6">
                            <label>
                                Long term Action To decrease MTTR
                            </label>
                            <textarea class="form-control" rows="3" name="DecreaseMTTR"></textarea>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>SAP Breakdown Order</label>
                            <input type="text" id="popupDate" name="SAPBreakdownOrder" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Category1 (Component)</label>
                            <input type="text" id="popupDate" name="FailureCategory1Component" class="form-control" />
                        </div>

                        <div class="form-group col-md-4">
                            <label>Failure Category2 (Root Cause)</label>
                            <input type="text" id="popupDate" name="FailureCategory2RootCause" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        Close
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>