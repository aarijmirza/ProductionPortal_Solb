@model DAL.Models.ExecutiveOperationsDashboardVM
@using System
@using System.Linq
@using System.Collections.Generic
@using Newtonsoft.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Executive Operations Dashboard";

    var dashboard = Model ?? new DAL.Models.ExecutiveOperationsDashboardVM();
    var summary = dashboard.Summary ?? new DAL.Models.ExecutiveSummaryVM();
    var selectedProduction = dashboard.SelectedProduction ?? new DAL.Models.ProductionPeriodVM();
    var mtdProduction = dashboard.MTDProduction ?? new DAL.Models.ProductionPeriodVM();
    var ytdProduction = dashboard.YTDProduction ?? new DAL.Models.ProductionPeriodVM();
    var supply = dashboard.SupplyChain ?? new DAL.Models.SupplyChainSnapshotVM();
    var departments = dashboard.Departments ?? new List<DAL.Models.DepartmentPerformanceVM>();
    var utilities = dashboard.Utilities ?? new List<DAL.Models.UtilityComplianceVM>();
    var risks = dashboard.TopRisks ?? new List<DAL.Models.OperationalRiskVM>();
    var actions = dashboard.ManagementActions ?? new List<DAL.Models.ManagementActionVM>();
    var productionTrend = dashboard.ProductionTrend ?? new List<DAL.Models.ProductionTrendVM>();
    var validationIssues = dashboard.DataValidationIssues ?? new List<DAL.Models.DataValidationIssueVM>();

    decimal supplyScore = summary.DispatchMTDTarget > 0
        ? Math.Min(100m, summary.DispatchMTD * 100m / summary.DispatchMTDTarget)
        : 0m;

    decimal dataQualityScore = Math.Max(0m, Math.Min(100m, summary.DataQualityScore));

    decimal selectedTotal = selectedProduction.Total;
    decimal mtdTotal = mtdProduction.Total;
    decimal ytdTotal = ytdProduction.Total;

    decimal smpSelectedShare = selectedTotal > 0m
        ? selectedProduction.SMP * 100m / selectedTotal
        : 0m;
    decimal rm1SelectedShare = selectedTotal > 0m
        ? selectedProduction.RM1 * 100m / selectedTotal
        : 0m;
    decimal rm2SelectedShare = selectedTotal > 0m
        ? selectedProduction.RM2 * 100m / selectedTotal
        : 0m;

    string assuranceClass = summary.DataQualityStatus == "Validated"
        ? string.Empty
        : (summary.DataQualityStatus == "Review" ? "review" : "attention");

    string reportPeriod = dashboard.FromDate == dashboard.ToDate
        ? dashboard.ToDate.ToString("dd MMM yyyy")
        : dashboard.FromDate.ToString("dd MMM") + " - " + dashboard.ToDate.ToString("dd MMM yyyy");

    Func<decimal, string> number0 = value => value.ToString("N0");
    Func<decimal, string> number1 = value => value.ToString("N1");
    Func<decimal, string> signed1 = value =>
        (value > 0 ? "+" : string.Empty) + value.ToString("N1") + "%";
    Func<decimal, string> scoreClass = value =>
        value >= 90m ? "good" : (value >= 75m ? "warn" : "bad");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --solb-maroon: #a81435;
        --solb-maroon-dark: #76001d;
        --solb-red: #c8102e;
        --solb-green: #168b5b;
        --solb-orange: #f59e0b;
        --solb-blue: #1769aa;
        --solb-navy: #183346;
        --page-bg: #edf1f5;
        --card-bg: #ffffff;
        --border: #dce2e9;
        --line: #e9edf2;
        --text: #17202d;
        --muted: #6c7687;
        --radius: 13px;
        --shadow: 0 5px 18px rgba(21, 32, 48, .07);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--page-bg);
        color: var(--text);
    }

    .xp-contentbar {
        /*        padding: 18px !important;
    */ background: var(--page-bg) !important;
    }

    .executive-dashboard {
        width: 100%;
        max-width: 1640px;
        margin: 0 auto;
    }

    /* =========================================================
           PAGE HEADER
        ========================================================= */

    .executive-header {
        position: relative;
        overflow: hidden;
        min-height: 142px;
        padding: 28px 30px;
        border-radius: 18px;
        background: linear-gradient(120deg, #640018 0%, var(--solb-maroon) 58%, #c62d50 100%);
        color: #ffffff;
        box-shadow: 0 14px 35px rgba(100, 0, 24, .20);
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 20px;
    }

        .executive-header::after {
            content: "";
            position: absolute;
            width: 310px;
            height: 310px;
            right: -115px;
            top: -155px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

    .header-main {
        position: relative;
        z-index: 2;
    }

    .header-tag {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 10px;
        margin-bottom: 9px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.11);
        font-size: 11px;
        font-weight: 700;
    }

    .header-main h2 {
        margin: 0;
        color: #ffffff;
        font-size: 32px;
        line-height: 1.1;
        font-weight: 900;
        letter-spacing: -.3px;
    }

    .header-main p {
        margin: 8px 0 0;
        color: rgba(255,255,255,.9);
        max-width: 680px;
        font-size: 13px;
        font-weight: 600;
    }

    .header-side {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 170px 220px;
        align-items: stretch;
        gap: 10px;
    }

    .executive-index,
    .header-meta {
        min-height: 88px;
        padding: 13px 15px;
        border-radius: 13px;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(255,255,255,.11);
        backdrop-filter: blur(5px);
    }

        .executive-index small,
        .executive-index span {
            display: block;
            color: rgba(255,255,255,.76);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .45px;
        }

        .executive-index strong {
            display: block;
            margin: 5px 0 4px;
            color: #fff;
            font-size: 29px;
            line-height: 1;
            font-weight: 950;
        }

        .executive-index .index-status {
            display: inline-flex;
            padding: 3px 7px;
            border-radius: 12px;
            background: rgba(255,255,255,.16);
            color: #fff;
            font-size: 9px;
            font-weight: 850;
            text-transform: none;
        }

    .report-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fff;
        box-shadow: var(--shadow);
    }

    .toolbar-context {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .toolbar-context-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f7e9ed;
        color: var(--solb-maroon);
    }

    .toolbar-context strong,
    .toolbar-context small {
        display: block;
    }

    .toolbar-context strong {
        color: var(--text);
        font-size: 12px;
        font-weight: 900;
    }

    .toolbar-context small {
        margin-top: 2px;
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
    }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-filter {
        display: flex;
        align-items: end;
        gap: 8px;
        padding: 9px 10px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: #f8fafc;
    }

        .header-filter label {
            display: block;
            margin: 0;
            color: var(--muted);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .header-filter input {
            width: 125px;
            height: 34px;
            margin-top: 3px;
            padding: 5px 7px;
            border: 1px solid #ccd4de;
            border-radius: 7px;
            background: #fff;
            color: #263142;
            font-size: 11px;
            font-weight: 700;
        }

    .filter-btn {
        height: 34px;
        padding: 0 12px;
        border: 0;
        border-radius: 7px;
        background: var(--solb-maroon);
        color: #fff;
        font-size: 10px;
        font-weight: 900;
        cursor: pointer;
    }

    .header-meta {
        text-align: right;
    }

        .header-meta small {
            display: block;
            color: rgba(255,255,255,.72);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .header-meta strong {
            display: block;
            margin-top: 3px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 900;
        }

    .print-btn {
        height: 42px;
        padding: 0 15px;
        border: 1px solid #e2c0c9;
        border-radius: 9px;
        background: #fff;
        color: var(--solb-maroon);
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
        white-space: nowrap;
    }

        .print-btn i {
            margin-right: 6px;
        }

        .print-btn:hover {
            background: #f8e8ed;
        }

    /* =========================================================
           COMMON CARD
        ========================================================= */

    .dashboard-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-header {
        min-height: 48px;
        padding: 12px 15px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .card-title {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text);
        font-size: 15px;
        font-weight: 900;
    }

        .card-title i {
            color: var(--solb-maroon);
            font-size: 14px;
        }

    .card-note {
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .card-body {
        padding: 15px;
    }

    /* =========================================================
           EXECUTIVE KPI CARDS
        ========================================================= */

    .executive-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 14px;
    }

    .executive-kpi {
        position: relative;
        min-height: 142px;
        padding: 17px 18px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(22, 34, 50, .06);
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .executive-kpi:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(22, 34, 50, .10);
        }

        .executive-kpi::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--solb-orange);
        }

        .executive-kpi.good::before {
            background: var(--solb-green);
        }

        .executive-kpi.bad::before {
            background: var(--solb-maroon);
        }

        .executive-kpi.info::before {
            background: var(--solb-blue);
        }

    .kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

    .kpi-label {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.3;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .kpi-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: #f6e8ec;
        color: var(--solb-maroon);
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        font-size: 12px;
    }

    .executive-kpi.good .kpi-icon {
        background: #e4f3ec;
        color: var(--solb-green);
    }

    .executive-kpi.info .kpi-icon {
        background: #e6f0f9;
        color: var(--solb-blue);
    }

    .kpi-value {
        margin-top: 12px;
        color: var(--text);
        font-size: 28px;
        line-height: 1;
        font-weight: 900;
    }

    .kpi-subtitle {
        margin-top: 8px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.35;
        font-weight: 650;
    }

    .kpi-status {
        display: inline-flex;
        margin-top: 9px;
        padding: 3px 7px;
        border-radius: 12px;
        background: #eef1f5;
        color: var(--muted);
        font-size: 10px;
        font-weight: 900;
    }

        .kpi-status.good {
            background: #e3f3ea;
            color: var(--solb-green);
        }

        .kpi-status.warn {
            background: #fff2d9;
            color: #a66500;
        }

        .kpi-status.bad {
            background: #f8e5e9;
            color: var(--solb-maroon);
        }

        .kpi-status.info {
            background: #e8f1f9;
            color: var(--solb-blue);
        }

    /* =========================================================
           THREE-PLANT PORTFOLIO
        ========================================================= */

    .plant-portfolio-section {
        margin-top: 14px;
    }

    .section-heading-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
        padding: 0 2px;
    }

        .section-heading-row h3 {
            margin: 0;
            color: var(--text);
            font-size: 19px;
            font-weight: 950;
        }

        .section-heading-row p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
        }

    .portfolio-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border: 1px solid #d9e0e8;
        border-radius: 20px;
        background: #fff;
        color: var(--text);
        font-size: 9px;
        font-weight: 900;
        white-space: nowrap;
    }

        .portfolio-badge i {
            color: var(--solb-maroon);
        }

    .plant-portfolio-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .plant-card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 15px;
        background: #fff;
        box-shadow: var(--shadow);
    }

        .plant-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: var(--plant-color);
        }

        .plant-card.smp {
            --plant-color: var(--solb-maroon);
        }

        .plant-card.rm1 {
            --plant-color: var(--solb-blue);
        }

        .plant-card.rm2 {
            --plant-color: var(--solb-green);
        }

    .plant-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 15px 17px 11px 20px;
    }

    .plant-identity {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .plant-symbol {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f7e8ec;
        color: var(--plant-color);
        font-size: 14px;
    }

    .plant-card.rm1 .plant-symbol {
        background: #e8f1f9;
    }

    .plant-card.rm2 .plant-symbol {
        background: #e5f3ed;
    }

    .plant-title strong,
    .plant-title span {
        display: block;
    }

    .plant-title strong {
        color: var(--text);
        font-size: 14px;
        font-weight: 950;
    }

    .plant-title span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .plant-share {
        padding: 5px 9px;
        border-radius: 16px;
        background: #f2f5f8;
        color: var(--plant-color);
        font-size: 10px;
        font-weight: 950;
    }

    .plant-primary {
        padding: 0 17px 12px 20px;
    }

        .plant-primary small {
            display: block;
            color: var(--muted);
            font-size: 8px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .plant-primary strong {
            display: block;
            margin-top: 3px;
            color: var(--text);
            font-size: 27px;
            line-height: 1;
            font-weight: 950;
        }

    .plant-metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        padding: 0 17px 12px 20px;
    }

    .plant-metric {
        padding: 9px 10px;
        border: 1px solid #e5eaf0;
        border-radius: 9px;
        background: #f9fafc;
    }

        .plant-metric span,
        .plant-metric strong {
            display: block;
        }

        .plant-metric span {
            color: var(--muted);
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .plant-metric strong {
            margin-top: 3px;
            color: var(--text);
            font-size: 13px;
            font-weight: 950;
        }

    .plant-context {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-height: 27px;
        padding: 0 17px 8px 20px;
    }

        .plant-context span {
            display: inline-flex;
            padding: 4px 7px;
            border-radius: 12px;
            background: #eef2f6;
            color: #566174;
            font-size: 8px;
            font-weight: 850;
        }

    .plant-trend-box {
        height: 115px;
        padding: 0 10px 10px 13px;
        position: relative;
    }

    .portfolio-breakdown {
        color: var(--muted) !important;
        line-height: 1.35;
    }

    /* =========================================================
           TOP ANALYTICS
        ========================================================= */

    /*    .top-analytics {
            display: grid;
            grid-template-columns: 1.35fr 1fr .82fr;
            gap: 13px;
            margin-top: 14px;
        }*/

    .top-analytics {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 14px;
        margin-top: 14px;
        align-items: start;
    }

    .trend-health-column {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

        .trend-health-column .dashboard-card {
            width: 100%;
        }

        .trend-health-column .chart-box {
            height: 285px;
        }

        .trend-health-column .health-score-layout {
            min-height: 255px;
        }

    .chart-box {
        height: 295px;
        position: relative;
    }

    .production-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
        margin-bottom: 12px;
    }

    .production-mini {
        padding: 10px;
        border: 1px solid #e4e8ee;
        border-radius: 9px;
        background: #fafbfc;
    }

        .production-mini small {
            color: var(--muted);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .production-mini strong {
            display: block;
            margin-top: 4px;
            color: var(--text);
            font-size: 17px;
            font-weight: 900;
        }

        .production-mini span {
            display: block;
            margin-top: 3px;
            color: var(--solb-green);
            font-size: 9px;
            font-weight: 800;
        }

    /* =========================================================
           HEALTH SCORE
        ========================================================= */

    .health-score-layout {
        display: grid;
        grid-template-columns: 145px 1fr;
        gap: 15px;
        align-items: center;
    }

    .health-donut-wrap {
        width: 140px;
        height: 140px;
        position: relative;
        margin: auto;
    }

    .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        pointer-events: none;
    }

        .donut-center strong {
            color: var(--text);
            font-size: 25px;
            font-weight: 900;
        }

        .donut-center span {
            margin-top: 2px;
            color: var(--muted);
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }

    .health-list {
        display: grid;
        gap: 9px;
    }

    .health-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        align-items: center;
    }

    .health-name {
        color: var(--muted);
        font-size: 10px;
        font-weight: 750;
    }

    .health-value {
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    .health-track {
        grid-column: 1 / -1;
        height: 5px;
        border-radius: 10px;
        background: #edf0f4;
        overflow: hidden;
    }

        .health-track span {
            display: block;
            height: 100%;
            border-radius: 10px;
            background: var(--solb-green);
        }

        .health-track.warn span {
            background: var(--solb-orange);
        }

        .health-track.bad span {
            background: var(--solb-maroon);
        }

        .health-track.smp span {
            background: var(--solb-maroon);
        }

        .health-track.rm1 span {
            background: var(--solb-blue);
        }

        .health-track.rm2 span {
            background: var(--solb-green);
        }

    /* =========================================================
           DEPARTMENT PERFORMANCE
        ========================================================= */

    .department-section {
        margin-top: 14px;
    }

    .department-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 11px;
    }

    .department-card {
        padding: 13px;
        border: 1px solid #e1e6ed;
        border-radius: 10px;
        background: #fbfcfd;
    }

    .department-head {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: center;
    }

    .department-name {
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    .department-score {
        font-size: 14px;
        font-weight: 900;
        color: var(--solb-green);
    }

        .department-score.info {
            color: var(--solb-blue);
        }

        .department-score.warn {
            color: var(--solb-orange);
        }

        .department-score.bad {
            color: var(--solb-maroon);
        }

    .department-progress {
        height: 7px;
        margin-top: 10px;
        background: #e9edf2;
        border-radius: 10px;
        overflow: hidden;
    }

        .department-progress span {
            display: block;
            height: 100%;
            border-radius: 10px;
            background: var(--solb-green);
        }

        .department-progress.warn span {
            background: var(--solb-orange);
        }

        .department-progress.bad span {
            background: var(--solb-maroon);
        }

        .department-progress.info span {
            background: var(--solb-blue);
        }

    .department-metric {
        margin-top: 4px;
        color: var(--muted);
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .25px;
    }

    .department-meta {
        margin-top: 8px;
        display: flex;
        justify-content: space-between;
        color: var(--muted);
        font-size: 8px;
        font-weight: 700;
    }

    /* =========================================================
           MIDDLE GRID
        ========================================================= */

    .middle-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 13px;
        margin-top: 14px;
    }

    /* =========================================================
           TOP RISKS
        ========================================================= */

    .risk-list {
        display: grid;
        gap: 8px;
    }

    .risk-item {
        display: grid;
        grid-template-columns: 28px 1fr auto;
        gap: 9px;
        align-items: center;
        padding: 9px;
        border: 1px solid #e9edf2;
        border-radius: 9px;
        background: #fbfcfd;
    }

    .risk-rank {
        width: 24px;
        height: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 7px;
        background: var(--solb-maroon);
        color: #ffffff;
        font-size: 10px;
        font-weight: 900;
    }

        .risk-rank.warn {
            background: var(--solb-orange);
        }

    .risk-title {
        color: var(--text);
        font-size: 10px;
        font-weight: 850;
    }

    .risk-detail {
        margin-top: 2px;
        color: var(--muted);
        font-size: 8px;
        line-height: 1.25;
        font-weight: 650;
    }

    .risk-value {
        text-align: right;
        color: var(--text);
        font-size: 11px;
        font-weight: 900;
    }

    /* =========================================================
           SUPPLY CHAIN SNAPSHOT
        ========================================================= */

    .supply-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 9px;
    }

    .supply-item {
        padding: 10px;
        border-radius: 9px;
        border: 1px solid #e6eaf0;
        background: #fafbfc;
    }

    .supply-icon {
        width: 29px;
        height: 29px;
        border-radius: 8px;
        background: #f5e7eb;
        color: var(--solb-maroon);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 12px;
    }

    .supply-label {
        margin-top: 8px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .supply-value {
        margin-top: 4px;
        color: var(--text);
        font-size: 18px;
        font-weight: 900;
    }

    .supply-sub {
        margin-top: 3px;
        color: var(--muted);
        font-size: 8px;
        font-weight: 650;
    }

    /* =========================================================
           UTILITY COMPLIANCE
        ========================================================= */

    .utility-table {
        width: 100%;
        border-collapse: collapse;
    }

        .utility-table th {
            padding: 9px 7px;
            background: #f0f3f6;
            color: var(--muted);
            font-size: 8px;
            text-align: center;
            font-weight: 900;
            text-transform: uppercase;
        }

            .utility-table th:first-child {
                text-align: left;
            }

        .utility-table td {
            padding: 9px 7px;
            border-bottom: 1px solid #edf0f4;
            color: var(--text);
            font-size: 9px;
            text-align: center;
            font-weight: 700;
        }

            .utility-table td:first-child {
                text-align: left;
                font-weight: 850;
            }

        .utility-table tr:last-child td {
            border-bottom: 0;
        }

    .status-pill {
        display: inline-flex;
        justify-content: center;
        min-width: 54px;
        padding: 3px 7px;
        border-radius: 12px;
        background: #e4f2eb;
        color: var(--solb-green);
        font-size: 8px;
        font-weight: 900;
    }

        .status-pill.warn {
            background: #fff1d4;
            color: #a76700;
        }

        .status-pill.bad {
            background: #f7e3e8;
            color: var(--solb-maroon);
        }

    .formula-note {
        padding: 9px 12px;
        border-top: 1px solid var(--line);
        background: #f8fafc;
        color: var(--muted);
        font-size: 8px;
        line-height: 1.35;
        font-weight: 700;
    }

        .formula-note strong {
            color: var(--text);
        }

    /* =========================================================
           BOTTOM TREND
        ========================================================= */

    .bottom-grid {
        display: grid;
        grid-template-columns: 1.65fr 1fr;
        gap: 13px;
        margin-top: 14px;
    }

    .trend-chart {
        height: 275px;
        position: relative;
    }

    /* =========================================================
           MANAGEMENT ACTIONS TABLE
        ========================================================= */

    .action-table {
        width: 100%;
        border-collapse: collapse;
    }

        .action-table th {
            padding: 9px 7px;
            background: var(--solb-maroon);
            color: #ffffff;
            font-size: 8px;
            text-align: left;
            font-weight: 900;
            text-transform: uppercase;
        }

        .action-table td {
            padding: 10px 7px;
            border-bottom: 1px solid #ebeff3;
            color: var(--text);
            font-size: 8px;
            line-height: 1.3;
            vertical-align: top;
        }

        .action-table tr:last-child td {
            border-bottom: 0;
        }

    .priority {
        display: inline-flex;
        justify-content: center;
        min-width: 44px;
        padding: 3px 6px;
        border-radius: 10px;
        background: #f7e2e7;
        color: var(--solb-maroon);
        font-size: 7px;
        font-weight: 900;
    }

        .priority.medium {
            background: #fff1d5;
            color: #a76700;
        }

        .priority.low {
            background: #e2f1e9;
            color: var(--solb-green);
        }

    /* =========================================================
           FOOTER
        ========================================================= */

    .dashboard-footer {
        margin-top: 14px;
        padding: 13px 4px 3px;
        border-top: 1px solid #ccd3dc;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
        text-align: right;
    }

        .dashboard-footer strong {
            color: var(--solb-maroon);
        }

    /* =========================================================
           DATA ASSURANCE
        ========================================================= */

    .data-assurance {
        margin-top: 14px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fff;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .data-assurance-summary {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        gap: 12px;
        align-items: center;
        padding: 13px 15px;
        cursor: pointer;
        list-style: none;
    }

        .data-assurance-summary::-webkit-details-marker {
            display: none;
        }

    .assurance-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e6f4ed;
        color: var(--solb-green);
    }

    .data-assurance.review .assurance-icon {
        background: #fff2d9;
        color: #a66500;
    }

    .data-assurance.attention .assurance-icon {
        background: #f8e5e9;
        color: var(--solb-maroon);
    }

    .assurance-copy strong,
    .assurance-copy small {
        display: block;
    }

    .assurance-copy strong {
        color: var(--text);
        font-size: 12px;
        font-weight: 900;
    }

    .assurance-copy small {
        margin-top: 2px;
        color: var(--muted);
        font-size: 10px;
        font-weight: 650;
    }

    .assurance-score {
        color: var(--text);
        font-size: 18px;
        font-weight: 950;
    }

    .assurance-pill {
        padding: 5px 9px;
        border-radius: 16px;
        background: #e6f4ed;
        color: var(--solb-green);
        font-size: 9px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .data-assurance.review .assurance-pill {
        background: #fff2d9;
        color: #a66500;
    }

    .data-assurance.attention .assurance-pill {
        background: #f8e5e9;
        color: var(--solb-maroon);
    }

    .validation-list {
        padding: 0 15px 14px;
        border-top: 1px solid var(--line);
    }

    .validation-row {
        display: grid;
        grid-template-columns: 150px 150px 1fr 85px;
        gap: 10px;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-size: 10px;
        font-weight: 700;
    }

        .validation-row:last-child {
            border-bottom: 0;
        }

        .validation-row strong {
            color: var(--text);
            font-size: 10px;
            font-weight: 900;
        }

        .validation-row .validation-severity {
            text-align: right;
            color: var(--solb-maroon);
            font-weight: 900;
        }

    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 1450px) {
        .executive-kpis {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .department-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1150px) {
        .executive-header {
            grid-template-columns: 1fr;
        }

        .header-side {
            grid-template-columns: 170px 220px;
        }

        .top-analytics,
        .middle-grid,
        .bottom-grid {
            grid-template-columns: 1fr;
        }

        .department-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .plant-portfolio-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .xp-contentbar {
            padding: 9px !important;
        }

        .executive-header {
            grid-template-columns: 1fr;
        }

        .header-side {
            align-items: stretch;
            grid-template-columns: 1fr 1fr;
        }

        .header-meta {
            text-align: left;
        }

        .header-filter {
            align-items: stretch;
            flex-wrap: wrap;
        }

        .report-toolbar,
        .toolbar-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .toolbar-context {
            width: 100%;
        }

        .header-filter > div {
            flex: 1 1 130px;
        }

        .header-filter input {
            width: 100%;
        }

        .executive-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .health-score-layout {
            grid-template-columns: 1fr;
        }

        .department-grid {
            grid-template-columns: 1fr;
        }

        .data-assurance-summary {
            grid-template-columns: auto 1fr;
        }

        .assurance-score,
        .assurance-pill {
            grid-column: 2;
        }

        .validation-row {
            grid-template-columns: 1fr;
            gap: 3px;
        }

            .validation-row .validation-severity {
                text-align: left;
            }
    }

    @@media (max-width: 480px) {
        .header-side {
            grid-template-columns: 1fr;
        }

        .executive-kpis {
            grid-template-columns: 1fr;
        }

        .production-summary-grid,
        .supply-grid {
            grid-template-columns: 1fr;
        }

        .section-heading-row {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    /* =========================================================
           PRINT
        ========================================================= */

    @@media print {
        @@page {
            size: A4 landscape;
            margin: 5mm;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        .no-print,
        .data-assurance,
        .xp-breadcrumbbar,
        .navbar,
        .sidebar,
        .footer,
        .xp-leftbar,
        .xp-rightbar,
        .xp-topbar {
            display: none !important;
        }

        html,
        body,
        .xp-contentbar {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
        }

        .executive-dashboard {
            width: 100% !important;
            max-width: none !important;
        }

        .executive-header {
            min-height: 76px !important;
            padding: 12px 15px !important;
            border-radius: 8px !important;
            box-shadow: none !important;
        }

        .header-main h2 {
            font-size: 21px !important;
        }

        .executive-kpis {
            grid-template-columns: repeat(8, 1fr) !important;
            gap: 5px !important;
            margin-top: 7px !important;
        }

        .executive-kpi {
            min-height: 75px !important;
            padding: 7px 7px 6px 10px !important;
            border-radius: 7px !important;
            box-shadow: none !important;
        }

        .kpi-label {
            font-size: 7px !important;
        }

        .kpi-icon {
            width: 21px !important;
            height: 21px !important;
        }

        .kpi-value {
            margin-top: 5px !important;
            font-size: 16px !important;
        }

        .kpi-subtitle,
        .kpi-status {
            font-size: 6px !important;
            margin-top: 4px !important;
        }

        .top-analytics {
            grid-template-columns: 1.35fr 1fr !important;
            gap: 6px !important;
            margin-top: 7px !important;
        }

        .plant-portfolio-section {
            margin-top: 7px !important;
        }

        .section-heading-row {
            margin-bottom: 5px !important;
        }

            .section-heading-row h3 {
                font-size: 10px !important;
            }

            .section-heading-row p,
            .portfolio-badge {
                font-size: 6px !important;
            }

        .plant-portfolio-grid {
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 6px !important;
        }

        .plant-card {
            border-radius: 7px !important;
            box-shadow: none !important;
            page-break-inside: avoid !important;
        }

        .plant-card-head,
        .plant-primary,
        .plant-metrics,
        .plant-context {
            padding-left: 9px !important;
            padding-right: 7px !important;
        }

        .plant-card-head {
            padding-top: 6px !important;
            padding-bottom: 4px !important;
        }

        .plant-symbol {
            width: 22px !important;
            height: 22px !important;
            border-radius: 6px !important;
            font-size: 8px !important;
        }

        .plant-title strong,
        .plant-primary strong {
            font-size: 10px !important;
        }

        .plant-title span,
        .plant-primary small,
        .plant-share,
        .plant-metric span,
        .plant-context span {
            font-size: 5px !important;
        }

        .plant-metrics {
            gap: 4px !important;
            padding-bottom: 4px !important;
        }

        .plant-metric {
            padding: 4px !important;
        }

            .plant-metric strong {
                font-size: 7px !important;
            }

        .plant-context {
            min-height: 16px !important;
            gap: 3px !important;
        }

        .plant-trend-box {
            height: 52px !important;
            padding-bottom: 3px !important;
        }

        .department-section,
        .middle-grid,
        .bottom-grid {
            margin-top: 7px !important;
        }

        .middle-grid {
            grid-template-columns: 1fr 1fr 1fr !important;
            gap: 6px !important;
        }

        .bottom-grid {
            grid-template-columns: 1.65fr 1fr !important;
            gap: 6px !important;
        }

        .department-grid {
            grid-template-columns: repeat(5, 1fr) !important;
            gap: 5px !important;
        }

        .dashboard-card,
        .department-card {
            page-break-inside: avoid !important;
            box-shadow: none !important;
        }

        .card-header {
            min-height: 31px !important;
            padding: 6px 8px !important;
        }

        .card-title {
            font-size: 9px !important;
        }

        .card-note {
            font-size: 6px !important;
        }

        .card-body {
            padding: 7px !important;
        }

        .chart-box,
        .trend-chart {
            height: 145px !important;
        }

        .health-donut-wrap {
            width: 95px !important;
            height: 95px !important;
        }

        .department-card {
            padding: 7px !important;
        }

        .department-name {
            font-size: 7px !important;
        }

        .department-score {
            font-size: 10px !important;
        }

        .utility-table th,
        .utility-table td,
        .action-table th,
        .action-table td {
            padding: 4px !important;
            font-size: 6px !important;
        }

        .dashboard-footer {
            margin-top: 6px !important;
            padding-top: 5px !important;
            font-size: 6px !important;
        }
    }
</style>

<div class="xp-breadcrumbbar no-print">
    <div class="row">
        <div class="col-md-9">
            <h4 class="xp-page-title">Executive Dashboard</h4>
        </div>
        <div class="col-md-3 text-right">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a>
                </li>
                <li class="breadcrumb-item">Executive</li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </div>
    </div>
</div>

<div class="xp-contentbar">
    <div class="executive-dashboard">

        <!-- EXECUTIVE HEADER -->
        <section class="executive-header">
            <div class="header-main">
                <div class="header-tag">
                    <i class="fa-solid fa-building"></i>
                    SOLB Steel Executive Management
                </div>

                <h2>Executive Operations Dashboard</h2>

                <p>
                    One executive view for Steel Making Plant, Rolling Mill 1
                    and Rolling Mill 2 with supporting supply, utility and maintenance controls.
                </p>
            </div>

            <div class="header-side">
                <div class="executive-index">
                    <small>3-Plant Portfolio</small>
                    <strong>@number0(selectedTotal) MT</strong>
                    <span class="index-status">SMP + RM1 + RM2</span>
                    <span style="margin-top:6px; text-transform:none;">
                        Data confidence @number0(dataQualityScore)%
                    </span>
                </div>

                <div class="header-meta">
                    <small>Report Period</small>
                    <strong>@reportPeriod</strong>
                    <small style="margin-top:5px;">Last Updated</small>
                    <strong>@dashboard.GeneratedOn.ToString("dd-MMM-yyyy hh:mm tt")</strong>
                </div>
            </div>
        </section>

        <section class="report-toolbar no-print">
            <div class="toolbar-context">
                <div class="toolbar-context-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                    <strong>Reporting period: @reportPeriod</strong>
                    <small>
                        Data assurance: @(string.IsNullOrWhiteSpace(summary.DataQualityStatus) ? "Attention" : summary.DataQualityStatus)
                        &nbsp;•&nbsp; @number0(dataQualityScore)% confidence
                    </small>
                </div>
            </div>

            <div class="toolbar-actions">
                @using (Html.BeginForm("dashboard", null, FormMethod.Get, new { @class = "header-filter" }))
                {
                    <div>
                        <label for="fromDate">From date</label>
                        <input id="fromDate"
                               name="fromDate"
                               type="date"
                               value="@dashboard.FromDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label for="toDate">To date</label>
                        <input id="toDate"
                               name="toDate"
                               type="date"
                               value="@dashboard.ToDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" class="filter-btn">
                        <i class="fa-solid fa-filter"></i> Load
                    </button>
                }

                <button type="button"
                        class="print-btn"
                        onclick="printExecutiveDashboard()">
                    <i class="fa-solid fa-print"></i>
                    Print / Save PDF
                </button>
            </div>
        </section>

        <!-- EXECUTIVE KPI CARDS -->
        <section class="executive-kpis">

            <div class="executive-kpi info">
                <div class="kpi-top">
                    <div class="kpi-label">Selected Production</div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-industry"></i>
                    </div>
                </div>

                <div class="kpi-value">@number0(selectedTotal) MT</div>
                <div class="kpi-subtitle">Combined selected-period production</div>
                <div class="kpi-status info">
                    SMP @number0(selectedProduction.SMP) • RM1 @number0(selectedProduction.RM1) • RM2 @number0(selectedProduction.RM2)
                </div>
            </div>

            <div class="executive-kpi info">
                <div class="kpi-top">
                    <div class="kpi-label">Portfolio MTD Output</div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>

                <div class="kpi-value">@number0(mtdTotal) MT</div>
                <div class="kpi-subtitle">Combined month-to-date production</div>
                <div class="kpi-status info">
                    SMP @number0(mtdProduction.SMP) • RM1 @number0(mtdProduction.RM1) • RM2 @number0(mtdProduction.RM2)
                </div>
            </div>

            <div class="executive-kpi info">
                <div class="kpi-top">
                    <div class="kpi-label">Portfolio YTD Output</div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-calendar"></i>
                    </div>
                </div>

                <div class="kpi-value">@number0(ytdTotal) MT</div>
                <div class="kpi-subtitle">Combined year-to-date production</div>
                <div class="kpi-status info">
                    SMP @number0(ytdProduction.SMP) • RM1 @number0(ytdProduction.RM1) • RM2 @number0(ytdProduction.RM2)
                </div>
            </div>

            <div class="executive-kpi @scoreClass(supplyScore)">
                <div class="kpi-top">
                    <div class="kpi-label">Dispatch MTD</div>
                    <div class="kpi-icon">
                        <i class="fa-solid fa-truck"></i>
                    </div>
                </div>

                <div class="kpi-value">@number0(summary.DispatchMTD) MT</div>
                <div class="kpi-subtitle">Customer dispatch month to date</div>
                <div class="kpi-status @scoreClass(supplyScore)">
                    @number1(supplyScore)% of @number0(summary.DispatchMTDTarget) MT target
                </div>
            </div>

