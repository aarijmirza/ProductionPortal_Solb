<script>
    Chart.defaults.font.family = "Segoe UI, Arial, sans-serif";
    Chart.defaults.color = "#344054";

    const maroon = "#a81435";
    const red = "#c8102e";
    const green = "#168b5b";
    const orange = "#f59e0b";
    const blue = "#1769aa";
    const navy = "#183346";
    const grey = "#9ca3af";
    const gridColor = "#e9edf2";

    const selectedProductionData = @Html.Raw(JsonConvert.SerializeObject(new decimal[]
    {
        selectedProduction.SMP,
        selectedProduction.RM1,
        selectedProduction.RM2
    }));

    const productionTrendLabels = @Html.Raw(JsonConvert.SerializeObject(
        productionTrend.Select(x => x.MonthLabel).ToList()));
    const productionTrendSMP = @Html.Raw(JsonConvert.SerializeObject(
        productionTrend.Select(x => x.SMP).ToList()));
    const productionTrendRM1 = @Html.Raw(JsonConvert.SerializeObject(
        productionTrend.Select(x => x.RM1).ToList()));
    const productionTrendRM2 = @Html.Raw(JsonConvert.SerializeObject(
        productionTrend.Select(x => x.RM2).ToList()));

    function plantContribution(series, index) {
        if (series[index] === null || series[index] === undefined) {
            return null;
        }

        const smp = productionTrendSMP[index] === null ? 0 : Number(productionTrendSMP[index] || 0);
        const rm1 = productionTrendRM1[index] === null ? 0 : Number(productionTrendRM1[index] || 0);
        const rm2 = productionTrendRM2[index] === null ? 0 : Number(productionTrendRM2[index] || 0);
        const total = smp + rm1 + rm2;

        return total > 0
            ? Math.round((Number(series[index]) * 100 / total) * 10) / 10
            : null;
    }

    const contributionSMP = productionTrendSMP.map(function (_, index) {
        return plantContribution(productionTrendSMP, index);
    });
    const contributionRM1 = productionTrendRM1.map(function (_, index) {
        return plantContribution(productionTrendRM1, index);
    });
    const contributionRM2 = productionTrendRM2.map(function (_, index) {
        return plantContribution(productionTrendRM2, index);
    });

    const valueLabelPlugin = {
        id: "executiveValueLabels",

        afterDatasetsDraw(chart) {
            const ctx = chart.ctx;

            ctx.save();
            ctx.fillStyle = "#263142";
            ctx.font = "700 9px Segoe UI";
            const isHorizontal = chart.options.indexAxis === "y";
            ctx.textAlign = isHorizontal ? "left" : "center";
            ctx.textBaseline = isHorizontal ? "middle" : "bottom";

            chart.data.datasets.forEach(function (dataset, datasetIndex) {
                if (dataset.type === "line") {
                    return;
                }

                const meta = chart.getDatasetMeta(datasetIndex);

                if (meta.hidden) {
                    return;
                }

                meta.data.forEach(function (element, index) {
                    const value = dataset.data[index];

                    if (value === null || value === undefined) {
                        return;
                    }

                    ctx.fillText(
                        Number(value).toLocaleString() + (isHorizontal ? " MT" : ""),
                        isHorizontal ? element.x + 8 : element.x,
                        isHorizontal ? element.y : element.y - 5
                    );
                });
            });

            ctx.restore();
        }
    };

    function createPlantTrendChart(canvasId, label, data, color) {
        const canvas = document.getElementById(canvasId);

        if (!canvas) {
            return;
        }

        new Chart(canvas, {
            type: "line",
            data: {
                labels: productionTrendLabels,
                datasets: [{
                    label: label,
                    data: data,
                    borderColor: color,
                    backgroundColor: color,
                    borderWidth: 2.5,
                    pointRadius: 2.5,
                    pointHoverRadius: 4,
                    fill: false,
                    spanGaps: false,
                    tension: .32
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                interaction: {
                    mode: "index",
                    intersect: false
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return " " + label + ": " + Number(context.raw || 0).toLocaleString() + " MT";
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            maxTicksLimit: 6,
                            font: { size: 7, weight: "bold" }
                        },
                        border: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: "rgba(220,226,233,.65)" },
                        ticks: {
                            maxTicksLimit: 3,
                            font: { size: 7 },
                            callback: function (value) {
                                return value >= 1000 ? (value / 1000) + "k" : value;
                            }
                        },
                        border: { display: false }
                    }
                }
            }
        });
    }

    createPlantTrendChart("smpPlantTrendChart", "SMP", productionTrendSMP, maroon);
    createPlantTrendChart("rm1PlantTrendChart", "RM1", productionTrendRM1, blue);
    createPlantTrendChart("rm2PlantTrendChart", "RM2", productionTrendRM2, green);

    /* PRODUCTION COMPARISON */

    new Chart(
        document.getElementById("productionComparisonChart"),
        {
            type: "bar",

            data: {
                labels: ["SMP", "RM1", "RM2"],

                datasets: [
                    {
                        label: "Selected output",
                        data: selectedProductionData,
                        backgroundColor: [maroon, blue, green],
                        borderRadius: 7,
                        borderSkipped: false,
                        barThickness: 32
                    }
                ]
            },

            plugins: [valueLabelPlugin],

            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                indexAxis: "y",
                layout: {
                    padding: {
                        right: 70
                    }
                },

                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return " " + Number(context.raw || 0).toLocaleString() + " MT";
                            }
                        }
                    }
                },

                scales: {
                    x: {
                        beginAtZero: true,

                        ticks: {
                            font: {
                                size: 8
                            },

                            callback: function (value) {
                                if (value >= 1000) {
                                    return (value / 1000) + "k";
                                }

                                return value;
                            }
                        },

                        grid: {
                            color: gridColor
                        },

                        border: {
                            display: false
                        }
                    },

                    y: {
                        grid: {
                            display: false
                        },

                        ticks: {
                            font: {
                                size: 11,
                                weight: "bold"
                            }
                        },

                        border: {
                            display: false
                        }
                    }
                }
            }
        }
    );

    /* PRODUCTION TREND */

    new Chart(
        document.getElementById("productionTrendChart"),
        {
            type: "line",

            data: {
                labels: productionTrendLabels,

                datasets: [
                    {
                        label: "SMP",
                        data: productionTrendSMP,
                        borderColor: maroon,
                        backgroundColor: "rgba(168,20,53,.08)",
                        fill: false,
                        borderWidth: 3,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .32
                    },
                    {
                        label: "RM1",
                        data: productionTrendRM1,
                        borderColor: blue,
                        backgroundColor: blue,
                        borderWidth: 2,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .25
                    },
                    {
                        label: "RM2",
                        data: productionTrendRM2,
                        borderColor: green,
                        backgroundColor: green,
                        borderWidth: 2,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .25
                    }
                ]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            boxWidth: 12,
                            font: {
                                size: 9,
                                weight: "bold"
                            }
                        }
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            callback: function (value) {
                                return Number(value).toLocaleString();
                            },

                            font: {
                                size: 8
                            }
                        },

                        grid: {
                            color: gridColor
                        },

                        border: {
                            display: false
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        },

                        ticks: {
                            font: {
                                size: 8
                            }
                        },

                        border: {
                            display: false
                        }
                    }
                }
            }
        }
    );

    /* SELECTED PRODUCTION MIX */

    new Chart(
        document.getElementById("portfolioMixChart"),
        {
            type: "doughnut",

            data: {
                labels: ["SMP", "RM1", "RM2"],

                datasets: [
                    {
                        data: selectedProductionData,
                        backgroundColor: [maroon, blue, green],
                        borderColor: "#ffffff",
                        borderWidth: 3,
                        hoverOffset: 4
                    }
                ]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "64%",
                animation: false,

                plugins: {
                    legend: {
                        display: false
                    },

                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                const value = Number(context.raw || 0);
                                const total = selectedProductionData.reduce(function (sum, item) {
                                    return sum + Number(item || 0);
                                }, 0);
                                const share = total > 0 ? (value * 100 / total).toFixed(1) : "0.0";
                                return " " + context.label + ": " + value.toLocaleString() + " MT (" + share + "%)";
                            }
                        }
                    }
                }
            }
        }
    );

    /* MONTHLY PRODUCTION CONTRIBUTION */

    new Chart(
        document.getElementById("executiveTrendChart"),
        {
            type: "line",

            data: {
                labels: productionTrendLabels,

                datasets: [
                    {
                        label: "SMP share",
                        data: contributionSMP,
                        borderColor: maroon,
                        backgroundColor: maroon,
                        borderWidth: 3,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .25
                    },
                    {
                        label: "RM1 share",
                        data: contributionRM1,
                        borderColor: blue,
                        backgroundColor: blue,
                        borderWidth: 2,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .25
                    },
                    {
                        label: "RM2 share",
                        data: contributionRM2,
                        borderColor: green,
                        backgroundColor: green,
                        borderWidth: 2,
                        pointRadius: 3,
                        spanGaps: false,
                        tension: .25
                    }
                ]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            boxWidth: 12,
                            font: {
                                size: 9,
                                weight: "bold"
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return " " + context.dataset.label + ": " + Number(context.raw || 0).toFixed(1) + "%";
                            }
                        }
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        min: 0,
                        max: 100,

                        ticks: {
                            callback: function (value) {
                                return value + "%";
                            },

                            font: {
                                size: 8
                            }
                        },

                        grid: {
                            color: gridColor
                        },

                        border: {
                            display: false
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        },

                        ticks: {
                            font: {
                                size: 8
                            }
                        },

                        border: {
                            display: false
                        }
                    }
                }
            }
        }
    );

    function printExecutiveDashboard() {
        window.print();
    }
</script>
