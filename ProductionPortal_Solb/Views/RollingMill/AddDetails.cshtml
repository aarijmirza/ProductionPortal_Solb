@using System.Globalization
@{
    ViewBag.Title = "add";
}
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Rolling Mill</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Rolling Mill</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->

<div class="xp-contentbar">
    <form action="/RollingMill/AddDetails" id="addprofileform" method="post">
        <input type="hidden" id="ID" name="ID" />

        <div class="card m-b-30">
            <div class="card-header bg-white text-right">

                <button type="button" class="btn btn-secondary" id="btnNew">New</button>
                <button type="submit" class="btn btn-primary" id="btnSave">Save Details</button>

            </div>

            <div class="card-body">
                <div class="form-row">

                    <div class="form-group col-md-2">
                        <label>Date</label>
                        <input type="date" class="form-control" id="date" name="Date" />
                    </div>

                    <div class="form-group col-md-2">
                        <label>Plant</label>
                        <select class="form-control" id="Plant" name="plant">
                            <option selected disabled>-- please select --</option>
                            <option value="Rolling Mill 1">Rolling Mill 1</option>
                            <option value="Rolling Mill 2">Rolling Mill 2</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Team</label>
                        <select class="form-control" name="Team" id="team">
                            <option selected disabled>-- please select --</option>
                            <option value="Team A">Team A</option>
                            <option value="Team B">Team B</option>
                            <option value="Team C">Team C</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Shift</label>
                        <select class="form-control" name="Shift" id="shift">
                            <option selected disabled>-- please select --</option>
                            <option value="Morning">Morning</option>
                            <option value="Evening">Evening</option>
                            <option value="Night">Night</option>
                            <option value="Long Morning">Long Morning</option>
                            <option value="Long Night">Long Night</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Shift Incharge</label>
                        <select class="form-control" name="ShiftIncharge" id="shiftincharge">
                            <option selected disabled>-- please select --</option>
                            <option value="Muhammad Ali">Muhammad Ali</option>
                            <option value="Altaf Khan">Altaf Khan</option>
                            <option value="Waseem Akram">Waseem Akram</option>
                        </select>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body">

            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Plant</th>
                        <th>Team</th>
                        <th>Shift</th>
                        <th>Shift Incharge</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.List)
                    {
                        <tr class="record-row"
                            style="cursor:pointer"
                            data-id="@item.ID"
                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                            data-plant="@item.Plant"
                            data-team="@item.Team"
                            data-shift="@item.Shift"
                            data-incharge="@item.ShiftIncharge">

                            <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                            <td>@item.Plant</td>
                            <td>@item.Team</td>
                            <td>@item.Shift</td>
                            <td>@item.ShiftIncharge</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

$(document).on("click", ".record-row", function () {

    var date = $(this).data("date");
    var shift = $(this).data("shift");
    var plant = $(this).data("plant");
    var team = $(this).data("team");
    var shiftincharge = $(this).data("incharge"); // 🔥 FIX

    console.log("Clicked:", date, shift, plant, team, shiftincharge);

    // ✅ MATCH HTML IDs (small letters)
    $("#date").val(date);
    $("#shift").val(shift).trigger("change");
    $("#Plant").val(plant).trigger("change");
    $("#team").val(team).trigger("change");
    $("#shiftincharge").val(shiftincharge).trigger("change");

    // AJAX (same)
    $.ajax({
        url: '@Url.Action("SetSelectedShift","RollingMill")',
        type: 'POST',
        data: {
            date: date,
            shift: shift,
            plant: plant,
            team: team,
            shiftincharge: shiftincharge
        },
        success: function (res) {
            console.log("Session Set:", res);

            if (res.success) {

                // 🔥 SAVE BEFORE RELOAD
                localStorage.setItem("rm_date", date);
                localStorage.setItem("rm_shift", shift);
                localStorage.setItem("rm_plant", plant);

            }
        }
    });

});

</script>