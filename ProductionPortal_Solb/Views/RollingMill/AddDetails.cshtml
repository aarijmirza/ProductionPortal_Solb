@using System.Globalization
@{
    ViewBag.Title = "add";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .selected-row {
        background-color: #d9edf7 !important;
        font-weight: bold;
    }
</style>

<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Rolling Mill</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Rolling Mill</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->

<div class="xp-contentbar">

    <div class="card mb-3 shadow-sm">
        <div class="card-header">
            <b>Currently Loaded Shift</b>
        </div>

        <div class="card-body">
            <div class="form-row">
                <div class="col-md-2"><b>Date:</b> @ViewBag.LoadedDate</div>
                <div class="col-md-3"><b>Plant:</b> @ViewBag.LoadedPlant</div>
                <div class="col-md-2"><b>Shift:</b> @ViewBag.LoadedShift</div>
                <div class="col-md-2"><b>Team:</b> @ViewBag.LoadedTeam</div>
                <div class="col-md-3"><b>Incharge:</b> @ViewBag.LoadedIncharge</div>
            </div>
        </div>
    </div>

    <form action="@Url.Action("AddDetails", "RollingMill")" id="addprofileform" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="ID" name="ID" />

        <div class="card m-b-30">
            <div class="card-header bg-white text-right">

                @*<button type="button" class="btn btn-secondary" id="btnNew">New</button>
                    <button type="submit" class="btn btn-primary" id="btnSave">Save Details</button>*@

                @*<button type="button" class="btn btn-success" id="btnLoad" disabled>
                        Load Selected
                    </button>*@

                <button type="submit" class="btn btn-primary" id="btnSave">
                    Save Details
                </button>

            </div>

            <div class="card-body">
                <div class="form-row">

                    <div class="form-group col-md-2">
                        <label>Date</label>
                        <input type="date" class="form-control" id="date" name="Date" />
                    </div>

                    <div class="form-group col-md-2">
                        <label>Plant</label>
                        <select class="form-control" id="Plant" name="plant">
                            <option selected disabled>-- please select --</option>
                            <option value="Rolling Mill 1">Rolling Mill 1</option>
                            <option value="Rolling Mill 2">Rolling Mill 2</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Team</label>
                        <select class="form-control" name="Team" id="team">
                            <option selected disabled>-- please select --</option>
                            <option value="Team A">Team A</option>
                            <option value="Team B">Team B</option>
                            <option value="Team C">Team C</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Shift</label>
                        <select class="form-control" name="Shift" id="shift">
                            <option selected disabled>-- please select --</option>
                            <option value="Morning">Morning</option>
                            <option value="Evening">Evening</option>
                            <option value="Night">Night</option>
                            <option value="Long Morning">Long Morning</option>
                            <option value="Long Night">Long Night</option>
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Shift Incharge</label>
                        <select class="form-control" name="ShiftIncharge" id="shiftincharge">
                            <option selected disabled>-- please select --</option>
                            <option value="Muhammad Ali">Muhammad Ali</option>
                            <option value="Altaf Khan">Altaf Khan</option>
                            <option value="Waseem Akram">Waseem Akram</option>
                        </select>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body">

            <form method="get" action="@Url.Action("AddDetails", "RollingMill")" class="mb-3">
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Select Date</label>
                        <input type="date"
                               name="date"
                               class="form-control"
                               value="@ViewBag.SelectedDate" />
                    </div>

                    <div class="form-group col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Load Date</button>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table id="xp-default-datatable" class="display table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Plant</th>
                            <th>Team</th>
                            <th>Shift</th>
                            <th>Shift Incharge</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.List)
                        {
                            <tr class="record-row"
                                style="cursor:pointer"
                                data-id="@item.ID"
                                data-date="@item.Date.ToString("yyyy-MM-dd")"
                                data-plant="@item.Plant"
                                data-team="@item.Team"
                                data-shift="@item.Shift"
                                data-incharge="@item.ShiftIncharge">

                                <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                                <td>@item.Plant</td>
                                <td>@item.Team</td>
                                <td>@item.Shift</td>
                                <td>@item.ShiftIncharge</td>
                                <td>
                                    <a href="javascript:void(0);"
                                       class="btn btn-sm btn-danger btn-delete"
                                       data-id="@item.ID">
                                        <i class="mdi mdi-trash-can"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-primary btn-sm btn-load-shift"
                                            data-id="@item.ID"
                                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                                            data-shift="@item.Shift"
                                            data-plant="@item.Plant"
                                            data-team="@item.Team"
                                            data-incharge="@item.ShiftIncharge">
                                        Load
                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    var selectedShiftData = null;

    // ==============================
    // ROW CLICK - SELECT DETAILS ONLY
    // ==============================
    $(document).on("click", ".record-row", function (e) {

        // Agar Load ya Delete button click hua ho to row click na chale
        if ($(e.target).closest(".btn-load-shift, .btn-delete").length > 0) {
            return;
        }

        $(".record-row").removeClass("selected-row");
        $(this).addClass("selected-row");

        var id = $(this).data("id");
        var date = $(this).data("date");
        var shift = $(this).data("shift");
        var plant = $(this).data("plant");
        var team = $(this).data("team");
        var shiftincharge = $(this).data("incharge");

        selectedShiftData = {
            id: id,
            date: date,
            shift: shift,
            plant: plant,
            team: team,
            shiftincharge: shiftincharge
        };

        $("#ID").val(id);
        $("#date").val(date);
        $("#Plant").val(plant).trigger("change");
        $("#team").val(team).trigger("change");
        $("#shift").val(shift).trigger("change");
        $("#shiftincharge").val(shiftincharge).trigger("change");

        $("#btnSave").prop("disabled", true).text("Selected Row Loaded");

        Swal.fire({
            icon: "info",
            title: "Shift Selected",
            text: "This row is selected. To continue, click Load button from Action column.",
            timer: 1500,
            showConfirmButton: false
        });
    });


    // ==============================
    // LOAD SHIFT FROM ACTION BUTTON
    // ==============================

    $(document).on("click", ".btn-load-shift", function (e) {
    e.preventDefault();
    e.stopPropagation();

    var row = $(this).closest("tr");

    var id = row.attr("data-id");
    var date = row.attr("data-date");
    var shift = row.attr("data-shift");
    var plant = row.attr("data-plant");
    var team = row.attr("data-team");
    var shiftincharge = row.attr("data-incharge");

    if (!id || !date || !shift || !plant || !team || !shiftincharge) {
        Swal.fire({
            icon: "error",
            title: "Missing Data",
            text: "ID, Date, Plant, Team, Shift or Shift Incharge is missing for this row."
        });
        return;
    }

    $.ajax({
        url: '@Url.Action("SetSelectedShift", "RollingMill")',
        type: 'POST',
        data: {
            __RequestVerificationToken:
                $("#addprofileform input[name='__RequestVerificationToken']").val(),
            shiftDetailID: id,
            date: date,
            shift: shift,
            plant: plant,
            team: team,
            shiftincharge: shiftincharge
        },
        success: function (res) {

            if (res.success) {

                localStorage.setItem("rm_shift_detail_id", id);
                localStorage.setItem("rm_date", date);
                localStorage.setItem("rm_shift", shift);
                localStorage.setItem("rm_plant", plant);
                localStorage.setItem("rm_team", team);
                localStorage.setItem("rm_shiftincharge", shiftincharge);

                Swal.fire({
                    icon: "success",
                    title: "Shift Loaded",
                    text: "Selected shift has been loaded successfully.",
                    timer: 1200,
                    showConfirmButton: false
                }).then(function () {
                    window.location.href =
                        '@Url.Action("list", "Delay")'
                        + '?date=' + encodeURIComponent(res.date || date)
                        + '&shift=' + encodeURIComponent(res.shift || shift)
                        + '&plant=' + encodeURIComponent(res.plant || plant);
                });

            } else {
                Swal.fire({
                    icon: "error",
                    title: "Load Failed",
                    text: res.message || "Selected shift could not be loaded."
                });
            }
        },
        error: function () {
            Swal.fire({
                icon: "error",
                title: "Server Error",
                text: "Unable to load selected shift."
            });
        }
    });
});

    // ==============================
    // SAVE NEW DETAILS ONLY
    // ==============================
    $("#addprofileform").on("submit", function (e) {

        var id = $("#ID").val();

        if (id && parseInt(id) > 0) {
            e.preventDefault();

            Swal.fire({
                icon: "warning",
                title: "Existing Row Selected",
                text: "This shift already exists. Please click Load button from Action column instead of Save Details."
            });

            return false;
        }

        var date = $("#date").val();
        var plant = $("#Plant").val();
        var team = $("#team").val();
        var shift = $("#shift").val();
        var shiftincharge = $("#shiftincharge").val();

        if (!date || !plant || !team || !shift || !shiftincharge) {
            e.preventDefault();

            Swal.fire({
                icon: "error",
                title: "Required Fields",
                text: "Please fill Date, Plant, Team, Shift and Shift Incharge."
            });

            return false;
        }

        return true;
    });


    // ==============================
    // DELETE
    // ==============================
    $(document).on("click", ".btn-delete", function (e) {
        e.preventDefault();
        e.stopPropagation();

        var id = $(this).data("id");

        Swal.fire({
            title: "Are you sure?",
            text: "This record will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {

            if (result.isConfirmed) {
                window.location.href = '/RollingMill/delete?ID=' + id;
            }
        });
    });

</script>
```
