<div class="xp-contentbar">
    @using (Html.BeginForm("AddDischarge", "RollingMill", FormMethod.Post, new { id = "addprofileform" }))
    {

        @Html.AntiForgeryToken()
        <input type="hidden" id="hdnID" name="ID" value="0" />

        @*<form action="/RollingMill/AddDischarge" id="addprofileform" method="post">*@
        <div class="row">
            <div class="col-lg-12">

                <div class="card mb-3 shadow-sm">
                    <div class="card-header">
                        <b>Rolling Mill Shift Details (Today)</b>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <b>Date:</b> @(Model.Date != null ? Model.Date.Value.ToString("dd-MM-yyyy") : "-")
                            </div>
                            <div class="form-group col-md-3">
                                <b>Plant:</b> @Model.Plant
                            </div>
                            <div class="form-group col-md-3">
                                <b>Shift:</b> @Model.Shift
                            </div>
                            <div class="form-group col-md-3">
                                <b>Shift Incharge:</b> @Model.ShiftIncharge
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card m-b-30">
                    <div class="card-header bg-white text-right">
                        <button type="submit" id="btnSubmit" class="btn btn-primary">Discharged</button>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            @*<div class="form-group col-md-2">
                                    <label>Date</label>
                                    <input type="date" class="form-control" id="date" name="Date" />
                                </div>*@

                            <div class="form-group col-md-2">
                                <label>Heat #</label>
                                @Html.DropDownListFor(m => m.HeatNo,
                                         (IEnumerable<SelectListItem>)ViewBag.HeatNo,
                                         "-- Select Heat --",
                                         new { @class = "form-control select2-heat", id = "ddlHeat" })
                            </div>
                            <div class="form-group col-md-2">
                                <label>Boarding #</label>
                                <input type="text" class="form-control" id="txtBoarding" name="BoardingNo" readonly>
                            </div>
                            <div class="form-group col-md-2">
                                <label>Steel Grade</label>
                                <input type="text" class="form-control" id="txtGrade" name="SteelGrade" readonly>
                            </div>
                            <div class="form-group col-md-2">
                                <label>P.O. Number</label>
                                <input type="text" class="form-control" id="txtPONumber" name="PONumber" readonly />
                            </div>
                            <div class="form-group col-md-2">
                                <label for="ProductSpecs">Product Code</label>
                                <input type="text" class="form-control" id="txtProductSpecs" name="ProductSpecs" readonly>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-2">
                                <label>Finished Product Grade</label>
                                <select class="form-control" id="ddlNewSteelGrade" name="NewSteelGrade">
                                    <option selected disabled>-- please select --</option>
                                    <option value="ASTM A615 G40">ASTM A615 G40</option>
                                    <option value="ASTM A615 G60">ASTM A615 G60</option>
                                    <option value="ASTM A615 G75">ASTM A615 G75</option>
                                    <option value="ASTM A615 G80">ASTM A615 G80</option>
                                    <option value="ASTM A706 G60">ASTM A706 G60</option>
                                    <option value="ASTM A706 G75">ASTM A706 G75</option>
                                    <option value="ASTM A706 G80">ASTM A706 G80</option>
                                    <option value="SAE 1008">SAE 1008</option>
                                    <option value="SAE 1006">SAE 1006</option>
                                </select>
                            </div>
                            <div class="form-group col-md-1">
                                <label>Cobble</label>
                                <input type="number" step="0.001" class="form-control" id="txtCobble" name="Cobble" placeholder="0">
                            </div>
                            <div class="form-group col-md-1">
                                <label>Hot Out</label>
                                <input type="number" step="0.001" class="form-control" id="txtHotOut" name="HotOut" placeholder="0">
                            </div>
                            <div class="form-group col-md-2">
                                <label>Total Billet</label>
                                <input type="number"
                                       class="form-control"
                                       id="txtTotalBillet"
                                       name="TotalBillet"
                                       min="1"
                                       step="1">

                                <small class="text-danger" id="remainingBilletText"></small>
                                @*<input type="text" class="form-control" id="txtTotalBillet" name="TotalBillet" readonly>*@
                            </div>
                            <div class="form-group col-md-2">
                                <label>Total Weight (MT)</label>
                                <input type="number" class="form-control" id="txtTotalWeight" name="TotalWeight" readonly>
                            </div>
                            <div class="form-group col-md-2">
                                <label>Discharge Seq.</label>
                                <input type="number"
                                       class="form-control"
                                       id="txtDischargingSequence"
                                       value="@nextSequence"
                                       name="DischargingSequence" />
                                @*<input type="number" class="form-control" value="0" name="DischargingSequence" readonly>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*</form>*@
    }


    <div class="row">
        <div class="col-lg-12">
            <div class="card m-b-30">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label><b>Filter by Shift</b></label>
                            <select id="shiftFilter" class="form-control">
                                <option value="">All</option>
                                <option value="Morning" @(Model.Shift == "Morning" ? "selected" : "")>Morning</option>
                                <option value="Afternoon" @(Model.Shift == "Afternoon" ? "selected" : "")>Afternoon</option>
                                <option value="Evening" @(Model.Shift == "Evening" ? "selected" : "")>Evening</option>
                                <option value="Night" @(Model.Shift == "Night" ? "selected" : "")>Night</option>
                                <option value="Long Morning" @(Model.Shift == "Long Morning" ? "selected" : "")>Long Morning</option>
                                <option value="Long Night" @(Model.Shift == "Long Night" ? "selected" : "")>Long Night</option>
                            </select>
                        </div>

                        <!-- 🔥 NEW KPI BADGES -->
                        <div class="col-md-6 d-flex align-items-end">

                            <div class="mr-3">
                                <small>Total Billet</small><br />
                                <span class="badge badge-primary p-2" id="totalBilletBadge">0</span>
                            </div>

                            <div>
                                <small>Total Weight (MT)</small><br />
                                <span class="badge badge-success p-2" id="totalWeightBadge">0.000</span>
                            </div>

                        </div>

                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Discharging Seq.</th>
                                    @*<th>Date</th>*@
                                    <th>Shift</th>
                                    <th>Heat #</th>
                                    @*<th>Boarding #</th>*@
                                    <th>Steel Grade</th>
                                    <th>Cobble</th>
                                    <th>HotOut</th>
                                    <th>Total Billet</th>
                                    <th>Total Weight (MT)</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="dischargeTableBody">
                                @if (Model.SubmittedHeat != null && Model.SubmittedHeat.Any())
                                {
                                    foreach (var item in Model.SubmittedHeat)
                                    {
                                        var gregorian = new CultureInfo("en-US");
                                        gregorian.DateTimeFormat.Calendar = new GregorianCalendar();

                                        <tr data-shift="@item.Shift">
                                            <td>@item.DischargingSequence</td>
                                            <td>@item.Shift</td>
                                            <td>@item.HeatNo</td>
                                            <td>@item.SteelGrade</td>
                                            <td>@item.Cobble</td>
                                            <td>@item.HotOut</td>
                                            <td>@item.TotalBillet</td>
                                            <td>@item.TotalWeight</td>
                                            <td>
                                                @switch (item.HeatStatus)
                                                {
                                                    case 102:
                                                        <span class="badge badge-success">Charging</span>
                                                        break;

                                                    case 103:
                                                        <span class="badge badge-warning">Discharged</span>
                                                        break;

                                                    default:
                                                        <span class="badge badge-light">Unknown</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <a href="javascript:void(0);"
                                                   class="btn btn-sm btn-info btn-edit"
                                                   data-id="@item.ID"
                                                   data-shift="@item.Shift"
                                                   data-heat="@item.HeatNo"
                                                   data-boarding="@item.BoardingNo"
                                                   data-grade="@item.SteelGrade"
                                                   data-newgrade="@item.NewSteelGrade"
                                                   data-ponumber="@item.PONumber"
                                                   data-productspecs="@item.ProductCode"
                                                   data-cobble="@item.Cobble"
                                                   data-hotout="@item.HotOut"
                                                   data-billet="@item.TotalBillet"
                                                   data-totalweight="@item.TotalWeight"
                                                   data-sequence="@item.DischargingSequence">
                                                    Edit
                                                </a>

                                                <a href="javascript:void(0);"
                                                   class="btn btn-sm btn-danger btn-delete"
                                                   data-id="@item.ID">
                                                    <i class="mdi mdi-trash-can"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">
                                            No submitted heats found for selected shift.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= SCRIPTS ================= -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        let chargingWeightPerBillet = 0;
        let originalBilletQty = 0;
        let originalTotalWeight = 0;

        function calculateTotalWeight() {
            var currentBillet = toNum($("#txtTotalBillet").val());

            if (currentBillet <= 0) {
                $("#txtTotalWeight").val("0.000");
                return;
            }

            // Agar billet quantity same hai, old/backend total weight same rahega
            if (currentBillet === originalBilletQty && originalTotalWeight > 0) {
                $("#txtTotalWeight").val(originalTotalWeight.toFixed(3));
                return;
            }

            // Agar billet quantity change hui hai, charging weight per billet se calculate hoga
            if (chargingWeightPerBillet > 0) {
                var calculatedWeight = currentBillet * chargingWeightPerBillet;
                $("#txtTotalWeight").val(calculatedWeight.toFixed(3));
            } else {
                $("#txtTotalWeight").val("0.000");
            }
        }

        let isSubmitting = false;
        let isEditMode = false;

        // ==============================
        // SELECT2 INIT
        // ==============================
        $('#ddlHeat').select2({
            placeholder: '-- Select Heat --',
            allowClear: true,
            width: '100%'
        });

        // ==============================
        // COMMON FUNCTIONS
        // ==============================
        function toNum(val) {
            return parseFloat($.trim(val)) || 0;
        }

        function normalizeShift(val) {
            return (val || "").toString().trim().toLowerCase();
        }

        function clearFields() {
            $("#txtBoarding").val('');
            $("#txtGrade").val('');
            $("#txtProductSpecs").val('');
            $("#txtPONumber").val('');
            $("#ddlNewSteelGrade").val('');
            $("#txtCobble").val('');
            $("#txtHotOut").val('');

            $("#txtTotalBillet")
                .val('')
                .removeAttr("max")
                .removeAttr("data-remaining");

            $("#txtTotalWeight").val('');
            $("#remainingBilletText").text('');
        }

        function calculateKPI() {
            var totalBillet = 0;
            var totalWeight = 0;

            $("#dischargeTableBody tr:visible").each(function () {

                var row = $(this);

                /*
                 * Table columns:
                 * 0 = Discharging Seq.
                 * 1 = Shift
                 * 2 = Heat #
                 * 3 = Steel Grade
                 * 4 = Cobble
                 * 5 = HotOut
                 * 6 = Total Billet
                 * 7 = Total Weight (MT)
                 * 8 = Status
                 * 9 = Action
                 */

                totalBillet +=
                    toNum(
                        row.find("td:eq(6)").text()
                    );

                totalWeight +=
                    toNum(
                        row.find("td:eq(7)").text()
                    );
            });

            $("#totalBilletBadge")
                .text(totalBillet);

            $("#totalWeightBadge")
                .text(
                    totalWeight.toFixed(3)
                );
        }

        function applyShiftFilter() {
            var selectedShift = normalizeShift($("#shiftFilter").val());

            $("#dischargeTableBody tr").each(function () {
                var rowShift = normalizeShift($(this).attr("data-shift"));

                if (selectedShift === "" || rowShift === selectedShift) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });

            calculateKPI();
        }

        // ==============================
        // DEFAULT DATE + NUMBER STEP
        // ==============================
        $("#date").val('@(Model.Date != null ? Model.Date.Value.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))');

        $("input[type='number']").attr("step", "any");

        // ==============================
        // HEAT CHANGE - INSERT MODE ONLY
        // ==============================
        $("#ddlHeat").on("change", function () {

            if (isEditMode) {
                return;
            }

            var heatNo = $(this).val();

            clearFields();

            if (!heatNo) {
                return;
            }

            $("#txtPONumber").val(heatNo);

$.ajax({
    url: '@Url.Action("GetChargingByHeat", "RollingMill")',
    type: 'GET',
    data: { heatNo: heatNo },
    success: function (res) {

        if (!res) {
            clearFields();

            Swal.fire({
                icon: 'warning',
                title: 'No Data Found',
                text: 'No charging data found against this Heat No.'
            });

            return;
        }

        var chargedBillet = toNum(res.ChargedBillet);
        var alreadyDischargedBillet = toNum(res.AlreadyDischargedBillet);
        var remainingBillet = toNum(res.RemainingBillet);
        var remainingWeight = toNum(res.TotalWeight);

        if (remainingBillet <= 0) {
            clearFields();

            $("#ddlHeat").val(null).trigger("change.select2");

            Swal.fire({
                icon: 'error',
                title: 'Heat Fully Discharged',
                text: 'This Heat No is already fully discharged.'
            });

            return;
        }

        // Store original charging values
        originalBilletQty = remainingBillet;
        originalTotalWeight = remainingWeight;

        // Weight per billet from charging
        chargingWeightPerBillet = remainingBillet > 0
            ? (remainingWeight / remainingBillet)
            : 0;
        debugger
        $("#txtBoarding").val(res.BoardingNo || '');
        $("#txtGrade").val(res.SteelGrade || '');
        $("#txtProductSpecs").val(
            res.ProductSpecs ||
            res.ProductCode ||
            ''
        );
        $("#txtPONumber").val(res.HeatNo || heatNo);

        $("#txtTotalBillet")
            .val(remainingBillet)
            .attr("max", remainingBillet)
            .attr("data-remaining", remainingBillet);

        // Pehle jo charging/backend se total weight aa raha hai woh same set hoga
        $("#txtTotalWeight").val(remainingWeight.toFixed(3));

        $("#remainingBilletText").text(
            "Charged: " + chargedBillet +
            " | Discharged: " + alreadyDischargedBillet +
            " | Remaining: " + remainingBillet +
            " | Wt/Billet: " + chargingWeightPerBillet.toFixed(3)
        );
    },
    error: function () {
        clearFields();

        Swal.fire({
            icon: 'error',
            title: 'Server Error',
            text: 'Unable to fetch charging details.'
        });
    }
});
        });

        // ==============================
        // EDIT BUTTON
        // ==============================
 $(document).on("click", ".btn-edit", function () {
     debugger
    isEditMode = true;

    var id = $(this).data("id");
    var heat = ($(this).data("heat") || "").toString().trim();
    var boarding = $(this).data("boarding");
    var grade = $(this).data("grade");
    var newGrade = $(this).data("newgrade");
    var poNumber = $(this).data("ponumber");
    var productSpecs =
        ($(this).attr("data-productspecs") || "")
            .toString()
            .trim();
    var cobble = $(this).data("cobble");
    var hotOut = $(this).data("hotout");
    var billet = toNum($(this).data("billet"));
    var totalWeight = toNum($(this).data("totalweight"));
    var sequence = $(this).data("sequence");

    $("#hdnID").val(id);

    var option = $("#ddlHeat option").filter(function () {
        return ($(this).val() || "").toString().trim().toLowerCase() === heat.toLowerCase();
    });

    if (option.length > 0) {
        option.prop("disabled", false);
        $("#ddlHeat").val(option.val()).trigger("change.select2");
    } else {
        var newOption = new Option(heat, heat, true, true);
        $("#ddlHeat").append(newOption).trigger("change.select2");
    }

    $("#txtBoarding").val(boarding || "");
    $("#txtGrade").val(grade || "");
    $("#ddlNewSteelGrade").val(newGrade || "");
    $("#txtPONumber").val(poNumber || heat);
    $("#txtProductSpecs").val(productSpecs || "");

    $("#txtCobble").val(cobble || 0);
    $("#txtHotOut").val(hotOut || 0);

    $("#txtTotalBillet")
        .val(billet)
        .removeAttr("max")
        .removeAttr("data-remaining");

    $("#txtTotalWeight").val(totalWeight.toFixed(3));
    $("#txtDischargingSequence").val(sequence || "");

    // ✅ Important: edit mode formula ke liye original values set karo
    originalBilletQty = billet;
    originalTotalWeight = totalWeight;

    // ✅ Fallback: old total weight / old billet se per billet weight
    chargingWeightPerBillet = billet > 0 ? (totalWeight / billet) : 0;

    // ✅ Better: charging se actual weight per billet fetch karo
    $.ajax({
        url: '@Url.Action("GetChargingByHeat", "RollingMill")',
        type: 'GET',
        data: { heatNo: heat },
        success: function (res) {

            if (res) {
                var remainingBillet = toNum(res.RemainingBillet);
                var remainingWeight = toNum(res.TotalWeight);

                if (remainingBillet > 0 && remainingWeight > 0) {
                    chargingWeightPerBillet = remainingWeight / remainingBillet;
                }

                /*
                 * Product Specs / Product Code:
                 * Prefer current charging response.
                 * If backend uses ProductCode instead of ProductSpecs,
                 * both names are supported.
                 */
                var chargingProductSpecs =
                    res.ProductSpecs ||
                    res.ProductCode ||
                    productSpecs ||
                    "";

                $("#txtProductSpecs").val(
                    chargingProductSpecs
                );
            }
            else {
                $("#txtProductSpecs").val(
                    productSpecs || ""
                );
            }

            $("#remainingBilletText").text(
                "Edit mode: update existing discharge record. Wt/Billet: " + chargingWeightPerBillet.toFixed(3)
            );
        }
    });

    $("#btnSubmit")
        .removeClass("btn-primary")
        .addClass("btn-warning")
        .text("Update Discharge");

    $("html, body").animate({
        scrollTop: $("#addprofileform").offset().top - 80
    }, 400);
});

        // ==============================
        // TOTAL BILLET VALIDATION - INSERT MODE ONLY
        // ==============================
        $("#txtTotalBillet").on("keyup change input", function () {

            var enteredBillet = toNum($("#txtTotalBillet").val());
            var remainingBillet = toNum($("#txtTotalBillet").attr("data-remaining"));

            if (!isEditMode) {
                if (remainingBillet > 0 && enteredBillet > remainingBillet) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Billet Quantity',
                        text: 'You cannot discharge more than remaining billet. Remaining billet is ' + remainingBillet + '.'
                    });

                    $("#txtTotalBillet").val(remainingBillet);
                }
            }

            calculateTotalWeight();
        });
        // ==============================
        // SUBMIT / UPDATE CONFIRMATION
        // ==============================
        $("#addprofileform").off("submit").on("submit", function (e) {
            e.preventDefault();

            if (isSubmitting) {
                return;
            }

            var id = parseInt($("#hdnID").val()) || 0;
            var isUpdate = id > 0;

            var heatNo = $("#ddlHeat").val();
            var totalBillet = toNum($("#txtTotalBillet").val());
            var remainingBillet = toNum($("#txtTotalBillet").attr("data-remaining"));

            if (!heatNo) {
                Swal.fire({
                    icon: 'error',
                    title: 'Heat Required',
                    text: 'Please select Heat No.'
                });
                return;
            }

            if (totalBillet <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Total Billet Required',
                    text: 'Please enter valid Total Billet.'
                });
                return;
            }

            if (!isUpdate) {
                if (remainingBillet <= 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Heat',
                        text: 'Please select a valid Heat No with remaining billet.'
                    });
                    return;
                }

                if (totalBillet > remainingBillet) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Billet Quantity',
                        text: 'You cannot discharge more than remaining billet. Remaining billet is ' + remainingBillet + '.'
                    });
                    return;
                }
            }

            Swal.fire({
                title: isUpdate ? 'Confirm Update' : 'Confirm Discharge',
                text: isUpdate
                    ? 'Are you sure you want to update this discharge record?'
                    : 'Are you sure you want to discharge this heat?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: isUpdate ? 'Yes, Update' : 'Yes, Discharge',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {

                if (result.isConfirmed) {
                    isSubmitting = true;

                    $("#btnSubmit")
                        .prop("disabled", true)
                        .text(isUpdate ? "Updating..." : "Submitting...");

                    $("#addprofileform")[0].submit();
                }
            });
        });

        // ==============================
        // DELETE CONFIRMATION
        // ==============================
        $(document).on("click", ".btn-delete", function (e) {
            e.preventDefault();
            e.stopPropagation();

            var id = $(this).data("id");

            Swal.fire({
                title: "Are you sure?",
                text: "This record will be permanently deleted.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {

                if (result.isConfirmed) {
                    window.location.href = '/RollingMill/deleteDischarging?ID=' + id;
                }
            });
        });

        // ==============================
        // TEMP DATA ALERTS
        // ==============================
        var successMsg = '@TempData["SuccessMessage"]';
        var errorMsg = '@TempData["ErrorMessage"]';

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: successMsg,
                confirmButtonColor: '#3085d6'
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMsg,
                confirmButtonColor: '#d33'
            });
        }

        // ==============================
        // SHIFT FILTER
        // ==============================
        $("#shiftFilter").off("change").on("change", function () {
            applyShiftFilter();
        });

        // ==============================
        // INITIAL LOAD
        // ==============================
        applyShiftFilter();
        calculateKPI();
    });
</script>