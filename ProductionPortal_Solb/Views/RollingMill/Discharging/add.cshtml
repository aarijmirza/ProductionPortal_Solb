
@using System.Globalization
@model DAL.Models.ViewModel.RMDischargingVM
@{
    ViewBag.Title = "add";

    int nextSequence = 1;

    if (Model.SubmittedHeat != null && Model.SubmittedHeat.Any())
    {
        nextSequence = Model.SubmittedHeat
            .Where(x => x.Shift == Model.Shift)
            .Select(x => x.DischargingSequence)
            .Where(x => x > 0)
            .DefaultIfEmpty(0)
            .Max() + 1;
    }
}
<style>
    .dropdown-container {
        position: relative;
    }

    .dropdown-menu-custom {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        width: 100%;
        max-width: 500px;
        /* 💥 INCREASE THIS VALUE 💥 */
        max-height: 250px; /* Increased height */
        overflow-y: auto; /* Keep scrollbar */
        border: 1px solid #ccc;
        background-color: white;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
        font-size: 12px;
    }

        .dropdown-menu-custom table {
            table-layout: fixed; /* Ensures fixed column widths */
        }

        .dropdown-menu-custom tbody tr {
            cursor: pointer;
        }

            .dropdown-menu-custom tbody tr:hover {
                background-color: #f5f5f5;
            }
            /* Style for selected row, if needed */
            .dropdown-menu-custom tbody tr.selected {
                background-color: #007bff;
                color: white;
            }

        /* Ensures headers are bold */
        .dropdown-menu-custom th {
            font-weight: bold;
            /* Add a border to the right of the header cells for alignment */
            border-right: 1px solid #ccc;
        }

            /* Remove the border from the last header cell */
            .dropdown-menu-custom th:last-child {
                border-right: none;
            }

        /* 💥 VERTICAL AND HORIZONTAL SEPARATORS 💥 */
        .dropdown-menu-custom td {
            /* Horizontal Separator (bottom) */
            border-bottom: 1px solid #ddd;
            /* Vertical Separator (right) */
            border-right: 1px solid #ccc; /* Light vertical line between columns */
        }

            /* Ensure the last column (last td in each row) does not have a right border */
            .dropdown-menu-custom td:last-child {
                border-right: none;
            }

        /* Ensure the last row doesn't have a bottom border, keeping it clean */
        .dropdown-menu-custom tr:last-child td {
            border-bottom: none;
        }
    /* ... (Keep existing hover styles) ... */

    /* Select2 ko Bootstrap form-control jesa banane ke liye */
    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--single {
            height: 36px !important;
            border: 1px solid #e8edf3 !important;
            border-radius: 5px !important;
            background-color: #f3f5f8 !important;
            display: flex !important;
            align-items: center !important;
        }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #8798ad !important;
        font-size: 16px !important;
        line-height: 45px !important;
        padding-left: 15px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
        right: 8px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #8798ad !important;
    }

    .select2-container--default.select2-container--focus .select2-selection--single,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #80bdff !important;
        outline: 0 !important;
        box-shadow: 0 0 0 0.1rem rgba(0, 123, 255, .25) !important;
    }
</style>

