@using System

@{
    string selectedDate = Convert.ToString(Session["RM_Date"]);
    string selectedShift = Convert.ToString(Session["RM_Shift"]);

    int selectedShiftDetailID = 0;
    int.TryParse(
        Convert.ToString(Session["RM_ShiftDetailID"]),
        out selectedShiftDetailID
    );

    bool hasRollingMillShift =
        !string.IsNullOrWhiteSpace(selectedDate) &&
        !string.IsNullOrWhiteSpace(selectedShift) &&
        selectedShiftDetailID > 0;

    /*
        This application already resolves roles through User.IsInRole().
        Do not use Roles.GetRolesForUser() because ASP.NET Role Manager
        is not enabled in Web.config.
    */
    bool isAdmin =
        User != null &&
        User.IsInRole("Administrator");

    bool isUser =
        User != null &&
        User.IsInRole("User");

    bool isRollingMill =
        User != null &&
        (
            User.IsInRole("Rolling Mill User") ||
            User.IsInRole("Rolling Mill")
        );

    bool isQC =
        User != null &&
        User.IsInRole("QC User");

    bool isSher =
        User != null &&
        User.IsInRole("Sher");

    bool isSupplyChain =
        User != null &&
        User.IsInRole("Supply Chain");

    bool isUtility =
        User != null &&
        User.IsInRole("Utility");

    bool isSteelMaking =
        User != null &&
        (
            User.IsInRole("Steel Making") ||
            User.IsInRole("Steel Making User")
        );

    bool canViewDashboardReports =
        isAdmin ||
        isUser ||
        isRollingMill ||
        isQC ||
        isSher ||
        isSupplyChain ||
        isUtility ||
        isSteelMaking;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@(ViewBag.Title ?? "Production Portal") - Solb Steel</title>

    <link rel="shortcut icon" href="@Url.Content("~/assets/images/favicon.png")">

    <link href="@Url.Content("~/assets/css/icons.css")"
          rel="stylesheet"
          type="text/css" />

    @Styles.Render("~/bundles/core-css")
    @Styles.Render("~/bundles/plugin-css")

    @RenderSection("styles", required: false)
    @RenderSection("vendorStyles", required: false)

    @* Keep only one jQuery reference because some existing pages may use
        inline jQuery before the closing body tag. *@
    @Scripts.Render("~/bundles/jquery")
</head>

<body class="xp-vertical">

    <!-- Search Modal -->
    <div class="modal search-modal fade" id="xpSearchModal" tabindex="-1" role="dialog" aria-labelledby="xpSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="xp-searchbar">
                        <form>
                            <div class="input-group">
                                <input type="search" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="button-addon2">
                                <div class="input-group-append">
                                    <button class="btn" type="submit" id="button-addon2">GO</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Search Modal -->
    <!-- Start XP Container -->
    <div id="xp-container">

        <!-- Start XP Topbar -->
        <div class="xp-topbar">
            <div class="row">
                <div class="col-2 col-md-1 col-lg-1 order-2 order-md-1 align-self-center">
                    <div class="xp-menubar">
                        <a class="xp-menu-hamburger" href="javascript:void(0);">
                            <i class="icon-menu font-20 text-white"></i>
                        </a>
                    </div>
                </div>

                <div class="col-10 col-md-11 col-lg-11 order-1 order-md-2">
                    <div class="xp-profilebar text-right">
                        <ul class="list-inline mb-0">
                            <li class="list-inline-item mr-0">
                                <div class="dropdown xp-userprofile">
                                    <a class="dropdown-toggle py-3 text-white text-center font-18"
                                       href="#"
                                       role="button"
                                       data-toggle="dropdown"
                                       aria-haspopup="true"
                                       aria-expanded="false">
                                        Welcome, @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="xp-userprofile">
                                        <a class="dropdown-item py-3" href="@Url.Action("Logout", "Login")">
                                            <i class="icon-power text-danger mr-2"></i> Logout
                                        </a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- End XP Topbar -->
        <!-- Start XP Leftbar -->
        <div class="xp-leftbar">

            <!-- Start XP Sidebar -->
            <div class="xp-sidebar">

                <!-- Start XP Logobar -->
                <div class="xp-logobar text-center">
                    <a href="@Url.Action("Index", "Home")" class="xp-logo">
                        <img src="@Url.Content("~/assets/images/logo.png")" class="img-fluid" alt="SOLB Steel" width="140" height="60" decoding="async" style="width:50%;">
                    </a>
                </div>
                <!-- End XP Logobar -->
                <!-- Start XP Navigationbar -->
                <div class="xp-navigationbar">
                    <ul class="xp-vertical-menu">

                        @* DASHBOARDS - Visible for all department roles *@

                        <li>
                            <a href="javascript:void(0);">
                                <span>DASHBOARD'S</span><i class="icon-arrow-right pull-right"></i>
                            </a>
                            @if (canViewDashboardReports)
                            {
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("ReportingSection", "Reporting")">OPERATION DASHBOARD</a></li>
                                </ul>
                            }
                            <ul class="xp-vertical-submenu">
                                <li><a href="@Url.Action("list", "Executive")">EXECUTIVE DASHBOARD</a></li>
                            </ul>
                        </li>

                        @* STEEL MAKING PLANT - Only Admin, Steel Making and QC *@
                        @if (isAdmin || isSteelMaking || isQC)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>STEEL MAKING PLANT</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "Scrapyard")">SCRAPYARD</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("EAFlist", "Meltshop")">ELECTRIC ARC FURNACE</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("LFlist", "Meltshop")">LADDLE FURNACE</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "CCM")">CCM</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("List", "CCMProduction")">BILLET YARD REPORT</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("Index", "SMPDayWiseProduction")">DAY WISE PRODUCTION</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("Index", "SMPProductionDelay")">DAY WISE DELAYS</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("CCMYieldlist", "CCM")">CCM YIELD BREAK DOWN</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("SMPlist", "Delay")">DELAY RECORD</a></li>
                                </ul>
                            </li>
                        }

                        @* QUALITY CONTROL - QC section with relevant access *@
                        @if (isAdmin || isQC || isRollingMill || isSteelMaking || isSupplyChain)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>QUALITY CONTROL</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                @if (isAdmin || isQC || isSteelMaking)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("HeatChemistry", "Quality")">HEAT CHEMISTRY</a></li>
                                    </ul>

                                    @*<ul class="xp-vertical-submenu">
                                            <li><a href="@Url.Action("castmillCertificate", "Quality")">CAST / MILL CERTIFICATE</a></li>
                                        </ul>*@
                                }

                                @if (isAdmin || isQC || isRollingMill)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("AddInspectionRM", "Quality")">QC INSPECTION DATA - RM</a></li>
                                    </ul>
                                }
                                @if (isAdmin || isQC || isRollingMill || isSupplyChain)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("BilletBoard", "Quality")">BILLET BOARDING</a></li>
                                    </ul>
                                }
                                @if (isAdmin || isQC || isRollingMill)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("QCInspectionRMadd", "RMMechanical")">RM MECHANICAL TEST RESULT</a></li>
                                    </ul>
                                }

                                @if (isAdmin || isQC)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("SlagByProductList", "Quality")">SLAG & BY PRODUCTS</a></li>
                                    </ul>

                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("HBIDRIlist", "Quality")">DRI / HBI ANALYSIS</a></li>
                                    </ul>
                                }
                            </li>
                        }
                        @* ROLLING MILL - Only Admin and Rolling Mill users *@
                        @if (isAdmin || isRollingMill)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>ROLLING MILL</span>
                                    <i class="icon-arrow-right pull-right"></i>
                                </a>

                                <ul class="xp-vertical-submenu">

                                    <li>
                                        <a href="@Url.Action("AddDetails", "RollingMill")">
                                            ROLLING MILL DETAILS
                                        </a>
                                    </li>

                                    <li>
                                        <a href="@Url.Action("add", "Target")">
                                            ROLLING MILL TARGETS
                                        </a>
                                    </li>

                                    @if (hasRollingMillShift)
                                    {
                                        <li>
                                            <a href="@Url.Action("AddCharge", "RollingMill")">
                                                BILLET CHARGING
                                            </a>
                                        </li>

                                        <li>
                                            <a href="@Url.Action("AddDischarge", "RollingMill")">
                                                FURNACE DISCHARGE
                                            </a>
                                        </li>

                                        <li>
                                            <a href="@Url.Action("RMHourlyDischarge", "RollingMill")">
                                                HOURLY DATA BREAKDOWN
                                            </a>
                                        </li>

                                        <li>
                                            <a href="@Url.Action("AddBundleSection", "RollingMill")">
                                                BUNDLE SECTION
                                            </a>
                                        </li>

                                        <li>
                                            <a href="@Url.Action("list", "Delay")">
                                                DELAY RECORD
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li style="color:#dc3545; padding:10px 20px; font-size:12px; font-weight:700;">
                                            ⚠ Please select Rolling Mill shift first
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        @* CMD MAINTENANCE - No separate CMD role available, so kept Admin/User *@
                        @if (isAdmin || isUser)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>CMD MAINTENANCE</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "Maintenance")">DELAY ANALYSIS REPORT</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("countermeasurelist", "Maintenance")">COUNTER MEASURE REPORT</a></li>
                                </ul>
                            </li>
                        }

                        @* SUPPLY CHAIN - Only Admin and Supply Chain *@
                        @if (isAdmin || isSupplyChain)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>SUPPLY CHAIN</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "SupplyChain")">SUPPLY CHAIN REPORT</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("add", "Stock")">MATERIAL STOCK</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("Stocklist", "Stock")">SUPPLY CHAIN STOCK</a></li>
                                </ul>
                            </li>
                        }

                        @* UTILITY - Only Admin and Utility *@
                        @if (isAdmin || isUtility || isUser)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>UTILITY CONSUMPTION</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "Consumption")">CONSUMPTIONS</a></li>
                                </ul>
                            </li>
                        }

                        @* SHER - Only Admin and Sher *@
                        @if (isAdmin || isSher)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>EHSS</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("KPIAdd", "Security")">EHSS DETAIL</a></li>
                                </ul>
                            </li>
                        }

                        @* REPORTS - Visible for all department roles *@
                        @if (canViewDashboardReports)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>REPORTS</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "SMPReports")">SMP REPORTS</a></li>
                                    <li><a href="@Url.Action("list", "RMReports")">ROLLING MILL REPORTS</a></li>
                                </ul>
                            </li>
                        }

                        @* SETTINGS - Only Administrator *@
                        @if (isAdmin)
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>SETTING</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "UserRole")">USER ROLE</a></li>
                                </ul>

                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "User")">USER DETAILS</a></li>
                                </ul>
                            </li>
                        }

                    </ul>
                </div>
                <!-- End XP Navigationbar -->

            </div>
            <!-- End XP Sidebar -->

        </div>
        <!-- End XP Leftbar -->
        <!-- Start XP Rightbar -->
        <div class="xp-rightbar">

            @RenderBody()

            <!-- Start XP Footerbar -->
            <div class="xp-footerbar">
                <footer class="footer">
                    <p class="mb-0">© 2025 Solb Steel - All Rights Reserved.</p>
                </footer>
            </div>
            <!-- End XP Footerbar -->

        </div>
        <!-- End XP Rightbar -->

    </div>
    <!-- End XP Container -->
    <!-- Core JavaScript -->
    @Scripts.Render("~/bundles/core-js")

    <!-- Plugin JavaScript -->
    @Scripts.Render("~/bundles/plugin-js")
    @RenderSection("vendorScripts", required: false)

    @RenderSection("scripts", required: false)

</body>
</html>