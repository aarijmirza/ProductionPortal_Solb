@{
    var selectedDate = Session["RM_Date"];
    var selectedShift = Session["RM_Shift"];
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Production Portal - Solb Steel</title>

    <link rel="shortcut icon" href="@Url.Content("~/assets/images/favicon.png")">

    <link href="@Url.Content("~/assets/css/icons.css")"
          rel="stylesheet"
          type="text/css" />

    @Styles.Render("~/bundles/core-css")
    @Styles.Render("~/bundles/plugin-css")

    @RenderSection("styles", required: false)

    @* Keep only one jQuery reference because some existing pages may use
        inline jQuery before the closing body tag. *@
    @Scripts.Render("~/bundles/jquery")
</head>

<body class="xp-vertical">
    <!-- Search Modal -->
    <div class="modal search-modal fade" id="xpSearchModal" tabindex="-1" role="dialog" aria-labelledby="xpSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="xp-searchbar">
                        <form>
                            <div class="input-group">
                                <input type="search" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="button-addon2">
                                <div class="input-group-append">
                                    <button class="btn" type="submit" id="button-addon2">GO</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Start XP Container -->
    <div id="xp-container">
        <!-- Start XP Topbar -->
        <div class="xp-topbar">

            <!-- Start XP Row -->
            <div class="row">

                <!-- Start XP Col -->
                <div class="col-2 col-md-1 col-lg-1 order-2 order-md-1 align-self-center">
                    <div class="xp-menubar">
                        <a class="xp-menu-hamburger" href="javascript:void(0);">
                            <i class="icon-menu font-20 text-white"></i>
                        </a>
                    </div>
                </div>
                <!-- End XP Col -->
                <!-- Start XP Col -->
                <div class="col-10 col-md-11 col-lg-11 order-1 order-md-2">
                    <div class="xp-profilebar text-right">
                        <ul class="list-inline mb-0">
                            <li class="list-inline-item mr-0">
                                <div class="dropdown xp-userprofile">
                                    @*<a class="dropdown-toggle" href="#" role="button" id="xp-userprofile" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><img src="~/assets/images/topbar/user.jpg" alt="user-profile" class="rounded-circle img-fluid"><span class="xp-user-live"></span></a>*@
                                    <a class="dropdown-toggle py-3 text-white text-center font-18" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Welcome, @User.Identity.Name</a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="xp-userprofile">
                                        @*<a class="dropdown-item py-3 text-white text-center font-16" href="#">Welcome, @User.Identity.Name</a>*@
                                        <a class="dropdown-item py-3" href="@Url.Action("Logout", "Login")"><i class="icon-power text-danger mr-2"></i> Logout</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <!-- End XP Col -->

            </div>
            <!-- End XP Row -->

        </div>
        <!-- End XP Topbar -->
        <!-- Start XP Leftbar -->
        <div class="xp-leftbar">

            <!-- Start XP Sidebar -->
            <div class="xp-sidebar">

                <!-- Start XP Logobar -->
                <div class="xp-logobar text-center">
                    <a href="@Url.Action("Index", "Home")" class="xp-logo"><img src="~/assets/images/logo.png" class="img-fluid" alt="logo" style="width:50%;"></a>
                </div>
                <!-- End XP Logobar -->
                <!-- Start XP Navigationbar -->
                <div class="xp-navigationbar">
                    <ul class="xp-vertical-menu">
                        <li>
                            <a href="javascript:void(0);">
                                <span>DASHBOARD'S</span><i class="icon-arrow-right pull-right"></i>
                            </a>
                            <ul class="xp-vertical-submenu">
                                <li><a href="@Url.Action("ReportingSection", "Reporting")">OPERATION DASHBOARD</a></li>
                            </ul>
                            <ul class="xp-vertical-submenu">
                                <li><a href="@Url.Action("list", "Executive")">EXECUTIVE DASHBOARD</a></li>
                            </ul>
                        </li>
                        @*<li class="xp-vertical-header">MELTSHOP SECTION</li>*@
                        @if (User.IsInRole("Administrator") || User.IsInRole("User") || User.IsInRole("Steel Making User") || User.IsInRole("QC User"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>STEEL MAKING PLANT</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "Scrapyard")">SCRAPYARD</a></li>
                                </ul><ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("EAFlist", "Meltshop")">ELECTRIC ARC FURNACE</a></li>
                                </ul><ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("LFlist", "Meltshop")">LADDLE FURNACE</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "CCM")">CCM</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("List", "CCMProduction")">BILLET YARD REPORT</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("CCMYieldlist", "CCM")">CCM YIELD BREAK DOWN</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("SMPlist", "Delay")">DELAY RECORD</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("QC User") || User.IsInRole("Rolling Mill User") || User.IsInRole("User"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>QUALITY CONTROL</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                @if (User.IsInRole("Administrator") || User.IsInRole("User") || User.IsInRole("QC User") || User.IsInRole("Steel Making User"))
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("HeatChemistry", "Quality")">HEAT CHEMISTRY</a></li>
                                    </ul>
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("castmillCertificate", "Quality")">CAST / MILL CERTIFICATE</a></li>
                                    </ul>
                                }
                                @if (User.IsInRole("Administrator") || User.IsInRole("Rolling Mill User") || User.IsInRole("QC User"))
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("AddInspectionRM", "Quality")">QC INSPECTION DATA - RM</a></li>
                                    </ul>
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("BilletBoard", "Quality")">BILLET BOARD</a></li>
                                    </ul>
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("QCInspectionRMadd", "Quality")">RM MECHANICAL TEST RESULT</a></li>
                                    </ul>
                                }
                                @if (User.IsInRole("Administrator") || User.IsInRole("QC User"))
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("SlagByProductList", "Quality")">SLAG & BY PRODUCTS</a></li>
                                    </ul>
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("HBIDRIlist", "Quality")">DRI / HBI ANALYSIS</a></li>
                                    </ul>
                                }

                            </li>
                        }
                        @if (User.IsInRole("Rolling Mill User") || User.IsInRole("Administrator") || User.IsInRole("user"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>ROLLING MILL</span><i class="icon-arrow-right pull-right"></i>
                                </a>

                                @if (selectedDate != null && selectedShift != null)
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("AddDetails","RollingMill")">DETAILS</a></li>
                                        <li><a href="@Url.Action("AddCharge","RollingMill")">BILLET CHARGING</a></li>
                                        <li><a href="@Url.Action("AddDischarge","RollingMill")">FURNACE DISCHARGE</a></li>
                                        <li><a href="@Url.Action("RMHourlyDischarge","RollingMill")">HOURLY DATA BREAKDOWN</a></li>
                                        <li><a href="@Url.Action("AddBundleSection","RollingMill")">BUNDLE SECTION</a></li>
                                        <li><a href="@Url.Action("add","Target")">ROLLING MILL TARGETS</a></li>
                                        @if (User.IsInRole("User") || User.IsInRole("Administrator") || User.IsInRole("Rolling Mill User"))
                                        {
                                            <li><a href="@Url.Action("list", "Delay")">DELAY RECORD</a></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <ul class="xp-vertical-submenu">
                                        <li><a href="@Url.Action("AddDetails","RollingMill")">ROLLING MILL DETAILS</a></li>
                                        <li style="color:red; padding:10px;">
                                            ⚠ Please select shift first
                                        </li>
                                    </ul>
                                }
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("User"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>CMD MAINTENANCE</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "Maintenance")">DELAY ANALYSIS REPORT</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("Supply Chain"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>SUPPLY CHAIN</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "SupplyChain")">SUPPLY CHAIN REPORT</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("add", "Stock")">MATERIAL STOCK</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("Stocklist", "Stock")">SUPPLY CHAIN STOCK</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("User"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>UTILITY CONSUMPTION</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("add", "Consumption")">CONSUMPTIONS</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("Sher"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>HSE</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("KPIAdd", "Security")">SHER DETAIL</a></li>
                                    @*<li><a href="@Url.Action("FSadd", "Security")">FIRE SYSTEM KPI</a></li>*@
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Administrator") || User.IsInRole("Rolling Mill User") || User.IsInRole("Supply Chain"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>REPORTS</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "SMPReports")">SMP REPORTS</a></li>
                                    <li><a href="@Url.Action("list", "RMReports")">ROLLING MILL REPORTS</a></li>
                                    @*@if (User.IsInRole("Administrator") || User.IsInRole("User") || User.IsInRole("Supply Chain"))
                                                                {
                                        <li><a href="@Url.Action("ReportingSection", "Reporting")">OTHER REPORTS</a></li>
                                                                }*@
                                    @*<li><a href="@Url.Action("ProductionSummary", "SMPReports")">DIRECTOR SUMMARY REPORTS</a></li>*@

                                    @*<li><a href="@Url.Action("DownloadSMPIntegratedPDF", "Reporting")">SMP INTEGRATED REPORT</a></li>
                                        <li><a href="@Url.Action("DownloadSMPDailyReport", "Reporting")">SMP DAILY SUMMARY REPORT</a></li>
                                        <li><a href="@Url.Action("DownloadDailyPlantStatistics", "Reporting")">SMP MONTHLY STATISTIC REPORT</a></li>*@

                                </ul>
                                @*<ul class="xp-vertical-submenu">
                                        @if (User.IsInRole("Administrator") || User.IsInRole("User"))
                                        {
                                            <li><a href="@Url.Action("DownloadSMPIntegratedPDF", "Reporting")">SMP INTEGRATED REPORT</a></li>
                                            <li><a href="@Url.Action("DownloadSMPDailyReport", "Reporting")">SMP DAILY SUMMARY REPORT</a></li>
                                            <li><a href="@Url.Action("DownloadDailyPlantStatistics", "Reporting")">SMP MONTHLY STATISTIC REPORT</a></li>
                                        }
                                        @if (User.IsInRole("Rolling Mill User") || User.IsInRole("Administrator") || User.IsInRole("User"))
                                        {
                                            <li><a href="@Url.Action("DailyProductionRM", "Reporting")" target="_blank">RM DAILY PRODUCTION REPORT</a></li>
                                            <li><a href="@Url.Action("RMMonthlyPerformanceReport", "Reporting")" target="_blank">RM MONTHLY SUMMARY REPORT</a></li>
                                        }
                                    </ul>*@
                            </li>
                        }

                        @if (User.IsInRole("Administrator"))
                        {
                            <li>
                                <a href="javascript:void(0);">
                                    <span>SETTING</span><i class="icon-arrow-right pull-right"></i>
                                </a>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "UserRole")">USER ROLE</a></li>
                                </ul>
                                <ul class="xp-vertical-submenu">
                                    <li><a href="@Url.Action("list", "User")">USER DETAILS</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
                <!-- End XP Navigationbar -->

            </div>
            <!-- End XP Sidebar -->

        </div>
        <!-- End XP Leftbar -->
        <!-- Start XP Rightbar -->
        <div class="xp-rightbar">

            @RenderBody()

            <!-- Start XP Footerbar -->
            <div class="xp-footerbar">
                <footer class="footer">
                    <p class="mb-0">© 2025 Solb Steel - All Rights Reserved.</p>
                </footer>
            </div>
            <!-- End XP Footerbar -->

        </div>
        <!-- End XP Rightbar -->

    </div>
    <!-- End XP Container -->
    <!-- Core JavaScript -->
    @Scripts.Render("~/bundles/core-js")

    <!-- Plugin JavaScript -->
    @Scripts.Render("~/bundles/plugin-js")

    <!-- Select2 is currently loaded from CDN because no local Select2 folder
         was shown in the project structure. -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
