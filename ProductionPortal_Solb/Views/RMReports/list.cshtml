@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ================= BREADCRUMB ================= -->
<!-- Start XP Breadcrumbbar -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6 col-lg-6">
            <h4 class="xp-page-title">Rolling Mill</h4>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="xp-breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")"><i class="icon-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="#">Rolling Mill</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reports</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- End XP Breadcrumbbar -->
<!-- ================= FILTER SECTION ================= -->
<div class="xp-contentbar">
    <div class="card mb-3">
        <div class="card-body">

            <div class="row align-items-end">

                <div class="col-md-2">
                    <label>From Date</label>
                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label>To Date</label>
                    <input type="date"
                           id="toDate"
                           name="toDate"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label>Plant</label>
                    <select id="plantFilter" class="form-control">
                        <option value="">All</option>
                        <option value="Rolling Mill 1">RM1</option>
                        <option value="Rolling Mill 2">RM2</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label>Shift</label>
                    <select id="shiftFilter" class="form-control">
                        <option value="">All</option>
                        <option value="Morning">Morning</option>
                        <option value="Evening">Evening</option>
                        <option value="Night">Night</option>
                        <option value="Long Morning">Long Morning</option>
                        <option value="Long Night">Long Night</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button class="btn btn-primary mt-4" id="applyFilter">
                        Apply Filter
                    </button>
                </div>

            </div>

        </div>
    </div>

    <!-- ================= REPORT CARDS ================= -->
    <div class="row">

        <!-- Shift Production Report -->
        <div class="col-md-4">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Shift Production Report</h5>

                    <button class="btn btn-primary openReport mb-2"
                            data-url="@Url.Action("ShiftProductionReport", "Reporting")">
                        View Report
                    </button>

                    <button class="btn btn-success downloadReport mb-2"
                            data-url="@Url.Action("ShiftProductionReport", "Reporting")">
                        Download Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Monthly Performance -->
        <div class="col-md-4">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Monthly Performance</h5>

                    <button class="btn btn-primary openReport mb-2"
                            data-url="@Url.Action("RMMonthlyPerformanceReport", "Reporting")">
                        View Report
                    </button>

                    <button class="btn btn-success downloadReport mb-2"
                            data-url="@Url.Action("RMMonthlyPerformanceReport", "Reporting")">
                        Download Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Daily Production -->
        <!--<div class="col-md-4">
            <div class="card border-danger mb-3">
                <div class="card-body text-center">
                    <h5>Daily Production</h5>-->
        @*<button class="btn btn-primary openReport mb-2"
                    data-url="@Url.Action("DailyProductionRM", "Reporting")">
                View Report
            </button>*@

        <!--<button class="btn btn-primary openReport mb-2"
                            data-url="@Url.Action("ShiftProductionDashboard", "Reporting")">
                        View Report
                    </button>

                    <button class="btn btn-success downloadReport mb-2"
                            data-url="@Url.Action("DailyProductionRM", "Reporting")">
                        Download Report
                    </button>
                </div>
            </div>
        </div>-->

    </div>
</div>

<!-- ================= SCRIPTS ================= -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function () {

        var today = new Date().toISOString().split("T")[0];

        $("#fromDate").val(today);
        $("#toDate").val(today);

        function validateFilters() {

            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();

            if (!fromDate) {
                alert("Please select From Date.");
                return false;
            }

            if (!toDate) {
                alert("Please select To Date.");
                return false;
            }

            if (new Date(fromDate) > new Date(toDate)) {
                alert("From Date cannot be greater than To Date.");
                return false;
            }

            return true;
        }

        function buildReportUrl(baseUrl, isDownload) {

            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();
            var plant = $("#plantFilter").val();
            var shift = $("#shiftFilter").val();

            return baseUrl
                + "?fromDate=" + encodeURIComponent(fromDate)
                + "&toDate=" + encodeURIComponent(toDate)
                + "&plant=" + encodeURIComponent(plant)
                + "&shift=" + encodeURIComponent(shift)
                + "&download=" + encodeURIComponent(isDownload);
        }

        $("#applyFilter").click(function () {
            validateFilters();
        });

        $(document).on("click", ".openReport", function () {

            if (!validateFilters()) {
                return;
            }

            var finalUrl = buildReportUrl(
                $(this).data("url"),
                false
            );

            window.open(finalUrl, "_blank");
        });

        $(document).on("click", ".downloadReport", function () {

            if (!validateFilters()) {
                return;
            }

            var finalUrl = buildReportUrl(
                $(this).data("url"),
                true
            );

            window.open(finalUrl, "_blank");
        });

    });
</script>