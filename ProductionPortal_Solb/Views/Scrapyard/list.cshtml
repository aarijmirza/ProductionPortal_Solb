@model List<DAL.Models.ScrapyardBLL>
@using System.Globalization

@{
    ViewBag.Title = "Scrapyard Record";
    var gregorian = new CultureInfo("en-US");
    gregorian.DateTimeFormat.Calendar = new GregorianCalendar();
}

<style>
    .group-header {
        cursor: pointer;
        font-weight: bold;
        background-color: #f0f0f0;
    }

    tr.shown {
        background-color: #e9f3ff !important;
    }
</style>

<!-- ================= HEADER ================= -->
<div class="xp-breadcrumbbar">
    <div class="row">
        <div class="col-md-6">
            <h4 class="xp-page-title">Scrapyard Record</h4>
        </div>
    </div>
</div>

<!-- ================= FILTERS ================= -->
<div class="xp-breadcrumbbar" style="padding:20px;">
    <div class="card">
        <div class="card-body d-flex justify-content-between">
            <div class="d-flex">
                <div class="form-group mr-2">
                    <label>From</label>
                    <input type="date" id="fromDate" class="form-control" />
                </div>
                <div class="form-group mr-2">
                    <label>To</label>
                    <input type="date" id="toDate" class="form-control" />
                </div>
                <div class="form-group d-flex align-items-end">
                    <button type="button" id="filterBtn" class="btn btn-primary mr-1">Filter</button>
                    <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                </div>
            </div>

            <div class="d-flex align-items-end">
                <a href="@Url.Action("add","Scrapyard")" class="btn btn-info mr-2">
                    <i class="fa fa-plus-circle"></i> Add Scrap
                </a>
                @*<button type="button" id="exportPdf" class="btn btn-danger">
                    <i class="fa fa-file-pdf-o"></i> Export PDF
                </button>*@
            </div>
        </div>
    </div>
</div>

<!-- ================= TABLE ================= -->
<div class="xp-contentbar">
    <div class="card">
        <div class="card-body">
            <table id="scrapyardListTable"
                   class="display table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Heat #</th>
                        <th>Buckets</th>
                        <th>Created By</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @{
                        var grouped = Model.GroupBy(x => new { x.Date, x.Time, x.HeatNo }).ToList();
                    }

                    @foreach (var g in grouped)
                    {
                        var h = g.First();

                        string detailHtml =
                            "<table class='table table-sm table-bordered m-0'>" +
                            "<thead><tr><th>Bucket</th><th>Light Scrap</th><th>HMS</th></tr></thead><tbody>";

                        foreach (var d in g)
                        {
                            detailHtml += $"<tr><td><b>{d.Bucket}</b></td><td>{(d.LightScrap ?? 0)}</td><td>{(d.HMS ?? 0)}</td></tr>";
                        }
                        detailHtml += "</tbody></table>";

                        <tr class="group-header"
                            data-details="@Html.Raw(HttpUtility.HtmlAttributeEncode(detailHtml))">

                            <td data-date="@h.Date.Value.ToString("yyyy-MM-dd")">
                                @h.Date.Value.ToString("dd-MM-yyyy", gregorian)
                            </td>
                            <td>@(h.Time.HasValue ? h.Time.Value.ToString(@"hh\:mm") : "")</td>
                            <td>@h.HeatNo</td>
                            <td>@g.Count() Buckets</td>
                            <td>@h.CreatedBy</td>
                            <td>
                                <a href="@Url.Action("Detail","Scrapyard",new { heatNo = h.HeatNo })"
                                   class="btn btn-sm btn-info"
                                   onclick="event.stopPropagation();">
                                    <i class="mdi mdi-book-open-page-variant"></i>
                                </a>
                                <a href="javascript:void(0);"
                                   onclick="confirmDelete('@h.HeatNo')"
                                   class="btn btn-sm btn-danger">
                                    <i class="mdi mdi-trash-can"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<script>
$(document).ready(function () {

    var table = $('#scrapyardListTable').DataTable({
        paging: true,
        pageLength: 10,
        lengthMenu: [[10,25,50,100],[10,25,50,100]],
        ordering: true,
        searching: true,
        info: true
    });

    // ---------- DATE FILTER ----------
    $.fn.dataTable.ext.search.push(function (settings, data, index) {

        var from = $('#fromDate').val();
        var to = $('#toDate').val();

        var rowNode = table.row(index).node();
        var rowDateStr = $(rowNode).find('td[data-date]').data('date');
        if (!rowDateStr) return true;

        var rowDate = new Date(rowDateStr + "T00:00:00");
        var fromDate = from ? new Date(from + "T00:00:00") : null;
        var toDate = to ? new Date(to + "T23:59:59") : null;

        if (fromDate && rowDate < fromDate) return false;
        if (toDate && rowDate > toDate) return false;

        return true;
    });

    // default date range
    var today = new Date();
    var firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
    function fmt(d){ return d.toISOString().split('T')[0]; }
    $('#fromDate').val(fmt(today));
    $('#toDate').val(fmt(today));
    table.draw();

    $('#filterBtn').click(() => table.draw());
    $('#clearBtn').click(() => {
        $('#fromDate,#toDate').val('');
        table.draw();
    });

    // ---------- CHILD ROW (BUCKET DETAILS) ----------
    $('#scrapyardListTable tbody').on('click', 'tr.group-header', function (e) {

        if ($(e.target).closest("a,button,i").length) return;

        var tr = $(this);
        var row = table.row(tr);

        if (row.child.isShown()) {
            row.child.hide();
            tr.removeClass('shown');
        } else {
            row.child(tr.data('details')).show();
            tr.addClass('shown');
        }
    });

    // ---------- EXPORT PDF ----------
    $('#exportPdf').click(function () {
        var from = $('#fromDate').val() || '';
        var to = $('#toDate').val() || '';
        window.location.href =
            '@Url.Action("ExportPDF","Scrapyard")'
            + '?from=' + encodeURIComponent(from)
            + '&to=' + encodeURIComponent(to);
    });

});

// ---------- DELETE ----------
function confirmDelete(heatNo) {
    if (confirm("Delete this record?")) {
        window.location.href = '/Scrapyard/Delete?heatNo=' + heatNo;
    }
}
</script>
